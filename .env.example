# App DB connection used by moneytracker-web.
# For host machine Postgres: DB_HOST=host.docker.internal
# For external Docker network Postgres: DB_HOST=<service-name-on-jobordermanager_default>
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=prod.moneytracker.v2
DB_USER=postgres
DB_PASSWORD=change_me

# Optional internal Postgres container (used only with --profile internal-db)
POSTGRES_DB=moneytracker
POSTGRES_USER=moneytracker
POSTGRES_PASSWORD=change_me

ASPNETCORE_ENVIRONMENT=Production
APP_TIMEZONE=Central America Standard Time
APP_PUBLIC_BASE_URL=https://yourdomain.com
LOGS_PATH=./logs

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SSL=true
EMAIL_SENDER=your-email@gmail.com
EMAIL_SENDER_NAME=MoneyTracker
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=change_me

# AI text import — set AI_PROVIDER to OpenAI or Google
AI_PROVIDER=Google

# Google AI — opción A: API Key simple (Google AI Studio, sin org policy)
GOOGLE_AI_API_KEY=

# Google AI — opción B: Vertex AI con cuenta de servicio (Google Cloud org)
# Descarga el JSON de la cuenta de servicio y ponlo en una ruta local
GOOGLE_AI_PROJECT_ID=
GOOGLE_AI_LOCATION=us-central1
GOOGLE_AI_MODEL=gemini-2.5-flash
GOOGLE_AI_MAX_TOKENS=2048
GOOGLE_SA_JSON_LOCAL_PATH=/ruta/local/service-account.json

