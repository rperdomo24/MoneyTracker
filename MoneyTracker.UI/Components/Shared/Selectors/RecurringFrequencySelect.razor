@using MoneyTracker.Domain.Enums.Transaction
@using MoneyTracker.UI.Helpers

<MudSelect T="RecurringFrequency?"
           Label="@Label"
           Value="@Value"
           ValueChanged="@((RecurringFrequency? value) => OnValueChanged(value))"
           Variant="Variant.Outlined"
           Required="@Required"
           Clearable="@Clearable"
           Disabled="@Disabled"
           Class="@Class">
    @foreach (var frequency in Enum.GetValues<RecurringFrequency>())
    {
        <MudSelectItem T="RecurringFrequency?" Value="@((RecurringFrequency?)frequency)" @key="frequency">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@frequency.GetIcon()" Size="Size.Small" />
                <MudText Typo="Typo.body2">@frequency.GetLabel()</MudText>
            </MudStack>
        </MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter] public RecurringFrequency? Value { get; set; }
    [Parameter] public EventCallback<RecurringFrequency?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Repeats";
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public bool Clearable { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;

    private async Task OnValueChanged(RecurringFrequency? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
