@using MoneyTracker.Application.DTOs
@using MoneyTracker.Domain.Enums.Account
@using MoneyTracker.UI.Helpers

<MudSelect T="int"
           Label="@Label"
           MultiSelection="true"
           SelectedValues="@SelectedAccountIds"
           SelectedValuesChanged="OnSelectedValuesChanged"
           Variant="Variant.Outlined"
           Clearable="true"
           Disabled="@Disabled"
           MultiSelectionTextFunc="@GetSelectionText"
           MaxHeight="400">

    @{
        AccountType? currentType = null;
    }

    @foreach (var account in OrderedAccounts)
    {
        if (currentType != account.Type)
        {
            currentType = account.Type;

            <MudSelectItem T="int" Value="-1" Disabled="true">
                <div class="py-2 px-1"
                     style="background-color: var(--mud-palette-action-hover); border-left: 3px solid var(--mud-palette-primary); margin: 4px -12px;">
                    <MudText Typo="Typo.subtitle2"
                             Class="text-primary font-weight-bold d-flex align-center">
                        <MudIcon Icon="@account.Type.ToIcon()"
                                 Size="Size.Small"
                                 Class="mr-2" />
                        @account.Type.ToLabel()
                    </MudText>
                </div>
            </MudSelectItem>
        }

        <MudSelectItem T="int" Value="@account.Id" @key="account.Id">
            <div class="d-flex align-center py-2 px-1">
                <MudAvatar Size="Size.Small"
                           Style="@($"background-color: {(string.IsNullOrEmpty(account.Color) ? "#757575" : account.Color)}; margin-right: 12px; flex-shrink: 0;")">
                    <MudIcon Icon="@account.Type.ToIcon()"
                             Color="Color.Surface"
                             Size="Size.Small" />
                </MudAvatar>

                <div class="flex-grow-1 min-width-0">
                    <MudText Typo="Typo.body2" Class="font-weight-medium">
                        @account.Name
                    </MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">
                        @account.Type.ToLabel()
                    </MudText>
                </div>

                <MudText Typo="Typo.body2"
                         Class="@($"{CurrencyHelper.GetAmountClass(account.CurrentBalance)} ml-2 font-weight-medium")"
                         Style="flex-shrink: 0;">
                    @CurrencyHelper.FormatCurrency(account.CurrentBalance)
                </MudText>
            </div>
        </MudSelectItem>
    }
</MudSelect>

@code {
    private const string EmptyText = "Select accounts...";

    [Parameter] public List<AccountDto> Accounts { get; set; } = new();
    [Parameter] public IReadOnlyCollection<int> SelectedAccountIds { get; set; } = Array.Empty<int>();
    [Parameter] public EventCallback<IReadOnlyCollection<int>> SelectedAccountIdsChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Accounts";
    [Parameter] public bool Disabled { get; set; } = false;

    // Filters should still be able to pick hidden accounts; set true for data-entry forms.
    [Parameter] public bool ExcludeHidden { get; set; } = false;

    // Grouped by account type, then alphabetical by name.
    private List<AccountDto> OrderedAccounts => Accounts
        .Where(a => !ExcludeHidden || !a.IsHidden || SelectedAccountIds.Contains(a.Id))
        .OrderBy(a => (int)a.Type)
        .ThenBy(a => a.Name.Trim(), StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    private async Task OnSelectedValuesChanged(IEnumerable<int> values)
    {
        SelectedAccountIds = values.ToArray();
        await SelectedAccountIdsChanged.InvokeAsync(SelectedAccountIds);
    }

    private string? GetSelectionText(IReadOnlyList<string?>? selectedValues)
    {
        if (selectedValues == null || selectedValues.Count == 0 || Accounts.Count == 0)
            return EmptyText;

        var selectedIds = selectedValues
            .Select(value => int.TryParse(value, out var id) ? (int?)id : null)
            .Where(id => id.HasValue)
            .Select(id => id!.Value)
            .ToList();

        if (selectedIds.Count == 0)
            return EmptyText;

        var selectedAccounts = Accounts
            .Where(a => selectedIds.Contains(a.Id))
            .ToList();

        if (selectedAccounts.Count == 0)
            return EmptyText;

        if (selectedAccounts.Count == 1)
        {
            var account = selectedAccounts[0];
            return $"{account.Name} ({CurrencyHelper.FormatCurrency(account.CurrentBalance)})";
        }

        if (selectedAccounts.Count <= 2)
            return string.Join(", ", selectedAccounts.Select(a => a.Name));

        var totalBalance = selectedAccounts.Sum(a => a.CurrentBalance);
        return $"{selectedAccounts.Count} accounts ({CurrencyHelper.FormatCurrency(totalBalance)})";
    }
}
