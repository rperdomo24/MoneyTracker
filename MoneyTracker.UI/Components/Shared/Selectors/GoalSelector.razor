@using MoneyTracker.Application.DTOs.Goals
@using MoneyTracker.UI.Helpers

<MudSelect T="int?"
           Label="@Label"
           Value="@SelectedGoalId"
           ValueChanged="@((int? value) => OnSelectedGoalChanged(value))"
           Variant="Variant.Outlined"
           Required="@Required"
           Disabled="@Disabled"
           Clearable="@Clearable"
           Dense="@Dense"
           Class="@Class"
           ToStringFunc="@GoalName">
    @foreach (var goal in SortedGoals)
    {
        <MudSelectItem T="int?" Value="@((int?)goal.Id)" @key="goal.Id">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Circle"
                         Size="Size.Small"
                         Style="@($"color:{goal.Color}; font-size:10px;")" />
                <MudText Typo="Typo.body2">@goal.Name</MudText>
                @if (ShowProgress)
                {
                    <MudText Typo="Typo.caption" Style="opacity:0.6; margin-left: auto;">
                        @goal.ProgressPercent%
                    </MudText>
                }
            </MudStack>
        </MudSelectItem>
    }
</MudSelect>

@code {
    // Callers decide which goals are offered (e.g. only active ones); this component sorts them.
    [Parameter] public List<SavingsGoalDto> Goals { get; set; } = new();
    [Parameter] public int? SelectedGoalId { get; set; }
    [Parameter] public EventCallback<int?> SelectedGoalIdChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Savings Goal";
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Dense { get; set; } = false;
    [Parameter] public bool ShowProgress { get; set; } = true;

    private List<SavingsGoalDto> SortedGoals => SelectorHelper.VisibleSorted(
        Goals,
        g => g.Name,
        _ => false,
        _ => true);

    private string GoalName(int? id) => Goals.FirstOrDefault(g => g.Id == id)?.Name ?? string.Empty;

    private async Task OnSelectedGoalChanged(int? value)
    {
        SelectedGoalId = value;
        await SelectedGoalIdChanged.InvokeAsync(value);
    }
}
