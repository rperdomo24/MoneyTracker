@using MoneyTracker.Domain.Enums.Category
@using MoneyTracker.UI.Helpers

@if (MultiSelection)
{
    <MudSelect T="CategoryTypeEnum"
               Label="@Label"
               MultiSelection="true"
               SelectedValues="@SelectedValues"
               SelectedValuesChanged="OnSelectedValuesChanged"
               Variant="Variant.Outlined"
               Clearable="@Clearable"
               Disabled="@Disabled"
               Class="@Class"
               AnchorOrigin="@AnchorOrigin"
               MultiSelectionTextFunc="@GetSelectionText">
        @foreach (var type in Options)
        {
            <MudSelectItem T="CategoryTypeEnum" Value="@type" @key="type">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@GetIcon(type)" Size="Size.Small" Color="@GetColor(type)" />
                    <MudText>@type.ToString()</MudText>
                </MudStack>
            </MudSelectItem>
        }
    </MudSelect>
}
else
{
    <MudSelect T="CategoryTypeEnum"
               Label="@Label"
               Value="@Value"
               ValueChanged="@((CategoryTypeEnum value) => OnValueChanged(value))"
               Variant="Variant.Outlined"
               Required="@Required"
               Disabled="@Disabled"
               Class="@Class"
               AnchorOrigin="@AnchorOrigin">
        @foreach (var type in Options)
        {
            <MudSelectItem T="CategoryTypeEnum" Value="@type" @key="type">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@GetIcon(type)" Size="Size.Small" Color="@GetColor(type)" />
                    <MudText>@type.ToString()</MudText>
                </MudStack>
            </MudSelectItem>
        }
    </MudSelect>
}

@code {
    private static readonly CategoryTypeEnum[] AllTypes = Enum.GetValues<CategoryTypeEnum>();

    // Single mode binds Value; multi mode (filters) binds SelectedValues.
    [Parameter] public CategoryTypeEnum Value { get; set; }
    [Parameter] public EventCallback<CategoryTypeEnum> ValueChanged { get; set; }

    [Parameter] public bool MultiSelection { get; set; } = false;
    [Parameter] public IReadOnlyCollection<CategoryTypeEnum> SelectedValues { get; set; } = Array.Empty<CategoryTypeEnum>();
    [Parameter] public EventCallback<IReadOnlyCollection<CategoryTypeEnum>> SelectedValuesChanged { get; set; }

    [Parameter] public IReadOnlyList<CategoryTypeEnum> Options { get; set; } = AllTypes;
    [Parameter] public string Label { get; set; } = "Type";
    [Parameter] public string EmptySelectionText { get; set; } = "All types";
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public Origin AnchorOrigin { get; set; } = Origin.BottomLeft;

    // Transfer has no dedicated icon/color in CategoryExtensions (its fallback is the generic category look).
    private static string GetIcon(CategoryTypeEnum type)
        => type == CategoryTypeEnum.Transfer ? Icons.Material.Filled.SwapHoriz : type.GetIcon();

    private static Color GetColor(CategoryTypeEnum type)
        => type == CategoryTypeEnum.Transfer ? Color.Info : type.GetColor();

    private string? GetSelectionText(IReadOnlyList<string?>? selected)
        => selected is null || selected.Count == 0
            ? EmptySelectionText
            : string.Join(", ", SelectedValues.Select(t => t.ToString()));

    private async Task OnValueChanged(CategoryTypeEnum value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private async Task OnSelectedValuesChanged(IEnumerable<CategoryTypeEnum> values)
    {
        SelectedValues = values.ToArray();
        await SelectedValuesChanged.InvokeAsync(SelectedValues);
    }
}
