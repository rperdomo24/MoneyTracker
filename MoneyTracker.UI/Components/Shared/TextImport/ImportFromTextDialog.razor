@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Merchants
@using MoneyTracker.Application.DTOs.TextImport
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Ai
@using MoneyTracker.Domain.Enums.Category
@using MoneyTracker.Domain.Enums.Transaction
@using MoneyTracker.UI.Components.Pages.Categories
@using MoneyTracker.UI.Components.Shared.Selectors
@using MoneyTracker.UI.Helpers.TextImport

@inject ITextImportService TextImportService
@inject ITransactionService TransactionService
@inject IAccountService AccountService
@inject ICategoryService CategoryService
@inject IMerchantService MerchantService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Magic Import</MudText>
            @if (_items.Count > 1)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
                    @_items.Count detected
                </MudChip>
            }
            @if (_savedCount > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                    @_savedCount saved
                </MudChip>
            }
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Loading...</MudText>
            </MudStack>
        }
        else
        {
            <MudStack Spacing="3">

                <!-- Input area -->
                <MudTextField @bind-Value="_rawText"
                              Label="Paste bank SMS, email or describe a transaction"
                              Variant="Variant.Outlined"
                              Lines="@(_items.Count > 0 ? 3 : 5)"
                              FullWidth="true"
                              MaxLength="MaxInputChars"
                              Counter="MaxInputChars"
                              HelperText="@(_rawText.Length > MaxInputChars - 200 ? $"Limit: {MaxInputChars} chars — split long batches" : "You can paste multiple messages at once")"
                              Error="@(_rawText.Length >= MaxInputChars)"
                              ErrorText="@($"Text exceeds {MaxInputChars} char limit. Split into smaller batches.")" />

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@(_analyzing ? null : Icons.Material.Filled.Search)"
                               Disabled="@(string.IsNullOrWhiteSpace(_rawText) || _analyzing || _rawText.Length >= MaxInputChars)"
                               OnClick="AnalyzeAsync">
                        @if (_analyzing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Analyzing...</span>
                        }
                        else
                        {
                            <span>Analyze</span>
                        }
                    </MudButton>

                    @if (_items.Count > 0)
                    {
                        <MudButton Variant="Variant.Text"
                                   Disabled="@(_analyzing || _saving)"
                                   OnClick="Clear">
                            Clear
                        </MudButton>
                    }
                </MudStack>

                <!-- Results -->
                @if (CurrentItem is not null)
                {
                    <!-- Navigation bar (multi-item only) -->
                    @if (_items.Count > 1)
                    {
                        <MudPaper Class="pa-3" Outlined="true" Style="border-color: var(--mud-palette-primary)">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                                    Transaction @(_currentIndex + 1) of @_items.Count
                                </MudText>
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                                   Size="Size.Small"
                                                   Disabled="@(_currentIndex == 0)"
                                                   OnClick="PrevItem" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                                   Size="Size.Small"
                                                   Disabled="@(_currentIndex == _items.Count - 1)"
                                                   OnClick="NextItem" />
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }

                    <!-- AI metadata: provider + confidence -->
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        @if (!string.IsNullOrWhiteSpace(CurrentItem.Provider))
                        {
                            <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.AccountBalance"
                                     Color="Color.Default" Variant="Variant.Outlined">
                                @CurrentItem.Provider
                            </MudChip>
                        }
                        <MudChip T="string" Size="Size.Small" Color="@ConfidenceColor" Variant="Variant.Filled">
                            @((CurrentItem.Confidence * 100).ToString("F0"))% confidence
                        </MudChip>
                    </MudStack>

                    <!-- Warnings -->
                    @if (CurrentItem.Warnings.Any())
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            Review: @string.Join(", ", CurrentItem.Warnings)
                        </MudAlert>
                    }

                    <!-- Fields -->
                    <MudPaper Class="pa-4" Outlined="true">
                        <MudStack Spacing="3">

                            <MudSelect T="TransactionTypeEnum"
                                       Label="Type"
                                       Variant="Variant.Outlined"
                                       Value="CurrentItem.Type"
                                       ValueChanged="OnTypeChanged">
                                <MudSelectItem Value="TransactionTypeEnum.Expense">Expense</MudSelectItem>
                                <MudSelectItem Value="TransactionTypeEnum.Income">Income</MudSelectItem>
                                <MudSelectItem Value="TransactionTypeEnum.Transfer">Transfer</MudSelectItem>
                            </MudSelect>

                            <MudNumericField T="decimal"
                                             Label="Amount"
                                             Variant="Variant.Outlined"
                                             Value="CurrentItem.Amount"
                                             ValueChanged="@((decimal v) => { CurrentItem.Amount = v; MarkEdited(); })"
                                             Min="0.01m"
                                             Format="F2"
                                             Adornment="Adornment.Start"
                                             AdornmentText="$" />

                            <MudDatePicker Label="Date"
                                           Variant="Variant.Outlined"
                                           Date="@CurrentItem.DateLocal.Date"
                                           DateChanged="OnDateChanged"
                                           MaxDate="DateTime.Today"
                                           AutoClose="true" />

                            <MudTextField Label="Name"
                                          Variant="Variant.Outlined"
                                          Value="CurrentItem.Merchant"
                                          ValueChanged="@((string v) => { CurrentItem.Merchant = v; MarkEdited(); })" />

                            <MudTextField Label="Description"
                                          Variant="Variant.Outlined"
                                          Value="CurrentItem.Description"
                                          ValueChanged="@((string v) => { CurrentItem.Description = v; MarkEdited(); })" />

                            <AccountSelector @bind-SelectedAccount="_selectedAccount"
                                              Accounts="@_accounts"
                                              Label="Account"
                                              Required="true"
                                              ShowBalance="true" />

                            <CategorySelector @bind-SelectedCategory="_selectedCategory"
                                              Categories="@_categories"
                                              FilterByType="@(_currentItemType == TransactionTypeEnum.Income
                                                    ? CategoryTypeEnum.Income
                                                    : CategoryTypeEnum.Expense)"
                                              ShowAddButton="true"
                                              OnAddCategory="CreateCategory" />

                            <MudSelect T="MerchantDto?" @bind-Value="_selectedMerchant"
                                       Label="Merchant (Optional)"
                                       Variant="Variant.Outlined"
                                       Clearable="true"
                                       ToStringFunc="@(m => m?.Name ?? string.Empty)">
                                @foreach (var m in _merchants)
                                {
                                    <MudSelectItem T="MerchantDto?" Value="@m">@m.Name</MudSelectItem>
                                }
                            </MudSelect>

                        </MudStack>
                    </MudPaper>
                }

            </MudStack>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Close</MudButton>

        @if (CurrentItem is not null)
        {
            @if (_items.Count > 1 && _currentIndex < _items.Count - 1)
            {
                <MudButton Variant="Variant.Text"
                           Disabled="@_saving"
                           OnClick="SkipItem">
                    Skip
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(!CanSave() || _saving)"
                           OnClick="SaveAndNext">
                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save & Next</span>
                    }
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(!CanSave() || _saving)"
                           OnClick="SaveAsync">
                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save</span>
                    }
                </MudButton>
            }
        }
    </DialogActions>
</MudDialog>

@code {
    private const int MaxInputChars = 3000;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private bool _loading = true;
    private bool _analyzing;
    private bool _saving;

    private string _rawText = string.Empty;
    private List<ParsedTransactionSuggestionDto> _items = new();
    private int _currentIndex;
    private int _savedCount;
    private int _trainingDataId;

    // Per-item selection state keyed by TempId
    private Dictionary<Guid, AccountDto?> _itemAccounts = new();
    private Dictionary<Guid, CategoryDto?> _itemCategories = new();
    private Dictionary<Guid, MerchantDto?> _itemMerchants = new();
    private Dictionary<Guid, TransactionTypeEnum> _itemTypes = new();
    private Dictionary<Guid, bool> _itemEdited = new();

    private List<AccountDto> _accounts = new();
    private List<CategoryDto> _categories = new();
    private List<MerchantDto> _merchants = new();

    private ParsedTransactionSuggestionDto? CurrentItem
        => _items.Count > 0 && _currentIndex < _items.Count ? _items[_currentIndex] : null;

    private AccountDto? _selectedAccount
    {
        get => CurrentItem is not null ? _itemAccounts.GetValueOrDefault(CurrentItem.TempId) : null;
        set { if (CurrentItem is not null) _itemAccounts[CurrentItem.TempId] = value; }
    }

    private CategoryDto? _selectedCategory
    {
        get => CurrentItem is not null ? _itemCategories.GetValueOrDefault(CurrentItem.TempId) : null;
        set { if (CurrentItem is not null) _itemCategories[CurrentItem.TempId] = value; }
    }

    private MerchantDto? _selectedMerchant
    {
        get => CurrentItem is not null ? _itemMerchants.GetValueOrDefault(CurrentItem.TempId) : null;
        set { if (CurrentItem is not null) _itemMerchants[CurrentItem.TempId] = value; }
    }

    private TransactionTypeEnum _currentItemType
        => CurrentItem is not null && _itemTypes.TryGetValue(CurrentItem.TempId, out var t) ? t : TransactionTypeEnum.Expense;

    private Color ConfidenceColor => CurrentItem?.Confidence switch
    {
        >= 0.9m => Color.Success,
        >= 0.7m => Color.Warning,
        _ => Color.Error
    };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        var accountsTask = AccountService.GetAllAsync();
        var categoriesTask = CategoryService.GetAllWithChildAsync(false);
        var merchantsTask = MerchantService.GetAllAsync();
        await Task.WhenAll(accountsTask, categoriesTask, merchantsTask);

        if (accountsTask.Result.Success && accountsTask.Result.Data is not null)
            _accounts = accountsTask.Result.Data.ToList();
        if (categoriesTask.Result.Success && categoriesTask.Result.Data is not null)
            _categories = categoriesTask.Result.Data.ToList();
        if (merchantsTask.Result.Success && merchantsTask.Result.Data is not null)
            _merchants = merchantsTask.Result.Data;

        _loading = false;
    }

    private async Task AnalyzeAsync()
    {
        if (string.IsNullOrWhiteSpace(_rawText)) return;
        if (_rawText.Length >= MaxInputChars)
        {
            Snackbar.Add($"Text exceeds {MaxInputChars} char limit. Split into smaller batches.", Severity.Warning);
            return;
        }

        _analyzing = true;
        StateHasChanged();

        try
        {
            var normalized = TextImportNormalizer.NormalizeSingleItem(_rawText);
            _rawText = normalized;

            var result = await TextImportService.AnalyzeAsync(normalized);

            if (!result.Success || result.Data?.Items.Any() != true)
            {
                Snackbar.Add(result.Message ?? "Unable to analyze text.", Severity.Error);
                _items = new();
                return;
            }

            _items = result.Data.Items;
            _currentIndex = 0;
            _trainingDataId = result.Data.AiTrainingDataId;
            _itemAccounts.Clear();
            _itemCategories.Clear();
            _itemMerchants.Clear();
            _itemTypes.Clear();
            _itemEdited.Clear();

            foreach (var item in _items)
                ResolveItemDefaults(item);

            var msg = _items.Count == 1
                ? "Transaction detected. Review and save."
                : $"{_items.Count} transactions detected. Review each one.";
            Snackbar.Add(msg, Severity.Success);
        }
        finally
        {
            _analyzing = false;
            StateHasChanged();
        }
    }

    private void ResolveItemDefaults(ParsedTransactionSuggestionDto item)
    {
        _itemTypes[item.TempId] = item.Type;

        // Fix year-like account hints
        if (string.IsNullOrWhiteSpace(item.AccountHint) ||
            (item.AccountHint.Length == 4 && (item.AccountHint.StartsWith("19") || item.AccountHint.StartsWith("20"))))
        {
            item.AccountHint = AccountHintResolver.ExtractHintFromText(item.RawText) ?? string.Empty;
        }

        var accountId = AccountHintResolver.ResolveAccountId(item.AccountHint, _accounts);
        _itemAccounts[item.TempId] = accountId.HasValue
            ? _accounts.FirstOrDefault(x => x.Id == accountId.Value)
            : _accounts.FirstOrDefault();

        if (!string.IsNullOrWhiteSpace(item.Merchant))
        {
            _itemMerchants[item.TempId] =
                _merchants.FirstOrDefault(m => m.Name.Equals(item.Merchant, StringComparison.OrdinalIgnoreCase))
                ?? _merchants.FirstOrDefault(m => m.Name.Contains(item.Merchant, StringComparison.OrdinalIgnoreCase))
                ?? _merchants.FirstOrDefault(m => item.Merchant.Contains(m.Name, StringComparison.OrdinalIgnoreCase));
        }

        _itemCategories[item.TempId] = null;
    }

    private bool CanSave()
        => CurrentItem is not null
           && CurrentItem.Amount > 0
           && _selectedAccount is not null
           && _selectedCategory is not null;

    private async Task SaveAsync()
    {
        if (!await SaveCurrentItem()) return;
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task SaveAndNext()
    {
        if (!await SaveCurrentItem()) return;
        NextItem();
    }

    private async Task<bool> SaveCurrentItem()
    {
        if (CurrentItem is null || _selectedAccount is null || _selectedCategory is null) return false;

        _saving = true;
        StateHasChanged();

        var dto = new TransactionDto
        {
            Name = CurrentItem.Merchant ?? string.Empty,
            Amount = CurrentItem.Amount,
            Date = CurrentItem.DateLocal,
            Description = CurrentItem.Description ?? string.Empty,
            CategoryId = _selectedCategory.Id,
            AccountId = _selectedAccount.Id,
            MerchantId = _selectedMerchant?.Id
        };

        var result = await TransactionService.CreateAsync(dto);
        _saving = false;

        if (result.Success)
        {
            _savedCount++;
            var wasEdited = CurrentItem is not null && _itemEdited.GetValueOrDefault(CurrentItem.TempId);
            _ = TextImportService.UpdateTrainingFeedbackAsync(
                _trainingDataId,
                wasEdited ? AiUserFeedback.Edited : AiUserFeedback.Confirmed);
            Snackbar.Add("Transaction saved.", Severity.Success);
            return true;
        }

        Snackbar.Add(result.Message ?? "Error saving transaction.", Severity.Error);
        return false;
    }

    private void SkipItem()
    {
        if (CurrentItem is not null)
            _ = TextImportService.UpdateTrainingFeedbackAsync(_trainingDataId, AiUserFeedback.Skipped);
        NextItem();
    }

    private void NextItem()
    {
        if (_currentIndex < _items.Count - 1)
            _currentIndex++;
    }

    private void PrevItem()
    {
        if (_currentIndex > 0)
            _currentIndex--;
    }

    private void OnTypeChanged(TransactionTypeEnum type)
    {
        if (CurrentItem is null) return;
        CurrentItem.Type = type;
        _itemTypes[CurrentItem.TempId] = type;
        _itemCategories[CurrentItem.TempId] = null;
        _itemEdited[CurrentItem.TempId] = true;
    }

    private void OnDateChanged(DateTime? date)
    {
        if (CurrentItem is null || date is null) return;
        CurrentItem.DateLocal = new DateTime(date.Value.Year, date.Value.Month, date.Value.Day);
        _itemEdited[CurrentItem.TempId] = true;
    }

    private void MarkEdited()
    {
        if (CurrentItem is not null)
            _itemEdited[CurrentItem.TempId] = true;
    }

    private void Clear()
    {
        _rawText = string.Empty;
        _items = new();
        _currentIndex = 0;
        _trainingDataId = 0;
        _itemAccounts.Clear();
        _itemCategories.Clear();
        _itemMerchants.Clear();
        _itemTypes.Clear();
        _itemEdited.Clear();
    }

    private async Task CreateCategory()
    {
        var categoryType = _currentItemType == TransactionTypeEnum.Income
            ? CategoryTypeEnum.Income
            : CategoryTypeEnum.Expense;

        var parameters = new DialogParameters
        {
            ["CategoryType"] = categoryType,
            ["OnCategoryUpdated"] = EventCallback.Factory.Create(this, async () =>
            {
                await ReloadCategories();
                StateHasChanged();
            })
        };

        await DialogService.ShowAsync<AddCategoryModal>("Create Category", parameters,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Small });
    }

    private async Task ReloadCategories()
    {
        var result = await CategoryService.GetAllWithChildAsync(false);
        if (result.Success && result.Data is not null)
            _categories = result.Data.ToList();
    }

    private void Cancel() => MudDialog.Cancel();
}
