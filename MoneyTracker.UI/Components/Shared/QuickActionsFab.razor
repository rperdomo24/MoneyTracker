@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums
@using MoneyTracker.Domain.Enums.Account
@using MoneyTracker.Domain.Enums.Transaction
@using MoneyTracker.UI.Components.Pages.Accounts
@using MoneyTracker.UI.Components.Pages.Transactions
@using MoneyTracker.UI.Helpers
@inject IAccountService AccountService

<div class="quick-actions-fab-container">
    <!-- 🚀 Main FAB Button -->
    <MudFab Color="Color.Primary"
            StartIcon="@(_isExpanded ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)"
            Size="Size.Large"
            Class="@($"fab-main-button {(_isExpanded ? "expanded" : "")}")"
            OnClick="@ToggleExpanded" />

    <!-- 📋 Action Buttons (Solo aparecen cuando está expandido) -->
    @if (_isExpanded)
    {
        <div class="fab-actions" @onclick:stopPropagation="true">

            <!-- 💳 Pay Credit Card -->
            <MudFab Color="Color.Warning"
                    StartIcon="@Icons.Material.Filled.CreditCard"
                    Size="Size.Medium"
                    Class="fab-action fab-action-4"
                    OnClick="@((MouseEventArgs e) => HandleAddTransactionClick(e, TransactionType.CreditPayment))" />

            <!-- 🔄 Transfer -->
            <MudFab Color="@(TransactionType.Transfer.GetTransactionTypeColor())"
                    StartIcon="@(TransactionType.Transfer.GetTransactionypeIcon())"
                    Size="Size.Medium"
                    Class="fab-action fab-action-3"
                    OnClick="@((MouseEventArgs e) => HandleAddTransactionClick(e, TransactionType.Transfer))" />

            <!-- 💰 Add Income -->
            <MudFab Color="@(TransactionType.Income.GetTransactionTypeColor())"
                    StartIcon="@(TransactionType.Income.GetTransactionypeIcon())"
                    Size="Size.Medium"
                    Class="fab-action fab-action-2"
                    OnClick="@((MouseEventArgs e) => HandleAddTransactionClick(e, TransactionType.Income))" />

            <!-- 💸 Add Expense -->
            <MudFab Color="@(TransactionType.Expense.GetTransactionTypeColor())"
                    StartIcon="@(TransactionType.Expense.GetTransactionypeIcon())"
                    Size="Size.Medium"
                    Class="fab-action fab-action-1"
                    OnClick="@((MouseEventArgs e) => HandleAddTransactionClick(e, TransactionType.Expense))" />
        </div>
    }

    <!-- 🏷️ Action Labels (Solo con labels opcionales) -->
    @if (_isExpanded && ShowLabels)
    {
        <div class="fab-labels">
            <div class="fab-label fab-label-4">
                @("Pay Card")
            </div>
            <div class="fab-label fab-label-3">Transfer</div>
            <div class="fab-label fab-label-2">Add Income</div>
            <div class="fab-label fab-label-1">Add Expense</div>
        </div>
    }

    <!-- 🌑 Backdrop (para cerrar al hacer clic fuera) -->
    @*  @if (_isExpanded)
    {
        <div class="fab-backdrop" @onclick="@CloseExpanded" @onclick:stopPropagation="false"></div>
    } *@
</div>

@code {
    private bool _isExpanded = false;
    private bool _isProcessingAction = false;

    /// <summary>
    /// Show text labels next to action buttons
    /// </summary>
    [Parameter] public bool ShowLabels { get; set; } = false;

    /// <summary>
    /// Callback when a transaction action is triggered
    /// </summary>
    [Parameter] public EventCallback<TransactionType> OnTransactionAction { get; set; }

    /// <summary>
    /// Callback when a transaction is successfully added (for refreshing parent)
    /// </summary>
    [Parameter] public EventCallback OnTransactionAdded { get; set; }

    /// <summary>
    /// Custom dialog options (optional)
    /// </summary>
    [Parameter] public DialogOptions? DialogOptions { get; set; }

    private DialogOptions _defaultDialogOptions => new()
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };

    private void ToggleExpanded()
    {
        _isExpanded = !_isExpanded;
        StateHasChanged();
    }

    private void CloseExpanded()
    {
        _isExpanded = false;
        StateHasChanged();
    }

    private async Task HandleAddTransactionClick(MouseEventArgs e, TransactionType transactionType)
    {
        // Prevenir que otros eventos interfieran
        if (_isProcessingAction) return;
        _isProcessingAction = true;

        try
        {
            // Primero notificar al componente padre
            if (OnTransactionAction.HasDelegate)
            {
                await OnTransactionAction.InvokeAsync(transactionType);
            }

            // Cerrar el FAB inmediatamente
            CloseExpanded();

            // Pequeño delay para asegurar que la UI se actualice
            await Task.Delay(50);

            if (!await CheckAccountType(transactionType))
            {
                if (await ShowNoCreditCardsAlertAsync(transactionType, showCreateOption: true))
                {
                    await OpenAddAccountModal();
                    return;
                }
            }
            else
            {
                // Abrir el modal
                await OpenTransactionModal(transactionType);
            }
        }
        finally
        {
            _isProcessingAction = false;
        }
    }

    private async Task HandleAddTransaction(TransactionType transactionType)
    {
        // Close the FAB first
        CloseExpanded();

        // Notify parent component about the action
        if (OnTransactionAction.HasDelegate)
        {
            await OnTransactionAction.InvokeAsync(transactionType);
        }

        // Then open the transaction modal
        await OpenTransactionModal(transactionType);
    }

    private async Task OpenTransactionModal(TransactionType transactionType)
    {
        var parameters = new DialogParameters
            {
                ["TransactionType"] = transactionType,
                ["OnTransactionAdded"] = EventCallback.Factory.Create(this, OnTransactionAddedInternal)
            };

        var title = transactionType switch
        {
            TransactionType.Income => "Add Income",
            TransactionType.Expense => "Add Expense",
            TransactionType.Transfer => "Transfer Money",
            TransactionType.CreditPayment => "Pay Credit Card",
            _ => "Add Transaction"
        };

        var options = DialogOptions ?? _defaultDialogOptions;

        await DialogService.ShowAsync<AddTransactionModal>(title, parameters, options);
    }

    private async Task<bool> CheckAccountType(TransactionType transactionType)
    {

        // Check if the transaction type requires a specific account type
        AccountType accountType = transactionType == TransactionType.CreditPayment ? AccountType.Credit : AccountType.None;

        // Check if there are accounts of the required type
        var accountsResult = await AccountService.HasAccountByType(accountType);
        if (accountsResult.Success)
        {
            return accountsResult.Data;
        }

        return false;
    }

    private async Task OpenAddAccountModal()
    {
        var parameters = new DialogParameters
            {
                ["OnAccountAdded"] = EventCallback.Factory.Create(this, OnTransactionAddedInternal)
            };

        var options = DialogOptions ?? _defaultDialogOptions;

        await DialogService.ShowAsync<AddAccountModal>("Add Account", parameters, options);
    }

    private async Task OnTransactionAddedInternal()
    {
        // Notify parent component to refresh data
        if (OnTransactionAdded.HasDelegate)
        {
            await OnTransactionAdded.InvokeAsync();
        }
    }

    public async Task<bool> ShowNoCreditCardsAlertAsync(TransactionType transactionType,
       bool showCreateOption = true)
    {
        AccountType accountType = transactionType == TransactionType.CreditPayment ? AccountType.Credit : AccountType.None;

        string accountTypeName = transactionType == TransactionType.CreditPayment ? "credit card accounts" : "accounts";
        string title = transactionType == TransactionType.CreditPayment ? "No Credit Cards Found" : "No Accounts Found";

        var message = showCreateOption
            ? $"You don't have any {accountTypeName} set up yet. Would you like to go to Accounts to create one?"
            : $"You don't have any {accountTypeName} set up yet. Please create a {(transactionType == TransactionType.CreditPayment ? "credit card " : "")}account first in the Accounts section.";

        var confirmText = showCreateOption ? "Go to Accounts" : "OK";
        var cancelText = showCreateOption ? "Cancel" : "";

        return await DialogService.ShowConfirmDialogAsync(
            title,
            message,
            confirmText,
            Color.Tertiary,
            cancelText
        );
    }
}