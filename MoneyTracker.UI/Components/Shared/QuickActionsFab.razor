@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Account
@using MoneyTracker.Domain.Enums.Transaction
@using MoneyTracker.UI.Components.Pages.Accounts
@using MoneyTracker.UI.Components.Pages.Transactions
@using MoneyTracker.UI.Components.Shared.TextImport
@using MoneyTracker.UI.Components.Shared.EmailImport
@using MoneyTracker.UI.Helpers
@inject IAccountService AccountService
@inject IEmailImportService EmailImportService
@inject IDialogService DialogService

<div class="quick-actions-fab-container">
    <!-- Main FAB -->
    <MudBadge Content="@_pendingReviewCount" Color="Color.Error" Overlap="true" Visible="@(_pendingReviewCount > 0)">
        <MudFab Color="Color.Primary"
                StartIcon="@(_isExpanded ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)"
                Size="Size.Large"
                Class="@($"fab-main-button {(_isExpanded ? "expanded" : "")}")"
                OnClick="@ToggleExpanded" />
    </MudBadge>

    @if (_isExpanded)
    {
        <div class="fab-actions" @onclick:stopPropagation="true">

            <!-- MOBILE (<600px): tooltips (no labels) -->
            <MudHidden Breakpoint="Breakpoint.SmAndUp">
                <MudTooltip Text="Transfer" Placement="Placement.Left">
                    <MudFab Color="@(TransactionTypeEnum.Transfer.GetTransactionTypeColor())"
                            StartIcon="@(TransactionTypeEnum.Transfer.GetTransactionTypeIcon())"
                            Size="Size.Medium"
                            Class="fab-action fab-action-3"
                            OnClick="@((MouseEventArgs e) => HandleAddTransactionClick(e, TransactionTypeEnum.Transfer))" />
                </MudTooltip>

                <MudTooltip Text="Add Income" Placement="Placement.Left">
                    <MudFab Color="@(TransactionTypeEnum.Income.GetTransactionTypeColor())"
                            StartIcon="@(TransactionTypeEnum.Income.GetTransactionTypeIcon())"
                            Size="Size.Medium"
                            Class="fab-action fab-action-2"
                            OnClick="@((MouseEventArgs e) => HandleAddTransactionClick(e, TransactionTypeEnum.Income))" />
                </MudTooltip>

                <MudTooltip Text="Add Expense" Placement="Placement.Left">
                    <MudFab Color="@(TransactionTypeEnum.Expense.GetTransactionTypeColor())"
                            StartIcon="@(TransactionTypeEnum.Expense.GetTransactionTypeIcon())"
                            Size="Size.Medium"
                            Class="fab-action fab-action-1"
                            OnClick="@((MouseEventArgs e) => HandleAddTransactionClick(e, TransactionTypeEnum.Expense))" />
                </MudTooltip>

                <MudTooltip Text="Import from text" Placement="Placement.Left">
                    <MudFab Color="Color.Info"
                            StartIcon="@Icons.Material.Filled.ContentPaste"
                            Size="Size.Medium"
                            Class="fab-action fab-action-4"
                            OnClick="@((MouseEventArgs e) => HandleImportFromTextClick(e))" />
                </MudTooltip>

                @if (_pendingReviewCount > 0)
                {
                    <MudTooltip Text="@($"Review {_pendingReviewCount} pending")" Placement="Placement.Left">
                        <MudBadge Content="@_pendingReviewCount" Color="Color.Error" Overlap="true">
                            <MudFab Color="Color.Warning"
                                    StartIcon="@Icons.Material.Filled.MarkEmailRead"
                                    Size="Size.Medium"
                                    Class="fab-action fab-action-5"
                                    OnClick="@((MouseEventArgs e) => HandleReviewPendingClick(e))" />
                        </MudBadge>
                    </MudTooltip>
                }
            </MudHidden>

            <!-- TABLET/DESKTOP (>=600px): same buttons, optional labels below -->
            <MudHidden Breakpoint="Breakpoint.Xs">
                <MudFab Color="@(TransactionTypeEnum.Transfer.GetTransactionTypeColor())"
                        StartIcon="@(TransactionTypeEnum.Transfer.GetTransactionTypeIcon())"
                        Size="Size.Medium"
                        Class="fab-action fab-action-3"
                        OnClick="@((MouseEventArgs e) => HandleAddTransactionClick(e, TransactionTypeEnum.Transfer))" />

                <MudFab Color="@(TransactionTypeEnum.Income.GetTransactionTypeColor())"
                        StartIcon="@(TransactionTypeEnum.Income.GetTransactionTypeIcon())"
                        Size="Size.Medium"
                        Class="fab-action fab-action-2"
                        OnClick="@((MouseEventArgs e) => HandleAddTransactionClick(e, TransactionTypeEnum.Income))" />

                <MudFab Color="@(TransactionTypeEnum.Expense.GetTransactionTypeColor())"
                        StartIcon="@(TransactionTypeEnum.Expense.GetTransactionTypeIcon())"
                        Size="Size.Medium"
                        Class="fab-action fab-action-1"
                        OnClick="@((MouseEventArgs e) => HandleAddTransactionClick(e, TransactionTypeEnum.Expense))" />

                <MudFab Color="Color.Info"
                        StartIcon="@Icons.Material.Filled.ContentPaste"
                        Size="Size.Medium"
                        Class="fab-action fab-action-4"
                        OnClick="@((MouseEventArgs e) => HandleImportFromTextClick(e))" />

                @if (_pendingReviewCount > 0)
                {
                    <MudBadge Content="@_pendingReviewCount" Color="Color.Error" Overlap="true">
                        <MudFab Color="Color.Warning"
                                StartIcon="@Icons.Material.Filled.MarkEmailRead"
                                Size="Size.Medium"
                                Class="fab-action fab-action-5"
                                OnClick="@((MouseEventArgs e) => HandleReviewPendingClick(e))" />
                    </MudBadge>
                }
            </MudHidden>
        </div>
    }

    <!-- Labels only on Tablet/Desktop -->
    @if (_isExpanded && ShowLabels)
    {
        <MudHidden Breakpoint="Breakpoint.Xs">
            <div class="fab-labels">
                @if (_pendingReviewCount > 0)
                {
                    <div class="fab-label fab-label-5">Review pending</div>
                }
                <div class="fab-label fab-label-4">Import</div>
                <div class="fab-label fab-label-3">Transfer</div>
                <div class="fab-label fab-label-2">Add Income</div>
                <div class="fab-label fab-label-1">Add Expense</div>
            </div>
        </MudHidden>
    }
</div>

@code {
    private bool _isExpanded = false;
    private bool _isProcessingAction = false;
    private int _pendingReviewCount = 0;

    [Parameter] public bool ShowLabels { get; set; } = false;
    [Parameter] public EventCallback<TransactionTypeEnum> OnTransactionAction { get; set; }
    [Parameter] public EventCallback OnTransactionAdded { get; set; }
    [Parameter] public DialogOptions? DialogOptions { get; set; }
    [Parameter] public int? PendingReviewCount { get; set; }
    [Parameter] public EventCallback OnReviewCompleted { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!PendingReviewCount.HasValue)
            await LoadPendingReviewCountAsync();
    }

    protected override void OnParametersSet()
    {
        if (PendingReviewCount.HasValue)
            _pendingReviewCount = PendingReviewCount.Value;
    }

    private async Task LoadPendingReviewCountAsync()
    {
        var result = await EmailImportService.GetPendingAsync();
        _pendingReviewCount = result.Success && result.Data is not null ? result.Data.Count : 0;
    }

    private DialogOptions _defaultDialogOptions => new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseButton = true,
        CloseOnEscapeKey = true,
        BackdropClick = true
    };

    private void ToggleExpanded()
    {
        _isExpanded = !_isExpanded;
        StateHasChanged();
    }

    private void CloseExpanded()
    {
        _isExpanded = false;
        StateHasChanged();
    }

    private async Task HandleAddTransactionClick(MouseEventArgs e, TransactionTypeEnum transactionType)
    {
        if (_isProcessingAction) return;
        _isProcessingAction = true;

        try
        {
            if (OnTransactionAction.HasDelegate)
                await OnTransactionAction.InvokeAsync(transactionType);

            CloseExpanded();
            await Task.Delay(50);

            if (!await CheckAccountType(transactionType))
            {
                if (await ShowNoCreditCardsAlertAsync(transactionType, showCreateOption: true))
                {
                    await OpenAddAccountModal();
                    return;
                }
            }
            else
            {
                await OpenTransactionModal(transactionType);
            }
        }
        finally
        {
            _isProcessingAction = false;
        }
    }

    private async Task OpenTransactionModal(TransactionTypeEnum transactionType)
    {
        var parameters = new DialogParameters
        {
            ["TransactionType"] = transactionType,
            ["OnTransactionAdded"] = EventCallback.Factory.Create(this, OnTransactionAddedInternal)
        };

        var title = transactionType switch
        {
            TransactionTypeEnum.Income => "Add Income",
            TransactionTypeEnum.Expense => "Add Expense",
            TransactionTypeEnum.Transfer => "Transfer Money",
            TransactionTypeEnum.CreditPayment => "Pay Credit Card",
            _ => "Add Transaction"
        };

        var options = DialogOptions ?? _defaultDialogOptions;
        await DialogService.ShowAsync<AddTransactionModal>(title, parameters, options);
    }

    private async Task<bool> CheckAccountType(TransactionTypeEnum transactionType)
    {
        var accountType = transactionType == TransactionTypeEnum.CreditPayment ? AccountType.Credit : AccountType.None;

        var accountsResult = await AccountService.HasAccountByType(accountType);
        return accountsResult.Success && accountsResult.Data;
    }

    private async Task OpenAddAccountModal()
    {
        var parameters = new DialogParameters
        {
            ["OnAccountAdded"] = EventCallback.Factory.Create(this, OnTransactionAddedInternal)
        };

        var options = DialogOptions ?? _defaultDialogOptions;
        await DialogService.ShowAsync<AddAccountModal>("Add Account", parameters, options);
    }

    private async Task OnTransactionAddedInternal()
    {
        if (OnTransactionAdded.HasDelegate)
            await OnTransactionAdded.InvokeAsync();
    }

    public async Task<bool> ShowNoCreditCardsAlertAsync(TransactionTypeEnum transactionType, bool showCreateOption = true)
    {
        var accountTypeName = transactionType == TransactionTypeEnum.CreditPayment ? "credit card accounts" : "accounts";
        var title = transactionType == TransactionTypeEnum.CreditPayment ? "No Credit Cards Found" : "No Accounts Found";

        var message = showCreateOption
            ? $"You don't have any {accountTypeName} set up yet. Would you like to go to Accounts to create one?"
            : $"You don't have any {accountTypeName} set up yet. Please create an account first in the Accounts section.";

        var confirmText = showCreateOption ? "Go to Accounts" : "OK";
        var cancelText = showCreateOption ? "Cancel" : "";

        return await DialogService.ShowConfirmDialogAsync(
            title,
            message,
            confirmText,
            Color.Tertiary,
            cancelText
        );
    }

    private async Task HandleImportFromTextClick(MouseEventArgs e)
    {
        if (_isProcessingAction) return;
        _isProcessingAction = true;

        try
        {
            CloseExpanded();
            await Task.Delay(50);

            var options = DialogOptions ?? _defaultDialogOptions;
            options = options with { MaxWidth = MaxWidth.Medium, FullWidth = true };

            await DialogService.ShowAsync<ImportFromTextDialog>("Import from text", new DialogParameters(), options);
        }
        finally
        {
            _isProcessingAction = false;
        }
    }

    private async Task HandleReviewPendingClick(MouseEventArgs e)
    {
        if (_isProcessingAction) return;
        _isProcessingAction = true;

        try
        {
            CloseExpanded();
            await Task.Delay(50);

            var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
            var dialog = await DialogService.ShowAsync<EmailImportDialog>("Bank emails to review", new DialogParameters(), options);
            await dialog.Result;

            if (!PendingReviewCount.HasValue)
                await LoadPendingReviewCountAsync();

            if (OnReviewCompleted.HasDelegate)
                await OnReviewCompleted.InvokeAsync();
        }
        finally
        {
            _isProcessingAction = false;
        }
    }
}
