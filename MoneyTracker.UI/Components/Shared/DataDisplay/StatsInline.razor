@* Stats Inline Component - Compact statistics display *@
@using MoneyTracker.Application.DTOs.Transactions

<div style="display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; gap: 24px; flex-wrap: nowrap; overflow-x: auto;">

@*     <!-- Total Transactions -->
    <div style="display: flex; align-items: center; gap: 12px; min-width: 140px;">
        <MudIcon Icon="@Icons.Material.Filled.Receipt"
                 Color="Color.Info"
                 Size="Size.Medium" />
        <div>
            <MudText Typo="Typo.caption" Color="Color.Default" Style="line-height: 1;">Transactions</MudText>
            <MudText Typo="Typo.h6" Style="white-space: nowrap; line-height: 1.2; margin-top: 2px;">
                <b>@(Summary?.TotalCount ?? 0)</b>
            </MudText>
        </div>
    </div>

    <!-- Divider -->
    <div style="width: 1px; height: 32px; background-color: var(--mud-palette-divider);"></div>
 *@
    <!-- Income -->
    <div style="display: flex; align-items: center; gap: 12px; min-width: 140px;">
        <MudIcon Icon="@Icons.Material.Filled.TrendingUp"
                 Color="Color.Success"
                 Size="Size.Medium" />
        <div>
            <MudText Typo="Typo.caption" Color="Color.Default" Style="line-height: 1;">Income</MudText>
            <MudText Typo="Typo.h6"
                     Color="Color.Success"
                     Style="white-space: nowrap; line-height: 1.2; margin-top: 2px;">
                <b>@FormatCurrency(Summary?.TotalIncome ?? 0)</b>
            </MudText>
        </div>
    </div>

    <!-- Divider -->
    <div style="width: 1px; height: 32px; background-color: var(--mud-palette-divider);"></div>

    <!-- Expenses -->
    <div style="display: flex; align-items: center; gap: 12px; min-width: 140px;">
        <MudIcon Icon="@Icons.Material.Filled.TrendingDown"
                 Color="Color.Error"
                 Size="Size.Medium" />
        <div>
            <MudText Typo="Typo.caption" Color="Color.Default" Style="line-height: 1;">Expenses</MudText>
            <MudText Typo="Typo.h6"
                     Color="Color.Error"
                     Style="white-space: nowrap; line-height: 1.2; margin-top: 2px;">
                <b>@FormatCurrency(Summary?.TotalExpense ?? 0)</b>
            </MudText>
        </div>
    </div>

    <!-- Divider -->
    <div style="width: 1px; height: 32px; background-color: var(--mud-palette-divider);"></div>

    <!-- Balance -->
    <div style="display: flex; align-items: center; gap: 12px; min-width: 140px;">
        <MudIcon Icon="@GetBalanceIcon()"
                 Color="@GetBalanceColor()"
                 Size="Size.Medium" />
        <div>
            <MudText Typo="Typo.caption" Color="Color.Default" Style="line-height: 1;">Balance</MudText>
            <MudText Typo="Typo.h6"
                     Color="@GetBalanceColor()"
                     Style="white-space: nowrap; line-height: 1.2; margin-top: 2px;">
                <b>@FormatCurrency(Summary?.Balance ?? 0)</b>
            </MudText>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public TransactionSummaryDto? Summary { get; set; }

    private string FormatCurrency(decimal amount)
    {
        return amount < 0 ? $"-${Math.Abs(amount):N2}" : $"${amount:N2}";
    }

    private string GetBalanceIcon()
    {
        var balance = Summary?.Balance ?? 0;
        return balance >= 0
            ? Icons.Material.Filled.AccountBalance
            : Icons.Material.Filled.Warning;
    }

    private Color GetBalanceColor()
    {
        var balance = Summary?.Balance ?? 0;
        return balance >= 0 ? Color.Success : Color.Error;
    }
}