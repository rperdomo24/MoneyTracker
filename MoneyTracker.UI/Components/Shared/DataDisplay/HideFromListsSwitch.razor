@* Standard IsHidden toggle for Account/Category/Merchant forms. Place right after the name/type fields. *@
<div class="mt-2 mb-4">
    <MudSwitch T="bool"
               Value="Value"
               ValueChanged="ValueChanged"
               Label="Hide from selection lists"
               Color="Color.Primary" />
    <MudText Typo="Typo.caption" Style="opacity: 0.7; display: block; margin-top: -4px;">
        Hidden items won't appear in dropdowns.
    </MudText>
</div>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
}
