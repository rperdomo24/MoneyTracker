@* Pagination Footer with Page Size Selector *@

<MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-4">

    <!-- Page Size Selector -->
    @if (ShowPageSizeSelector)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.body2" Color="Color.Default">Rows per page:</MudText>

            <MudSelect T="int"
                       Value="@PageSize"
                       ValueChanged="HandlePageSizeChanged"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       Style="width: 100px;">
                @foreach (var size in PageSizeOptions)
                {
                    <MudSelectItem Value="@size">@size</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    }

    <!-- Pagination -->
    @if (TotalPages > 1)
    {
        <!-- Mobile: few numbers -->
        <MudHidden Breakpoint="Breakpoint.SmAndUp">
            <MudPagination Count="@TotalPages"
                           Selected="@CurrentPage"
                           SelectedChanged="OnPageChanged"
                           Color="Color.Primary"
                           ShowFirstButton="@ShowFirstLastButtons"
                           ShowLastButton="@ShowFirstLastButtons"
                           BoundaryCount="1" />
        </MudHidden>

        <!-- Tablet/Desktop: normal -->
        <MudHidden Breakpoint="Breakpoint.Xs">
            <MudPagination Count="@TotalPages"
                           Selected="@CurrentPage"
                           SelectedChanged="OnPageChanged"
                           Color="Color.Primary"
                           ShowFirstButton="@ShowFirstLastButtons"
                           ShowLastButton="@ShowFirstLastButtons" />
        </MudHidden>

        @if (ShowInfo)
        {
            <MudText Typo="Typo.caption" Color="Color.Default">
                Showing @GetStartRow()-@GetEndRow() of @TotalItems @ItemName
            </MudText>
        }
    }
</MudStack>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public int TotalItems { get; set; } = 0;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    [Parameter] public bool ShowInfo { get; set; } = true;
    [Parameter] public bool ShowFirstLastButtons { get; set; } = true;
    [Parameter] public bool ShowPageSizeSelector { get; set; } = true;
    [Parameter] public string ItemName { get; set; } = "items";
    [Parameter] public List<int> PageSizeOptions { get; set; } = new() { 5, 10, 25, 50, 100 };

    private async Task HandlePageSizeChanged(int newValue)
    {
        if (PageSize != newValue)
        {
            PageSize = newValue;
            await PageSizeChanged.InvokeAsync(newValue); // Notifica al componente padre
        }
    }

    private int GetStartRow()
    {
        if (TotalItems == 0) return 0;
        return (CurrentPage - 1) * PageSize + 1;
    }

    private int GetEndRow()
    {
        return Math.Min(CurrentPage * PageSize, TotalItems);
    }
}
