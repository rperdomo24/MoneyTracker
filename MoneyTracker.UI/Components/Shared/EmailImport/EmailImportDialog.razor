@using MoneyTracker.Application.DTOs.Gmail
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.UI.Components.Shared.TextImport
@inject IEmailImportService EmailImportService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Bank emails to review</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </MudStack>
        }
        else if (_items.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">No pending emails to review.</MudAlert>
        }
        else
        {
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudCheckBox T="bool" Value="@_selectAll" ValueChanged="@ToggleSelectAll" Label="Select all" Dense="true" />
                @if (_selectedIds.Count > 0)
                {
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   Disabled="@_reviewing"
                                   OnClick="@(() => ReviewItemsAsync(_selectedIds.ToList()))">
                            Review selected (@_selectedIds.Count)
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                   Disabled="@_bulkDismissing"
                                   OnClick="DismissSelectedAsync">
                            Dismiss selected (@_selectedIds.Count)
                        </MudButton>
                    </MudStack>
                }
            </MudStack>

            <MudStack Spacing="2">
                @foreach (var item in _items)
                {
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudCheckBox T="bool" Value="@_selectedIds.Contains(item.Id)" ValueChanged="@((bool v) => ToggleSelected(item.Id, v))" />
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body1">
                                        @(item.Provider ?? item.From)
                                        @if (item.Amount.HasValue)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="ml-2">
                                                @item.Amount.Value.ToString("C2")
                                            </MudChip>
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Subject</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.ReceivedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                                </MudStack>
                            </MudStack>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           Disabled="@_reviewing"
                                           OnClick="@(() => ReviewItemsAsync(new List<int> { item.Id }))">
                                    Review
                                </MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => DismissAsync(item))">
                                    Dismiss
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private bool _loading = true;
    private bool _selectAll = false;
    private bool _bulkDismissing = false;
    private bool _reviewing = false;
    private List<EmailImportItemDto> _items = new();
    private HashSet<int> _selectedIds = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await EmailImportService.GetPendingAsync();
        _items = result.Success && result.Data is not null ? result.Data : new();
        _selectedIds.Clear();
        _selectAll = false;
        _loading = false;
    }

    private void ToggleSelected(int itemId, bool selected)
    {
        if (selected)
            _selectedIds.Add(itemId);
        else
            _selectedIds.Remove(itemId);

        _selectAll = _items.Count > 0 && _selectedIds.Count == _items.Count;
    }

    private void ToggleSelectAll(bool selected)
    {
        _selectAll = selected;
        _selectedIds = selected ? _items.Select(i => i.Id).ToHashSet() : new HashSet<int>();
    }

    private async Task DismissSelectedAsync()
    {
        if (_bulkDismissing || _selectedIds.Count == 0) return;
        _bulkDismissing = true;

        try
        {
            var idsToRemove = _selectedIds.ToList();
            foreach (var itemId in idsToRemove)
            {
                var result = await EmailImportService.DismissAsync(itemId);
                if (result.Success)
                {
                    _items.RemoveAll(i => i.Id == itemId);
                    _selectedIds.Remove(itemId);
                }
                else
                {
                    Snackbar.Add(result.Message, Severity.Error);
                }
            }

            _selectAll = false;
        }
        finally
        {
            _bulkDismissing = false;
        }
    }

    private async Task ReviewItemsAsync(List<int> itemIds)
    {
        if (_reviewing || itemIds.Count == 0) return;
        _reviewing = true;

        try
        {
            var suggestionsResult = await EmailImportService.GetReviewSuggestionsAsync(itemIds);
            if (!suggestionsResult.Success || suggestionsResult.Data is null || suggestionsResult.Data.Count == 0)
            {
                Snackbar.Add(suggestionsResult.Message ?? "Could not prepare selected emails for review.", Severity.Error);
                return;
            }

            if (suggestionsResult.Data.Count < itemIds.Count)
            {
                Snackbar.Add("Some selected emails could not be analyzed and were skipped.", Severity.Warning);
            }

            var importedEmailIds = new HashSet<int>();
            var parameters = new DialogParameters
            {
                ["ReviewBatch"] = suggestionsResult.Data,
                ["OnEmailImported"] = EventCallback.Factory.Create<int>(this, id =>
                {
                    importedEmailIds.Add(id);
                    return EmailImportService.MarkImportedAsync(id);
                })
            };
            var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

            var dialog = await DialogService.ShowAsync<ImportFromTextDialog>("Magic Import", parameters, options);
            await dialog.Result;

            foreach (var emailId in importedEmailIds)
            {
                _items.RemoveAll(i => i.Id == emailId);
                _selectedIds.Remove(emailId);
            }

            _selectAll = _items.Count > 0 && _selectedIds.Count == _items.Count;
        }
        finally
        {
            _reviewing = false;
        }
    }

    private async Task DismissAsync(EmailImportItemDto item)
    {
        var result = await EmailImportService.DismissAsync(item.Id);
        if (result.Success)
        {
            _items.Remove(item);
            _selectedIds.Remove(item.Id);
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Error);
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
