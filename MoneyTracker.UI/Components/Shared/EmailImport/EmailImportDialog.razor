@using MoneyTracker.Application.DTOs.Gmail
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.UI.Components.Shared.TextImport
@inject IEmailImportService EmailImportService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Bank emails to review</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </MudStack>
        }
        else if (_items.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">No pending emails to review.</MudAlert>
        }
        else
        {
            <MudStack Spacing="2">
                @foreach (var item in _items)
                {
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body1">
                                    @(item.Provider ?? item.From)
                                    @if (item.Amount.HasValue)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="ml-2">
                                            @item.Amount.Value.ToString("C2")
                                        </MudChip>
                                    }
                                </MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Subject</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@item.ReceivedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                            </MudStack>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => ReviewAsync(item))">
                                    Review
                                </MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => DismissAsync(item))">
                                    Dismiss
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private bool _loading = true;
    private List<EmailImportItemDto> _items = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await EmailImportService.GetPendingAsync();
        _items = result.Success && result.Data is not null ? result.Data : new();
        _loading = false;
    }

    private async Task ReviewAsync(EmailImportItemDto item)
    {
        var aiInput = $"From: {item.From}\nSubject: {item.Subject}\nDate: {item.ReceivedAtUtc:O}\n\n{item.BodyText}";

        var parameters = new DialogParameters { ["InitialText"] = aiInput };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<ImportFromTextDialog>("Magic Import", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await EmailImportService.MarkImportedAsync(item.Id);
            _items.Remove(item);
        }
    }

    private async Task DismissAsync(EmailImportItemDto item)
    {
        var result = await EmailImportService.DismissAsync(item.Id);
        if (result.Success)
        {
            _items.Remove(item);
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Error);
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
