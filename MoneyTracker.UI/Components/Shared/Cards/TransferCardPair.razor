@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Common.Extensions
@using MoneyTracker.Domain.Const
@using MoneyTracker.UI.Helpers

<MudCard Outlined="true" Class="@GetCardClass()" Elevation="@(Highlighted ? 4 : 0)">
    <MudCardContent Class="pa-3">

        <!-- ================= MOBILE (<600px): 2-row layout ================= -->
        <MudHidden Breakpoint="Breakpoint.SmAndUp">
            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Spacing="2">

                <!-- LEFT: checkbox + icon + info -->
                <MudStack Row="true"
                          Spacing="2"
                          AlignItems="AlignItems.Center"
                          Style="flex: 1; min-width: 0;">

                    @if (ShowCheckbox)
                    {
                        <MudCheckBox T="bool"
                                     Dense="true"
                                     Size="Size.Medium"
                                     Value="@IsSelected"
                                     Disabled="true"
                                     ReadOnly="true" />
                    }

                    <MudAvatar Size="Size.Medium"
                               Color="Color.Info">
                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz"
                                 Color="Color.Surface" />
                    </MudAvatar>

                    <!-- TEXT -->
                    <MudStack Spacing="0" Style="flex:1; min-width:0;">

                        <!-- Title (single-line, safe): link only on FROM -->
                        @{
                            var fromName = (FromTransaction.Account?.Name ?? string.Empty).Replace(" - ", " · ");
                            var toName = (ToTransaction.Account?.Name ?? string.Empty).Replace(" - ", " · ");
                            var fullTitle = $"{fromName} → {toName}";
                        }

                        <MudTooltip Text="@fullTitle" Placement="Placement.Bottom" Arrow="true" Delay="200">
                            <MudText Typo="Typo.body1"
                                     Class="font-weight-medium"
                                     Style="min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
                                     title="@fullTitle">

                                <MudLink Href="@GetAccountLink(FromTransaction)"
                                         Class="text-inherit"
                                         Underline="Underline.Hover"
                                         @onclick:stopPropagation="true">
                                    @fromName
                                </MudLink>

                                <span style="opacity:0.6;"> → </span>

                                <span style="opacity:0.85;">
                                    @toName
                                </span>

                            </MudText>
                        </MudTooltip>

                        <!-- Subtitle like TransactionCard -->
                        <MudText Typo="Typo.caption" Style="opacity:0.7;">
                            Transfer · @FromTransaction.Date.ToString("MMM dd, yyyy")
                        </MudText>

                    </MudStack>
                </MudStack>

                <!-- RIGHT: amount -->
                <MudText Typo="Typo.h6"
                         Class="font-weight-bold"
                         Style="flex-shrink:0;">
                    @ShowAmountTransaction(ToTransaction.Amount)
                </MudText>

            </MudStack>
        </MudHidden>

        <!-- ================= TABLET/DESKTOP (>=600px): single-row layout ================= -->
        <MudHidden Breakpoint="Breakpoint.Xs">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">

                <!-- Left -->
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="flex: 1; min-width: 0;">

                    @if (ShowCheckbox)
                    {
                        <MudCheckBox T="bool"
                                     Dense="true"
                                     Size="Size.Medium"
                                     Value="@IsSelected"
                                     Disabled="true"
                                     ReadOnly="true" />
                    }

                    <MudAvatar Size="Size.Medium"
                               Color="Color.Info"
                               Class="cursor-pointer"
                               @onclick="HandleCardClick">
                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Surface" />
                    </MudAvatar>

                    <MudStack Spacing="1" Style="flex:1; min-width:0;" Class="cursor-pointer" @onclick="HandleCardClick">

                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Style="min-width:0;">
                            <MudLink Href="@GetAccountLink(FromTransaction)"
                                     Typo="Typo.body1"
                                     Class="font-weight-medium text-truncate"
                                     Style="min-width:0;"
                                     Underline="Underline.Hover">
                                @FromTransaction.Account?.Name
                            </MudLink>

                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                     Size="Size.Small"
                                     Style="opacity: 0.6;" />

                            <MudLink Href="@GetAccountLink(ToTransaction)"
                                     Typo="Typo.body1"
                                     Class="font-weight-medium text-truncate"
                                     Style="min-width:0;"
                                     Underline="Underline.Hover">
                                @ToTransaction.Account?.Name
                            </MudLink>

                            <MudTooltip Text="Linked transfer - cannot be selected individually">
                                <MudIcon Icon="@Icons.Material.Filled.Link"
                                         Size="Size.Small"
                                         Style="opacity: 0.5;" />
                            </MudTooltip>
                        </MudStack>

                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
                                @GetTransferTypeLabel()
                            </MudChip>

                            <MudText Typo="Typo.caption" Style="opacity: 0.7;">
                                @FromTransaction.Date.ToString("MMM dd, yyyy")
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudStack>

                <!-- Right -->
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex-shrink: 0;">
                    <MudText Typo="Typo.h6" Class="font-weight-bold">
                        @ShowAmountTransaction(ToTransaction.Amount)
                    </MudText>

                    @if (ShowActions)
                    {
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                 Size="Size.Small"
                                 Dense="true"
                                 AnchorOrigin="Origin.BottomLeft"
                                 TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="HandleEdit">
                                Edit Transfer
                            </MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="HandleDelete">
                                <MudText Color="Color.Error">Delete Transfer</MudText>
                            </MudMenuItem>
                        </MudMenu>
                    }
                </MudStack>

            </MudStack>
        </MudHidden>

    </MudCardContent>
</MudCard>

@code {
    [Parameter] public TransactionDto FromTransaction { get; set; } = default!;
    [Parameter] public TransactionDto ToTransaction { get; set; } = default!;
    [Parameter] public bool ShowAccounts { get; set; } = true;
    [Parameter] public bool ShowActions { get; set; } = true;
    [Parameter] public bool Highlighted { get; set; } = false;

    [Parameter] public bool ShowCheckbox { get; set; } = false;
    [Parameter] public bool IsSelected { get; set; } = false;

    [Parameter] public EventCallback<TransactionDto> OnCardClick { get; set; }
    [Parameter] public EventCallback<TransactionDto> OnEdit { get; set; }
    [Parameter] public EventCallback<TransactionDto> OnDelete { get; set; }

    private async Task HandleCardClick()
    {
        if (OnCardClick.HasDelegate)
            await OnCardClick.InvokeAsync(ToTransaction);
    }

    private async Task HandleEdit()
    {
        if (OnEdit.HasDelegate)
            await OnEdit.InvokeAsync(ToTransaction);
    }

    private async Task HandleDelete()
    {
        if (OnDelete.HasDelegate)
            await OnDelete.InvokeAsync(ToTransaction);
    }

    private string GetCardClass()
    {
        var baseClass = "mb-2";
        return Highlighted ? $"{baseClass} mud-theme-info" : baseClass;
    }

    private string GetAccountLink(TransactionDto transaction) => $"/accounts/{transaction.AccountId}";

    private string GetTransferTypeLabel()
    {
        if (ToTransaction.TransferType.HasValue)
            return ToTransaction.TransactionType.GetDescription();

        return "Transfer";
    }

    private static string ShowAmountTransaction(decimal amount)
        => amount == 0 ? "$0.00" : $"-/+${amount:N2}";
}