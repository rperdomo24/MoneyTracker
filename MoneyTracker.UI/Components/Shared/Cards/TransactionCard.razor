@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Common.Extensions
@using MoneyTracker.UI.Helpers

<MudCard Outlined="true" Class="@GetCardClass()" Elevation="@(Highlighted ? 4 : 0)">
    <MudCardContent Class="pa-3">

        <!-- ================= MOBILE (<600px) ================= -->
        <MudHidden Breakpoint="Breakpoint.SmAndUp">
            <MudStack Spacing="2">

                <!-- Row 1: left content + menu -->
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">

                    <!-- LEFT -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex:1; min-width:0;" Class="cursor-pointer" @onclick="HandleCardClick">

                        @if (ShowCheckbox)
                        {
                            <MudCheckBox T="bool"
                                         Dense="true"
                                         Size="Size.Medium"
                                         Value="@IsSelected"
                                         ValueChanged="@OnSelectionChanged"
                                         Disabled="@(!CanBeSelected)"
                                         @onclick:stopPropagation="true" />
                        }

                        <MudAvatar Size="Size.Medium"
                                   Style="@GetAvatarStyle()"
                                   Class="cursor-pointer"
                                   @onclick="HandleCardClick">
                            <MudIcon Icon="@GetTransactionIcon()" Color="Color.Surface" />
                        </MudAvatar>

                        <MudStack Spacing="0" Style="min-width:0;">
                            <MudText Typo="Typo.body1" Class="font-weight-medium text-truncate">
                                @GetDisplayName()
                            </MudText>

                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="min-width:0;">
                                @if (!string.IsNullOrWhiteSpace(Transaction.MerchantName))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" Style="font-size:0.75rem;opacity:0.6;" />
                                }
                                <MudText Typo="Typo.caption" Class="text-truncate" Style="opacity:0.7;">
                                    @Transaction.Category?.Name
                                </MudText>
                            </MudStack>
                        </MudStack>

                    </MudStack>

                    <!-- RIGHT: menu only (doesn't steal width from title) -->
                    @if (ShowActions)
                    {
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                 Size="Size.Small"
                                 Dense="true"
                                 AnchorOrigin="Origin.BottomLeft"
                                 TransformOrigin="Origin.TopRight"
                                 @onclick:stopPropagation="true">
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="HandleEdit">Edit</MudMenuItem>

                            <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy"
                                         OnClick="HandleDuplicate"
                                         Disabled="@IsDuplicating">
                                @if (IsDuplicating)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <MudText>Duplicating...</MudText>
                                }
                                else
                                {
                                    <MudText>Duplicate</MudText>
                                }
                            </MudMenuItem>

                            <MudDivider />

                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="HandleDelete">
                                <MudText Color="Color.Error">Delete</MudText>
                            </MudMenuItem>
                        </MudMenu>
                    }

                </MudStack>

                <!-- Row 2: amount aligned right -->
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="min-width:0;">
                        @if (ShowAccount && Transaction.Account != null)
                        {
                            <MudLink Href="@GetAccountLink()"
                                     Typo="Typo.caption"
                                     Class="text-truncate"
                                     Style="opacity:0.7; min-width:0;"
                                     Underline="Underline.Hover"
                                     @onclick:stopPropagation="true">
                                @Transaction.Account.Name
                            </MudLink>

                            <MudText Typo="Typo.caption" Style="opacity:0.5;">•</MudText>
                        }

                        <MudText Typo="Typo.caption" Style="opacity:0.7;">
                            @Transaction.Date.ToString("MMM dd, yyyy")
                        </MudText>
                    </MudStack>

                    <MudText Typo="Typo.body1" Class="@GetAmountClass()">
                        @Transaction.GetAmountDisplay()
                    </MudText>

                </MudStack>

            </MudStack>
        </MudHidden>

        <!-- ================= TABLET / DESKTOP ================= -->
        <MudHidden Breakpoint="Breakpoint.Xs">

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center">

                <!-- LEFT -->
                <MudStack Row="true"
                          Spacing="2"
                          AlignItems="AlignItems.Center"
                          Style="flex:1; min-width:0;">

                    @if (ShowCheckbox)
                    {
                        <MudCheckBox T="bool"
                                     Dense="true"
                                     Size="Size.Medium"
                                     Value="@IsSelected"
                                     ValueChanged="@OnSelectionChanged"
                                     Disabled="@(!CanBeSelected)"
                                     @onclick:stopPropagation="true" />
                    }

                    <MudAvatar Size="Size.Medium"
                               Style="@GetAvatarStyle()"
                               @onclick="HandleCardClick"
                               Class="cursor-pointer">
                        <MudIcon Icon="@GetTransactionIcon()"
                                 Color="Color.Surface" />
                    </MudAvatar>

                    <MudStack Spacing="0"
                              Style="min-width:0;"
                              Class="cursor-pointer"
                              @onclick="HandleCardClick">

                        <MudText Typo="Typo.body1"
                                 Class="font-weight-medium text-truncate">
                            @GetDisplayName()
                        </MudText>

                        <MudStack Row="true"
                                  Spacing="1"
                                  AlignItems="AlignItems.Center"
                                  Style="min-width:0;">

                            @if (!string.IsNullOrWhiteSpace(Transaction.MerchantName))
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" Style="font-size:0.75rem;opacity:0.6;" />
                            }

                            <MudText Typo="Typo.caption"
                                     Class="text-truncate"
                                     Style="opacity:0.7;">
                                @Transaction.Category?.Name
                            </MudText>

                            @if (ShowAccount && Transaction.Account != null)
                            {
                                <MudText Typo="Typo.caption"
                                         Style="opacity:0.5;">•</MudText>

                                <MudLink Href="@GetAccountLink()"
                                         Typo="Typo.caption"
                                         Class="text-truncate"
                                         Style="opacity:0.7;"
                                         Underline="Underline.Hover"
                                         @onclick:stopPropagation="true">
                                    @Transaction.Account.Name
                                </MudLink>
                            }

                            <MudText Typo="Typo.caption"
                                     Style="opacity:0.5;">•</MudText>

                            <MudText Typo="Typo.caption"
                                     Style="opacity:0.7;">
                                @Transaction.Date.ToString("MMM dd, yyyy")
                            </MudText>

                        </MudStack>
                    </MudStack>
                </MudStack>

                <!-- RIGHT -->
                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Spacing="2"
                          Style="flex-shrink:0;">

                    <MudText Typo="Typo.h6"
                             Class="@GetAmountClass()">
                        @Transaction.GetAmountDisplay()
                    </MudText>

                    @if (ShowActions)
                    {
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                 Size="Size.Small"
                                 Dense="true"
                                 AnchorOrigin="Origin.BottomLeft"
                                 TransformOrigin="Origin.TopRight">

                            <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                         OnClick="HandleEdit">
                                Edit
                            </MudMenuItem>

                            <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy"
                                         OnClick="HandleDuplicate"
                                         Disabled="@IsDuplicating">

                                @if (IsDuplicating)
                                {
                                    <MudProgressCircular Size="Size.Small"
                                                         Indeterminate="true"
                                                         Class="mr-2" />
                                    <MudText>Duplicating...</MudText>
                                }
                                else
                                {
                                    <MudText>Duplicate</MudText>
                                }
                            </MudMenuItem>

                            <MudDivider />

                            <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                         OnClick="HandleDelete">
                                <MudText Color="Color.Error">Delete</MudText>
                            </MudMenuItem>

                        </MudMenu>
                    }
                </MudStack>

            </MudStack>

        </MudHidden>

    </MudCardContent>
</MudCard>

@code {
    [Parameter] public TransactionDto Transaction { get; set; } = default!;
    [Parameter] public bool ShowAccount { get; set; } = true;
    [Parameter] public bool ShowActions { get; set; } = true;
    [Parameter] public bool Highlighted { get; set; } = false;
    [Parameter] public bool IsDuplicating { get; set; } = false;

    // ✅ CHECKBOX PARAMETERS
    [Parameter] public bool ShowCheckbox { get; set; } = false;
    [Parameter] public bool IsSelected { get; set; } = false;
    [Parameter] public bool CanBeSelected { get; set; } = true;
    [Parameter] public EventCallback<bool> OnSelectionChanged { get; set; }

    [Parameter] public EventCallback<TransactionDto> OnCardClick { get; set; }
    [Parameter] public EventCallback<TransactionDto> OnEdit { get; set; }
    [Parameter] public EventCallback<TransactionDto> OnDuplicate { get; set; }
    [Parameter] public EventCallback<TransactionDto> OnDelete { get; set; }

    private async Task HandleCardClick()
    {
        if (OnCardClick.HasDelegate)
        {
            await OnCardClick.InvokeAsync(Transaction);
        }
    }

    private async Task HandleEdit()
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(Transaction);
        }
    }

    private async Task HandleDuplicate()
    {
        if (OnDuplicate.HasDelegate)
        {
            await OnDuplicate.InvokeAsync(Transaction);
        }
    }

    private async Task HandleDelete()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(Transaction);
        }
    }

    private string GetCardClass()
    {
        var baseClass = "mb-2";
        return Highlighted ? $"{baseClass} mud-theme-primary" : baseClass;
    }

    private string GetAmountClass()
    {
        if (Transaction.IsTransfer())
        {
            return Transaction.IsOutgoingTransfer()
                ? "text-error font-weight-bold"
                : "text-success font-weight-bold";
        }

        return Transaction.IsIncome()
            ? "text-success font-weight-bold"
            : "text-error font-weight-bold";
    }

    private string GetAccountLink() => $"/accounts/{Transaction.AccountId}";

    // ✅ NUEVOS MÉTODOS REUTILIZABLES
    private string GetAvatarStyle()
    {
        if (Transaction.IsTransfer())
        {
            return Transaction.IsOutgoingTransfer()
                ? "background-color: #f44336;"  // Rojo para saliente
                : "background-color: #4caf50;"; // Verde para entrante
        }

        return $"background-color: {Transaction.Category?.Color ?? "#6366f1"}";
    }

    private string GetTransactionIcon()
    {
        if (Transaction.IsTransfer())
        {
            return Transaction.IsOutgoingTransfer()
                ? Icons.Material.Filled.CallMade
                : Icons.Material.Filled.CallReceived;
        }

        return Transaction.Category?.Icon.ToIcon() ?? Icons.Material.Filled.Receipt;
    }

    private string GetDisplayName()
    {
        return !string.IsNullOrWhiteSpace(Transaction.MerchantName)
            ? Transaction.MerchantName
            : Transaction.Name;
    }
}