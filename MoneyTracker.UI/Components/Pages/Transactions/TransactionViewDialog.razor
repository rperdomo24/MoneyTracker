@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.UI.Helpers
@inject ITransactionService TransactionService

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Medium" />
            <MudText Typo="Typo.h6">Transaction Details</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-6">
                <MudProgressCircular Indeterminate="true" />
            </MudStack>
        }
        else if (_transaction is null)
        {
            <MudText Typo="Typo.body2" Style="opacity:0.6;" Class="pa-4">Transaction not found.</MudText>
        }
        else
        {
            <MudStack Spacing="3" Class="pa-1">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Style="opacity:0.5;">Name</MudText>
                    <MudText Typo="Typo.body1" Class="font-weight-medium">@_transaction.Name</MudText>
                </MudStack>

                <MudStack Row="true" Spacing="4">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Style="opacity:0.5;">Amount</MudText>
                        <MudText Typo="Typo.body1"
                                 Style="@($"color:{(_transaction.Amount >= 0 ? "var(--mud-palette-success)" : "var(--mud-palette-error)")}")">
                            @CurrencyHelper.FormatCurrency(Math.Abs(_transaction.Amount))
                        </MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Style="opacity:0.5;">Date</MudText>
                        <MudText Typo="Typo.body1">@_transaction.Date.ToString("MMM d, yyyy")</MudText>
                    </MudStack>
                </MudStack>

                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Style="opacity:0.5;">Account</MudText>
                    <MudText Typo="Typo.body1">@(_transaction.Account?.Name ?? "—")</MudText>
                </MudStack>

                @if (_transaction.Category is not null)
                {
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Style="opacity:0.5;">Category</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            @if (!string.IsNullOrWhiteSpace(_transaction.Category.Color))
                            {
                                <MudAvatar Style="@($"background:{_transaction.Category.Color}; width:18px; height:18px;")" />
                            }
                            <MudText Typo="Typo.body1">@_transaction.Category.Name</MudText>
                        </MudStack>
                    </MudStack>
                }

                @if (!string.IsNullOrWhiteSpace(_transaction.MerchantName))
                {
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Style="opacity:0.5;">Merchant</MudText>
                        <MudText Typo="Typo.body1">@_transaction.MerchantName</MudText>
                    </MudStack>
                }

                @if (!string.IsNullOrWhiteSpace(_transaction.Description))
                {
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Style="opacity:0.5;">Notes</MudText>
                        <MudText Typo="Typo.body2" Style="opacity:0.8;">@_transaction.Description</MudText>
                    </MudStack>
                }
            </MudStack>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int TransactionId { get; set; }

    private TransactionDto? _transaction;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (TransactionId > 0)
        {
            var result = await TransactionService.GetByIdAsync(TransactionId);
            _transaction = result.Success ? result.Data : null;
        }
        _loading = false;
    }

    private void Close() => MudDialog.Close();
}
