@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums
@using MoneyTracker.UI.Components.Pages.Categories
@using MoneyTracker.UI.Helpers
@inject ITransactionService TransactionService
@inject ICategoryService CategoryService
@inject IAccountService AccountService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center justify-space-between">
            <div class="d-flex align-center">
                <MudIcon Icon="@GetTransactionIcon()"
                         Color="@GetTransactionColor()"
                         Size="Size.Medium"
                         Class="mr-3" />
                <div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">
                        @GetModalTitle()
                    </MudText>
                    <MudText Typo="Typo.body2" Class="text-muted">
                        @GetModalSubtitle()
                    </MudText>
                </div>
            </div>
            <div class="d-flex align-center ga-2">
                <MudChip T="string" Size="Size.Small"
                         Color="@GetTransactionColor()"
                         Variant="Variant.Text">
                    @GetTransactionTypeDisplay()
                </MudChip>
                <MudText Typo="Typo.caption" Class="text-muted">
                    ID: @TransactionId
                </MudText>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-0">
            @if (_loading)
            {
                <div class="text-center pa-6">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText Class="mt-3">Loading transaction...</MudText>
                </div>
            }
            else if (_originalTransaction == null)
            {
                <div class="text-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Class="text-error mb-3" />
                    <MudText Typo="Typo.h6" Class="mb-2">Transaction Not Found</MudText>
                    <MudText Class="text-muted">The transaction you're trying to edit doesn't exist.</MudText>
                </div>
            }
            else if (_isCreditPayment)
            {
                @* ========== CREDIT PAYMENT EDIT UI ========== *@
                <MudGrid>
                    <!-- LEFT COLUMN - CREDIT PAYMENT FORM -->
                    <MudItem xs="12" md="7">
                        <MudForm @ref="_form" Model="_transaction">
                            <MudStack Spacing="4">
                                <!-- Change Detection Alert -->
                                @if (HasChanges())
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mb-2">
                                        <div class="d-flex align-center justify-space-between">
                                            <span>You have unsaved changes to this payment</span>
                                            <MudButton Size="Size.Small"
                                                       Variant="Variant.Text"
                                                       OnClick="ResetToOriginal">
                                                Reset
                                            </MudButton>
                                        </div>
                                    </MudAlert>
                                }

                                <!-- Credit Payment Details -->
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" Class="mr-2" Size="Size.Small" />
                                        Credit Card Payment Details
                                    </MudText>

                                    <MudGrid>
                                        <!-- Payment Name -->
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          Label="Payment Name"
                                                          @bind-Value="_transaction.Name"
                                                          Variant="Variant.Outlined"
                                                          Required="true"
                                                          Placeholder="e.g., Credit Card Payment, Monthly Payment..."
                                                          HelperText="Descriptive name for this payment"
                                                          @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>

                                        <!-- Payment Amount -->
                                        <MudItem xs="12" md="6">
                                            <MudNumericField T="decimal"
                                                             Label="Payment Amount"
                                                             @bind-Value="_transaction.Amount"
                                                             Variant="Variant.Outlined"
                                                             Required="true"
                                                             Min="0.01m"
                                                             Step="0.01m"
                                                             Format="F2"
                                                             Culture="@System.Globalization.CultureInfo.CurrentCulture"
                                                             Adornment="Adornment.Start"
                                                             AdornmentText="$"
                                                             HelperText="Update payment amount"
                                                             @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>

                                        <!-- Payment Date -->
                                        <MudItem xs="12" md="6">
                                            <MudDatePicker Label="Payment Date"
                                                           @bind-Date="_transactionDate"
                                                           Variant="Variant.Outlined"
                                                           Required="true"
                                                           MaxDate="DateTime.Today"
                                                           HelperText="Update payment date"
                                                           Editable="true"
                                                           DateFormat="MM/dd/yyyy"
                                                           @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>

                                        <!-- From Account (Read-only for edits) -->
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          Label="Paid From Account"
                                                          Value="@GetFromAccountName()"
                                                          Variant="Variant.Outlined"
                                                          ReadOnly="true"
                                                          HelperText="Source account (cannot be changed)"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                                        </MudItem>
                                    </MudGrid>
                                </div>

                                <!-- Description -->
                                <div>
                                    <MudTextField T="string"
                                                  Label="Description (Optional)"
                                                  @bind-Value="_transaction.Description"
                                                  Variant="Variant.Outlined"
                                                  Lines="3"
                                                  Placeholder="Update payment description..."
                                                  HelperText="Optional: Update payment purpose or details"
                                                  @onkeydown="@((e) => HandleKeyDown(e))" />
                                </div>

                                <!-- Credit Card Info -->
                                @if (_creditCardAccount != null)
                                {
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Size="Size.Small" />
                                            Credit Card Information
                                        </MudText>

                                        <MudPaper Class="pa-3" Elevation="1" Style="border-left: 4px solid #ff5722;">
                                            <MudGrid>
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.caption" Class="text-muted">Credit Card</MudText>
                                                    <MudText Typo="Typo.body2" Class="font-weight-medium">
                                                        @_creditCardAccount.Name
                                                    </MudText>
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.caption" Class="text-muted">Current Debt</MudText>
                                                    <MudText Typo="Typo.body2" Class="font-weight-medium text-error">
                                                        @GetCreditCardDebt(_creditCardAccount).ToString("C")
                                                    </MudText>
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.caption" Class="text-muted">Credit Limit</MudText>
                                                    <MudText Typo="Typo.body2" Class="font-weight-medium">
                                                        @_creditCardAccount.CreditLimit.ToString("C")
                                                    </MudText>
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.caption" Class="text-muted">Available Credit</MudText>
                                                    <MudText Typo="Typo.body2" Class="font-weight-medium text-success">
                                                        @GetAvailableCredit(_creditCardAccount).ToString("C")
                                                    </MudText>
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    </div>
                                }

                                <!-- Warning about credit payment edits -->
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    <strong>Note:</strong> This payment was made from @GetFromAccountName() to reduce credit card debt.
                                    The account information cannot be changed to maintain payment integrity.
                                </MudAlert>

                                <!-- Advanced Options -->
                                <MudExpansionPanels>
                                    <MudExpansionPanel Text="Advanced Options" Icon="@Icons.Material.Filled.Settings">
                                        <MudStack Spacing="3">
                                            <MudCheckBox @bind-Value="_deleteAfterUpdate" Color="Color.Error">
                                                <span class="ml-2">Delete this payment after updating</span>
                                            </MudCheckBox>
                                        </MudStack>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            </MudStack>
                        </MudForm>
                    </MudItem>

                    <!-- RIGHT COLUMN - CREDIT PAYMENT PREVIEW -->
                    <MudItem xs="12" md="5">
                        <MudStack Spacing="4">
                            <!-- Payment Preview -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Preview" Class="mr-2" Size="Size.Small" />
                                    Updated Payment Preview
                                </MudText>

                                <MudPaper Class="pa-3 mb-3" Elevation="2" Style="border-left: 4px solid #ff5722;">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Payment" Color="Color.Warning" Class="mr-2" />
                                            <div>
                                                <MudText Typo="Typo.body2" Class="font-weight-medium">@_transaction.Name</MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                    Credit Payment • @GetFormattedDate()
                                                </MudText>
                                            </div>
                                        </div>
                                        <MudText Typo="Typo.h6" Class="font-weight-bold text-warning">
                                            @(_transaction.Amount.ToString("C"))
                                        </MudText>
                                    </div>
                                </MudPaper>

                                @if (!string.IsNullOrWhiteSpace(_transaction.Description))
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        <strong>Note:</strong> @_transaction.Description
                                    </MudAlert>
                                }
                            </div>

                            <!-- Changes Summary for Payment -->
                            @if (HasChanges())
                            {
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.Compare" Class="mr-2" Size="Size.Small" />
                                        Payment Changes
                                    </MudText>

                                    <MudPaper Class="pa-3" Elevation="1">
                                        <MudStack Spacing="2">
                                            @foreach (var change in GetChanges())
                                            {
                                                <div class="d-flex align-center justify-space-between">
                                                    <MudText Typo="Typo.body2" Class="font-weight-medium">@change.Field:</MudText>
                                                    <div class="text-right">
                                                        <MudText Typo="Typo.caption" Class="text-muted text-decoration-line-through">
                                                            @change.OldValue
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Color="Color.Primary">
                                                            @change.NewValue
                                                        </MudText>
                                                    </div>
                                                </div>
                                            }
                                        </MudStack>
                                    </MudPaper>
                                </div>
                            }

                            <!-- Payment Info -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" Size="Size.Small" />
                                    Payment Information
                                </MudText>

                                <MudList T="string" Dense="true">
                                    <MudListItem Icon="@Icons.Material.Filled.CreditCard">
                                        <div>
                                            <MudText Typo="Typo.body2">Payment Type</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                Credit Card Payment
                                            </MudText>
                                        </div>
                                    </MudListItem>

                                    <MudListItem Icon="@Icons.Material.Filled.DateRange">
                                        <div>
                                            <MudText Typo="Typo.body2">Created</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                @_originalTransaction?.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                                            </MudText>
                                        </div>
                                    </MudListItem>

                                    <MudListItem Icon="@Icons.Material.Filled.AccountBalance">
                                        <div>
                                            <MudText Typo="Typo.body2">Paid From</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                @GetFromAccountName()
                                            </MudText>
                                        </div>
                                    </MudListItem>
                                </MudList>
                            </div>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            }
            else if (_isTransfer)
            {
                @* ========== TRANSFER EDIT UI ========== *@
                <MudGrid>
                    <!-- LEFT COLUMN - TRANSFER FORM -->
                    <MudItem xs="12" md="7">
                        <MudForm @ref="_form" Model="_transaction">
                            <MudStack Spacing="4">
                                <!-- Change Detection Alert -->
                                @if (HasChanges())
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mb-2">
                                        <div class="d-flex align-center justify-space-between">
                                            <span>You have unsaved changes to this transfer</span>
                                            <MudButton Size="Size.Small"
                                                       Variant="Variant.Text"
                                                       OnClick="ResetToOriginal">
                                                Reset
                                            </MudButton>
                                        </div>
                                    </MudAlert>
                                }

                                <!-- Transfer Details -->
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="mr-2" Size="Size.Small" />
                                        Transfer Details
                                    </MudText>

                                    <MudGrid>
                                        <!-- FROM Account (Read-only for edits) -->
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          Label="From Account"
                                                          Value="@GetFromAccountName()"
                                                          Variant="Variant.Outlined"
                                                          ReadOnly="true"
                                                          HelperText="Source account (cannot be changed)"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                                        </MudItem>

                                        <!-- Transfer Amount -->
                                        <MudItem xs="12" md="6">
                                            <MudNumericField T="decimal"
                                                             Label="Transfer Amount"
                                                             @bind-Value="_transaction.Amount"
                                                             Variant="Variant.Outlined"
                                                             Required="true"
                                                             Min="0.01m"
                                                             Step="0.01m"
                                                             Format="F2"
                                                             Culture="@System.Globalization.CultureInfo.CurrentCulture"
                                                             Adornment="Adornment.Start"
                                                             AdornmentText="$"
                                                             HelperText="Update transfer amount"
                                                             @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>

                                        <!-- TO Account (Read-only for edits) -->
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          Label="To Account"
                                                          Value="@GetToAccountName()"
                                                          Variant="Variant.Outlined"
                                                          ReadOnly="true"
                                                          HelperText="Destination account (cannot be changed)"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                                        </MudItem>

                                        <!-- Transfer Date -->
                                        <MudItem xs="12" md="6">
                                            <MudDatePicker Label="Transfer Date"
                                                           @bind-Date="_transactionDate"
                                                           Variant="Variant.Outlined"
                                                           Required="true"
                                                           MaxDate="DateTime.Today"
                                                           HelperText="Update transfer date"
                                                           Editable="true"
                                                           DateFormat="MM/dd/yyyy"
                                                           @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>
                                    </MudGrid>
                                </div>

                                <!-- Description -->
                                <div>
                                    <MudTextField T="string"
                                                  Label="Description (Optional)"
                                                  @bind-Value="_transaction.Description"
                                                  Variant="Variant.Outlined"
                                                  Lines="3"
                                                  Placeholder="Update transfer description..."
                                                  HelperText="Optional: Update transfer purpose or details"
                                                  @onkeydown="@((e) => HandleKeyDown(e))" />
                                </div>

                                <!-- Warning about transfer edits -->
                                <MudAlert Severity="Severity.Warning" Dense="true">
                                    <strong>Note:</strong> Editing this transfer will update both the outgoing and incoming transactions.
                                    Changes to accounts are not allowed to maintain transfer integrity.
                                </MudAlert>

                                <!-- Advanced Options -->
                                <MudExpansionPanels>
                                    <MudExpansionPanel Text="Advanced Options" Icon="@Icons.Material.Filled.Settings">
                                        <MudStack Spacing="3">
                                            <MudCheckBox @bind-Value="_deleteAfterUpdate" Color="Color.Error">
                                                <span class="ml-2">Delete this entire transfer after updating</span>
                                            </MudCheckBox>
                                        </MudStack>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            </MudStack>
                        </MudForm>
                    </MudItem>

                    <!-- RIGHT COLUMN - TRANSFER PREVIEW -->
                    <MudItem xs="12" md="5">
                        <MudStack Spacing="4">
                            <!-- Transfer Preview -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Preview" Class="mr-2" Size="Size.Small" />
                                    Updated Transfer Preview
                                </MudText>

                                <!-- FROM Account Preview -->
                                <MudPaper Class="pa-3 mb-3" Elevation="2" Style="border-left: 4px solid #f44336;">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.CallMade" Color="Color.Error" Class="mr-2" />
                                            <div>
                                                <MudText Typo="Typo.body2" Class="font-weight-medium">From: @GetFromAccountName()</MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">Transfer Out • @GetFormattedDate()</MudText>
                                            </div>
                                        </div>
                                        <MudText Typo="Typo.h6" Class="font-weight-bold text-error">
                                            -@(_transaction.Amount.ToString("C"))
                                        </MudText>
                                    </div>
                                </MudPaper>

                                <!-- Transfer Arrow -->
                                <div class="text-center mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.SwapVert" Color="Color.Info" Size="Size.Large" />
                                </div>

                                <!-- TO Account Preview -->
                                <MudPaper Class="pa-3 mb-3" Elevation="2" Style="border-left: 4px solid #4caf50;">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.CallReceived" Color="Color.Success" Class="mr-2" />
                                            <div>
                                                <MudText Typo="Typo.body2" Class="font-weight-medium">To: @GetToAccountName()</MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">Transfer In • @GetFormattedDate()</MudText>
                                            </div>
                                        </div>
                                        <MudText Typo="Typo.h6" Class="font-weight-bold text-success">
                                            +@(_transaction.Amount.ToString("C"))
                                        </MudText>
                                    </div>
                                </MudPaper>

                                @if (!string.IsNullOrWhiteSpace(_transaction.Description))
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        <strong>Note:</strong> @_transaction.Description
                                    </MudAlert>
                                }
                            </div>

                            <!-- Changes Summary for Transfer -->
                            @if (HasChanges())
                            {
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.Compare" Class="mr-2" Size="Size.Small" />
                                        Transfer Changes
                                    </MudText>

                                    <MudPaper Class="pa-3" Elevation="1">
                                        <MudStack Spacing="2">
                                            @foreach (var change in GetChanges())
                                            {
                                                <div class="d-flex align-center justify-space-between">
                                                    <MudText Typo="Typo.body2" Class="font-weight-medium">@change.Field:</MudText>
                                                    <div class="text-right">
                                                        <MudText Typo="Typo.caption" Class="text-muted text-decoration-line-through">
                                                            @change.OldValue
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Color="Color.Primary">
                                                            @change.NewValue
                                                        </MudText>
                                                    </div>
                                                </div>
                                            }
                                        </MudStack>
                                    </MudPaper>
                                </div>
                            }

                            <!-- Transfer Info -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" Size="Size.Small" />
                                    Transfer Information
                                </MudText>

                                <MudList T="string" Dense="true">
                                    <MudListItem Icon="@Icons.Material.Filled.SwapHoriz">
                                        <div>
                                            <MudText Typo="Typo.body2">Transfer Type</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                Account to Account Transfer
                                            </MudText>
                                        </div>
                                    </MudListItem>

                                    <MudListItem Icon="@Icons.Material.Filled.DateRange">
                                        <div>
                                            <MudText Typo="Typo.body2">Created</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                @_originalTransaction?.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                                            </MudText>
                                        </div>
                                    </MudListItem>

                                    @if (_pairedTransaction != null)
                                    {
                                        <MudListItem Icon="@Icons.Material.Filled.Link">
                                            <div>
                                                <MudText Typo="Typo.body2">Paired Transaction</MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                    ID: @_pairedTransaction.Id (@GetPairedTransactionType())
                                                </MudText>
                                            </div>
                                        </MudListItem>
                                    }
                                </MudList>
                            </div>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            }
            else
            {
                @* ========== REGULAR TRANSACTION EDIT UI ========== *@
                <MudGrid>
                    <!-- LEFT COLUMN - FORM -->
                    <MudItem xs="12" md="7">
                        <MudForm @ref="_form" Model="_transaction">
                            <MudStack Spacing="4">
                                <!-- Change Detection Alert -->
                                @if (HasChanges())
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mb-2">
                                        <div class="d-flex align-center justify-space-between">
                                            <span>You have unsaved changes</span>
                                            <MudButton Size="Size.Small"
                                                       Variant="Variant.Text"
                                                       OnClick="ResetToOriginal">
                                                Reset
                                            </MudButton>
                                        </div>
                                    </MudAlert>
                                }

                                <!-- Basic Transaction Info -->
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Size="Size.Small" />
                                        Transaction Details
                                    </MudText>

                                    <MudGrid>
                                        <!-- Name -->
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          Label="Transaction Name"
                                                          @bind-Value="_transaction.Name"
                                                          Variant="Variant.Outlined"
                                                          Required="true"
                                                          Placeholder="e.g., Grocery shopping, Salary, etc."
                                                          HelperText="Descriptive name for this transaction"
                                                          @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>

                                        <!-- Amount -->
                                        <MudItem xs="12" md="6">
                                            <MudNumericField T="decimal"
                                                             Label="Amount"
                                                             @bind-Value="_transaction.Amount"
                                                             Variant="Variant.Outlined"
                                                             Required="true"
                                                             Min="0.01m"
                                                             Step="0.01m"
                                                             Format="F2"
                                                             Culture="@System.Globalization.CultureInfo.CurrentCulture"
                                                             Adornment="Adornment.Start"
                                                             AdornmentText="$"
                                                             HelperText="Enter the transaction amount"
                                                             @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>

                                        <!-- Date -->
                                        <MudItem xs="12" md="6">
                                            <MudDatePicker Label="Date"
                                                           @bind-Date="_transactionDate"
                                                           Variant="Variant.Outlined"
                                                           Required="true"
                                                           MaxDate="DateTime.Today"
                                                           HelperText="Transaction date"
                                                           Editable="true"
                                                           DateFormat="MM/dd/yyyy"
                                                           @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>

                                        <!-- Category -->
                                        <MudItem xs="12" md="6">
                                            <MudGrid>
                                                <MudItem xs="10">
                                                    <MudSelect T="CategoryDto"
                                                               Label="Category"
                                                               @bind-Value="_selectedCategory"
                                                               Variant="Variant.Outlined"
                                                               Required="true"
                                                               HelperText="Select category"
                                                               ToStringFunc="@(c => c?.Name ?? "Select category")"
                                                               Clearable="true"
                                                               @onkeydown="@HandleCategoryKeyDown">
                                                        @if (_filteredCategories?.Any() == true)
                                                        {
                                                            @foreach (var category in _filteredCategories)
                                                            {
                                                                <MudSelectItem Value="@category">
                                                                    <div class="d-flex align-center">
                                                                        <MudAvatar Size="Size.Small"
                                                                                   Style="@($"background-color: {category.Color}; margin-right: 8px;")">
                                                                            <MudIcon Icon="@category.Icon.ToIcon()"
                                                                                     Color="Color.Surface"
                                                                                     Size="Size.Small" />
                                                                        </MudAvatar>
                                                                        <div>
                                                                            <MudText Typo="Typo.body2">@category.Name</MudText>
                                                                            @if (category.ParentId.HasValue)
                                                                            {
                                                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                                                    Subcategory
                                                                                </MudText>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </MudSelectItem>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <MudSelectItem Value="@((CategoryDto)null!)" Disabled="true">
                                                                <MudText Class="text-muted">No categories available</MudText>
                                                            </MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="2" Class="d-flex align-end">
                                                    <MudTooltip Text="Add new category">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                                       Color="Color.Primary"
                                                                       Variant="Variant.Outlined"
                                                                       Size="Size.Large"
                                                                       OnClick="@CreateCategory" />
                                                    </MudTooltip>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    </MudGrid>
                                </div>

                                <!-- Description -->
                                <div>
                                    <MudTextField T="string"
                                                  Label="Description (Optional)"
                                                  @bind-Value="_transaction.Description"
                                                  Variant="Variant.Outlined"
                                                  Lines="3"
                                                  Placeholder="Add any additional details about this transaction..."
                                                  HelperText="Optional: Add more context or details"
                                                  @onkeydown="@((e) => HandleKeyDown(e))" />
                                </div>

                                <!-- Account Selection -->
                                @if (_accounts?.Any() == true)
                                {
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="mr-2" Size="Size.Small" />
                                            Account
                                        </MudText>

                                        <MudSelect T="string"
                                                   Label="Account"
                                                   @bind-Value="_selectedAccountString"
                                                   Variant="Variant.Outlined"
                                                   Required="true"
                                                   HelperText="Select the account for this transaction">
                                            @foreach (var account in _accounts)
                                            {
                                                <MudSelectItem Value="@account.Id.ToString()">
                                                    <div class="d-flex align-center justify-space-between">
                                                        <div class="d-flex align-center">
                                                            <MudIcon Icon="@account.Icon.ToIcon()"
                                                                     Style="@($"color: {account.Color};")"
                                                                     Class="mr-2"
                                                                     Size="Size.Small" />
                                                            <div>
                                                                <MudText Typo="Typo.body2">@account.Name</MudText>
                                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                                    Balance: @account.CurrentBalance.ToString("C")
                                                                </MudText>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    </div>
                                }

                                <!-- Advanced Options -->
                                <MudExpansionPanels>
                                    <MudExpansionPanel Text="Advanced Options" Icon="@Icons.Material.Filled.Settings">
                                        <MudStack Spacing="3">
                                            <MudCheckBox @bind-Value="_deleteAfterUpdate" Color="Color.Error">
                                                <span class="ml-2">Delete this transaction after updating</span>
                                            </MudCheckBox>

                                            <MudCheckBox @bind-Value="_createRecurring" Color="Color.Primary">
                                                <span class="ml-2">Make this a recurring transaction</span>
                                            </MudCheckBox>
                                        </MudStack>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            </MudStack>
                        </MudForm>
                    </MudItem>

                    <!-- RIGHT COLUMN - PREVIEW & HISTORY -->
                    <MudItem xs="12" md="5">
                        <MudStack Spacing="4">
                            <!-- Live Preview -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Preview" Class="mr-2" Size="Size.Small" />
                                    Updated Preview
                                </MudText>

                                <MudPaper Class="pa-4" Elevation="2" Style="@($"border-left: 4px solid {GetTransactionColorHex()};")">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center">
                                            <MudAvatar Size="Size.Medium"
                                                       Style="@($"background-color: {GetSelectedCategoryColor()}; margin-right: 12px;")">
                                                <MudIcon Icon="@GetSelectedCategoryIcon()"
                                                         Color="Color.Surface" />
                                            </MudAvatar>
                                            <div>
                                                <MudText Typo="Typo.subtitle1" Class="font-weight-medium">
                                                    @(!string.IsNullOrWhiteSpace(_transaction.Name) ? _transaction.Name : "Transaction Name")
                                                </MudText>
                                                <MudText Typo="Typo.body2" Class="text-muted">
                                                    @GetSelectedCategoryName() • @GetFormattedDate()
                                                </MudText>
                                                @if (!string.IsNullOrWhiteSpace(_transaction.Description))
                                                {
                                                    <MudText Typo="Typo.caption" Class="text-muted mt-1">
                                                        @_transaction.Description
                                                    </MudText>
                                                }
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <MudText Typo="Typo.h6"
                                                     Class="@($"font-weight-bold {GetAmountColorClass()}")">
                                                @GetAmountDisplay()
                                            </MudText>
                                            @if (_accounts?.Any() == true)
                                            {
                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                    @GetSelectedAccountName()
                                                </MudText>
                                            }
                                        </div>
                                    </div>
                                </MudPaper>
                            </div>

                            <!-- Original vs Updated Comparison -->
                            @if (HasChanges())
                            {
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.Compare" Class="mr-2" Size="Size.Small" />
                                        Changes Summary
                                    </MudText>

                                    <MudPaper Class="pa-3" Elevation="1">
                                        <MudStack Spacing="2">
                                            @foreach (var change in GetChanges())
                                            {
                                                <div class="d-flex align-center justify-space-between">
                                                    <MudText Typo="Typo.body2" Class="font-weight-medium">@change.Field:</MudText>
                                                    <div class="text-right">
                                                        <MudText Typo="Typo.caption" Class="text-muted text-decoration-line-through">
                                                            @change.OldValue
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Color="Color.Primary">
                                                            @change.NewValue
                                                        </MudText>
                                                    </div>
                                                </div>
                                            }
                                        </MudStack>
                                    </MudPaper>
                                </div>
                            }

                            <!-- Transaction History -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" Size="Size.Small" />
                                    Transaction Info
                                </MudText>

                                <MudList T="string" Dense="true">
                                    <MudListItem Icon="@Icons.Material.Filled.DateRange">
                                        <div>
                                            <MudText Typo="Typo.body2">Created</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                @_originalTransaction?.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                                            </MudText>
                                        </div>
                                    </MudListItem>

                                    @if (_originalTransaction?.UpdatedAt != null && _originalTransaction.UpdatedAt != _originalTransaction.CreatedAt)
                                    {
                                        <MudListItem Icon="@Icons.Material.Filled.Edit">
                                            <div>
                                                <MudText Typo="Typo.body2">Last Updated</MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                    @_originalTransaction.UpdatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                                                </MudText>
                                            </div>
                                        </MudListItem>
                                    }

                                    <MudListItem Icon="@Icons.Material.Filled.Fingerprint">
                                        <div>
                                            <MudText Typo="Typo.body2">Transaction ID</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                @TransactionId
                                            </MudText>
                                        </div>
                                    </MudListItem>
                                </MudList>
                            </div>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            }
        </MudContainer>
    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-space-between align-center" style="width: 100%;">
            <div class="d-flex align-center ga-2">
                @if (HasChanges())
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                        @GetChanges().Count() change(s)
                    </MudChip>
                }
                <MudText Typo="Typo.caption" Class="text-muted">
                    Press Enter to save • Ctrl+Z to reset
                </MudText>
            </div>

            <div>
                <MudButton Color="Color.Default"
                           Variant="Variant.Text"
                           OnClick="Cancel"
                           Class="mr-2">
                    Cancel
                </MudButton>

                @if (_deleteAfterUpdate)
                {
                    <MudButton Color="Color.Error"
                               Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="DeleteTransaction"
                               Class="mr-2">
                        @GetDeleteButtonText()
                    </MudButton>
                }

                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="UpdateTransaction"
                           Disabled="@(!IsFormValid() || !HasChanges())">
                    @GetUpdateButtonText()
                </MudButton>
            </div>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int TransactionId { get; set; }
    [Parameter] public EventCallback OnTransactionUpdated { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = default!;
    private TransactionDto _transaction = new();
    private TransactionDto? _originalTransaction;
    private TransactionDto? _pairedTransaction; // Para transferencias
    private List<CategoryDto>? _categories;
    private List<CategoryDto>? _filteredCategories;
    private List<AccountDto>? _accounts;
    private bool _loading = true;
    private bool _deleteAfterUpdate = false;
    private bool _createRecurring = false;
    private bool _isTransfer = false;
    private bool _isCreditPayment = false; // ✨ NEW
    private AccountDto? _creditCardAccount; // ✨ NEW: For credit card info
    private DialogOptions _dialogOptions = new() { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Medium };

    // Form fields
    private DateTime? _transactionDate;
    private CategoryDto? _selectedCategory;
    private string _selectedAccountString = string.Empty;

    // Transfer categories
    private CategoryDto? _transferOutCategory;
    private CategoryDto? _transferInCategory;
    private CategoryDto? _creditPaymentCategory; // ✨ NEW

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;

        try
        {
            // Load the transaction to edit
            var transactionResult = await TransactionService.GetByIdAsync(TransactionId);
            if (!transactionResult.Success || transactionResult.Data == null)
            {
                Snackbar.Add("Transaction not found", Severity.Error);
                return;
            }

            _originalTransaction = transactionResult.Data;

            // Check transaction type
            _isTransfer = IsTransferTransaction(_originalTransaction);
            _isCreditPayment = IsCreditPaymentTransaction(_originalTransaction); // ✨ NEW

            // Create a copy for editing
            _transaction = new TransactionDto
                {
                    Id = _originalTransaction.Id,
                    Name = _originalTransaction.Name,
                    Amount = _originalTransaction.Amount,
                    Description = _originalTransaction.Description,
                    Date = _originalTransaction.Date,
                    CategoryId = _originalTransaction.CategoryId,
                    AccountId = _originalTransaction.AccountId
                };

            _transactionDate = _transaction.Date;

            // Load categories
            var categoriesResult = await CategoryService.GetAllAsync();
            if (categoriesResult.Success)
            {
                _categories = categoriesResult.Data ?? new List<CategoryDto>();

                // Get special categories
                _transferOutCategory = _categories.FirstOrDefault(c => c.Name == "Transfer Out" && c.Type == CategoryType.Expense);
                _transferInCategory = _categories.FirstOrDefault(c => c.Name == "Transfer In" && c.Type == CategoryType.Income);
                _creditPaymentCategory = _categories.FirstOrDefault(c => c.Name == "Credit Card Payment" && c.Type == CategoryType.Expense); // ✨ NEW

                FilterCategoriesByType();

                // Set selected category
                _selectedCategory = _filteredCategories?.FirstOrDefault(c => c.Id == _transaction.CategoryId);
            }

            // Load accounts
            var accountsResult = await AccountService.GetAllAsync();
            if (accountsResult.Success)
            {
                _accounts = accountsResult.Data?.ToList() ?? new List<AccountDto>();
                if (_transaction.AccountId.HasValue)
                {
                    _selectedAccountString = _transaction.AccountId.Value.ToString();
                }

                // ✨ NEW: Load credit card info for credit payments
                if (_isCreditPayment)
                {
                    await LoadCreditCardInfo();
                }
            }

            // Load paired transaction if this is a transfer
            if (_isTransfer)
            {
                await LoadPairedTransaction();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading data: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool IsTransferTransaction(TransactionDto transaction)
    {
        return transaction.Category?.Name == "Transfer Out" || transaction.Category?.Name == "Transfer In";
    }

    // ✨ NEW: Credit Payment Detection
    private bool IsCreditPaymentTransaction(TransactionDto transaction)
    {
        return transaction.Category?.Name == "Credit Card Payment" && transaction.Category?.Type == CategoryType.Expense;
    }

    // ✨ NEW: Load Credit Card Information
    private async Task LoadCreditCardInfo()
    {
        try
        {
            // For credit payments, we need to find which credit card this payment was for
            // This is a simplified approach - in a real app you might have better relationships
            // For now, we'll assume it's a payment to reduce credit card debt

            // You could implement logic here to find the related credit card
            // For simplicity, we'll just mark it as a credit card payment

            // If you have logic to determine which credit card, you could load it here:
            // _creditCardAccount = _accounts?.FirstOrDefault(a => a.Type == AccountType.Credit && /* some logic */);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Warning: Could not load credit card info: " + ex.Message, Severity.Warning);
        }
    }

    private async Task LoadPairedTransaction()
    {
        try
        {
            // This is a simplified approach - in a real app you'd have a TransferPairId
            // For now, we'll find the matching transfer transaction by date, amount, and description
            var allTransactionsResult = await TransactionService.GetAllAsync();
            if (allTransactionsResult.Success && allTransactionsResult.Data != null)
            {
                var isOutgoing = _originalTransaction!.Category!.Name == "Transfer Out";
                var targetCategoryName = isOutgoing ? "Transfer In" : "Transfer Out";

                _pairedTransaction = allTransactionsResult.Data
                    .FirstOrDefault(t =>
                        t.Id != _originalTransaction.Id &&
                        t.Category?.Name == targetCategoryName &&
                        t.Amount == _originalTransaction.Amount &&
                        t.Date.Date == _originalTransaction.Date.Date &&
                        t.Description == _originalTransaction.Description);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Warning: Could not load paired transaction: " + ex.Message, Severity.Warning);
        }
    }

    private void FilterCategoriesByType()
    {
        if (_categories == null || _originalTransaction?.Category == null) return;

        var targetCategoryType = _originalTransaction.Category.Type;

        _filteredCategories = _categories
            .Where(c => c.Type == targetCategoryType)
            .OrderBy(c => c.ParentId.HasValue ? 1 : 0)
            .ThenBy(c => c.Name)
            .ToList();
    }

    private bool HasChanges()
    {
        if (_originalTransaction == null) return false;

        return _transaction.Name != _originalTransaction.Name ||
               _transaction.Amount != _originalTransaction.Amount ||
               _transaction.Description != _originalTransaction.Description ||
               _transactionDate != _originalTransaction.Date ||
               (_selectedCategory?.Id != _originalTransaction.CategoryId && !_isTransfer && !_isCreditPayment) ||
               (_selectedAccountString != string.Empty ?
                   int.Parse(_selectedAccountString) : (int?)null) != _originalTransaction.AccountId;
    }

    private List<ChangeItem> GetChanges()
    {
        var changes = new List<ChangeItem>();

        if (_originalTransaction == null) return changes;

        if (_transaction.Name != _originalTransaction.Name)
            changes.Add(new("Name", _originalTransaction.Name, _transaction.Name));

        if (_transaction.Amount != _originalTransaction.Amount)
            changes.Add(new("Amount", _originalTransaction.Amount.ToString("C"), _transaction.Amount.ToString("C")));

        if (_transactionDate != _originalTransaction.Date)
            changes.Add(new("Date", _originalTransaction.Date.ToString("MMM dd, yyyy"), _transactionDate?.ToString("MMM dd, yyyy") ?? ""));

        if (_selectedCategory?.Id != _originalTransaction.CategoryId && !_isTransfer && !_isCreditPayment)
            changes.Add(new("Category", _originalTransaction.Category?.Name ?? "", _selectedCategory?.Name ?? ""));

        if (_transaction.Description != _originalTransaction.Description)
            changes.Add(new("Description",
                string.IsNullOrWhiteSpace(_originalTransaction.Description) ? "(empty)" : _originalTransaction.Description,
                string.IsNullOrWhiteSpace(_transaction.Description) ? "(empty)" : _transaction.Description));

        return changes;
    }

    private void ResetToOriginal()
    {
        if (_originalTransaction == null) return;

        _transaction.Name = _originalTransaction.Name;
        _transaction.Amount = _originalTransaction.Amount;
        _transaction.Description = _originalTransaction.Description;
        _transactionDate = _originalTransaction.Date;
        _selectedCategory = _filteredCategories?.FirstOrDefault(c => c.Id == _originalTransaction.CategoryId);

        if (_originalTransaction.AccountId.HasValue)
        {
            _selectedAccountString = _originalTransaction.AccountId.Value.ToString();
        }

        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && IsFormValid() && HasChanges())
        {
            await UpdateTransaction();
        }
        else if (e.CtrlKey && e.Key == "z")
        {
            ResetToOriginal();
        }
    }

    private async Task HandleCategoryKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && IsFormValid() && HasChanges())
        {
            await UpdateTransaction();
            return;
        }

        if (e.Key.Length == 1 && char.IsLetter(e.Key[0]) && _filteredCategories?.Any() == true)
        {
            var letter = e.Key.ToLower();
            var categoryStartingWithLetter = _filteredCategories
                .FirstOrDefault(c => c.Name.ToLower().StartsWith(letter));

            if (categoryStartingWithLetter != null)
            {
                _selectedCategory = categoryStartingWithLetter;
                StateHasChanged();
            }
        }
    }

    private bool IsFormValid()
    {
        if (_isTransfer || _isCreditPayment)
        {
            return _transaction.Amount > 0 &&
                   _transactionDate.HasValue &&
                   !string.IsNullOrWhiteSpace(_transaction.Name);
        }

        return !string.IsNullOrWhiteSpace(_transaction.Name) &&
               _transaction.Amount > 0 &&
               _transactionDate.HasValue &&
               _selectedCategory != null &&
               (_accounts?.Any() != true || !string.IsNullOrWhiteSpace(_selectedAccountString));
    }

    private async Task UpdateTransaction()
    {
        try
        {
            if (!IsFormValid() || !HasChanges()) return;

            if (_isTransfer)
            {
                await UpdateTransfer();
            }
            else if (_isCreditPayment)
            {
                await UpdateCreditPayment(); // ✨ NEW
            }
            else
            {
                await UpdateRegularTransaction();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error: " + ex.Message, Severity.Error);
        }
    }

    // ✨ NEW: Update Credit Payment
    private async Task UpdateCreditPayment()
    {
        _transaction.Date = _transactionDate!.Value;

        var result = await TransactionService.UpdateAsync(_transaction);
        if (result.Success)
        {
            Snackbar.Add("Credit card payment updated successfully", Severity.Success);
            await OnTransactionUpdated.InvokeAsync();

            if (_deleteAfterUpdate)
            {
                await DeleteTransaction();
            }
            else
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        else
        {
            Snackbar.Add(result.Message ?? "Error updating credit payment", Severity.Error);
        }
    }

    private async Task UpdateTransfer()
    {
        _transaction.Date = _transactionDate!.Value;

        // Update the main transaction
        var result = await TransactionService.UpdateAsync(_transaction);
        if (!result.Success)
        {
            Snackbar.Add(result.Message ?? "Error updating transfer", Severity.Error);
            return;
        }

        // Update the paired transaction if it exists
        if (_pairedTransaction != null)
        {
            _pairedTransaction.Amount = _transaction.Amount;
            _pairedTransaction.Date = _transaction.Date;
            _pairedTransaction.Description = _transaction.Description;

            var pairedResult = await TransactionService.UpdateAsync(_pairedTransaction);
            if (!pairedResult.Success)
            {
                Snackbar.Add("Transfer updated, but paired transaction update failed: " + pairedResult.Message, Severity.Warning);
            }
        }

        Snackbar.Add("Transfer updated successfully", Severity.Success);
        await OnTransactionUpdated.InvokeAsync();

        if (_deleteAfterUpdate)
        {
            await DeleteTransaction();
        }
        else
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private async Task UpdateRegularTransaction()
    {
        _transaction.Date = _transactionDate!.Value;
        _transaction.CategoryId = _selectedCategory!.Id;

        if (!string.IsNullOrWhiteSpace(_selectedAccountString) &&
            int.TryParse(_selectedAccountString, out int accountId))
        {
            _transaction.AccountId = accountId;
        }

        var result = await TransactionService.UpdateAsync(_transaction);
        if (result.Success)
        {
            Snackbar.Add("Transaction updated successfully", Severity.Success);
            await OnTransactionUpdated.InvokeAsync();

            if (_deleteAfterUpdate)
            {
                await DeleteTransaction();
            }
            else
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        else
        {
            Snackbar.Add(result.Message ?? "Error updating transaction", Severity.Error);
        }
    }

    private async Task DeleteTransaction()
    {
        try
        {
            if (_isTransfer && _pairedTransaction != null)
            {
                // Delete both transactions for transfers
                var mainResult = await TransactionService.DeleteAsync(TransactionId);
                var pairedResult = await TransactionService.DeleteAsync(_pairedTransaction.Id);

                if (mainResult.Success && pairedResult.Success)
                {
                    Snackbar.Add("Transfer deleted successfully", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Error deleting transfer completely", Severity.Error);
                }
            }
            else
            {
                var result = await TransactionService.DeleteAsync(TransactionId);
                if (result.Success)
                {
                    var message = _isCreditPayment ? "Credit card payment deleted successfully" : "Transaction deleted successfully";
                    Snackbar.Add(message, Severity.Success);
                }
                else
                {
                    Snackbar.Add(result.Message ?? "Error deleting transaction", Severity.Error);
                }
            }

            await OnTransactionUpdated.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error: " + ex.Message, Severity.Error);
        }
    }

    private async Task CreateCategory()
    {
        var parameters = new DialogParameters
            {
                ["OnCategoryUpdated"] = EventCallback.Factory.Create(this, LoadData)
            };

        await DialogService.ShowAsync<AddCategoryModal>("Create Category", parameters, _dialogOptions);
    }

    private void Cancel() => MudDialog.Cancel();

    // ✨ NEW: Credit Card Helper Methods
    private decimal GetAvailableCredit(AccountDto account)
    {
        if (account.Type != AccountType.Credit) return 0;
        return account.CreditLimit + account.CurrentBalance; // Balance será negativo
    }

    private decimal GetCreditCardDebt(AccountDto account)
    {
        if (account.Type != AccountType.Credit) return 0;
        return Math.Abs(account.CurrentBalance); // Mostrar como positivo
    }

    // Helper methods for UI
    private string GetModalTitle()
    {
        return _isCreditPayment ? "Edit Credit Card Payment" : _isTransfer ? "Edit Transfer" : "Edit Transaction";
    }

    private string GetModalSubtitle()
    {
        return _isCreditPayment ? "Update credit card payment details" : _isTransfer ? "Update transfer details between accounts" : "Update transaction details";
    }

    private string GetTransactionTypeDisplay()
    {
        if (_isCreditPayment) return "Credit Payment";
        if (_isTransfer) return "Transfer";
        return _originalTransaction?.Category?.Type.ToString() ?? "Unknown";
    }

    private string GetDeleteButtonText()
    {
        return _isCreditPayment ? "Delete Payment" : _isTransfer ? "Delete Transfer" : "Delete";
    }

    private string GetUpdateButtonText()
    {
        return _isCreditPayment ? "Update Payment" : _isTransfer ? "Update Transfer" : "Update Transaction";
    }

    private string GetTransactionIcon() => _isCreditPayment ? Icons.Material.Filled.CreditCard : _isTransfer ? Icons.Material.Filled.SwapHoriz : Icons.Material.Filled.Edit;

    private Color GetTransactionColor() => _isCreditPayment ? Color.Warning : _isTransfer ? Color.Info : (_originalTransaction?.Category?.Type == CategoryType.Income ? Color.Success : Color.Error);

    private string GetTransactionColorHex() => _isCreditPayment ? "#ff5722" : _isTransfer ? "#2196f3" : (_originalTransaction?.Category?.Type == CategoryType.Income ? "#4CAF50" : "#f44336");

    private string GetSelectedCategoryColor() => _selectedCategory?.Color ?? "#6366f1";
    private string GetSelectedCategoryIcon() => _selectedCategory?.Icon.ToIcon() ?? Icons.Material.Filled.Category;
    private string GetSelectedCategoryName() => _selectedCategory?.Name ?? "Select Category";

    private string GetSelectedAccountName()
    {
        if (!string.IsNullOrWhiteSpace(_selectedAccountString) && int.TryParse(_selectedAccountString, out int accountId))
        {
            var account = _accounts?.FirstOrDefault(a => a.Id == accountId);
            return account?.Name ?? "Select Account";
        }
        return "Select Account";
    }

    private string GetFromAccountName()
    {
        if (_originalTransaction?.Account != null)
        {
            return _originalTransaction.Account.Name;
        }
        return "Unknown Account";
    }

    private string GetToAccountName()
    {
        if (_pairedTransaction?.Account != null)
        {
            return _pairedTransaction.Account.Name;
        }
        return "Unknown Account";
    }

    private string GetPairedTransactionType()
    {
        return _pairedTransaction?.Category?.Name == "Transfer In" ? "Incoming" : "Outgoing";
    }

    private string GetFormattedDate() => _transactionDate?.ToString("MMM dd, yyyy") ?? "Select Date";

    private string GetAmountDisplay()
    {
        if (_transaction.Amount <= 0) return "$0.00";

        if (_isTransfer || _isCreditPayment)
        {
            return _transaction.Amount.ToString("C");
        }

        var sign = _originalTransaction?.Category?.Type == CategoryType.Income ? "+" : "-";
        return $"{sign}{_transaction.Amount:C}";
    }

    private string GetAmountColorClass() => _isCreditPayment ? "text-warning" : _isTransfer ? "text-info" : (_originalTransaction?.Category?.Type == CategoryType.Income ? "text-success" : "text-error");

    // Helper classes
    public record ChangeItem(string Field, string OldValue, string NewValue);
}