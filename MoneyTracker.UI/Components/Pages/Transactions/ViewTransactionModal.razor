            </div>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int TransactionId { get; set; }
    [Parameter] public EventCallback OnTransactionChanged { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private TransactionDto? _transaction;
    private TransactionDto? _pairedTransaction; // Para transferencias
    private AccountDto? _account;
    private AccountDto? _fromAccount; // Para transferencias
    private AccountDto? _toAccount; // Para transferencias
    private List<AccountDto>? _creditCardAccounts; // ✨ NEW: Para mostrar tarjetas de crédito relacionadas
    private List<TransactionDto>? _relatedTransactions;
    private CategoryStatsDto? _categoryStats;
    private bool _loading = true;
    private bool _isTransfer = false;
    private bool _isCreditPayment = false; // ✨ NEW

    private DialogOptions _dialogOptions = new()
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Large
        };

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactionDetails();
    }

    private async Task LoadTransactionDetails()
    {
        _loading = true;

        try
        {
            // Load main transaction
            var transactionResult = await TransactionService.GetByIdAsync(TransactionId);
            if (!transactionResult.Success || transactionResult.Data == null)
            {
                Snackbar.Add("Transaction not found", Severity.Error);
                return;
            }

            _transaction = transactionResult.Data;

            // Check transaction type
            _isTransfer = IsTransferTransaction(_transaction);
            _isCreditPayment = IsCreditPaymentTransaction(_transaction); // ✨ NEW

            if (_isCreditPayment)
            {
                await LoadCreditPaymentDetails(); // ✨ NEW
            }
            else if (_isTransfer)
            {
                await LoadTransferDetails();
            }
            else
            {
                await LoadRegularTransactionDetails();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading transaction details: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool IsTransferTransaction(TransactionDto transaction)
    {
        return transaction.Category?.Name == "Transfer Out" || transaction.Category?.Name == "Transfer In";
    }

    // ✨ NEW: Credit Payment Detection
    private bool IsCreditPaymentTransaction(TransactionDto transaction)
    {
        return transaction.Category?.Name == "Credit Card Payment" && transaction.Category?.Type == CategoryType.Expense;
    }

    // ✨ NEW: Load Credit Payment Details
    private async Task LoadCreditPaymentDetails()
    {
        // Load account for this payment (source account)
        if (_transaction!.AccountId.HasValue)
        {
            var accountResult = await AccountService.GetByIdAsync(_transaction.AccountId.Value);
            if (accountResult.Success)
            {
                _account = accountResult.Data;
            }
        }

        // Load all credit card accounts to show related info
        await LoadCreditCardAccounts();
    }

    // ✨ NEW: Load Credit Card Accounts
    private async Task LoadCreditCardAccounts()
    {
        try
        {
            var accountsResult = await AccountService.GetAllAsync();
            if (accountsResult.Success && accountsResult.Data != null)
            {
                _creditCardAccounts = accountsResult.Data
                    .Where(a => a.Type == AccountType.Credit)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            // Silently fail for credit card accounts
        }
    }

    private async Task LoadTransferDetails()
    {
        // Load account for this transaction
        if (_transaction!.AccountId.HasValue)
        {
            var accountResult = await AccountService.GetByIdAsync(_transaction.AccountId.Value);
            if (accountResult.Success)
            {
                _account = accountResult.Data;

                // Set FROM and TO accounts based on transaction type
                if (_transaction.Category?.Name == "Transfer Out")
                {
                    _fromAccount = _account;
                }
                else
                {
                    _toAccount = _account;
                }
            }
        }

        // Load paired transaction
        await LoadPairedTransaction();

        // Load account for paired transaction
        if (_pairedTransaction?.AccountId.HasValue == true)
        {
            var pairedAccountResult = await AccountService.GetByIdAsync(_pairedTransaction.AccountId.Value);
            if (pairedAccountResult.Success)
            {
                var pairedAccount = pairedAccountResult.Data;

                // Set the other account
                if (_transaction.Category?.Name == "Transfer Out")
                {
                    _toAccount = pairedAccount;
                }
                else
                {
                    _fromAccount = pairedAccount;
                }
            }
        }
    }

    private async Task LoadPairedTransaction()
    {
        try
        {
            // Find the matching transfer transaction
            var allTransactionsResult = await TransactionService.GetAllAsync();
            if (allTransactionsResult.Success && allTransactionsResult.Data != null)
            {
                var isOutgoing = _transaction!.Category!.Name == "Transfer Out";
                var targetCategoryName = isOutgoing ? "Transfer In" : "Transfer Out";

                _pairedTransaction = allTransactionsResult.Data
                    .FirstOrDefault(t =>
                        t.Id != _transaction.Id &&
                        t.Category?.Name == targetCategoryName &&
                        t.Amount == _transaction.Amount &&
                        t.Date.Date == _transaction.Date.Date &&
                        t.Description == _transaction.Description);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Warning: Could not load paired transaction: " + ex.Message, Severity.Warning);
        }
    }

    private async Task LoadRegularTransactionDetails()
    {
        // Load account details if transaction has an account
        if (_transaction!.AccountId.HasValue)
        {
            var accountResult = await AccountService.GetByIdAsync(_transaction.AccountId.Value);
            if (accountResult.Success)
            {
                _account = accountResult.Data;
            }
        }

        // Load related transactions (same category, similar timeframe)
        await LoadRelatedTransactions();

        // Load category statistics
        await LoadCategoryStats();
    }

    private async Task LoadRelatedTransactions()
    {
        if (_transaction?.CategoryId == null || _isTransfer || _isCreditPayment) return;

        try
        {
            var allTransactionsResult = await TransactionService.GetAllAsync();
            if (allTransactionsResult.Success && allTransactionsResult.Data != null)
            {
                var threeMonthsAgo = _transaction.Date.AddDays(-90);
                var threeMonthsLater = _transaction.Date.AddDays(90);

                _relatedTransactions = allTransactionsResult.Data
                    .Where(t => t.Id != _transaction.Id &&
                               t.CategoryId == _transaction.CategoryId &&
                               t.Date >= threeMonthsAgo && t.Date <= threeMonthsLater)
                    .OrderByDescending(t => t.Date)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            // Silently fail for related transactions
        }
    }

    private async Task LoadCategoryStats()
    {
        if (_transaction?.CategoryId == null || _isTransfer || _isCreditPayment) return;

        var result = await TransactionService.GetCategoryStatsAsync(_transaction.CategoryId.Value);
        if (result.Success && result.Data != null)
        {
            _categoryStats = result.Data;
        }
    }

    private async Task EditTransaction()
    {
        var parameters = new DialogParameters
            {
                ["TransactionId"] = TransactionId,
                ["OnTransactionUpdated"] = EventCallback.Factory.Create(this, OnTransactionUpdated)
            };

        await DialogService.ShowAsync<UpdateTransactionModal>("Edit Transaction", parameters, _dialogOptions);
    }

    private async Task DuplicateTransaction()
    {
        if (_transaction == null) return;

        if (_isCreditPayment)
        {
            // ✨ NEW: For credit payments, create a new credit payment
            var parameters = new DialogParameters
                {
                    ["TransactionType"] = TransactionType.CreditPayment,
                    ["OnTransactionAdded"] = EventCallback.Factory.Create(this, OnTransactionUpdated)
                };

            await DialogService.ShowAsync<AddTransactionModal>("Duplicate Credit Payment", parameters, _dialogOptions);
        }
        else if (_isTransfer)
        {
            // For transfers, create a new transfer with same amount and description
            var parameters = new DialogParameters
                {
                    ["TransactionType"] = TransactionType.Transfer,
                    ["OnTransactionAdded"] = EventCallback.Factory.Create(this, OnTransactionUpdated)
                };

            await DialogService.ShowAsync<AddTransactionModal>("Duplicate Transfer", parameters, _dialogOptions);
        }
        else
        {
            var duplicatedTransaction = new TransactionDto
                {
                    Name = $"Copy of {_transaction.Name}",
                    Amount = _transaction.Amount,
                    Description = _transaction.Description,
                    CategoryId = _transaction.CategoryId,
                    AccountId = _transaction.AccountId,
                    Date = DateTime.Today
                };

            var transactionType = _transaction.Category?.Type == CategoryType.Income ?
                TransactionType.Income : TransactionType.Expense;

            var parameters = new DialogParameters
                {
                    ["TransactionType"] = transactionType,
                    ["PrefilledTransaction"] = duplicatedTransaction,
                    ["OnTransactionAdded"] = EventCallback.Factory.Create(this, OnTransactionUpdated)
                };

            await DialogService.ShowAsync<AddTransactionModal>("Duplicate Transaction", parameters, _dialogOptions);
        }
    }

    private async Task ShareTransaction()
    {
        if (_transaction == null) return;

        string shareText;
        if (_isCreditPayment)
        {
            // ✨ NEW: Credit payment sharing
            shareText = $"Credit Card Payment: {_transaction.Amount:C}\n" +
                       $"Payment: {_transaction.Name}\n" +
                       $"From: {GetFromAccountName()}\n" +
                       $"Date: {_transaction.Date:MMM dd, yyyy}";
        }
        else if (_isTransfer)
        {
            shareText = $"Transfer: {_transaction.Amount:C}\n" +
                       $"From: {GetFromAccountName()}\n" +
                       $"To: {GetToAccountName()}\n" +
                       $"Date: {_transaction.Date:MMM dd, yyyy}";
        }
        else
        {
            shareText = $"Transaction: {_transaction.Name}\n" +
                       $"Amount: {GetAmountDisplay()}\n" +
                       $"Category: {_transaction.Category?.Name}\n" +
                       $"Date: {_transaction.Date:MMM dd, yyyy}";
        }

        if (!string.IsNullOrWhiteSpace(_transaction.Description))
        {
            shareText += $"\nNote: {_transaction.Description}";
        }

        // For web apps, copy to clipboard
        await CopyToClipboard(shareText);
        var itemType = _isCreditPayment ? "Credit payment" : _isTransfer ? "Transfer" : "Transaction";
        Snackbar.Add($"{itemType} details copied to clipboard", Severity.Success);
    }

    private async Task DeleteTransaction()
    {
        if (_transaction == null) return;

        var itemType = _isCreditPayment ? "credit payment" : _isTransfer ? "transfer" : "transaction";
        var itemName = _isCreditPayment ? _transaction.Name : _isTransfer ? $"{GetFromAccountName()} → {GetToAccountName()}" : _transaction.Name;

        bool confirmed = await DialogService.ShowConfirmDialogAsync(
               $"Delete {itemType}",
               $"Are you sure you want to delete this {itemType}? This action cannot be undone.",
               "Delete",
               Color.Error
               );

        if (confirmed)
        {
            try
            {
                if (_isTransfer && _pairedTransaction != null)
                {
                    // Delete both transactions for transfers
                    var mainResult = await TransactionService.DeleteAsync(TransactionId);
                    var pairedResult = await TransactionService.DeleteAsync(_pairedTransaction.Id);

                    if (mainResult.Success && pairedResult.Success)
                    {
                        Snackbar.Add("Transfer deleted successfully", Severity.Success);
                    }
                    else
                    {
                        Snackbar.Add("Error deleting transfer completely", Severity.Error);
                    }
                }
                else
                {
                    var deleteResult = await TransactionService.DeleteAsync(TransactionId);
                    if (deleteResult.Success)
                    {
                        var successMessage = _isCreditPayment ? "Credit payment deleted successfully" :
                                           _isTransfer ? "Transfer deleted successfully" :
                                           "Transaction deleted successfully";
                        Snackbar.Add(successMessage, Severity.Success);
                    }
                    else
                    {
                        Snackbar.Add(deleteResult.Message ?? $"Error deleting {itemType}", Severity.Error);
                    }
                }

                await OnTransactionChanged.InvokeAsync();
                MudDialog.Close();
            }
            catch (Exception ex)
            {
                Snackbar.Add("Error: " + ex.Message, Severity.Error);
            }
        }
    }

