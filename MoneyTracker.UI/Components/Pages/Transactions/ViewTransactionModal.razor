    private bool WasModified()
    {
        return _transaction?.UpdatedAt != null && _transaction.UpdatedAt != _transaction.CreatedAt;
    }

    private bool IsSimilarAmount(decimal amount)
    {
        if (_transaction == null) return false;
        var difference = Math.Abs(_transaction.Amount - amount);
        var threshold = Math.Max(_transaction.Amount * 0.1m, 10m); // 10% or $10, whichever is greater
        return difference <= threshold;
    }
