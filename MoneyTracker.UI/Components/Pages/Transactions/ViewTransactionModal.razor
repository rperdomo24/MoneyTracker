        return _isCreditPayment ? $"Payment: {_transaction.Amount:C}" :
               _isTransfer ? $"Transfer: {_transaction.Amount:C}" :
               _transaction.Name;
    }

    private string GetTransactionSubtitle()
    {
        if (_transaction == null) return "";
        return _isCreditPayment ? $"Credit Card Payment • {_transaction.Date:MMM dd, yyyy}" :
               _isTransfer ? $"{GetFromAccountName()} → {GetToAccountName()}" :
               $"{_transaction.Category?.Name} • {_transaction.Date:MMM dd, yyyy}";
    }

    private string GetTransactionIcon()
    {
        if (_transaction == null) return Icons.Material.Filled.Receipt;
        return _isCreditPayment ? Icons.Material.Filled.CreditCard :
               _isTransfer ? Icons.Material.Filled.SwapHoriz :
               (_transaction.Category?.Icon.ToIcon() ?? Icons.Material.Filled.Category);
    }

    private string GetTransactionColor()
    {
        if (_transaction == null) return "#6366f1";
        return _isCreditPayment ? "#ff5722" :
               _isTransfer ? "#2196f3" :
               (_transaction.Category?.Color ?? "#6366f1");
    }

    private Color GetTransactionMudColor()
    {
        if (_transaction == null) return Color.Default;
        return _isCreditPayment ? Color.Warning :
               _isTransfer ? Color.Info :
               (_transaction.Category?.Type == CategoryType.Income ? Color.Success : Color.Error);
    }

    private string GetTransactionTypeIcon()
    {
        if (_transaction == null) return Icons.Material.Filled.Receipt;
        return _isCreditPayment ? Icons.Material.Filled.CreditCard :
               _isTransfer ? Icons.Material.Filled.SwapHoriz :
               _transaction.Category?.Type.GetCategoryTypeIcon() ?? Icons.Material.Filled.Category;
    }

    private string GetTransactionTypeDisplay()
    {
        if (_transaction == null) return "Unknown";
        return _isCreditPayment ? "Credit Payment" :
               _isTransfer ? "Transfer" :
               _transaction.Category?.Type.ToString() ?? "Unknown";
    }

    private string GetAmountDisplay()
    {
        if (_transaction == null) return "$0.00";

        if (_isTransfer || _isCreditPayment)
        {
            return _transaction.Amount.ToString("C");
        }

        var sign = _transaction.Category?.Type == CategoryType.Income ? "+" : "-";
        return $"{sign}{_transaction.Amount:C}";
    }

    private string GetAmountColorClass()
    {
        if (_transaction == null) return "";
        return _isCreditPayment ? "text-warning" :
               _isTransfer ? "text-info" :
               (_transaction.Category?.Type == CategoryType.Income ? "text-success" : "text-error");
    }

    private string GetRelatedAmountDisplay(TransactionDto related)
    {
