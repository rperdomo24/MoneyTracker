@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums
@using MoneyTracker.UI.Helpers
@using MoneyTracker.Application.Common.Extensions
@inject ITransactionService TransactionService
@inject ICategoryService CategoryService
@inject IAccountService AccountService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center justify-space-between">
            <div class="d-flex align-center">
                <MudAvatar Size="Size.Medium"
                           Style="@($"background-color: {GetTransactionColor()}; margin-right: 12px;")">
                    <MudIcon Icon="@GetTransactionIcon()"
                             Color="Color.Surface" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">
                        @GetTransactionTitle()
                    </MudText>
                    <MudText Typo="Typo.body2" Class="text-muted">
                        @GetTransactionSubtitle()
                    </MudText>
                </div>
            </div>
            <div class="d-flex align-center ga-2">
                @if (_transaction != null)
                {
                    <MudChip T="string" Size="Size.Small"
                             Color="@GetTransactionMudColor()"
                             Variant="Variant.Text"
                             Icon="@GetTransactionTypeIcon()">
                        @GetTransactionTypeDisplay()
                    </MudChip>
                    <MudText Typo="Typo.h5" Class="@GetAmountColorClass()">
                        @GetAmountDisplay()
                    </MudText>
                }
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-0">
            @if (_loading)
            {
                <div class="text-center pa-6">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText Class="mt-3">Loading transaction details...</MudText>
                </div>
            }
            else if (_transaction == null)
            {
                <div class="text-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Class="text-error mb-3" />
                    <MudText Typo="Typo.h6" Class="mb-2">Transaction Not Found</MudText>
                    <MudText Class="text-muted">The transaction you're looking for doesn't exist or has been deleted.</MudText>
                </div>
            }
            else if (_isCreditPayment)
            {
                @* ========== CREDIT PAYMENT VIEW UI ========== *@
                <MudGrid>
                    <!-- LEFT COLUMN - CREDIT PAYMENT DETAILS -->
                    <MudItem xs="12" md="8">
                        <MudStack Spacing="4">
                            <!-- Credit Payment Overview Card -->
                            <MudPaper Class="pa-4" Elevation="2" Style="border-left: 6px solid #ff5722;">
                                <MudGrid>
                                    <MudItem xs="12">
                                        <div class="text-center mb-4">
                                            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Large" Color="Color.Warning" />
                                            <MudText Typo="Typo.h4" Class="font-weight-bold mt-2">
                                                Credit Card Payment
                                            </MudText>
                                            <MudText Typo="Typo.h3" Class="font-weight-bold text-warning mt-1">
                                                @_transaction.Amount.ToString("C")
                                            </MudText>
                                            <MudText Typo="Typo.body1" Class="text-muted mt-2">
                                                @_transaction.Date.ToString("MMMM dd, yyyy")
                                            </MudText>
                                        </div>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>

                            <!-- Payment Details -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Payment" Class="mr-2" Size="Size.Small" />
                                    Payment Details
                                </MudText>

                                <!-- Payment Transaction -->
                                <MudPaper Class="pa-3 mb-3" Elevation="2" Style="border-left: 4px solid #ff5722;">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Payment" Color="Color.Warning" Class="mr-3" Size="Size.Medium" />
                                            <div>
                                                <MudText Typo="Typo.subtitle1" Class="font-weight-medium">Payment Transaction</MudText>
                                                <MudText Typo="Typo.h6" Class="font-weight-bold">
                                                    @_transaction.Name
                                                </MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                    @GetFromAccountName() → Credit Card Payment
                                                </MudText>
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <MudText Typo="Typo.h5" Class="font-weight-bold text-warning">
                                                @_transaction.Amount.ToString("C")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                Payment Amount
                                            </MudText>
                                        </div>
                                    </div>
                                </MudPaper>

                                <!-- Payment Source Account -->
                                @if (_account != null)
                                {
                                    <MudPaper Class="pa-3 mb-3" Elevation="1" Style="border-left: 4px solid #2196f3;">
                                        <div class="d-flex align-center justify-space-between">
                                            <div class="d-flex align-center">
                                                <MudIcon Icon="@_account.Icon.ToIcon()"
                                                         Style="@($"color: {_account.Color};")"
                                                         Class="mr-3" Size="Size.Medium" />
                                                <div>
                                                    <MudText Typo="Typo.subtitle1" Class="font-weight-medium">Paid From</MudText>
                                                    <MudText Typo="Typo.h6" Class="font-weight-bold">
                                                        @_account.Name
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Class="text-muted">
                                                        @_account.Type.ToLabel()
                                                    </MudText>
                                                </div>
                                            </div>
                                            <div class="text-right">
                                                <MudText Typo="Typo.body2" Class="font-weight-medium">Current Balance</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">
                                                    @_account.CurrentBalance.ToString("C")
                                                </MudText>
                                            </div>
                                        </div>
                                    </MudPaper>
                                }

                                <!-- Credit Card Information (if available) -->
                                @if (_creditCardAccounts?.Any() == true)
                                {
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-medium">
                                            Related Credit Cards
                                        </MudText>
                                        @foreach (var creditCard in _creditCardAccounts.Take(3))
                                        {
                                            <MudPaper Class="pa-3 mb-2" Elevation="1" Style="border-left: 4px solid #ff5722;">
                                                <MudGrid>
                                                    <MudItem xs="8">
                                                        <div class="d-flex align-center">
                                                            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Color="Color.Warning" Class="mr-2" />
                                                            <div>
                                                                <MudText Typo="Typo.body1" Class="font-weight-medium">@creditCard.Name</MudText>
                                                                <MudText Typo="Typo.caption" Class="text-muted">Credit Card</MudText>
                                                            </div>
                                                        </div>
                                                    </MudItem>
                                                    <MudItem xs="4" Class="text-right">
                                                        <MudText Typo="Typo.caption" Class="text-muted">Current Debt</MudText>
                                                        <MudText Typo="Typo.body2" Class="font-weight-medium text-error">
                                                            @GetCreditCardDebt(creditCard).ToString("C")
                                                        </MudText>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Payment Description -->
                            @if (!string.IsNullOrWhiteSpace(_transaction.Description))
                            {
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" Size="Size.Small" />
                                        Payment Note
                                    </MudText>
                                    <MudPaper Class="pa-3" Elevation="1">
                                        <MudText Typo="Typo.body1">
                                            @_transaction.Description
                                        </MudText>
                                    </MudPaper>
                                </div>
                            }

                            <!-- Payment Category Info -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Category" Class="mr-2" Size="Size.Small" />
                                    Payment Category
                                </MudText>
                                <MudPaper Class="pa-3" Elevation="1">
                                    <div class="d-flex align-center">
                                        <MudAvatar Size="Size.Medium"
                                                   Style="@($"background-color: #ff5722; margin-right: 12px;")">
                                            <MudIcon Icon="@Icons.Material.Filled.CreditCard"
                                                     Color="Color.Surface" />
                                        </MudAvatar>
                                        <div>
                                            <MudText Typo="Typo.subtitle1" Class="font-weight-medium">
                                                Credit Card Payment
                                            </MudText>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">
                                                Expense
                                            </MudChip>
                                        </div>
                                    </div>
                                </MudPaper>
                            </div>
                        </MudStack>
                    </MudItem>

                    <!-- RIGHT COLUMN - PAYMENT ACTIONS & METADATA -->
                    <MudItem xs="12" md="4">
                        <MudStack Spacing="4">
                            <!-- Payment Actions -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Speed" Class="mr-2" Size="Size.Small" />
                                    Actions
                                </MudText>

                                <MudStack Spacing="2">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Edit"
                                               FullWidth="true"
                                               OnClick="EditTransaction">
                                        Edit Payment
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.ContentCopy"
                                               FullWidth="true"
                                               OnClick="DuplicateTransaction">
                                        Duplicate Payment
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Info"
                                               StartIcon="@Icons.Material.Filled.Share"
                                               FullWidth="true"
                                               OnClick="ShareTransaction">
                                        Share Payment
                                    </MudButton>

                                    <MudDivider Class="my-2" />

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.Delete"
                                               FullWidth="true"
                                               OnClick="DeleteTransaction">
                                        Delete Payment
                                    </MudButton>
                                </MudStack>
                            </div>

                            <!-- Payment Metadata -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Size="Size.Small" />
                                    Payment Info
                                </MudText>

                                <MudList T="string" Dense="true">
                                    <MudListItem Icon="@Icons.Material.Filled.CreditCard">
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-medium">Type</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">Credit Card Payment</MudText>
                                        </div>
                                    </MudListItem>

                                    <MudListItem Icon="@Icons.Material.Filled.Fingerprint">
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-medium">Transaction ID</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">@TransactionId.ToString()</MudText>
                                        </div>
                                    </MudListItem>

                                    <MudListItem Icon="@Icons.Material.Filled.DateRange">
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-medium">Payment Date</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                @_transaction.Date.ToString("MMM dd, yyyy 'at' h:mm tt")
                                            </MudText>
                                        </div>
                                    </MudListItem>

                                    <MudListItem Icon="@Icons.Material.Filled.AccountBalance">
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-medium">Paid From</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">@GetFromAccountName()</MudText>
                                        </div>
                                    </MudListItem>

                                    <MudListItem Icon="@Icons.Material.Filled.Add">
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-medium">Created</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                @_transaction.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                                            </MudText>
                                        </div>
                                    </MudListItem>
                                </MudList>
                            </div>

                            <!-- Payment Timeline -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="mr-2" Size="Size.Small" />
                                    Timeline
                                </MudText>

                                <MudTimeline>
                                    <MudTimelineItem Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                                        <MudText Typo="Typo.body2" Class="font-weight-medium">Payment Created</MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">
                                            @_transaction.CreatedAt.ToString("MMM dd, yyyy"), @_transaction.CreatedAt.ToString("h:mm tt")
                                        </MudText>
                                    </MudTimelineItem>

                                    @if (WasModified())
                                    {
                                        <MudTimelineItem Color="Color.Info" Variant="Variant.Filled" Size="Size.Small">
                                            <MudText Typo="Typo.body2" Class="font-weight-medium">Last Modified</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                @_transaction.UpdatedAt.ToString("MMM dd, yyyy"), @_transaction.UpdatedAt.ToString("h:mm tt")
                                            </MudText>
                                        </MudTimelineItem>
                                    }

                                    <MudTimelineItem Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                                        <MudText Typo="Typo.body2" Class="font-weight-medium">Viewing Now</MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">
                                            @DateTime.Now.ToString("MMM dd, yyyy"), @DateTime.Now.ToString("h:mm tt")
                                        </MudText>
                                    </MudTimelineItem>
                                </MudTimeline>
                            </div>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            }
            else if (_isTransfer)
            {
                @* ========== TRANSFER VIEW UI ========== *@
                <MudGrid>
                    <!-- LEFT COLUMN - TRANSFER DETAILS -->
                    <MudItem xs="12" md="8">
                        <MudStack Spacing="4">
                            <!-- Transfer Overview Card -->
                            <MudPaper Class="pa-4" Elevation="2" Style="border-left: 6px solid #2196f3;">
                                <MudGrid>
                                    <MudItem xs="12">
                                        <div class="text-center mb-4">
                                            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Large" Color="Color.Info" />
                                            <MudText Typo="Typo.h4" Class="font-weight-bold mt-2">
                                                Account Transfer
                                            </MudText>
                                            <MudText Typo="Typo.h3" Class="font-weight-bold text-info mt-1">
                                                @_transaction.Amount.ToString("C")
                                            </MudText>
                                            <MudText Typo="Typo.body1" Class="text-muted mt-2">
                                                @_transaction.Date.ToString("MMMM dd, yyyy")
                                            </MudText>
                                        </div>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>

                            <!-- Transfer Flow -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="mr-2" Size="Size.Small" />
                                    Transfer Flow
                                </MudText>

                                <!-- FROM Account -->
                                <MudPaper Class="pa-3 mb-3" Elevation="2" Style="border-left: 4px solid #f44336;">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.CallMade" Color="Color.Error" Class="mr-3" Size="Size.Medium" />
                                            <div>
                                                <MudText Typo="Typo.subtitle1" Class="font-weight-medium">From Account</MudText>
                                                <MudText Typo="Typo.h6" Class="font-weight-bold">
                                                    @GetFromAccountName()
                                                </MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                    @GetFromAccountType() Account
                                                </MudText>
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <MudText Typo="Typo.h5" Class="font-weight-bold text-error">
                                                -@_transaction.Amount.ToString("C")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                Outgoing
                                            </MudText>
                                        </div>
                                    </div>
                                </MudPaper>

                                <!-- Transfer Arrow -->
                                <div class="text-center my-3">
                                    <MudIcon Icon="@Icons.Material.Filled.SwapVert" Color="Color.Info" Size="Size.Large" />
                                    <MudText Typo="Typo.body2" Class="text-muted">Transfer</MudText>
                                </div>

                                <!-- TO Account -->
                                <MudPaper Class="pa-3 mb-3" Elevation="2" Style="border-left: 4px solid #4caf50;">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.CallReceived" Color="Color.Success" Class="mr-3" Size="Size.Medium" />
                                            <div>
                                                <MudText Typo="Typo.subtitle1" Class="font-weight-medium">To Account</MudText>
                                                <MudText Typo="Typo.h6" Class="font-weight-bold">
                                                    @GetToAccountName()
                                                </MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                    @GetToAccountType() Account
                                                </MudText>
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <MudText Typo="Typo.h5" Class="font-weight-bold text-success">
                                                +@_transaction.Amount.ToString("C")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                Incoming
                                            </MudText>
                                        </div>
                                    </div>
                                </MudPaper>
                            </div>

                            <!-- Transfer Description -->
                            @if (!string.IsNullOrWhiteSpace(_transaction.Description))
                            {
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" Size="Size.Small" />
                                        Transfer Note
                                    </MudText>
                                    <MudPaper Class="pa-3" Elevation="1">
                                        <MudText Typo="Typo.body1">
                                            @_transaction.Description
                                        </MudText>
                                    </MudPaper>
                                </div>
                            }

                            <!-- Paired Transaction Info -->
                            @if (_pairedTransaction != null)
                            {
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.Link" Class="mr-2" Size="Size.Small" />
                                        Linked Transaction
                                    </MudText>
                                    <MudPaper Class="pa-3" Elevation="1">
                                        <div class="d-flex align-center justify-space-between">
                                            <div>
                                                <MudText Typo="Typo.body1" Class="font-weight-medium">
                                                    @_pairedTransaction.Name
                                                </MudText>
                                                <MudText Typo="Typo.body2" Class="text-muted">
                                                    ID: @_pairedTransaction.Id • @GetPairedTransactionType()
                                                </MudText>
                                            </div>
                                            <MudButton Size="Size.Small"
                                                       Variant="Variant.Text"
                                                       OnClick="@(() => ViewTransaction(_pairedTransaction.Id))">
                                                View Details
                                            </MudButton>
                                        </div>
                                    </MudPaper>
                                </div>
                            }
                        </MudStack>
                    </MudItem>

                    <!-- RIGHT COLUMN - TRANSFER ACTIONS & METADATA -->
                    <MudItem xs="12" md="4">
                        <MudStack Spacing="4">
                            <!-- Transfer Actions -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Speed" Class="mr-2" Size="Size.Small" />
                                    Actions
                                </MudText>

                                <MudStack Spacing="2">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Edit"
                                               FullWidth="true"
                                               OnClick="EditTransaction">
                                        Edit Transfer
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.ContentCopy"
                                               FullWidth="true"
                                               OnClick="DuplicateTransaction">
                                        Duplicate Transfer
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Info"
                                               StartIcon="@Icons.Material.Filled.Share"
                                               FullWidth="true"
                                               OnClick="ShareTransaction">
                                        Share Transfer
                                    </MudButton>

                                    <MudDivider Class="my-2" />

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.Delete"
                                               FullWidth="true"
                                               OnClick="DeleteTransaction">
                                        Delete Transfer
                                    </MudButton>
                                </MudStack>
                            </div>

                            <!-- Transfer Metadata -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Size="Size.Small" />
                                    Transfer Info
                                </MudText>

                                <MudList T="string" Dense="true">
                                    <MudListItem Icon="@Icons.Material.Filled.SwapHoriz">
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-medium">Type</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">Account Transfer</MudText>
                                        </div>
                                    </MudListItem>

                                    <MudListItem Icon="@Icons.Material.Filled.Fingerprint">
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-medium">Transaction ID</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">@TransactionId.ToString()</MudText>
                                        </div>
                                    </MudListItem>

                                    @if (_pairedTransaction != null)
                                    {
                                        <MudListItem Icon="@Icons.Material.Filled.Link">
                                            <div>
                                                <MudText Typo="Typo.body2" Class="font-weight-medium">Paired ID</MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">@_pairedTransaction.Id.ToString()</MudText>
                                            </div>
                                        </MudListItem>
                                    }

                                    <MudListItem Icon="@Icons.Material.Filled.DateRange">
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-medium">Date</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                @_transaction.Date.ToString("MMM dd, yyyy 'at' h:mm tt")
                                            </MudText>
                                        </div>
                                    </MudListItem>

                                    <MudListItem Icon="@Icons.Material.Filled.Add">
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-medium">Created</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                @_transaction.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                                            </MudText>
                                        </div>
                                    </MudListItem>
                                </MudList>
                            </div>

                            <!-- Transfer Timeline -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="mr-2" Size="Size.Small" />
                                    Timeline
                                </MudText>

                                <MudTimeline>
                                    <MudTimelineItem Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
