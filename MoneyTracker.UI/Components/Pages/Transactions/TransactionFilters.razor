@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums
@using MoneyTracker.Domain.Enums.Account
@using MoneyTracker.Domain.Enums.Category
@using MoneyTracker.Domain.Enums.Filters
@using MoneyTracker.UI.Helpers
@inject ICategoryService CategoryService
@inject ISnackbar Snackbar
@inject IAccountService AccountService

<MudDrawer @bind-Open="@IsOpen"
           Anchor="Anchor.End"
           Elevation="2"
           Variant="@DrawerVariant.Temporary"
           Width="500px"
           OverlayAutoClose="false">

    <MudDrawerHeader>
        <div class="d-flex justify-space-between align-center" style="width: 100%;">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Class="mr-2" />
                Filters
            </MudText>

            <MudIconButton Icon="@Icons.Material.Filled.Clear"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           OnClick="ClearAllFilters"
                           Disabled="@(_activeFilterCount == 0)"
                           Title="Clear All Filters" />
        </div>
    </MudDrawerHeader>

    <MudDrawerContainer Class="pa-4">
        <MudGrid>
            <!-- Time Period Filter -->
            <MudItem xs="12" md="12">
                <MudSelect T="TimePeriodFilter"
                           Label="Time Period"
                           @bind-Value="_tempFilter.TimePeriod"
                           @bind-Value:after="OnTimePeriodChanged"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="TimePeriodFilter.LastMonth">Last Month</MudSelectItem>
                    <MudSelectItem Value="TimePeriodFilter.ThisMonth">This Month</MudSelectItem>
                    <MudSelectItem Value="TimePeriodFilter.ThisYear">This Year</MudSelectItem>
                    <MudSelectItem Value="TimePeriodFilter.Custom">Custom Range</MudSelectItem>
                </MudSelect>
            </MudItem>

            <!-- Custom Date Range -->
            @if (_tempFilter.TimePeriod == TimePeriodFilter.Custom)
            {
                <MudItem xs="12" md="6">
                    <MudDatePicker Label="Start Date"
                                   @bind-Date="_tempFilter.FromDate"
                                   Variant="Variant.Outlined"
                                   MaxDate="_tempFilter.ToDate ?? DateTime.Today" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker Label="End Date"
                                   @bind-Date="_tempFilter.ToDate"
                                   Variant="Variant.Outlined"
                                   MinDate="_tempFilter.FromDate"
                                   MaxDate="DateTime.Today" />
                </MudItem>
            }

            <!-- Type Filter (siempre visible) -->
            <MudItem xs="12" md="12">
                <MudSelect T="string"
                           Label="Type"
                           @bind-Value="_selectedTypeString"
                           @bind-Value:after="OnTypeChanged"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    <MudSelectItem Value="@("Income")">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@CategoryTypeEnum.Income.GetIcon()"
                                     Color="@CategoryTypeEnum.Income.GetColor()"
                                     Class="mr-2" Size="Size.Small" />
                            Income
                        </div>
                    </MudSelectItem>
                    <MudSelectItem Value="@("Expense")">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@CategoryTypeEnum.Expense.GetIcon()"
                                     Color="@CategoryTypeEnum.Expense.GetColor()"
                                     Class="mr-2" Size="Size.Small" />
                            Expense
                        </div>
                    </MudSelectItem>
                </MudSelect>
            </MudItem>

            <!-- Category Filter (filtrado por Type) -->
            <MudItem xs="12" md="12">
                <MudSelect T="string"
                           Label="Category"
                           @bind-Value="_selectedCategoryString"
                           @bind-Value:after="OnCategoryChanged"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Disabled="@(GetFilteredCategories()?.Any() != true)">
                    @if (GetFilteredCategories()?.Any() == true)
                    {
                        @foreach (var category in GetFilteredCategories())
                        {
                            <MudSelectItem Value="@category.Id.ToString()">
                                <div class="d-flex align-center">
                                    <MudAvatar Size="Size.Small"
                                               Style="@($"background-color: {category.Color}; margin-right: 8px;")">
                                        <MudIcon Icon="@category.Icon.ToIcon()"
                                                 Color="Color.Surface"
                                                 Size="Size.Small" />
                                    </MudAvatar>
                                    @category.Name
                                    <MudSpacer />
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(category.Type == CategoryTypeEnum.Income ? Color.Success : Color.Error)"
                                             Variant="Variant.Text">
                                        @category.Type
                                    </MudChip>
                                </div>
                            </MudSelectItem>
                        }
                    }
                    else
                    {
                        <MudText Class="pa-4 text-center text-muted">
                            @if (_loadingCategories)
                            {
                                <span>Loading categories...</span>
                            }
                            else if (_tempFilter.Type.HasValue)
                            {
                                <span>No @_tempFilter.Type.Value categories available</span>
                            }
                            else
                            {
                                <span>Select a Type first</span>
                            }
                        </MudText>
                    }
                </MudSelect>
            </MudItem>

            @if (_orderedAccounts?.Any() == true)
            {
                <MudItem xs="12" md="12">
                    <MudSelect T="int"
                               Label="Accounts"
                               MultiSelection="true"
                               @bind-SelectedValues="SelectedAccountIds"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               MultiSelectionTextFunc="@GetSelectedAccountsText"
                               MaxHeight="400">

                        @{
                            AccountType? currentType = null;
                        }

                        @foreach (var account in _orderedAccounts)
                        {
                            @if (currentType != account.Type)
                            {
                                currentType = account.Type;

                                <MudSelectItem Value="-1" Disabled="true">
                                    <div class="py-2 px-1" style="background-color: var(--mud-palette-action-hover); border-left: 3px solid var(--mud-palette-primary); margin: 4px -12px;">
                                        <MudText Typo="Typo.subtitle2" Class="text-primary font-weight-bold d-flex align-center">
                                            <MudIcon Icon="@account.Type.ToIcon()"
                                                     Size="Size.Small"
                                                     Class="mr-2" />
                                            @account.Type.ToLabel()
                                        </MudText>
                                    </div>
                                </MudSelectItem>
                            }

                            <MudSelectItem Value="account.Id">
                                <div class="d-flex align-center py-2 px-1">
                                    <MudAvatar Size="Size.Small"
                                               Style="@($"background-color: {(string.IsNullOrEmpty(account.Color) ? "#757575" : account.Color)}; margin-right: 12px; flex-shrink: 0;")">
                                        <MudIcon Icon="@account.Type.ToIcon()"
                                                 Color="Color.Surface"
                                                 Size="Size.Small" />
                                    </MudAvatar>

                                    <div class="flex-grow-1 min-width-0">
                                        <MudText Typo="Typo.body2" Class="font-weight-medium">
                                            @account.Name
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">
                                            @account.Type.ToLabel()
                                        </MudText>
                                    </div>

                                    <MudText Typo="Typo.body2"
                                             Class="@($"{GetBalanceColorClass(account.CurrentBalance)} ml-2 font-weight-medium")"
                                             Style="flex-shrink: 0;">
                                        @FormatCurrency(account.CurrentBalance)
                                    </MudText>
                                </div>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }

            <!-- Search Field -->
            <MudItem xs="12" md="12">
                <MudTextField T="string"
                              Label="Search"
                              @bind-Value="_tempFilter.SearchText"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Placeholder="Search by name or description..."
                              Clearable="true"
                              DebounceInterval="500" />
            </MudItem>
        </MudGrid>

        <!-- Debug Info - Solo en desarrollo -->
        @if (_showDebugInfo && System.Diagnostics.Debugger.IsAttached)
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">
                <div>
                    <strong>Debug Info:</strong><br />
                    Categories loaded: @(_categories?.Count ?? 0)<br />
                    Accounts loaded: @(_activeAccounts?.Count ?? 0)<br />
                    Ordered accounts: @(_orderedAccounts?.Count ?? 0)<br />
                    Loading: @_loadingCategories<br />
                    Error: @_loadError
                </div>
            </MudAlert>
        }
    </MudDrawerContainer>

    <!-- Apply Filters Button -->
    <div class="pa-4 d-flex ga-2" style="border-top: 1px solid var(--mud-palette-divider); background-color: var(--mud-palette-background);">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Close"
                   OnClick="CancelAndClose">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Check"
                   OnClick="ApplyAndClose">
            Apply Filters
        </MudButton>
    </div>

</MudDrawer>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public TransactionFilterDto Filter { get; set; } = new();
    [Parameter] public EventCallback<TransactionFilterDto> OnFilterChanged { get; set; }
    [Parameter] public EventCallback OnFiltersApplied { get; set; }
    [Parameter] public EventCallback OnFiltersInitialized { get; set; }

    // ✅ Filtro temporal - todos los cambios se hacen aquí
    private TransactionFilterDto _tempFilter = new();

    private List<CategoryDto>? _categories;
    private List<AccountDto>? _activeAccounts;
    private List<AccountDto>? _orderedAccounts;
    private int _activeFilterCount = 0;
    private bool _loadingCategories = true;
    private string _loadError = string.Empty;
    private bool _showDebugInfo = false;

    private string _selectedCategoryString = string.Empty;
    private string _selectedTypeString = string.Empty;

    // ✅ Accounts usa _tempFilter
    private IEnumerable<int> SelectedAccountIds
    {
        get => _tempFilter.AccountIds ?? Enumerable.Empty<int>();
        set
        {
            _tempFilter.AccountIds = value?.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterOptions();
        CalculateActiveFilterCount();
        await OnFiltersInitialized.InvokeAsync();
    }

    // ✅ Cuando se abre el drawer, copiar filtros actuales a temp
    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            _tempFilter = new TransactionFilterDto
            {
                TimePeriod = Filter.TimePeriod,
                FromDate = Filter.FromDate,
                ToDate = Filter.ToDate,
                AccountIds = Filter.AccountIds?.ToList(),
                SearchText = Filter.SearchText,
                CategoryId = Filter.CategoryId,
                Type = Filter.Type
            };

            _selectedCategoryString = Filter.CategoryId?.ToString() ?? string.Empty;
            _selectedTypeString = Filter.Type?.ToString() ?? string.Empty;

            CalculateActiveFilterCount();
        }
    }

    private async Task LoadFilterOptions()
    {
        _loadingCategories = true;
        _loadError = string.Empty;

        try
        {
            if (CategoryService == null)
            {
                _loadError = "CategoryService is null - DI problem";
                return;
            }

            _loadError = "Loading categories...";
            var categoriesResult = await CategoryService.GetAllAsync();

            if (categoriesResult.Success)
            {
                var allCategories = categoriesResult.Data?.ToList() ?? new List<CategoryDto>();
                _categories = allCategories.ToList();

                if (_categories.Count == 0)
                {
                    _loadError = "No categories found in database";
                }
                else
                {
                    _loadError = string.Empty;
                }
            }
            else
            {
                _categories = new List<CategoryDto>();
                _loadError = $"Service error: {categoriesResult.Message ?? "Unknown error"}";
                Snackbar.Add($"Error loading categories: {categoriesResult.Message}", Severity.Warning);
            }

            _loadError = "Loading accounts...";
            StateHasChanged();

            var accountsResult = await AccountService.GetAccountsWithBalancesAsync();
            if (accountsResult.Success)
            {
                _activeAccounts = accountsResult.Data?.ToList() ?? new List<AccountDto>();

                _orderedAccounts = _activeAccounts
                    .OrderBy(a => (int)a.Type)
                    .ThenBy(a => a.Name)
                    .ToList();

                _loadError = string.Empty;
            }
            else
            {
                _activeAccounts = new List<AccountDto>();
                _orderedAccounts = new List<AccountDto>();
                _loadError = $"Error loading accounts: {accountsResult.Message}";
                Snackbar.Add($"Error loading accounts: {accountsResult.Message}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            _categories = new List<CategoryDto>();
            _activeAccounts = new List<AccountDto>();
            _orderedAccounts = new List<AccountDto>();
            _loadError = $"Exception: {ex.Message}";
            Snackbar.Add($"Error loading filter options: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingCategories = false;
            StateHasChanged();
        }
    }

    // ✅ Filtrado reactivo usa _tempFilter
    private IEnumerable<CategoryDto> GetFilteredCategories()
    {
        if (_categories == null || !_categories.Any())
            return Enumerable.Empty<CategoryDto>();

        var filtered = _categories.AsEnumerable();

        if (_tempFilter.Type.HasValue)
        {
            filtered = filtered.Where(c => c.Type == _tempFilter.Type.Value);
        }

        return filtered.OrderBy(c => c.Name);
    }

    private string GetSelectedAccountsText(List<string> selectedValues)
    {
        if (!selectedValues?.Any() == true || _activeAccounts?.Any() != true)
            return "Select accounts...";

        var selectedIds = selectedValues.Where(x => int.TryParse(x, out _))
                                       .Select(x => int.Parse(x))
                                       .ToList();

        if (!selectedIds.Any())
            return "Select accounts...";

        var selectedAccounts = _activeAccounts.Where(a => selectedIds.Contains(a.Id)).ToList();

        if (!selectedAccounts.Any())
            return "Select accounts...";

        if (selectedAccounts.Count == 1)
        {
            var account = selectedAccounts.First();
            return $"{account.Name} ({FormatCurrency(account.CurrentBalance)})";
        }

        if (selectedAccounts.Count <= 2)
        {
            return string.Join(", ", selectedAccounts.Select(a => a.Name));
        }

        var totalBalance = selectedAccounts.Sum(a => a.CurrentBalance);
        return $"{selectedAccounts.Count} accounts ({FormatCurrency(totalBalance)})";
    }

    private string FormatCurrency(decimal amount)
    {
        return amount < 0 ? $"-${Math.Abs(amount):N2}" : $"${amount:N2}";
    }

    private string GetBalanceColorClass(decimal balance)
    {
        return balance switch
        {
            > 0 => "text-success",
            < 0 => "text-error",
            _ => "text-muted"
        };
    }

    // ✅ Todos los métodos de cambio usan _tempFilter
    private async Task OnTimePeriodChanged()
    {
        if (_tempFilter.TimePeriod != TimePeriodFilter.Custom)
        {
            _tempFilter.FromDate = null;
            _tempFilter.ToDate = null;
        }
        CalculateActiveFilterCount();
    }

    private async Task OnCategoryChanged()
    {
        if (!string.IsNullOrWhiteSpace(_selectedCategoryString) && int.TryParse(_selectedCategoryString, out int categoryId))
        {
            _tempFilter.CategoryId = categoryId;
        }
        else
        {
            _tempFilter.CategoryId = null;
        }
        CalculateActiveFilterCount();
    }

    private async Task OnTypeChanged()
    {
        if (!string.IsNullOrWhiteSpace(_selectedTypeString))
        {
            _tempFilter.Type = _selectedTypeString == "Income" ? CategoryTypeEnum.Income : CategoryTypeEnum.Expense;
        }
        else
        {
            _tempFilter.Type = null;
        }

        // Limpiar categoría si ya no es válida
        if (_tempFilter.CategoryId.HasValue && _tempFilter.Type.HasValue)
        {
            var selectedCategory = _categories?.FirstOrDefault(c => c.Id == _tempFilter.CategoryId.Value);
            if (selectedCategory != null && selectedCategory.Type != _tempFilter.Type.Value)
            {
                _tempFilter.CategoryId = null;
                _selectedCategoryString = string.Empty;
            }
        }

        CalculateActiveFilterCount();
    }

    // ✅ CalculateActiveFilterCount usa _tempFilter
    private void CalculateActiveFilterCount()
    {
        _activeFilterCount = 0;

        if (_tempFilter.TimePeriod != TimePeriodFilter.ThisMonth) _activeFilterCount++;
        if (_tempFilter.AccountIds?.Any() == true) _activeFilterCount++;
        if (!string.IsNullOrWhiteSpace(_tempFilter.SearchText)) _activeFilterCount++;
        if (_tempFilter.CategoryId.HasValue) _activeFilterCount++;
        if (_tempFilter.Type.HasValue) _activeFilterCount++;
    }

    // ✅ Clear limpia solo _tempFilter
    private async Task ClearAllFilters()
    {
        _tempFilter = new TransactionFilterDto();
        _selectedCategoryString = string.Empty;
        _selectedTypeString = string.Empty;
        CalculateActiveFilterCount();
    }

    // ✅ Apply copia _tempFilter → Filter
    private async Task ApplyAndClose()
    {
        Filter.TimePeriod = _tempFilter.TimePeriod;
        Filter.FromDate = _tempFilter.FromDate;
        Filter.ToDate = _tempFilter.ToDate;
        Filter.AccountIds = _tempFilter.AccountIds?.ToList();
        Filter.SearchText = _tempFilter.SearchText;
        Filter.CategoryId = _tempFilter.CategoryId;
        Filter.Type = _tempFilter.Type;

        await OnFilterChanged.InvokeAsync(Filter);
        await OnFiltersApplied.InvokeAsync();

        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    // ✅ Cancel descarta cambios
    private async Task CancelAndClose()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}