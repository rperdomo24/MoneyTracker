@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums
@using MoneyTracker.UI.Components.Pages.Categories
@using MoneyTracker.Application.Common.Extensions
@using MoneyTracker.UI.Helpers
@inject ITransactionService TransactionService
@inject ICategoryService CategoryService
@inject IAccountService AccountService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@GetTransactionIcon()"
                     Color="@GetTransactionColor()"
                     Size="Size.Medium"
                     Class="mr-3" />
            <div>
                <MudText Typo="Typo.h6" Class="font-weight-bold">
                    @GetModalTitle()
                </MudText>
                <MudText Typo="Typo.body2" Class="text-muted">
                    @GetModalSubtitle()
                </MudText>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-0">
            @if (_loading)
            {
                <div class="text-center pa-6">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText Class="mt-3">Loading data...</MudText>
                </div>
            }
            else if (_transactionType == TransactionType.CreditPayment)
            {
                @* ========== CREDIT PAYMENT UI ========== *@
                <MudGrid>
                    <!-- LEFT COLUMN - PAYMENT FORM -->
                    <MudItem xs="12" md="7">
                        <MudForm @ref="_form" Model="_transaction">
                            <MudStack Spacing="4">
                                <!-- Credit Payment Details -->
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" Class="mr-2" Size="Size.Small" />
                                        Credit Card Payment
                                    </MudText>

                                    <MudGrid>
                                        <!-- FROM Account (Non-Credit Only) -->
                                        <MudItem xs="12" md="6">
                                            <MudSelect T="string"
                                                       Label="Pay From Account"
                                                       Value="_fromAccountString"
                                                       ValueChanged="OnFromAccountChanged"
                                                       Variant="Variant.Outlined"
                                                       Required="true"
                                                       HelperText="Account to pay from"
                                                       @onkeydown="@((e) => HandleKeyDown(e))">
                                                @if (_accounts?.Any() == true)
                                                {
                                                    @foreach (var account in _accounts.Where(a => a.Type != AccountType.Credit))
                                                    {
                                                        <MudSelectItem Value="@account.Id.ToString()">
                                                            <div class="d-flex align-center justify-space-between">
                                                                <div class="d-flex align-center">
                                                                    <MudIcon Icon="@account.Icon.ToIcon()"
                                                                             Style="@($"color: {account.Color};")"
                                                                             Class="mr-2" Size="Size.Small" />
                                                                    <div>
                                                                        <MudText Typo="Typo.body2">@account.Name</MudText>
                                                                        <MudText Typo="Typo.caption" Class="text-muted">
                                                                            @account.Type.ToLabel() • @account.CurrentBalance.ToString("C")
                                                                        </MudText>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <!-- Payment Amount -->
                                        <MudItem xs="12" md="6">
                                            <MudNumericField T="decimal"
                                                             Label="Payment Amount"
                                                             @bind-Value="_transaction.Amount"
                                                             Variant="Variant.Outlined"
                                                             Required="true"
                                                             Min="0.01m"
                                                             Step="0.01m"
                                                             Format="F2"
                                                             Culture="@System.Globalization.CultureInfo.CurrentCulture"
                                                             Adornment="Adornment.Start"
                                                             AdornmentText="$"
                                                             HelperText="Amount to pay"
                                                             @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>

                                        <!-- TO Account (Credit Cards Only) -->
                                        <MudItem xs="12" md="6">
                                            <MudSelect T="string"
                                                       Label="Credit Card"
                                                       Value="_toAccountString"
                                                       ValueChanged="OnToAccountChanged"
                                                       Variant="Variant.Outlined"
                                                       Required="true"
                                                       HelperText="Credit card to pay"
                                                       @onkeydown="@((e) => HandleKeyDown(e))">
                                                @if (_accounts?.Any() == true)
                                                {
                                                    @foreach (var account in _accounts.Where(a => a.Type == AccountType.Credit && a.Id.ToString() != _fromAccountString))
                                                    {
                                                        <MudSelectItem Value="@account.Id.ToString()">
                                                            <div class="d-flex align-center justify-space-between">
                                                                <div class="d-flex align-center">
                                                                    <MudIcon Icon="@account.Icon.ToIcon()"
                                                                             Style="@($"color: {account.Color};")"
                                                                             Class="mr-2" Size="Size.Small" />
                                                                    <div>
                                                                        <MudText Typo="Typo.body2">@account.Name</MudText>
                                                                        <MudText Typo="Typo.caption" Class="text-muted">
                                                                            Debt: @GetCreditCardDebt(account).ToString("C")
                                                                        </MudText>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <!-- Payment Date -->
                                        <MudItem xs="12" md="6">
                                            <MudDatePicker Label="Payment Date"
                                                           @bind-Date="_transactionDate"
                                                           Variant="Variant.Outlined"
                                                           Required="true"
                                                           MaxDate="DateTime.Today"
                                                           HelperText="Date of payment"
                                                           Editable="true"
                                                           DateFormat="MM/dd/yyyy"
                                                           @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>
                                    </MudGrid>
                                </div>

                                <!-- Description -->
                                <div>
                                    <MudTextField T="string"
                                                  Label="Description (Optional)"
                                                  @bind-Value="_transaction.Description"
                                                  Variant="Variant.Outlined"
                                                  Lines="3"
                                                  Placeholder="e.g., Monthly payment, Extra payment, Debt reduction..."
                                                  HelperText="Optional: Purpose of this payment"
                                                  @onkeydown="@((e) => HandleKeyDown(e))" />
                                </div>

                                <!-- Quick Add Toggle -->
                                <div>
                                    <MudCheckBox @bind-Value="_quickAddMode" Color="Color.Warning">
                                        <span class="ml-2">Quick Add Mode - Stay in modal after saving</span>
                                    </MudCheckBox>
                                </div>
                            </MudStack>
                        </MudForm>
                    </MudItem>

                    <!-- RIGHT COLUMN - PAYMENT PREVIEW -->
                    <MudItem xs="12" md="5">
                        <MudStack Spacing="4">
                            <!-- Credit Card Info -->
                            @if (_selectedToAccount != null)
                            {
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Size="Size.Small" />
                                        Credit Card Details
                                    </MudText>

                                    <MudPaper Class="pa-3 mb-3" Elevation="2" Style="border-left: 4px solid #ff5722;">
                                        <div class="d-flex align-center justify-space-between mb-2">
                                            <div class="d-flex align-center">
                                                <MudIcon Icon="@_selectedToAccount.Icon.ToIcon()"
                                                         Style="@($"color: {_selectedToAccount.Color};")"
                                                         Class="mr-2" />
                                                <MudText Typo="Typo.subtitle2" Class="font-weight-medium">
                                                    @_selectedToAccount.Name
                                                </MudText>
                                            </div>
                                        </div>

                                        <MudGrid>
                                            <MudItem xs="6">
                                                <MudText Typo="Typo.caption" Class="text-muted">Current Debt</MudText>
                                                <MudText Typo="Typo.body2" Class="font-weight-medium text-error">
                                                    @GetCreditCardDebt(_selectedToAccount).ToString("C")
                                                </MudText>
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudText Typo="Typo.caption" Class="text-muted">Available Credit</MudText>
                                                <MudText Typo="Typo.body2" Class="font-weight-medium text-success">
                                                    @GetAvailableCredit(_selectedToAccount).ToString("C")
                                                </MudText>
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudText Typo="Typo.caption" Class="text-muted">Credit Limit</MudText>
                                                <MudText Typo="Typo.body2" Class="font-weight-medium">
                                                    @_selectedToAccount.CreditLimit.ToString("C")
                                                </MudText>
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudText Typo="Typo.caption" Class="text-muted">After Payment</MudText>
                                                <MudText Typo="Typo.body2" Class="font-weight-medium text-info">
                                                    @((GetCreditCardDebt(_selectedToAccount) - _transaction.Amount).ToString("C"))
                                                </MudText>
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                </div>
                            }

                            <!-- Payment Preview -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Preview" Class="mr-2" Size="Size.Small" />
                                    Payment Preview
                                </MudText>

                                <MudPaper Class="pa-3 mb-3" Elevation="2" Style="border-left: 4px solid #ff5722;">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Payment" Color="Color.Warning" Class="mr-2" />
                                            <div>
                                                <MudText Typo="Typo.body2" Class="font-weight-medium">
                                                    Credit Card Payment
                                                </MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                    @GetFromAccountName() → @GetToAccountName() • @GetFormattedDate()
                                                </MudText>
                                            </div>
                                        </div>
                                        <MudText Typo="Typo.h6" Class="font-weight-bold text-warning">
                                            @(_transaction.Amount.ToString("C"))
                                        </MudText>
                                    </div>
                                </MudPaper>

                                @if (!string.IsNullOrWhiteSpace(_transaction.Description))
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        <strong>Note:</strong> @_transaction.Description
                                    </MudAlert>
                                }
                            </div>

                            <!-- Quick Templates for Credit Payments -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Speed" Class="mr-2" Size="Size.Small" />
                                    Payment Templates
                                </MudText>

                                <MudGrid>
                                    @foreach (var template in GetCreditPaymentTemplates())
                                    {
                                        <MudItem xs="6">
                                            <MudButton Variant="Variant.Outlined"
                                                       FullWidth="true"
                                                       StartIcon="@template.Icon"
                                                       OnClick="@(() => ApplyCreditPaymentTemplate(template))"
                                                       Size="Size.Small"
                                                       Color="Color.Warning">
                                                @template.Name
                                            </MudButton>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </div>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            }
            else if (_transactionType == TransactionType.Transfer)
            {
                @* ========== TRANSFER UI ========== *@
                <MudGrid>
                    <!-- LEFT COLUMN - TRANSFER FORM -->
                    <MudItem xs="12" md="7">
                        <MudForm @ref="_form" Model="_transaction">
                            <MudStack Spacing="4">
                                <!-- Transfer Details -->
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="mr-2" Size="Size.Small" />
                                        Transfer Details
                                    </MudText>

                                    <MudGrid>
                                        <!-- FROM Account -->
                                        <MudItem xs="12" md="6">
                                            <MudSelect T="string"
                                                       Label="From Account"
                                                       Value="_fromAccountString"
                                                       ValueChanged="OnFromAccountChanged"
                                                       Variant="Variant.Outlined"
                                                       Required="true"
                                                       HelperText="Account to transfer money from"
                                                       @onkeydown="@((e) => HandleKeyDown(e))">
                                                @if (_accounts?.Any() == true)
                                                {
                                                    @foreach (var account in _accounts)
                                                    {
                                                        <MudSelectItem Value="@account.Id.ToString()">
                                                            <div class="d-flex align-center justify-space-between">
                                                                <div class="d-flex align-center">
                                                                    <MudIcon Icon="@account.Icon.ToIcon()"
                                                                             Style="@($"color: {account.Color};")"
                                                                             Class="mr-2" Size="Size.Small" />
                                                                    <div>
                                                                        <MudText Typo="Typo.body2">@account.Name</MudText>
                                                                        <MudText Typo="Typo.caption" Class="text-muted">
                                                                            Balance: @account.CurrentBalance.ToString("C")
                                                                        </MudText>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <!-- Transfer Amount -->
                                        <MudItem xs="12" md="6">
                                            <MudNumericField T="decimal"
                                                             Label="Transfer Amount"
                                                             @bind-Value="_transaction.Amount"
                                                             Variant="Variant.Outlined"
                                                             Required="true"
                                                             Min="0.01m"
                                                             Step="0.01m"
                                                             Format="F2"
                                                             Culture="@System.Globalization.CultureInfo.CurrentCulture"
                                                             Adornment="Adornment.Start"
                                                             AdornmentText="$"
                                                             HelperText="Amount to transfer"
                                                             @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>

                                        <!-- TO Account -->
                                        <MudItem xs="12" md="6">
                                            <MudSelect T="string"
                                                       Label="To Account"
                                                       Value="_toAccountString"
                                                       ValueChanged="OnToAccountChanged"
                                                       Variant="Variant.Outlined"
                                                       Required="true"
                                                       HelperText="Account to transfer money to"
                                                       @onkeydown="@((e) => HandleKeyDown(e))">
                                                @if (_accounts?.Any() == true)
                                                {
                                                    @foreach (var account in _accounts.Where(a => a.Id.ToString() != _fromAccountString))
                                                    {
                                                        <MudSelectItem Value="@account.Id.ToString()">
                                                            <div class="d-flex align-center justify-space-between">
                                                                <div class="d-flex align-center">
                                                                    <MudIcon Icon="@account.Icon.ToIcon()"
                                                                             Style="@($"color: {account.Color};")"
                                                                             Class="mr-2" Size="Size.Small" />
                                                                    <div>
                                                                        <MudText Typo="Typo.body2">@account.Name</MudText>
                                                                        <MudText Typo="Typo.caption" Class="text-muted">
                                                                            Balance: @account.CurrentBalance.ToString("C")
                                                                        </MudText>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <!-- Transfer Date -->
                                        <MudItem xs="12" md="6">
                                            <MudDatePicker Label="Transfer Date"
                                                           @bind-Date="_transactionDate"
                                                           Variant="Variant.Outlined"
                                                           Required="true"
                                                           MaxDate="DateTime.Today"
                                                           HelperText="Date of transfer"
                                                           Editable="true"
                                                           DateFormat="MM/dd/yyyy"
                                                           @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>
                                    </MudGrid>
                                </div>

                                <!-- Description -->
                                <div>
                                    <MudTextField T="string"
                                                  Label="Description (Optional)"
                                                  @bind-Value="_transaction.Description"
                                                  Variant="Variant.Outlined"
                                                  Lines="3"
                                                  Placeholder="e.g., Credit card payment, Savings transfer, Emergency fund..."
                                                  HelperText="Optional: Purpose of this transfer"
                                                  @onkeydown="@((e) => HandleKeyDown(e))" />
                                </div>

                                <!-- Quick Add Toggle -->
                                <div>
                                    <MudCheckBox @bind-Value="_quickAddMode" Color="Color.Info">
                                        <span class="ml-2">Quick Add Mode - Stay in modal after saving</span>
                                    </MudCheckBox>
                                </div>
                            </MudStack>
                        </MudForm>
                    </MudItem>

                    <!-- RIGHT COLUMN - TRANSFER PREVIEW -->
                    <MudItem xs="12" md="5">
                        <MudStack Spacing="4">
                            <!-- Transfer Preview -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Preview" Class="mr-2" Size="Size.Small" />
                                    Transfer Preview
                                </MudText>

                                <!-- FROM Account Preview -->
                                <MudPaper Class="pa-3 mb-3" Elevation="2" Style="border-left: 4px solid #f44336;">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.CallMade" Color="Color.Error" Class="mr-2" />
                                            <div>
                                                <MudText Typo="Typo.body2" Class="font-weight-medium">From: @GetFromAccountName()</MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">Transfer Out • @GetFormattedDate()</MudText>
                                            </div>
                                        </div>
                                        <MudText Typo="Typo.h6" Class="font-weight-bold text-error">
                                            -@(_transaction.Amount.ToString("C"))
                                        </MudText>
                                    </div>
                                </MudPaper>

                                <!-- Transfer Arrow -->
                                <div class="text-center mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.SwapVert" Color="Color.Info" Size="Size.Large" />
                                </div>

                                <!-- TO Account Preview -->
                                <MudPaper Class="pa-3 mb-3" Elevation="2" Style="border-left: 4px solid #4caf50;">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.CallReceived" Color="Color.Success" Class="mr-2" />
                                            <div>
                                                <MudText Typo="Typo.body2" Class="font-weight-medium">To: @GetToAccountName()</MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">Transfer In • @GetFormattedDate()</MudText>
                                            </div>
                                        </div>
                                        <MudText Typo="Typo.h6" Class="font-weight-bold text-success">
                                            +@(_transaction.Amount.ToString("C"))
                                        </MudText>
                                    </div>
                                </MudPaper>

                                @if (!string.IsNullOrWhiteSpace(_transaction.Description))
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        <strong>Note:</strong> @_transaction.Description
                                    </MudAlert>
                                }
                            </div>

                            <!-- Quick Templates for Transfers -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Speed" Class="mr-2" Size="Size.Small" />
                                    Quick Templates
                                </MudText>

                                <MudGrid>
                                    @foreach (var template in GetTransferTemplates())
                                    {
                                        <MudItem xs="6">
                                            <MudButton Variant="Variant.Outlined"
                                                       FullWidth="true"
                                                       StartIcon="@template.Icon"
                                                       OnClick="@(() => ApplyTransferTemplate(template))"
                                                       Size="Size.Small">
                                                @template.Name
                                            </MudButton>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </div>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            }
            else
            {
                @* ========== EXISTING INCOME/EXPENSE UI ========== *@
                <MudGrid>
                    <!-- LEFT COLUMN - FORM -->
                    <MudItem xs="12" md="7">
                        <MudForm @ref="_form" Model="_transaction">
                            <MudStack Spacing="4">
                                <!-- Basic Transaction Info -->
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Size="Size.Small" />
                                        Transaction Details
                                    </MudText>

                                    <MudGrid>
                                        <!-- Name -->
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          Label="Transaction Name"
                                                          @bind-Value="_transaction.Name"
                                                          Variant="Variant.Outlined"
                                                          Required="true"
                                                          Placeholder="e.g., Grocery shopping, Salary, etc."
                                                          HelperText="Descriptive name for this transaction"
                                                          @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>

                                        <!-- Amount -->
                                        <MudItem xs="12" md="6">
                                            <MudNumericField T="decimal"
                                                             Label="Amount"
                                                             @bind-Value="_transaction.Amount"
                                                             Variant="Variant.Outlined"
                                                             Required="true"
                                                             Min="0.01m"
                                                             Step="0.01m"
                                                             Format="F2"
                                                             Culture="@System.Globalization.CultureInfo.CurrentCulture"
                                                             Adornment="Adornment.Start"
                                                             AdornmentText="$"
                                                             HelperText="Enter the transaction amount"
                                                             @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>

                                        <!-- Date with Manual Input -->
                                        <MudItem xs="12" md="6">
                                            <MudDatePicker Label="Date"
                                                           @bind-Date="_transactionDate"
                                                           Variant="Variant.Outlined"
                                                           Required="true"
                                                           MaxDate="DateTime.Today"
                                                           HelperText="Select transaction date"
                                                           Editable="true"
                                                           DateFormat="MM/dd/yyyy"
                                                           @onkeydown="@((e) => HandleKeyDown(e))" />
                                        </MudItem>

                                        <!-- Category with Search -->
                                        <MudItem xs="12" md="6">
                                            <MudGrid>
                                                <MudItem xs="10">
                                                    <MudSelect T="CategoryDto"
                                                               Label="Category"
                                                               @bind-Value="_selectedCategory"
                                                               Variant="Variant.Outlined"
                                                               Required="true"
                                                               HelperText="Select category"
                                                               ToStringFunc="@(c => c?.Name ?? "Select category")"
                                                               Clearable="true"
                                                               @onkeydown="@HandleCategoryKeyDown">
                                                        @if (_filteredCategories?.Any() == true)
                                                        {
                                                            @foreach (var category in _filteredCategories)
                                                            {
                                                                <MudSelectItem Value="@category">
                                                                    <div class="d-flex align-center">
                                                                        <MudAvatar Size="Size.Small"
                                                                                   Style="@($"background-color: {category.Color}; margin-right: 8px;")">
                                                                            <MudIcon Icon="@category.Icon.ToIcon()"
                                                                                     Color="Color.Surface"
                                                                                     Size="Size.Small" />
                                                                        </MudAvatar>
                                                                        <div>
                                                                            <MudText Typo="Typo.body2">@category.Name</MudText>
                                                                            @if (category.ParentId.HasValue)
                                                                            {
                                                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                                                    Subcategory
                                                                                </MudText>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </MudSelectItem>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <MudSelectItem Value="@((CategoryDto)null!)" Disabled="true">
                                                                <MudText Class="text-muted">No categories available for @_transactionType.ToString().ToLower()</MudText>
                                                            </MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="2" Class="d-flex align-end">
                                                    <MudTooltip Text="Add new category">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                                       Color="Color.Primary"
                                                                       Variant="Variant.Outlined"
                                                                       Size="Size.Large"
                                                                       OnClick="@CreateCategory" />
                                                    </MudTooltip>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    </MudGrid>
                                </div>

                                <!-- Description -->
                                <div>
                                    <MudTextField T="string"
                                                  Label="Description (Optional)"
                                                  @bind-Value="_transaction.Description"
                                                  Variant="Variant.Outlined"
                                                  Lines="3"
                                                  Placeholder="Add any additional details about this transaction..."
                                                  HelperText="Optional: Add more context or details"
                                                  @onkeydown="@((e) => HandleKeyDown(e))" />
                                </div>

                                <!-- Account Selection -->
                                @if (_accounts?.Any() == true)
                                {
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="mr-2" Size="Size.Small" />
                                            Account
                                        </MudText>

                                        <MudSelect T="string"
                                                   Label="Account"
                                                   @bind-Value="_selectedAccountString"
                                                   Variant="Variant.Outlined"
                                                   Required="true"
                                                   HelperText="Select the account for this transaction">
                                            @foreach (var account in _accounts)
                                            {
                                                <MudSelectItem Value="@account.Id.ToString()">
                                                    <div class="d-flex align-center justify-space-between">
                                                        <div class="d-flex align-center">
                                                            <MudIcon Icon="@account.Icon.ToIcon()"
                                                                     Style="@($"color: {account.Color};")"
                                                                     Class="mr-2"
                                                                     Size="Size.Small" />
                                                            <div>
                                                                <MudText Typo="Typo.body2">@account.Name</MudText>
                                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                                    Balance: @account.CurrentBalance.ToString("C")
                                                                </MudText>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    </div>
                                }

                                <!-- Quick Add Toggle -->
                                <div>
                                    <MudCheckBox @bind-Value="_quickAddMode" Color="Color.Primary">
                                        <span class="ml-2">Quick Add Mode - Stay in modal after saving</span>
                                    </MudCheckBox>
                                </div>
                            </MudStack>
                        </MudForm>
                    </MudItem>

                    <!-- RIGHT COLUMN - PREVIEW -->
                    <MudItem xs="12" md="5">
                        <MudStack Spacing="4">
                            <!-- Live Preview -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Preview" Class="mr-2" Size="Size.Small" />
                                    Live Preview
                                </MudText>

                                <MudPaper Class="pa-4" Elevation="2" Style="@($"border-left: 4px solid {GetTransactionColorHex()};")">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center">
                                            <MudAvatar Size="Size.Medium"
                                                       Style="@($"background-color: {GetSelectedCategoryColor()}; margin-right: 12px;")">
                                                <MudIcon Icon="@GetSelectedCategoryIcon()"
                                                         Color="Color.Surface" />
                                            </MudAvatar>
                                            <div>
                                                <MudText Typo="Typo.subtitle1" Class="font-weight-medium">
                                                    @(!string.IsNullOrWhiteSpace(_transaction.Name) ? _transaction.Name : "Transaction Name")
                                                </MudText>
                                                <MudText Typo="Typo.body2" Class="text-muted">
                                                    @GetSelectedCategoryName() • @GetFormattedDate()
                                                </MudText>
                                                @if (!string.IsNullOrWhiteSpace(_transaction.Description))
                                                {
                                                    <MudText Typo="Typo.caption" Class="text-muted mt-1">
                                                        @_transaction.Description
                                                    </MudText>
                                                }
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <MudText Typo="Typo.h6"
                                                     Class="@($"font-weight-bold {GetAmountColorClass()}")">
                                                @GetAmountDisplay()
                                            </MudText>
                                            @if (_accounts?.Any() == true)
                                            {
                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                    @GetSelectedAccountName()
                                                </MudText>
                                            }
                                        </div>
                                    </div>
                                </MudPaper>
                            </div>

                            <!-- Recent Transactions of Same Type -->
                            @if (_recentTransactions?.Any() == true)
                            {
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" Size="Size.Small" />
                                        Recent @_transactionType.ToString()s
                                    </MudText>

                                    <MudList T="string" Dense="true">
                                        @foreach (var recent in _recentTransactions.Take(5))
                                        {
                                            <MudListItem OnClick="@(() => QuickFill(recent))"
                                                         Class="cursor-pointer pa-2"
                                                         Style="border-radius: 8px;">
                                                <div class="d-flex align-center justify-space-between">
                                                    <div class="d-flex align-center">
                                                        <MudAvatar Size="Size.Small"
                                                                   Style="@($"background-color: {recent.Category?.Color}; margin-right: 8px;")">
                                                            <MudIcon Icon="@(recent.Category?.Icon.ToIcon() ?? Icons.Material.Filled.Category)"
                                                                     Color="Color.Surface"
                                                                     Size="Size.Small" />
                                                        </MudAvatar>
                                                        <div>
                                                            <MudText Typo="Typo.body2">@recent.Name</MudText>
                                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                                @recent.Category?.Name • @recent.GetShortFormattedDate()
                                                            </MudText>
                                                        </div>
                                                    </div>
                                                    <MudText Typo="Typo.body2" Class="@GetAmountColorClass()">
                                                        @recent.Amount.ToString("C")
                                                    </MudText>
                                                </div>
                                            </MudListItem>
                                        }
                                    </MudList>
                                </div>
                            }

                            <!-- Quick Templates -->
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Speed" Class="mr-2" Size="Size.Small" />
                                    Quick Templates
                                </MudText>

                                <MudGrid>
                                    @foreach (var template in GetQuickTemplates())
                                    {
                                        <MudItem xs="6">
                                            <MudButton Variant="Variant.Outlined"
                                                       FullWidth="true"
                                                       StartIcon="@template.Icon"
                                                       OnClick="@(() => ApplyTemplate(template))"
                                                       Size="Size.Small">
                                                @template.Name
                                            </MudButton>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </div>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            }
        </MudContainer>
    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-space-between align-center" style="width: 100%;">
            <MudText Typo="Typo.caption" Class="text-muted">
                @if (_transactionType == TransactionType.Transfer)
                {
                    <span>Transfer between accounts • Press Enter to save</span>
                }
                else if (_transactionType == TransactionType.CreditPayment)
                {
                    <span>Credit card payment • Press Enter to save</span>
                }
                else if (_filteredCategories?.Any() == true)
                {
                    <span>@_filteredCategories.Count categories • Press Enter to save</span>
                }
            </MudText>

            <div>
                <MudButton Color="Color.Default"
                           Variant="Variant.Text"
                           OnClick="Cancel"
                           Class="mr-2">
                    Cancel
                </MudButton>
                @if (_quickAddMode)
                {
                    <MudButton Color="@GetTransactionColor()"
                               Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="SaveAndAddAnother"
                               Disabled="@(!IsFormValid())"
                               Class="mr-2">
                        Save & Add Another
                    </MudButton>
                }
                <MudButton Color="@GetTransactionColor()"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveTransaction"
                           Disabled="@(!IsFormValid())">
                    @GetSaveButtonText()
                </MudButton>
            </div>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public TransactionType TransactionType { get; set; }
    [Parameter] public TransactionDto? PrefilledTransaction { get; set; }
    [Parameter] public EventCallback OnTransactionAdded { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = default!;
    private TransactionDto _transaction = new();
    private List<CategoryDto>? _categories;
    private List<CategoryDto>? _filteredCategories;
    private List<AccountDto>? _accounts;
    private List<TransactionDto>? _recentTransactions;
    private bool _loading = true;
    private bool _quickAddMode = false;
    private bool _isDuplicating = false;
    private DialogOptions _dialogOptions = new() { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Medium };

    // Form fields
    private DateTime? _transactionDate = DateTime.Today;
    private CategoryDto? _selectedCategory;
    private string _selectedAccountString = string.Empty;
    private string _categorySearchTerm = string.Empty;

    // Transfer-specific fields (UPDATED)
    private string _fromAccountString = string.Empty;
    private string _toAccountString = string.Empty;
    private CategoryDto? _transferOutCategory;
    private CategoryDto? _transferInCategory;

    // ✨ NEW: Credit Payment specific fields
    private CategoryDto? _creditPaymentCategory; // Para pagos de tarjeta
    private AccountDto? _selectedFromAccount;
    private AccountDto? _selectedToAccount;

    // ✨ NEW: Dynamic transaction type detection
    private TransactionType _detectedTransactionType;
    private bool _typeDetected = false;

    // Transaction type from parameter (UPDATED)
    private TransactionType _transactionType => _typeDetected ? _detectedTransactionType : TransactionType;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        // Configure categories based on transaction type
        if (_transactionType == TransactionType.Transfer)
        {
            await EnsureTransferCategories();
        }
        else if (_transactionType == TransactionType.CreditPayment)
        {
            await EnsureCreditPaymentCategories();
        }

        // If we have a prefilled transaction (duplicate scenario)
        if (PrefilledTransaction != null)
        {
            _isDuplicating = true;
            LoadPrefilledData();
        }
    }

    private void LoadPrefilledData()
    {
        if (PrefilledTransaction == null) return;

        _transaction = new TransactionDto
            {
                Name = PrefilledTransaction.Name,
                Amount = PrefilledTransaction.Amount,
                Description = PrefilledTransaction.Description,
                CategoryId = PrefilledTransaction.CategoryId,
                AccountId = PrefilledTransaction.AccountId,
                Date = PrefilledTransaction.Date
            };

        // Set the date
        _transactionDate = PrefilledTransaction.Date;

        // Set the category
        if (PrefilledTransaction.CategoryId.HasValue && _filteredCategories != null)
        {
            _selectedCategory = _filteredCategories.FirstOrDefault(c => c.Id == PrefilledTransaction.CategoryId.Value);
        }

        // Set the account
        if (PrefilledTransaction.AccountId.HasValue)
        {
            _selectedAccountString = PrefilledTransaction.AccountId.Value.ToString();
        }

        StateHasChanged();
    }

    private async Task LoadData()
    {
        _loading = true;

        try
        {
            // Load categories
            var categoriesResult = await CategoryService.GetAllAsync();
            if (categoriesResult.Success)
            {
                _categories = categoriesResult.Data ?? new List<CategoryDto>();
                FilterCategoriesByType();
            }

            // Load accounts
            var accountsResult = await AccountService.GetAllAsync();
            if (accountsResult.Success)
            {
                _accounts = accountsResult.Data?.ToList() ?? new List<AccountDto>();

                // Auto-select first non-credit account for payments
                if (_accounts.Any() && string.IsNullOrWhiteSpace(_selectedAccountString) &&
                    _transactionType != TransactionType.Transfer && _transactionType != TransactionType.CreditPayment)
                {
                    _selectedAccountString = _accounts.First().Id.ToString();
                }

                // For credit payments, auto-select first bank account as FROM
                if (_transactionType == TransactionType.CreditPayment && string.IsNullOrWhiteSpace(_fromAccountString))
                {
                    var firstBankAccount = _accounts.FirstOrDefault(a => a.Type == AccountType.Bank);
                    if (firstBankAccount != null)
                    {
                        _fromAccountString = firstBankAccount.Id.ToString();
                        _selectedFromAccount = firstBankAccount;
                    }
                }
            }

            // Load recent transactions of same type (skip for transfers and credit payments)
            if (_transactionType != TransactionType.Transfer && _transactionType != TransactionType.CreditPayment)
            {
                var transactionsResult = await TransactionService.GetAllAsync();
                if (transactionsResult.Success)
                {
                    var targetType = _transactionType == TransactionType.Income ? CategoryType.Income : CategoryType.Expense;
                    _recentTransactions = transactionsResult.Data?
                        .Where(t => t.Category?.Type == targetType)
                        .OrderByDescending(t => t.Date)
                        .Take(10)
                        .ToList() ?? new List<TransactionDto>();
                }
            }

            // If we have prefilled data, load it after everything else is loaded
            if (PrefilledTransaction != null)
            {
                LoadPrefilledData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading data: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ✨ UPDATED: Auto-detection logic
    private void OnFromAccountChanged(string accountId)
    {
        _fromAccountString = accountId;
        _selectedFromAccount = GetAccountById(accountId);
        DetectTransactionType();
        StateHasChanged();
    }

    private void OnToAccountChanged(string accountId)
    {
        _toAccountString = accountId;
        _selectedToAccount = GetAccountById(accountId);
        DetectTransactionType();
        StateHasChanged();
    }

    private async void DetectTransactionType()
    {
        if (_selectedFromAccount != null && _selectedToAccount != null)
        {
            // ✨ Auto-detect Credit Payment
            if (_selectedFromAccount.Type != AccountType.Credit &&
                _selectedToAccount.Type == AccountType.Credit)
            {
                // Cambiar automáticamente a CreditPayment
                _detectedTransactionType = TransactionType.CreditPayment;
                _typeDetected = true;
                await EnsureCreditPaymentCategories();
                return;
            }

            // ✨ Auto-detect regular Transfer
            if (_selectedFromAccount.Type != AccountType.Credit &&
                _selectedToAccount.Type != AccountType.Credit)
            {
                _detectedTransactionType = TransactionType.Transfer;
                _typeDetected = true;
                await EnsureTransferCategories();
                return;
            }
        }

        // Reset to original type if no detection
        _typeDetected = false;
    }

    private AccountDto? GetAccountById(string accountIdString)
    {
        if (string.IsNullOrWhiteSpace(accountIdString) ||
            !int.TryParse(accountIdString, out int accountId))
            return null;

        return _accounts?.FirstOrDefault(a => a.Id == accountId);
    }

    // ✨ NEW: Credit Payment Categories Setup
    private async Task EnsureCreditPaymentCategories()
    {
        try
        {
            var categoriesResult = await CategoryService.GetAllAsync();
            if (categoriesResult.Success)
            {
                var categories = categoriesResult.Data ?? new List<CategoryDto>();

                // Buscar categoría de Credit Card Payment (Expense)
                _creditPaymentCategory = categories
                    .FirstOrDefault(c => c.Type == CategoryType.Expense && c.Name == "Credit Card Payment");

                // Crear Credit Card Payment si no existe
                if (_creditPaymentCategory == null)
                {
                    var creditPaymentDto = new CategoryDto
                        {
                            Name = "Credit Card Payment",
                            Type = CategoryType.Expense,
                            Color = "#ff5722", // Naranja para pagos
                            Icon = CategoryIcon.CreditCard, // Asumiendo que existe
                        };

                    var createResult = await CategoryService.CreateAsync(creditPaymentDto);
                    if (createResult.Success)
                    {
                        // Recargar para obtener el ID
                        var reloadResult = await CategoryService.GetAllAsync();
                        if (reloadResult.Success)
                        {
                            _creditPaymentCategory = reloadResult.Data?
                                .FirstOrDefault(c => c.Type == CategoryType.Expense && c.Name == "Credit Card Payment");
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error setting up credit payment categories: " + ex.Message, Severity.Warning);
        }
    }

    private async Task EnsureTransferCategories()
    {
        try
        {
            var categoriesResult = await CategoryService.GetAllAsync();
            if (categoriesResult.Success)
            {
                var categories = categoriesResult.Data ?? new List<CategoryDto>();

                // Buscar categoría de Transfer Out (Expense)
                _transferOutCategory = categories
                    .FirstOrDefault(c => c.Type == CategoryType.Expense && c.Name == "Transfer Out");

                // Buscar categoría de Transfer In (Income)
                _transferInCategory = categories
                    .FirstOrDefault(c => c.Type == CategoryType.Income && c.Name == "Transfer In");

                // Crear Transfer Out si no existe
                if (_transferOutCategory == null)
                {
                    var transferOutDto = new CategoryDto
                        {
                            Name = "Transfer Out",
                            Type = CategoryType.Expense,  // ✅ Tipo Expense para salidas
                            Color = "#f44336",  // Rojo para salidas
                            Icon = CategoryIcon.TrendingDown,
                        };

                    var createResult = await CategoryService.CreateAsync(transferOutDto);
                    if (createResult.Success)
                    {
                        // Recargar para obtener el ID
                        var reloadResult = await CategoryService.GetAllAsync();
                        if (reloadResult.Success)
                        {
                            _transferOutCategory = reloadResult.Data?
                                .FirstOrDefault(c => c.Type == CategoryType.Expense && c.Name == "Transfer Out");
                        }
                    }
                }

                // Crear Transfer In si no existe
                if (_transferInCategory == null)
                {
                    var transferInDto = new CategoryDto
                        {
                            Name = "Transfer In",
                            Type = CategoryType.Income,  // ✅ Tipo Income para entradas
                            Color = "#4caf50",  // Verde para entradas
                            Icon = CategoryIcon.TrendingUp,
                        };

                    var createResult = await CategoryService.CreateAsync(transferInDto);
                    if (createResult.Success)
                    {
                        // Recargar para obtener el ID
                        var reloadResult = await CategoryService.GetAllAsync();
                        if (reloadResult.Success)
                        {
                            _transferInCategory = reloadResult.Data?
                                .FirstOrDefault(c => c.Type == CategoryType.Income && c.Name == "Transfer In");
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error setting up transfer categories: " + ex.Message, Severity.Warning);
        }
    }

    private void FilterCategoriesByType()
    {
        if (_categories == null) return;

        var targetCategoryType = _transactionType == TransactionType.Income
            ? CategoryType.Income
            : CategoryType.Expense;

        _filteredCategories = _categories
            .Where(c => c.Type == targetCategoryType)
            .OrderBy(c => c.ParentId.HasValue ? 1 : 0)
            .ThenBy(c => c.Name)
            .ToList();
    }

    private async Task<IEnumerable<CategoryDto>> SearchCategories(string value)
    {
        await Task.Delay(1); // Placeholder for potential async operations

        if (string.IsNullOrWhiteSpace(value) || _filteredCategories == null)
            return _filteredCategories ?? new List<CategoryDto>();

        return _filteredCategories.Where(c =>
            c.Name.Contains(value, StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => c.Name.StartsWith(value, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
            .ThenBy(c => c.Name);
    }

    private async Task HandleCategoryKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && IsFormValid())
        {
            await SaveTransaction();
            return;
        }

        // Handle letter navigation
        if (e.Key.Length == 1 && char.IsLetter(e.Key[0]) && _filteredCategories?.Any() == true)
        {
            var letter = e.Key.ToLower();
            var categoryStartingWithLetter = _filteredCategories
                .FirstOrDefault(c => c.Name.ToLower().StartsWith(letter));

            if (categoryStartingWithLetter != null)
            {
                _selectedCategory = categoryStartingWithLetter;
                StateHasChanged();
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && IsFormValid())
        {
            await SaveTransaction();
        }
    }

    // ✨ UPDATED: IsFormValid with Credit Payment support
    private bool IsFormValid()
    {
        if (_transactionType == TransactionType.Transfer)
        {
            return !string.IsNullOrWhiteSpace(_fromAccountString) &&
                   !string.IsNullOrWhiteSpace(_toAccountString) &&
                   _fromAccountString != _toAccountString &&
                   _transaction.Amount > 0 &&
                   _transactionDate.HasValue &&
                   _transferOutCategory != null &&
                   _transferInCategory != null;
        }

        // ✨ NEW: Credit Payment validation
        if (_transactionType == TransactionType.CreditPayment)
        {
            return !string.IsNullOrWhiteSpace(_fromAccountString) &&
                   !string.IsNullOrWhiteSpace(_toAccountString) &&
                   _fromAccountString != _toAccountString &&
                   _transaction.Amount > 0 &&
                   _transactionDate.HasValue &&
                   _creditPaymentCategory != null &&
                   _selectedFromAccount?.Type != AccountType.Credit &&
                   _selectedToAccount?.Type == AccountType.Credit;
        }

        return !string.IsNullOrWhiteSpace(_transaction.Name) &&
               _transaction.Amount > 0 &&
               _transactionDate.HasValue &&
               _selectedCategory != null &&
               (_accounts?.Any() != true || !string.IsNullOrWhiteSpace(_selectedAccountString));
    }

    // ✨ UPDATED: SaveTransaction with Credit Payment support
    private async Task SaveTransaction()
    {
        if (_transactionType == TransactionType.Transfer)
        {
            await SaveTransfer();
        }
        else if (_transactionType == TransactionType.CreditPayment)
        {
            await SaveCreditPayment(); // ✨ NEW method
        }
        else
        {
            await SaveRegularTransaction();
        }
    }

    // ✨ NEW: Save Credit Payment Logic
    private async Task SaveCreditPayment()
    {
        try
        {
            if (!IsFormValid()) return;

            if (!int.TryParse(_fromAccountString, out int fromAccountId) ||
                !int.TryParse(_toAccountString, out int toAccountId))
            {
                Snackbar.Add("Invalid account selection", Severity.Error);
                return;
            }

            var fromAccount = _accounts?.FirstOrDefault(a => a.Id == fromAccountId);
            var toAccount = _accounts?.FirstOrDefault(a => a.Id == toAccountId);

            // Crear descripción automática si está vacía
            var description = string.IsNullOrWhiteSpace(_transaction.Description)
                ? $"Credit card payment to {toAccount?.Name}"
                : _transaction.Description;

            // ✅ Solo crear UNA transacción (Expense) - pago de tarjeta
            var paymentTransaction = new TransactionDto
                {
                    Name = $"Payment - {toAccount?.Name}",
                    Amount = _transaction.Amount,
                    Date = _transactionDate!.Value,
                    Description = description,
                    CategoryId = _creditPaymentCategory!.Id,
                    AccountId = fromAccountId // ✅ Sale de la cuenta normal
                };

            var result = await TransactionService.CreateAsync(paymentTransaction);
            if (!result.Success)
            {
                Snackbar.Add("Error creating credit payment: " + result.Message, Severity.Error);
                return;
            }

            Snackbar.Add("Credit card payment recorded successfully", Severity.Success);
            await OnTransactionAdded.InvokeAsync();

            if (!_quickAddMode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                ResetCreditPaymentForm();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error processing credit payment: " + ex.Message, Severity.Error);
        }
    }

    private async Task SaveTransfer()
    {
        try
        {
            if (!IsFormValid()) return;

            if (!int.TryParse(_fromAccountString, out int fromAccountId) ||
                !int.TryParse(_toAccountString, out int toAccountId))
            {
                Snackbar.Add("Invalid account selection", Severity.Error);
                return;
            }

            // Crear descripción automática si está vacía
            var description = string.IsNullOrWhiteSpace(_transaction.Description)
                ? $"Transfer from {GetFromAccountName()} to {GetToAccountName()}"
                : _transaction.Description;

            // ✅ Transacción de SALIDA (FROM account) - EXPENSE
            var outgoingTransaction = new TransactionDto
                {
                    Name = $"Transfer to {GetToAccountName()}",
                    Amount = _transaction.Amount,
                    Date = _transactionDate!.Value,
                    Description = description,
                    CategoryId = _transferOutCategory!.Id,  // ✅ Categoría Expense
                    AccountId = fromAccountId
                };

            // ✅ Transacción de ENTRADA (TO account) - INCOME
            var incomingTransaction = new TransactionDto
                {
                    Name = $"Transfer from {GetFromAccountName()}",
                    Amount = _transaction.Amount,
                    Date = _transactionDate!.Value,
                    Description = description,
                    CategoryId = _transferInCategory!.Id,  // ✅ Categoría Income
                    AccountId = toAccountId
                };

            // Crear ambas transacciones
            var outgoingResult = await TransactionService.CreateAsync(outgoingTransaction);
            if (!outgoingResult.Success)
            {
                Snackbar.Add("Error creating outgoing transfer: " + outgoingResult.Message, Severity.Error);
                return;
            }

            var incomingResult = await TransactionService.CreateAsync(incomingTransaction);
            if (!incomingResult.Success)
            {
                Snackbar.Add("Error creating incoming transfer: " + incomingResult.Message, Severity.Error);
                // TODO: Rollback outgoing transaction
                return;
            }

            Snackbar.Add("Transfer completed successfully", Severity.Success);
            await OnTransactionAdded.InvokeAsync();

            if (!_quickAddMode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                ResetTransferForm();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error processing transfer: " + ex.Message, Severity.Error);
        }
    }

    private async Task SaveRegularTransaction()
    {
        try
        {
            if (!IsFormValid()) return;

            _transaction.Date = _transactionDate!.Value;
            _transaction.CategoryId = _selectedCategory!.Id;

            if (!string.IsNullOrWhiteSpace(_selectedAccountString) &&
                int.TryParse(_selectedAccountString, out int accountId))
            {
                _transaction.AccountId = accountId;
            }

            var result = await TransactionService.CreateAsync(_transaction);
            if (result.Success)
            {
                var message = _isDuplicating ? "Transaction duplicated successfully" : $"{_transactionType} added successfully";
                Snackbar.Add(message, Severity.Success);
                await OnTransactionAdded.InvokeAsync();

                if (!_quickAddMode)
                {
                    MudDialog.Close(DialogResult.Ok(true));
                }
            }
            else
            {
                Snackbar.Add(result.Message ?? "Error adding transaction", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error: " + ex.Message, Severity.Error);
        }
    }

    // ✨ UPDATED: SaveAndAddAnother with Credit Payment support
    private async Task SaveAndAddAnother()
    {
        await SaveTransaction();
        if (_quickAddMode)
        {
            if (_transactionType == TransactionType.Transfer)
            {
                ResetTransferForm();
            }
            else if (_transactionType == TransactionType.CreditPayment)
            {
                ResetCreditPaymentForm();
            }
            else
            {
                ResetForm();
            }
        }
    }

