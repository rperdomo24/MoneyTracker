    private void QuickFill(TransactionDto template)
    {
        _transaction.Name = template.Name;
        _transaction.Amount = template.Amount;
        _transaction.Description = template.Description;
        _selectedCategory = template.Category;
        if (template.AccountId.HasValue)
        {
            _selectedAccountString = template.AccountId.Value.ToString();
        }
    }

    private void ApplyTemplate(QuickTemplate template)
    {
        _transaction.Name = template.Name;
        if (template.Amount.HasValue)
        {
            _transaction.Amount = template.Amount.Value;
        }
        if (template.CategoryId.HasValue)
        {
            _selectedCategory = _filteredCategories?.FirstOrDefault(c => c.Id == template.CategoryId.Value);
        }
    }

    private void ApplyTransferTemplate(QuickTemplate template)
    {
        _transaction.Description = template.Name;
        if (template.Amount.HasValue)
        {
            _transaction.Amount = template.Amount.Value;
        }
    }

    // ✨ NEW: Apply Credit Payment Template
    private void ApplyCreditPaymentTemplate(QuickTemplate template)
    {
        _transaction.Description = template.Name;

        if (_selectedToAccount != null)
        {
            switch (template.Name)
            {
                case "Minimum Payment":
                    // Assumir 2% del debt como pago mínimo
                    _transaction.Amount = Math.Max(25m, GetCreditCardDebt(_selectedToAccount) * 0.02m);
                    break;
                case "Full Balance":
                    _transaction.Amount = GetCreditCardDebt(_selectedToAccount);
                    break;
                case "Monthly Payment":
                    // Assumir pago mensual típico
                    _transaction.Amount = Math.Min(200m, GetCreditCardDebt(_selectedToAccount));
                    break;
            }
        }

        if (template.Amount.HasValue)
        {
            _transaction.Amount = template.Amount.Value;
        }

        StateHasChanged();
    }

