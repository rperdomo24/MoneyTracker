    private string GetSelectedAccountName()
    {
        if (!string.IsNullOrWhiteSpace(_selectedAccountString) && int.TryParse(_selectedAccountString, out int accountId))
        {
            var account = _accounts?.FirstOrDefault(a => a.Id == accountId);
            return account?.Name ?? "Select Account";
        }
        return "Select Account";
    }

    private string GetFromAccountName()
    {
        if (!int.TryParse(_fromAccountString, out int accountId)) return "Select Account";
        return _accounts?.FirstOrDefault(a => a.Id == accountId)?.Name ?? "Select Account";
    }

    private string GetToAccountName()
    {
        if (!int.TryParse(_toAccountString, out int accountId)) return "Select Account";
        return _accounts?.FirstOrDefault(a => a.Id == accountId)?.Name ?? "Select Account";
    }

    private string GetFormattedDate() => _transactionDate?.GetFormattedDate() ?? "Select Date";

    private string GetAmountDisplay()
    {
        if (_transaction.Amount <= 0) return "$0.00";

        if (_transactionType == TransactionType.Transfer || _transactionType == TransactionType.CreditPayment)
        {
            return _transaction.Amount.ToString("C");
        }

        var sign = _transactionType == TransactionType.Income ? "+" : "-";
        return $"{sign}{_transaction.Amount:C}";
    }

    private string GetAmountColorClass() => _transactionType == TransactionType.Income ? "text-success" : "text-error";

    // ✨ NEW: Get Available Credit for display
    private decimal GetAvailableCredit(AccountDto account)
    {
        if (account.Type != AccountType.Credit) return 0;
        return account.CreditLimit + account.CurrentBalance; // Balance será negativo
    }

    // ✨ NEW: Get Credit Card Debt
    private decimal GetCreditCardDebt(AccountDto account)
    {
        if (account.Type != AccountType.Credit) return 0;
        return Math.Abs(account.CurrentBalance); // Mostrar como positivo
    }

