@page "/transactions"
@using MoneyTracker.Application.Common.Extensions
@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums
@using MoneyTracker.Domain.Enums.Category
@using MoneyTracker.Domain.Enums.Filters
@using MoneyTracker.Domain.Enums.Transaction
@using MoneyTracker.UI.Components
@using MoneyTracker.UI.Components.Shared
@using MoneyTracker.UI.Helpers
@inject ITransactionService TransactionService
@inject IAccountService AccountService

<PageTitle>Transactions - MoneyTracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
    <!-- Header Section -->
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold mb-2">Manage your income, expenses, and transfers</MudText>
            <MudText Typo="Typo.body1" Class="text-muted">
                Manage your income and expenses
                @if (_transactionSummary?.TotalCount > 0)
                {
                    <span> • @(_transactionSummary.TotalCount) total transactions</span>
                    @if (_hasActiveFilters)
                    {
                        <span> (filtered)</span>
                    }
                }
            </MudText>
        </div>
        <div class="d-flex ga-2">
            <!-- ✨ NEW: Pay Credit Card Button -->
            <MudButton Variant="Variant.Text"
            Color="Color.Secondary"
            StartIcon="@Icons.Material.Filled.FileDownload"
            OnClick="ExportTransactions"
            Disabled="_loading">
                Export
            </MudButton>
        </div>
    </div>

    <!-- Filtros Separados -->
    <TransactionFilters Filter="_filterDto"
    OnFilterChanged="OnFilterChanged"
    OnFiltersApplied="LoadTransactionsAsync"
    OnFiltersInitialized="OnFiltersInitialized" />

    <!-- Quick Stats Cards (mejoradas) -->
    @if (_transactionSummary != null && !_loading)
    {
        <MudGrid Class="mb-6">
            <!-- Total Income Card -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 text-center" Elevation="2" Style="@($"border-top: 4px solid {(TransactionType.Income.GetTransactionTypeHexColor())};")">
                    <MudIcon Icon="@(TransactionType.Income.GetTransactionypeIcon())"
                    Color="@(TransactionType.Income.GetTransactionTypeColor())"
                    Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="@($"font-weight-bold text-success")">
                        @_transactionSummary.TotalIncome.ToString("C")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">Total Income</MudText>
                </MudPaper>
            </MudItem>

            <!-- Total Expenses Card -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 text-center" Elevation="2" Style="@($"border-top: 4px solid {(TransactionType.Expense.GetTransactionTypeHexColor())};")">
                    <MudIcon Icon="@(TransactionType.Expense.GetTransactionypeIcon())"
                    Color="@(TransactionType.Expense.GetTransactionTypeColor())"
                    Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="@($"font-weight-bold text-error")">
                        @_transactionSummary.TotalExpense.ToString("C")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">Total Expenses</MudText>
                </MudPaper>
            </MudItem>

            <!-- Balance Card -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 text-center" Elevation="2" Style="@_transactionSummary.GetBalanceCardStyle()">
                    <MudIcon Icon="@_transactionSummary.GetBalanceIcon()"
                    Color="@_transactionSummary.GetBalanceColor()"
                    Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="@_transactionSummary.GetBalanceTextClass()">
                        @_transactionSummary.Balance.ToString("C")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">Balance</MudText>
                </MudPaper>
            </MudItem>

            <!-- Total Transactions Card -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 text-center" Elevation="2" Style="border-top: 4px solid #2196F3;">
                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Info" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="font-weight-bold text-info">@_transactionSummary.TotalCount</MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">
                        Total Transactions
                        @if (_transactionSummary.TotalCount > 0)
                        {
                            <br />
                            <span>Avg: @_transactionSummary.GetAverageAmount().ToString("C2")</span>
                        }
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Period Info Alert -->
        <MudAlert Severity="Severity.Info" Class="mb-4">
            <div class="d-flex align-center justify-space-between">
                <div>
                    <strong>@GetPeriodDescription()</strong>
                    @if (_filterDto.TimePeriod == TimePeriodFilter.Custom
                  && _filterDto.FromDate.HasValue && _filterDto.ToDate.HasValue)
                    {
                        <span class="ml-2">
                            (@_filterDto.FromDate.GetFormattedDateSafe() - @_filterDto.ToDate.GetFormattedDateSafe())
                        </span>
                    }
                </div>
                @if (_transactionSummary.TotalCount > 0)
                {
                    <MudText Typo="Typo.body2">
                        Filtered Results: <strong>@_transactionSummary.GetTransactionCountText()</strong>
                    </MudText>
                }
            </div>
        </MudAlert>
    }

    <!-- Transactions Table (mejorada) -->
    <MudPaper Elevation="2">
        @if (_loading)
        {
            <div class="text-center pa-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                <MudText Class="mt-4">Loading transactions...</MudText>
            </div>
        }
        else if (_transactionSummary?.Transactions?.Any() == true)
        {
            <MudTable T="TransactionDto"
            Items="@_transactionSummary.Transactions"
            Dense="true"
            Hover="true"
            Breakpoint="Breakpoint.Sm"
            Loading="@_loading"
            LoadingProgressColor="Color.Info"
            FixedHeader="true"
            Height="600px">
                <ToolBarContent>
                    <div class="d-flex align-center justify-space-between" style="width: 100%;">
                        <MudText Typo="Typo.h6">
                            Transactions (@_transactionSummary.TotalCount)
                        </MudText>

                        <div class="d-flex align-center ga-2">
                            @if (_hasActiveFilters)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                                    Filtered
                                </MudChip>
                            }
                        </div>
                    </div>
                </ToolBarContent>

                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<TransactionDto, object>(x => x.Date)">Date</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TransactionDto, object>(x => x.Name)">Name</MudTableSortLabel></MudTh>
                    <MudTh>Category</MudTh>
                    <MudTh>Account</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TransactionDto, object>(x => x.Amount)">Amount</MudTableSortLabel></MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Date">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-2 text-muted" />
                            <div>
                                <MudText Typo="Typo.body2" Class="font-weight-medium">@context.GetShortFormattedDate()</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">@context.Date.Year</MudText>
                            </div>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Name">
                        <div class="d-flex align-center">
                            <MudAvatar Size="Size.Medium"
                            Style="@($"background-color: {context.GetTransactionColor()}; margin-right: 12px;")">
                                <MudIcon Icon="@(context.GetTransactionIcon())"
                                Color="Color.Surface"
                                Size="Size.Small" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2" Class="font-weight-medium">@context.Name</MudText>
                                <!-- ✨ NEW: Show transaction type badge for special transactions -->
                                @if (context.IsCreditPayment())
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                        Credit Payment
                                    </MudChip>
                                }
                                else if (context.IsTransfer())
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                                        Transfer
                                    </MudChip>
                                }
                            </div>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Category">
                        @if (context.Category is not null)
                        {
                            <div class="d-flex align-center">
                                <MudAvatar Size="Size.Small"
                                Style="@($"background-color: {context.Category.Color}; margin-right: 8px;")">
                                    <MudIcon Icon="@context.Category.Icon.ToIcon()"
                                    Color="Color.Surface"
                                    Size="Size.Small" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body2">@context.Category.Name</MudText>
                                    <MudChip T="string" Size="Size.Small"
                                    Color="@(context.Category.Type == CategoryType.Income ? Color.Success : Color.Error)"
                                    Variant="Variant.Text">
                                        @context.Category.Type.ToString()
                                    </MudChip>
                                </div>
                            </div>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">Uncategorized</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Account">
                        @if (context.Account != null)
                        {
                            <div class="d-flex align-center">
                                <MudAvatar Size="Size.Small"
                                Style="@($"background-color: {context.Account.Color}; margin-right: 8px;")">
                                    <MudIcon Icon="@context.Account.Type.ToIcon()"
                                    Color="Color.Surface"
                                    Size="Size.Small" />
                                </MudAvatar>

                                <div>
                                    <MudText Typo="Typo.body2">@context.Account.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="text-muted">@context.Account.Type.ToString()</MudText>
                                </div>
                            </div>
                        }
                        else
                        {
                            <MudText Class="text-muted">No account</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Amount">
                        <MudText Typo="Typo.h6" Class="@($"font-weight-bold {context.GetAmountColorClass()}")">
                            @context.GetAmountDisplay()
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Description">
                        @if (!string.IsNullOrWhiteSpace(context.Description))
                        {
                            <MudTooltip Text="@context.Description">
                                <MudText Typo="Typo.body2" Class="text-muted">
                                    @(context.Description.Length > 30 ? context.Description.Substring(0, 30) + "..." : context.Description)
                                </MudText>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="text-muted font-italic">No description</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <div class="d-flex ga-1">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                            Color="Color.Info"
                            Size="Size.Small"
                            OnClick="@(() => ViewTransaction(context.Id))"
                            Title="View Details" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                            Color="Color.Primary"
                            Size="Size.Small"
                            OnClick="@(() => EditTransaction(context.Id))"
                            Title="Edit Transaction" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                            Color="Color.Error"
                            Size="Size.Small"
                            OnClick="@(() => DeleteTransaction(context.Id, context.Name))"
                            Title="Delete Transaction" />
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <!-- Enhanced Empty State -->
            <div class="text-center pa-8">
                @if (_hasActiveFilters)
                {
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="text-muted mb-4" Style="font-size: 4rem;" />
                    <MudText Typo="Typo.h6" Class="mb-2">No transactions found</MudText>
                    <MudText Typo="Typo.body1" Class="text-muted mb-4">
                        No transactions match your current filters. Try adjusting your search criteria.
                    </MudText>
                    <MudButton Variant="Variant.Text"
                    Color="Color.Primary"
                    OnClick="ClearAllFilters">
                        Clear All Filters
                    </MudButton>
                }
                else
                {
                    <div class="d-flex flex-column align-center justify-center py-16">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt"
                        Size="Size.Large"
                        Class="text-muted mb-4"
                        Style="font-size: 4rem;" />

                        <MudText Typo="Typo.h6" Class="mb-2">
                            No transactions yet
                        </MudText>

                        <MudText Typo="Typo.body1" Class="text-muted mb-6 text-center" Style="max-width: 350px;">
                            Click the <MudChip T="string" Size="Size.Small"
                            Color="Color.Primary"
                            Icon="@Icons.Material.Filled.Add"
                            Class="fab-hint-chip">
                                Add
                            </MudChip> button to create your first transaction
                        </MudText>

                        <!-- 🎯 Arrow apuntando hacia donde está el FAB -->
                        <div class="fab-arrow-hint">
                            <MudIcon Icon="@Icons.Material.Filled.SouthEast"
                            Size="Size.Large"
                            Class="text-primary fab-arrow-icon" />
                        </div>
                    </div>
                }
            </div>
        }
    </MudPaper>
    <QuickActionsFab OnTransactionAdded="@OnTransactionChanged" />
</MudContainer>

@code {
    // Usando tu sistema actual
    private TransactionSummaryDto? _transactionSummary;
    private TransactionFilterDto _filterDto = new() { TimePeriod = TimePeriodFilter.ThisMonth };
    private bool _loading = true;
    private bool _hasActiveFilters = false;
    private bool _filtersLoaded = false; // Nueva variable

    // Dialog options
    private DialogOptions _dialogOptions = new()
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Large
        };

    protected override async Task OnInitializedAsync()
    {
        _loading = false;
    }

    // Método llamado desde el componente de filtros cuando termine de cargar
    private async Task OnFiltersInitialized()
    {
        if (!_filtersLoaded)
        {
            _filtersLoaded = true;
            await LoadTransactionsAsync(); // Ahora sí cargar transacciones
        }
    }

    private async Task LoadTransactionsAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var result = await TransactionService.GetFilteredAsync(_filterDto);
            if (result.Success)
            {
                _transactionSummary = result.Data ?? new TransactionSummaryDto();
            }
            else
            {
                Snackbar.Add(result.Message ?? "Error loading transactions", Severity.Error);
                _transactionSummary = new TransactionSummaryDto();
            }

            _hasActiveFilters = HasActiveFilters();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading data: " + ex.Message, Severity.Error);
            _transactionSummary = new TransactionSummaryDto();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    // Manejadores del componente de filtros
    private async Task OnFilterChanged(TransactionFilterDto filter)
    {
        _filterDto = filter;
    }

    private bool HasActiveFilters()
    {
        return _filterDto.TimePeriod != TimePeriodFilter.ThisMonth ||
               _filterDto.AccountIds?.Any() == true ||
               !string.IsNullOrWhiteSpace(_filterDto.SearchText) ||
               _filterDto.CategoryId.HasValue ||
               _filterDto.Type.HasValue;
    }

    private async Task ClearAllFilters()
    {
        _filterDto = new TransactionFilterDto { TimePeriod = TimePeriodFilter.ThisMonth };
        await LoadTransactionsAsync();
    }

    // Métodos de UI helper
    private string GetPeriodDescription()
    {
        return _filterDto.TimePeriod switch
        {
            TimePeriodFilter.LastMonth => "Last Month Results",
            TimePeriodFilter.ThisMonth => "This Month Results",
            TimePeriodFilter.ThisYear => "This Year Results",
            TimePeriodFilter.Custom => "Custom Period Results",
            _ => "Filtered Results"
        };
    }

    // Export functionality
    private async Task ExportTransactions()
    {
        try
        {
            // Aquí implementarías la lógica de exportación
            // Por ahora solo un mensaje
            if (_transactionSummary?.Transactions?.Any() == true)
            {
                Snackbar.Add($"Exported {_transactionSummary.TotalCount} transactions", Severity.Success);
            }
            else
            {
                Snackbar.Add("No transactions to export", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export error: {ex.Message}", Severity.Error);
        }
    }

    private async Task ViewTransaction(int transactionId)
    {
        var parameters = new DialogParameters
            {
                ["TransactionId"] = transactionId,
                ["OnTransactionChanged"] = EventCallback.Factory.Create(this, OnTransactionChanged)
            };

        await DialogService.ShowAsync<ViewTransactionModal>("Transaction Details", parameters, _dialogOptions);
    }

    private async Task EditTransaction(int transactionId)
    {
        var parameters = new DialogParameters
            {
                ["TransactionId"] = transactionId,
                ["OnTransactionUpdated"] = EventCallback.Factory.Create(this, OnTransactionChanged)
            };

        await DialogService.ShowAsync<UpdateTransactionModal>("Edit Transaction", parameters, _dialogOptions);
    }

    private async Task DeleteTransaction(int transactionId, string transactionName)
    {
        bool confirmed = await DialogService.ShowConfirmDialogAsync(
            "Delete Transaction",
            $"Are you sure you want to delete '{transactionName}'? This action cannot be undone.",
            "Delete",
            Color.Error
        );

        if (confirmed)
        {
            try
            {
                var result = await TransactionService.DeleteAsync(transactionId);
                if (result.Success)
                {
                    Snackbar.Add("Transaction deleted successfully", Severity.Success);
                    await OnTransactionChanged();
                }
                else
                {
                    Snackbar.Add(result.Message ?? "Error deleting transaction", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add("Error: " + ex.Message, Severity.Error);
            }
        }
    }

    private async Task OnTransactionChanged()
    {
        await LoadTransactionsAsync();
    }
}