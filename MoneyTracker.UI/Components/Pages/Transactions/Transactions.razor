@page "/transactions"
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-2">Transactions</MudText>

    <!-- Filtro por fecha -->
    <MudPaper Class="pa-3 d-flex align-center justify-space-between mb-2">
        <MudStack Direction="Row" Spacing="1" AlignItems=" AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.FilterList" />
            <MudDateRangePicker @bind-DateRange="dateRange" />
        </MudStack>
        <MudIconButton Icon="@Icons.Material.Filled.Search" />
    </MudPaper>

    <!-- Totales -->
    <MudGrid Class="mb-2">
        <MudItem xs="6">
            <MudText Typo="Typo.caption">Income</MudText>
            <MudText Typo="Typo.subtitle2">$@totalIncome.ToString("N2")</MudText>
        </MudItem>
        <MudItem xs="6">
            <MudText Typo="Typo.caption">Spending</MudText>
            <MudText Typo="Typo.subtitle2">$@totalSpending.ToString("N2")</MudText>
        </MudItem>
    </MudGrid>

    <!-- Lista de transacciones -->
    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">@GroupedTransactions.Count transaction(s)</MudText>

    @foreach (var group in GroupedTransactions)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3">@group.Key</MudText>
        @foreach (var tx in group.Value)
        {
            <MudPaper Class="pa-2 mt-1">
                <MudGrid>
                    <MudItem xs="2" Class="d-flex align-center justify-center">
                        <MudAvatar Icon="@tx.Icon" Color="@tx.Color" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.subtitle1">@tx.Description</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@tx.Account</MudText>
                    </MudItem>
                    <MudItem xs="4" Class="d-flex justify-end flex-column align-end">
                        <MudText Typo="Typo.subtitle2" Color="@(tx.Type == "Income" ? Color.Success : Color.Error)">
                            @((tx.Type == "Income" ? "+" : "-") + "$" + tx.Amount.ToString("N2"))
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">$@tx.BalanceAfter.ToString("N2")</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
    }

    <!-- FAB -->
    <MudFab Icon="@Icons.Material.Filled.Add"
    Color="Color.Primary"
    Class="mud-fab-bottom-right mud-fab-fixed"
    Style="bottom: 24px; right: 24px;" />
</MudContainer>

@code {
    private DateRange dateRange = new(DateTime.Today.AddDays(-30), DateTime.Today);

    private decimal totalIncome
    {
        get
        {
            return Transactionsdto.Where(t => t.Type == "Income").Sum(t => t.Amount);
        }
    }

    private decimal totalSpending
    {
        get
        {
            return Transactionsdto.Where(t => t.Type == "Expense").Sum(t => t.Amount);
        }
    }

    private List<TransactionDto> Transactionsdto = new()
    {
        new() { Date = DateTime.Today, Description = "pupusas", Type = "Expense", Amount = 2.50m, Account = "Cash", BalanceAfter = -2.50m, Icon = Icons.Material.Filled.Restaurant, Color = Color.Error },
        new() { Date = DateTime.Today, Description = "saving money", Type = "Income", Amount = 10m, Account = "capital", BalanceAfter = 35m, Icon = Icons.Material.Filled.Savings, Color = Color.Success }
    };

    private Dictionary<string, List<TransactionDto>> GroupedTransactions =>
        Transactionsdto
        .Where(t => t.Date >= dateRange.Start && t.Date <= dateRange.End)
        .GroupBy(t => t.Date.ToString("MMMM dd, yyyy"))
        .ToDictionary(g => g.Key, g => g.ToList());

    public class TransactionDto
    {
        public DateTime Date { get; set; }
        public string Type { get; set; } = "Expense"; // or "Income"
        public string Description { get; set; } = "";
        public string Account { get; set; } = "";
        public decimal Amount { get; set; }
        public decimal BalanceAfter { get; set; }
        public string Icon { get; set; } = Icons.Material.Filled.Money;
        public Color Color { get; set; } = Color.Default;
    }
}
