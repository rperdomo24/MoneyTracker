@page "/transactions"
@using MoneyTracker.Application.Common.Extensions
@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums
@using MoneyTracker.Domain.Enums.Category
@using MoneyTracker.Domain.Enums.Filters
@using MoneyTracker.Domain.Enums.Transaction
@using MoneyTracker.UI.Components
@using MoneyTracker.UI.Components.Shared
@using MoneyTracker.UI.Components.Shared.DataDisplay
@using MoneyTracker.UI.Components.Shared.Filters
@using MoneyTracker.UI.Components.Shared.Navigation
@using MoneyTracker.UI.Components.Shared.Selection
@using MoneyTracker.UI.Helpers
@inject ITransactionService TransactionService
@inject IAccountService AccountService
@inject ICategoryService CategoryService

<PageTitle>Transactions - MoneyTracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
    <!-- Header Section -->
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <Breadcrumb Items="@_breadcrumbItems" />

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Text"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.FilterList"
                       OnClick="ToggleFiltersDrawer">
                Filters
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="ExportTransactions"
                       Disabled="_loading">
                Export
            </MudButton>
        </MudStack>
    </MudStack>

    <ActiveFiltersChips Filter="@_filterDto"
                        Categories="@_categories"
                        Accounts="@_accounts"
                        OnFilterRemoved="OnFilterRemoved"
                        OnClearAll="ClearAllFilters" />

    <!-- Stats Inline -->
    @if (!_loading)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <StatsInline Summary="@_transactionSummary" />
        </MudPaper>
    }

    <!-- Transactions List -->
    <MudPaper Elevation="2">
        @if (_loading)
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                <MudText Class="mt-4">Loading transactions...</MudText>
            </MudStack>
        }
        else if (_groupedTransactions?.Any() == true)
        {
            <!-- Toolbar -->
            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Class="px-4 py-2"
                      Style="border-bottom: 1px solid var(--mud-palette-divider);">
                <MudText Typo="Typo.subtitle1">
                    Transactions (@_totalTransactions)
                </MudText>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    @if (_hasActiveFilters)
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="Color.Primary"
                                 Variant="Variant.Text">
                            Filtered
                        </MudChip>
                    }

                    <MudSelect T="int"
                               @bind-Value="_rowsPerPage"
                               @bind-Value:after="OnRowsPerPageChanged"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Margin="Margin.Dense"
                               Style="width: 110px;">
                        <MudSelectItem Value="5">5 rows</MudSelectItem>
                        <MudSelectItem Value="10">10 rows</MudSelectItem>
                        <MudSelectItem Value="25">25 rows</MudSelectItem>
                        <MudSelectItem Value="50">50 rows</MudSelectItem>
                        <MudSelectItem Value="100">100 rows</MudSelectItem>
                    </MudSelect>
                </MudStack>
            </MudStack>

            <MudPaper Elevation="0"
                      Class="px-4 py-1"
                      Style="position: sticky; top: 0; z-index: 10; background-color: var(--mud-palette-surface); border-bottom: 1px solid var(--mud-palette-divider);">
                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween">

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex: 3;">
                        <div style="width: 40px;"></div>
                        <div style="width: 40px;"></div>
                        <MudText Typo="Typo.caption" Color="Color.Default" Style="font-weight: 400; font-size: 0.7rem; opacity: 0.5; text-transform: uppercase;">
                            Transaction
                        </MudText>
                    </MudStack>

                    <div Style="flex: 1;">
                        <MudText Typo="Typo.caption" Color="Color.Default" Style="font-weight: 400; font-size: 0.7rem; opacity: 0.5; text-transform: uppercase;">
                            Category
                        </MudText>
                    </div>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex: 1; justify-content: flex-end;">
                        <MudText Typo="Typo.caption" Color="Color.Default" Style="font-weight: 400; font-size: 0.7rem; opacity: 0.5; text-transform: uppercase;">
                            Amount
                        </MudText>
                        <div style="width: 40px;"></div>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <!-- Expansion Panels -->
            <MudExpansionPanels MultiExpansion="true"
                                Elevation="0"
                                Square="true">
                @foreach (var group in _groupedTransactions)
                {
                    <MudExpansionPanel Expanded="true">
                        <TitleContent>
                            <MudStack Row="true"
                                      Justify="Justify.SpaceBetween"
                                      AlignItems="AlignItems.Center"
                                      Style="width: 100%;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudCheckBox T="bool"
                                                 Dense="true"
                                                 Size="Size.Small"
                                                 Value="@IsGroupSelected(group)"
                                                 ValueChanged="@(value => ToggleGroupSelection(group, value))"
                                                 @onclick:stopPropagation="true" />

                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday"
                                             Size="Size.Small"
                                             Color="Color.Default"
                                             Style="opacity: 0.6;" />

                                    <MudText Typo="Typo.body2" Color="Color.Default" Style="font-weight: 500; opacity: 0.7;">
                                        @group.DateDisplay
                                    </MudText>

                                    <MudText Typo="Typo.caption" Color="Color.Default" Style="opacity: 0.5;">
                                        · @group.Count transactions
                                    </MudText>
                                </MudStack>

                                <MudText Typo="Typo.body2"
                                         Color="@GetGroupTotalColor(group.Total)"
                                         Style="font-weight: 500; opacity: 0.7;">
                                    @FormatCurrency(group.Total)
                                </MudText>
                            </MudStack>
                        </TitleContent>

                        <ChildContent>
                            @foreach (var transaction in group.Transactions)
                            {
                                <MudPaper Elevation="0"
                                          Class="px-4 py-3"
                                          Style="border-bottom: 1px solid var(--mud-palette-divider);">
                                    <MudStack Row="true"
                                              AlignItems="AlignItems.Center"
                                              Justify="Justify.SpaceBetween">

                                        @* LEFT: Checkbox + Avatar + Transaction Info *@
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex: 3;">
                                            <MudCheckBox T="bool"
                                                         Dense="true"
                                                         Size="Size.Medium"
                                                         Value="@_selectedTransactionIds.Contains(transaction.Id)"
                                                         ValueChanged="@(value => ToggleTransactionSelection(transaction.Id, value))"
                                                         @onclick:stopPropagation="true" />

                                            <MudAvatar Size="Size.Medium"
                                                       Style="@($"background-color: {transaction.GetTransactionColor()}; width: 40px; height: 40px;")">
                                                <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                    @transaction.Name.Substring(0, 1).ToUpper()
                                                </MudText>
                                            </MudAvatar>

                                            <MudStack Spacing="0">
                                                <MudLink Typo="Typo.body1"
                                                         Class="font-weight-bold"
                                                         Underline="Underline.Hover"
                                                         OnClick="@(() => ViewTransaction(transaction.Id))"
                                                         Style="cursor: pointer; line-height: 1.4; font-size: 0.95rem;">
                                                    @transaction.Name
                                                </MudLink>

                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    @if (transaction.IsTransfer())
                                                    {
                                                        <MudChip T="string"
                                                                 Size="Size.Small"
                                                                 Color="Color.Info"
                                                                 Variant="Variant.Outlined"
                                                                 Style="height: 20px; font-size: 0.7rem;">
                                                            Transfer Out
                                                        </MudChip>
                                                    }
                                                    else
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Default" Style="opacity: 0.7; font-size: 0.8rem;">
                                                            @(transaction.IsIncome() ? "Income" : "Expense")
                                                        </MudText>
                                                    }

                                                    @if (transaction.Account != null)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Default" Style="opacity: 0.5;">-</MudText>
                                                        <MudLink Typo="Typo.caption"
                                                                 Class="font-weight-bold"
                                                                 Underline="Underline.Hover"
                                                                 OnClick="@(() => {})"
                                                                 Style="cursor: pointer; font-size: 0.8rem;">
                                                            @transaction.Account.Name
                                                        </MudLink>
                                                    }
                                                </MudStack>
                                            </MudStack>
                                        </MudStack>

                                        @* CENTER: Category *@
                                        <div Style="flex: 1;">
                                            @if (transaction.Category != null)
                                            {
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                    <MudAvatar Size="Size.Small"
                                                               Style="@($"background-color: {transaction.Category.Color}; width: 28px; height: 28px;")">
                                                        <MudIcon Icon="@transaction.Category.Icon.ToIcon()"
                                                                 Color="Color.Surface"
                                                                 Size="Size.Small" />
                                                    </MudAvatar>
                                                    <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                                        @transaction.Category.Name
                                                    </MudText>
                                                </MudStack>
                                            }
                                            else
                                            {
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                    <MudAvatar Size="Size.Small" Color="Color.Default" Style="width: 28px; height: 28px;">
                                                        <MudIcon Icon="@Icons.Material.Filled.QuestionMark" Size="Size.Small" />
                                                    </MudAvatar>
                                                    <MudText Typo="Typo.body2" Color="Color.Default" Style="opacity: 0.6;">
                                                        Uncategorized
                                                    </MudText>
                                                </MudStack>
                                            }
                                        </div>

                                        @* RIGHT: Amount + Menu *@
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex: 1; justify-content: flex-end;">
                                            <MudText Typo="Typo.h6"
                                                     Class="font-weight-bold"
                                                     Color="@GetAmountColor(transaction)"
                                                     Style="font-size: 1.1rem;">
                                                @transaction.GetAmountDisplay()
                                            </MudText>

                                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                                     Size="Size.Small"
                                                     Dense="true"
                                                     AnchorOrigin="Origin.BottomRight"
                                                     TransformOrigin="Origin.TopRight"
                                                     @onclick:stopPropagation="true">
                                                <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                                             OnClick="@(() => ViewTransaction(transaction.Id))">
                                                    View Details
                                                </MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                                             OnClick="@(() => EditTransaction(transaction.Id))">
                                                    Edit
                                                </MudMenuItem>
                                                <MudDivider />
                                                <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                                             OnClick="@(() => DeleteTransaction(transaction.Id, transaction.Name))">
                                                    <MudText Color="Color.Error">Delete</MudText>
                                                </MudMenuItem>
                                            </MudMenu>
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>

            <!-- Paginación -->
            <PaginationWithPageSize CurrentPage="@_currentPage"
                                    TotalPages="@_totalPages"
                                    TotalItems="@_totalTransactions"
                                    @bind-PageSize="_rowsPerPage"
                                    @bind-PageSize:after="OnRowsPerPageChanged"
                                    OnPageChanged="OnPageChanged"
                                    ItemName="transactions"
                                    PageSizeOptions="@(new List<int> { 5, 10, 25, 50, 100 })" />

        }
        else
        {
            <!-- Enhanced Empty State -->
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-8">
                @if (_hasActiveFilters)
                {
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff"
                             Size="Size.Large"
                             Color="Color.Default"
                             Style="font-size: 4rem;"
                             Class="mb-4" />
                    <MudText Typo="Typo.h6" Class="mb-2">No transactions found</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Default" Class="mb-4">
                        No transactions match your current filters. Try adjusting your search criteria.
                    </MudText>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               OnClick="ClearAllFilters">
                        Clear All Filters
                    </MudButton>
                }
                else
                {
                    <MudStack AlignItems="AlignItems.Center" Spacing="4" Style="padding: 64px 0;">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt"
                                 Size="Size.Large"
                                 Color="Color.Default"
                                 Style="font-size: 4rem;" />

                        <MudText Typo="Typo.h6">
                            No transactions yet
                        </MudText>

                        <MudText Typo="Typo.body1"
                                 Color="Color.Default"
                                 Align="Align.Center"
                                 Style="max-width: 350px;">
                            Click the
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Primary"
                                     Icon="@Icons.Material.Filled.Add">
                                Add
                            </MudChip>
                            button to create your first transaction
                        </MudText>

                        <MudIcon Icon="@Icons.Material.Filled.SouthEast"
                                 Size="Size.Large"
                                 Color="Color.Primary" />
                    </MudStack>
                }
            </MudStack>
        }
    </MudPaper>

    <TransactionFilters @bind-IsOpen="_filtersDrawerOpen"
                        Filter="_filterDto"
                        OnFilterChanged="OnFilterChanged"
                        OnFiltersApplied="LoadTransactionsAsync"
                        OnFiltersInitialized="OnFiltersInitialized" />

    <QuickActionsFab OnTransactionAdded="@OnTransactionChanged" />

    <!-- Selection Action Bar -->
    <SelectionActionBar SelectedCount="@SelectedCount"
                        OnClearSelection="ClearSelection"
                        OnDeleteSelected="DeleteSelectedTransactions" />
</MudContainer>

@code {
    private bool _filtersDrawerOpen = false;
    private List<CategoryDto>? _categories;
    private List<AccountDto>? _accounts;

    private TransactionSummaryDto? _transactionSummary;
    private TransactionFilterDto _filterDto = new() { TimePeriod = TimePeriodFilter.ThisMonth };
    private bool _loading = true;
    private bool _hasActiveFilters = false;
    private bool _filtersLoaded = false;

    private List<TransactionGroup> _groupedTransactions = new();
    private int _currentPage = 1;
    private int _totalPages = 1;
    private int _rowsPerPage = 10;
    private int _totalTransactions = 0;

    // Selection state
    private HashSet<int> _selectedTransactionIds = new();
    private int SelectedCount => _selectedTransactionIds.Count;

    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Home", href: "/", disabled: false, icon: Icons.Material.Filled.Home),
        new BreadcrumbItem("Transactions", href: null, disabled: true, icon: Icons.Material.Filled.Receipt)
    };

    private DialogOptions _dialogOptions = new()
    {
        CloseButton = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Large
    };

    public class TransactionGroup
    {
        public DateTime Date { get; set; }
        public string DateDisplay => Date.ToString("MMMM dd, yyyy");
        public List<TransactionDto> Transactions { get; set; } = new();
        public int Count => Transactions.Count;
        public decimal Total => Transactions.Sum(t => t.IsIncome() ? t.Amount : -t.Amount);
    }

    private void ToggleFiltersDrawer()
    {
        _filtersDrawerOpen = !_filtersDrawerOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        _loading = false;
    }

    private async Task LoadTransactionsAsync()
    {
        _loading = true;
        _selectedTransactionIds.Clear();
        StateHasChanged();

        try
        {
            var result = await TransactionService.GetFilteredAsync(_filterDto);
            if (result.Success)
            {
                _transactionSummary = result.Data ?? new TransactionSummaryDto();
            }
            else
            {
                Snackbar.Add(result.Message ?? "Error loading transactions", Severity.Error);
                _transactionSummary = new TransactionSummaryDto();
            }

            _hasActiveFilters = HasActiveFilters();
            GroupTransactions();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading data: " + ex.Message, Severity.Error);
            _transactionSummary = new TransactionSummaryDto();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void GroupTransactions()
    {
        if (_transactionSummary?.Transactions?.Any() != true)
        {
            _groupedTransactions = new();
            _totalPages = 1;
            _totalTransactions = 0;
            return;
        }

        _totalTransactions = _transactionSummary.Transactions.Count;
        _totalPages = (int)Math.Ceiling(_totalTransactions / (double)_rowsPerPage);

        var pagedTransactions = _transactionSummary.Transactions
            .OrderByDescending(t => t.Date)
            .Skip((_currentPage - 1) * _rowsPerPage)
            .Take(_rowsPerPage)
            .ToList();

        _groupedTransactions = pagedTransactions
            .GroupBy(t => t.Date.Date)
            .OrderByDescending(g => g.Key)
            .Select(g => new TransactionGroup
            {
                Date = g.Key,
                Transactions = g.OrderByDescending(t => t.Date).ToList()
            })
            .ToList();
    }

    private void OnPageChanged(int page)
    {
        _currentPage = page;
        GroupTransactions();
    }

    private void OnRowsPerPageChanged()
    {
        _currentPage = 1;
        GroupTransactions();
    }

    // Selection methods
    private bool IsGroupSelected(TransactionGroup group)
    {
        return group.Transactions.All(t => _selectedTransactionIds.Contains(t.Id));
    }

    private void ToggleGroupSelection(TransactionGroup group, bool selected)
    {
        if (selected)
        {
            foreach (var transaction in group.Transactions)
            {
                _selectedTransactionIds.Add(transaction.Id);
            }
        }
        else
        {
            foreach (var transaction in group.Transactions)
            {
                _selectedTransactionIds.Remove(transaction.Id);
            }
        }
        StateHasChanged();
    }

    private void ToggleTransactionSelection(int transactionId, bool selected)
    {
        if (selected)
        {
            _selectedTransactionIds.Add(transactionId);
        }
        else
        {
            _selectedTransactionIds.Remove(transactionId);
        }
        StateHasChanged();
    }

    private void ClearSelection()
    {
        _selectedTransactionIds.Clear();
        StateHasChanged();
    }

    private async Task DeleteSelectedTransactions()
    {
        if (_selectedTransactionIds.Count == 0) return;

        bool confirmed = await DialogService.ShowConfirmDialogAsync(
            "Delete Transactions",
            $"Are you sure you want to delete {_selectedTransactionIds.Count} transaction(s)? This action cannot be undone.",
            "Delete",
            Color.Error
        );

        if (confirmed)
        {
            try
            {
                int successCount = 0;
                int failCount = 0;

                foreach (var transactionId in _selectedTransactionIds.ToList())
                {
                    var result = await TransactionService.DeleteAsync(transactionId);
                    if (result.Success)
                    {
                        successCount++;
                    }
                    else
                    {
                        failCount++;
                    }
                }

                if (successCount > 0)
                {
                    Snackbar.Add($"{successCount} transaction(s) deleted successfully", Severity.Success);
                    _selectedTransactionIds.Clear();
                    await LoadTransactionsAsync();
                }

                if (failCount > 0)
                {
                    Snackbar.Add($"Failed to delete {failCount} transaction(s)", Severity.Warning);
                }
            }
            catch (Exception)
            {
                Snackbar.Add("Error deleting transactions", Severity.Error);
            }
        }
    }

    private string FormatCurrency(decimal amount)
    {
        return amount < 0 ? $"-${Math.Abs(amount):N2}" : $"${amount:N2}";
    }

    private Color GetGroupTotalColor(decimal total)
    {
        return total switch
        {
            > 0 => Color.Success,
            < 0 => Color.Error,
            _ => Color.Default
        };
    }

    private Color GetAmountColor(TransactionDto transaction)
    {
        if (transaction.IsIncome()) return Color.Success;
        if (transaction.IsExpense()) return Color.Error;
        return Color.Default;
    }

    private async Task OnFilterChanged(TransactionFilterDto filter)
    {
        _filterDto = filter;
    }

    private bool HasActiveFilters()
    {
        return _filterDto.TimePeriod != TimePeriodFilter.ThisMonth ||
               _filterDto.AccountIds?.Any() == true ||
               !string.IsNullOrWhiteSpace(_filterDto.SearchText) ||
               _filterDto.CategoryId.HasValue ||
               _filterDto.Type.HasValue;
    }

    private async Task ClearAllFilters()
    {
        _filterDto = new TransactionFilterDto { TimePeriod = TimePeriodFilter.ThisMonth };
        await LoadTransactionsAsync();
    }

    private async Task ExportTransactions()
    {
        try
        {
            if (_transactionSummary?.Transactions?.Any() == true)
            {
                Snackbar.Add($"Exported {_transactionSummary.TotalCount} transactions", Severity.Success);
            }
            else
            {
                Snackbar.Add("No transactions to export", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export error: {ex.Message}", Severity.Error);
        }
    }

    private async Task ViewTransaction(int transactionId)
    {
        var parameters = new DialogParameters
        {
            ["TransactionId"] = transactionId,
            ["OnTransactionChanged"] = EventCallback.Factory.Create(this, OnTransactionChanged)
        };

        await DialogService.ShowAsync<ViewTransactionModal>("Transaction Details", parameters, _dialogOptions);
    }

    private async Task EditTransaction(int transactionId)
    {
        var parameters = new DialogParameters
        {
            ["TransactionId"] = transactionId,
            ["OnTransactionUpdated"] = EventCallback.Factory.Create(this, OnTransactionChanged)
        };

        await DialogService.ShowAsync<UpdateTransactionModal>("Edit Transaction", parameters, _dialogOptions);
    }

    private async Task DeleteTransaction(int transactionId, string transactionName)
    {
        bool confirmed = await DialogService.ShowConfirmDialogAsync(
            "Delete Transaction",
            $"Are you sure you want to delete '{transactionName}'? This action cannot be undone.",
            "Delete",
            Color.Error
        );

        if (confirmed)
        {
            try
            {
                var result = await TransactionService.DeleteAsync(transactionId);
                if (result.Success)
                {
                    Snackbar.Add("Transaction deleted successfully", Severity.Success);
                    await OnTransactionChanged();
                }
                else
                {
                    Snackbar.Add(result.Message ?? "Error deleting transaction", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add("Error: " + ex.Message, Severity.Error);
            }
        }
    }

    private async Task OnTransactionChanged()
    {
        await LoadTransactionsAsync();
    }

    private async Task OnFiltersInitialized()
    {
        if (!_filtersLoaded)
        {
            _filtersLoaded = true;
            await LoadFilterData();
            await LoadTransactionsAsync();
        }
    }

    private async Task LoadFilterData()
    {
        try
        {
            var categoriesResult = await CategoryService.GetAllAsync();
            if (categoriesResult.Success)
            {
                _categories = categoriesResult.Data?.ToList();
            }

            var accountsResult = await AccountService.GetAccountsWithBalancesAsync();
            if (accountsResult.Success)
            {
                _accounts = accountsResult.Data?.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading filter data: {ex.Message}", Severity.Warning);
        }
    }

    private async Task OnFilterRemoved(string filterType)
    {
        await LoadTransactionsAsync();
    }
}