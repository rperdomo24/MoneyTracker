@page "/transactions"
@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums
@using MoneyTracker.UI.Helpers
@inject ITransactionService TransactionService
@inject ICategoryService CategoryService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Transactions - MoneyTracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
    <!-- Header Section -->
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold mb-2">Transactions</MudText>
            <MudText Typo="Typo.body1" Class="text-muted">
                Manage your income and expenses
                @if (_transactions?.Any() == true)
                {
                    <span> • @_transactions.Count total transactions</span>
                }
            </MudText>
        </div>
        <div class="d-flex ga-2">
            <MudButton Variant="Variant.Outlined"
                       Color="@TransactionType.Income.GetMudColor()"
                       StartIcon="@TransactionType.Income.GetIcon()"
                       OnClick="@(() => AddTransaction(TransactionType.Income))">
                Add Income
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="@TransactionType.Expense.GetMudColor()"
                       StartIcon="@Icons.Material.Filled.Remove"
                       OnClick="@(() => AddTransaction(TransactionType.Expense))">
                Add Expense
            </MudButton>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    @if (_transactions?.Any() == true)
    {
        <MudGrid Class="mb-6">
            <!-- Total Income Card -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 text-center" Elevation="2" Style="@($"border-top: 4px solid {TransactionType.Income.GetHexColor()};")">
                    <MudIcon Icon="@TransactionType.Income.GetIcon()" 
                             Color="@TransactionType.Income.GetMudColor()" 
                             Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="@($"font-weight-bold {CategoryType.Income.GetCategoryTypeMudColor().ToString().ToLower()}")">
                        @_totalIncome.ToString("C")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">Total Income</MudText>
                </MudPaper>
            </MudItem>
            
            <!-- Total Expenses Card -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 text-center" Elevation="2" Style="@($"border-top: 4px solid {TransactionType.Expense.GetHexColor()};")">
                    <MudIcon Icon="@TransactionType.Expense.GetIcon()" 
                             Color="@TransactionType.Expense.GetMudColor()" 
                             Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="@($"font-weight-bold {CategoryType.Expense.GetCategoryTypeMudColor().ToString().ToLower()}")">
                        @_totalExpense.ToString("C")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">Total Expenses</MudText>
                </MudPaper>
            </MudItem>
            
            <!-- Balance Card -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 text-center" Elevation="2" Style="@GetBalanceCardStyle()">
                    <MudIcon Icon="@GetBalanceIcon()"
                             Color="@GetBalanceColor()"
                             Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="@GetBalanceTextClass()">
                        @_balance.ToString("C")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">Balance</MudText>
                </MudPaper>
            </MudItem>
            
            <!-- Total Transactions Card -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 text-center" Elevation="2" Style="border-top: 4px solid #2196F3;">
                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Info" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="font-weight-bold text-info">@_transactions.Count</MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">Total Transactions</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    <!-- Filters Section -->
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string"
                              Label="Search"
                              @bind-Value="_searchText"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Placeholder="Search by name or description..."
                              Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string"
                           Label="Category"
                           @bind-Value="_selectedCategoryString"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    @if (_categories?.Any() == true)
                    {
                        @foreach (var category in _categories)
                        {
                            <MudSelectItem Value="@category.Id.ToString()">
                                <div class="d-flex align-center">
                                    <MudIcon Icon="@category.Icon.ToIcon()"
                                             Style="@($"color: {category.Color};")"
                                             Class="mr-2"
                                             Size="Size.Small" />
                                    @category.Name
                                </div>
                            </MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string"
                           Label="Type"
                           @bind-Value="_selectedTypeString"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    <MudSelectItem Value="@("Income")">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@CategoryType.Income.GetCategoryTypeIcon()" 
                                     Color="@CategoryType.Income.GetCategoryTypeMudColor()" 
                                     Class="mr-2" Size="Size.Small" />
                            Income
                        </div>
                    </MudSelectItem>
                    <MudSelectItem Value="@("Expense")">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@CategoryType.Expense.GetCategoryTypeIcon()" 
                                     Color="@CategoryType.Expense.GetCategoryTypeMudColor()" 
                                     Class="mr-2" Size="Size.Small" />
                            Expense
                        </div>
                    </MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="d-flex ga-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="ApplyFilters"
                               FullWidth="true">
                        Apply Filters
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               OnClick="ClearFilters">
                        Clear
                    </MudButton>
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Transactions Table -->
    <MudPaper Elevation="2">
        @if (_loading)
        {
            <div class="text-center pa-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                <MudText Class="mt-4">Loading transactions...</MudText>
            </div>
        }
        else if (_filteredTransactions?.Any() == true)
        {
            <MudTable T="TransactionDto"
                      Items="@_filteredTransactions"
                      Dense="true"
                      Hover="true"
                      Breakpoint="Breakpoint.Sm"
                      Loading="@_loading"
                      LoadingProgressColor="Color.Info">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<TransactionDto, object>(x => x.Date)">Date</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TransactionDto, object>(x => x.Name)">Name</MudTableSortLabel></MudTh>
                    <MudTh>Category</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TransactionDto, object>(x => x.Amount)">Amount</MudTableSortLabel></MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Date">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-2 text-muted" />
                            <div>
                                <MudText Typo="Typo.body2" Class="font-weight-medium">@context.GetShortFormattedDate()</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">@context.Date.Year</MudText>
                            </div>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Name">
                        <MudText Typo="Typo.body2" Class="font-weight-medium">@context.Name</MudText>
                    </MudTd>
                    <MudTd DataLabel="Category">
                        @if (context.Category is not null)
                        {
                            <div class="d-flex align-center">
                                <MudAvatar Size="Size.Small"
                                           Style="@($"background-color: {context.Category.Color}; margin-right: 8px;")">
                                    <MudIcon Icon="@context.Category.Icon.ToIcon()"
                                             Color="Color.Surface"
                                             Size="Size.Small" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body2">@context.Category.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="text-muted">@context.Category.Type.ToString()</MudText>
                                </div>
                            </div>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">Uncategorized</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Amount">
                        <MudText Typo="Typo.body1" Class="@($"font-weight-bold {context.GetAmountColorClass()}")">
                            @context.GetAmountDisplay()
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Description">
                        @if (!string.IsNullOrWhiteSpace(context.Description))
                        {
                            <MudText Typo="Typo.body2" Class="text-muted">
                                @(context.Description.Length > 30 ? context.Description.Substring(0, 30) + "..." : context.Description)
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="text-muted font-italic">No description</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <div class="d-flex ga-1">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           OnClick="@(() => ViewTransaction(context.Id))"
                                           Title="View Details" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => EditTransaction(context.Id))"
                                           Title="Edit Transaction" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteTransaction(context.Id, context.Name))"
                                           Title="Delete Transaction" />
                        </div>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
                </PagerContent>
            </MudTable>
        }
        else
        {
            <!-- Empty State -->
            <div class="text-center pa-8">
                @if (string.IsNullOrWhiteSpace(_searchText) && string.IsNullOrWhiteSpace(_selectedCategoryString) && string.IsNullOrWhiteSpace(_selectedTypeString))
                {
                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Large" Class="text-muted mb-4" Style="font-size: 4rem;" />
                    <MudText Typo="Typo.h6" Class="mb-2">No transactions yet</MudText>
                    <MudText Typo="Typo.body1" Class="text-muted mb-4">
                        Start by adding your first income or expense transaction.
                    </MudText>
                    <div class="d-flex justify-center ga-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="@TransactionType.Income.GetMudColor()"
                                   StartIcon="@TransactionType.Income.GetIcon()"
                                   OnClick="@(() => AddTransaction(TransactionType.Income))">
                            Add Income
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="@TransactionType.Expense.GetMudColor()"
                                   StartIcon="@Icons.Material.Filled.Remove"
                                   OnClick="@(() => AddTransaction(TransactionType.Expense))">
                            Add Expense
                        </MudButton>
                    </div>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="text-muted mb-4" Style="font-size: 4rem;" />
                    <MudText Typo="Typo.h6" Class="mb-2">No transactions found</MudText>
                    <MudText Typo="Typo.body1" Class="text-muted mb-4">
                        Try adjusting your search criteria or filters.
                    </MudText>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               OnClick="ClearFilters">
                        Clear Filters
                    </MudButton>
                }
            </div>
        }
    </MudPaper>
</MudContainer>

@code {
    private List<TransactionDto>? _transactions;
    private List<TransactionDto>? _filteredTransactions;
    private List<CategoryDto>? _categories;
    private bool _loading = true;

    // Stats
    private decimal _totalIncome;
    private decimal _totalExpense;
    private decimal _balance;

    // Filters
    private string _searchText = string.Empty;
    private string _selectedCategoryString = string.Empty;
    private string _selectedTypeString = string.Empty;

    // Dialog options
    private DialogOptions _dialogOptions = new()
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Large
        };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;

        try
        {
            // Load transactions
            var transactionsResult = await TransactionService.GetAllAsync();
            if (transactionsResult.Success)
            {
                _transactions = transactionsResult.Data?.ToList() ?? new List<TransactionDto>();
                CalculateStats();
                ApplyFilters();
            }
            else
            {
                Snackbar.Add(transactionsResult.Message ?? "Error loading transactions", Severity.Error);
                _transactions = new List<TransactionDto>();
                _filteredTransactions = new List<TransactionDto>();
            }

            // Load categories for filters
            var categoriesResult = await CategoryService.GetAllAsync();
            if (categoriesResult.Success)
            {
                _categories = categoriesResult.Data?.ToList() ?? new List<CategoryDto>();
            }
            else
            {
                Snackbar.Add(categoriesResult.Message ?? "Error loading categories", Severity.Warning);
                _categories = new List<CategoryDto>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading data: " + ex.Message, Severity.Error);
            _transactions = new List<TransactionDto>();
            _filteredTransactions = new List<TransactionDto>();
            _categories = new List<CategoryDto>();
        }
        finally
        {
            _loading = false;
        }
    }

    private void CalculateStats()
    {
        if (_transactions?.Any() != true)
        {
            _totalIncome = 0;
            _totalExpense = 0;
            _balance = 0;
            return;
        }

        _totalIncome = _transactions
            .Where(t => t.IsIncome())
            .Sum(t => t.Amount);

        _totalExpense = _transactions
            .Where(t => t.IsExpense())
            .Sum(t => t.Amount);

        _balance = _totalIncome - _totalExpense;
    }

    private void ApplyFilters()
    {
        if (_transactions == null)
        {
            _filteredTransactions = new List<TransactionDto>();
            return;
        }

        var filtered = _transactions.AsEnumerable();

        // Search filter
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var searchLower = _searchText.ToLower();
            filtered = filtered.Where(t =>
                t.Name.ToLower().Contains(searchLower) ||
                (!string.IsNullOrWhiteSpace(t.Description) && t.Description.ToLower().Contains(searchLower)));
        }

        // Category filter
        if (!string.IsNullOrWhiteSpace(_selectedCategoryString) && int.TryParse(_selectedCategoryString, out int categoryId))
        {
            filtered = filtered.Where(t => t.CategoryId == categoryId);
        }

        // Type filter
        if (!string.IsNullOrWhiteSpace(_selectedTypeString))
        {
            var targetType = _selectedTypeString == "Income" ? CategoryType.Income : CategoryType.Expense;
            filtered = filtered.Where(t => t.Category?.Type == targetType);
        }

        _filteredTransactions = filtered
            .OrderByDescending(t => t.Date)
            .ThenByDescending(t => t.CreatedAt)
            .ToList();

        StateHasChanged();
    }

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _selectedCategoryString = string.Empty;
        _selectedTypeString = string.Empty;
        ApplyFilters();
    }

    // Transaction Actions
    private async Task AddTransaction(TransactionType transactionType)
    {
        var parameters = new DialogParameters
            {
                ["TransactionType"] = transactionType,
                ["OnTransactionAdded"] = EventCallback.Factory.Create(this, OnTransactionChanged)
            };

        var title = transactionType == TransactionType.Income ? "Add Income" : "Add Expense";
        await DialogService.ShowAsync<AddTransactionModal>(title, parameters, _dialogOptions);
    }

    private async Task ViewTransaction(int transactionId)
    {
        var parameters = new DialogParameters
            {
                ["TransactionId"] = transactionId,
                ["OnTransactionChanged"] = EventCallback.Factory.Create(this, OnTransactionChanged)
            };

        await DialogService.ShowAsync<ViewTransactionModal>("Transaction Details", parameters, _dialogOptions);
    }

    private async Task EditTransaction(int transactionId)
    {
        var parameters = new DialogParameters
            {
                ["TransactionId"] = transactionId,
                ["OnTransactionUpdated"] = EventCallback.Factory.Create(this, OnTransactionChanged)
            };

        await DialogService.ShowAsync<UpdateTransactionModal>("Edit Transaction", parameters, _dialogOptions);
    }

    private async Task DeleteTransaction(int transactionId, string transactionName)
    {
        bool confirmed = await DialogService.ShowConfirmDialogAsync(
            "Delete Transaction",
            $"Are you sure you want to delete '{transactionName}'? This action cannot be undone.",
            "Delete",
            Color.Error
        );

        if (confirmed)
        {
            try
            {
                var result = await TransactionService.DeleteAsync(transactionId);
                if (result.Success)
                {
                    Snackbar.Add("Transaction deleted successfully", Severity.Success);
                    await OnTransactionChanged();
                }
                else
                {
                    Snackbar.Add(result.Message ?? "Error deleting transaction", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add("Error: " + ex.Message, Severity.Error);
            }
        }
    }

    private async Task OnTransactionChanged()
    {
        await LoadData();
    }

    private string GetBalanceCardStyle()
    {
        var color = _balance >= 0 ? TransactionType.Income.GetHexColor() : TransactionType.Expense.GetHexColor();
        return $"border-top: 4px solid {color};";
    }

    private string GetBalanceIcon()
    {
        return _balance >= 0 ? Icons.Material.Filled.AccountBalance : Icons.Material.Filled.Warning;
    }

    private Color GetBalanceColor()
    {
        return _balance >= 0 ? Color.Success : Color.Error;
    }

    private string GetBalanceTextClass()
    {
        return $"font-weight-bold {(_balance >= 0 ? "text-success" : "text-error")}";
    }

    // Filter change handlers
    private async Task OnSearchChanged(string value)
    {
        _searchText = value;
        await Task.Delay(300); 
        ApplyFilters();
    }

    private void OnCategoryChanged(string value)
    {
        _selectedCategoryString = value;
        ApplyFilters();
    }

    private void OnTypeChanged(string value)
    {
        _selectedTypeString = value;
        ApplyFilters();
    }
}