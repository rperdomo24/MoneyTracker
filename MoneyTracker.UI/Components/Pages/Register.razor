@page "/register"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@using Microsoft.Extensions.Options
@using MoneyTracker.Application.Constants.Configuration
@inject IOptions<ApplicationSettings> ApplicationOptions

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-12">
    <MudPaper Class="pa-6">
        @if (ApplicationOptions.Value.EnablePublicRegistration)
        {
            <MudText Typo="Typo.h5" Class="mb-4">Create account</MudText>

            <form method="post" action="/auth/register">
                <AntiforgeryToken />
                <MudText Typo="Typo.caption" Class="mb-1 d-block">Display name (optional)</MudText>
                <input type="text"
                       name="displayName"
                       @bind="_displayName"
                       autocomplete="name"
                       class="mud-input-slot mud-input-root mud-input-root-outlined"
                       style="width:100%; padding: 14px 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;" />
                <MudText Typo="Typo.caption" Class="mb-1 mt-3 d-block">Email</MudText>
                <input type="email"
                       name="email"
                       @bind="_email"
                       autocomplete="username"
                       class="mud-input-slot mud-input-root mud-input-root-outlined"
                       style="width:100%; padding: 14px 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;" />
                <MudText Typo="Typo.caption" Class="mb-1 mt-3 d-block">Password</MudText>
                <div style="position: relative;">
                    <input type="@(_showPassword ? "text" : "password")"
                           name="password"
                           @bind="_password"
                           autocomplete="new-password"
                           class="mud-input-slot mud-input-root mud-input-root-outlined"
                           style="width:100%; padding: 14px 42px 14px 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;" />
                    <MudIconButton Icon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                   OnClick="TogglePasswordVisibility"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   ButtonType="ButtonType.Button"
                                   Style="position: absolute; right: 6px; top: 50%; transform: translateY(-50%);" />
                </div>
                <MudText Typo="Typo.caption" Class="mb-1 mt-3 d-block">Confirm password</MudText>
                <div style="position: relative;">
                    <input type="@(_showConfirmPassword ? "text" : "password")"
                           name="confirmPassword"
                           @bind="_confirmPassword"
                           autocomplete="new-password"
                           class="mud-input-slot mud-input-root mud-input-root-outlined"
                           style="width:100%; padding: 14px 42px 14px 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;" />
                    <MudIconButton Icon="@(_showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                   OnClick="ToggleConfirmPasswordVisibility"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   ButtonType="ButtonType.Button"
                                   Style="position: absolute; right: 6px; top: 50%; transform: translateY(-50%);" />
                </div>

                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@Error</MudAlert>
                }

                @if (!string.IsNullOrWhiteSpace(Info))
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@Info</MudAlert>
                }

                <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" Class="mt-4">
                    Create account
                </MudButton>
            </form>
        }
        else
        {
            <MudText Typo="Typo.h5" Class="mb-4">Closed beta</MudText>
            <MudText Typo="Typo.body1">
                Public registration is disabled while beta access is managed by invitation.
            </MudText>
            <MudText Typo="Typo.body2" Class="mt-3">
                If you already have an invite link, open it to finish your registration.
            </MudText>
        }

        <MudText Typo="Typo.body2" Class="mt-4">
            Already have an account? <MudLink Href="/login">Sign in</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? DisplayName { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Info { get; set; }

    private string _displayName = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _showPassword;
    private bool _showConfirmPassword;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(DisplayName))
        {
            _displayName = DisplayName;
        }

        if (!string.IsNullOrWhiteSpace(Email))
        {
            _email = Email;
        }
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        _showConfirmPassword = !_showConfirmPassword;
    }
}
