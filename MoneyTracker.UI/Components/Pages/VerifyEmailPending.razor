@page "/verify-email-pending"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout

<MudText Typo="Typo.h5" Align="Align.Center" Class="font-weight-bold">Verify your email</MudText>
<MudText Typo="Typo.body2" Align="Align.Center" Class="mb-3">
    Your account exists but email confirmation is still pending.
</MudText>

@if (!string.IsNullOrWhiteSpace(Info))
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@Info</MudAlert>
}

@if (!string.IsNullOrWhiteSpace(Error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@Error</MudAlert>
}

<form method="post" action="/auth/resend-confirmation">
    <AntiforgeryToken />
    <MudTextField @bind-Value="_email"
                  Label="Email"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  FullWidth="true" />
    <input type="hidden" name="email" value="@_email" />
    <MudButton ButtonType="ButtonType.Submit"
               Color="Color.Primary"
               Variant="Variant.Filled"
               FullWidth="true"
               Class="mt-4">
        Resend confirmation email
    </MudButton>
</form>

<MudButton Href="/login"
           Color="Color.Secondary"
           Variant="Variant.Text"
           FullWidth="true"
           Class="mt-2">
    Back to sign in
</MudButton>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Info { get; set; }

    private string _email = string.Empty;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Email))
        {
            _email = Email;
        }
    }
}
