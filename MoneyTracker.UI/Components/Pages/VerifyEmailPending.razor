@page "/verify-email-pending"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-12">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h5" Class="mb-2">Verify your email</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">
            Your account exists but email confirmation is still pending.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(Info))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@Info</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@Error</MudAlert>
        }

        <form method="post" action="/auth/resend-confirmation">
            <AntiforgeryToken />
            <MudTextField @bind-Value="_email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <input type="hidden" name="email" value="@_email" />
            <MudButton ButtonType="ButtonType.Submit"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Class="mt-4">
                Resend confirmation email
            </MudButton>
        </form>

        <MudText Typo="Typo.body2" Class="mt-3">
            <MudLink Href="/login">Back to sign in</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Info { get; set; }

    private string _email = string.Empty;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Email))
        {
            _email = Email;
        }
    }
}
