@page "/invite/register"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@using MoneyTracker.Application.Interfaces
@inject IUserInvitationService UserInvitationService

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-12">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h5" Class="mb-4">Create account</MudText>

        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
        }
        else
        {
            <form method="post" action="/auth/invite-register">
                <AntiforgeryToken />
                <MudText Typo="Typo.caption" Class="mb-1 d-block">Email</MudText>
                <input type="email"
                       value="@_email"
                       readonly
                       autocomplete="email"
                       class="mud-input-slot mud-input-root mud-input-root-outlined"
                       style="width:100%; padding: 14px 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;" />
                <MudText Typo="Typo.caption" Class="mb-1 mt-3 d-block">Display name</MudText>
                <input type="text"
                       name="displayName"
                       @bind="_displayName"
                       autocomplete="name"
                       class="mud-input-slot mud-input-root mud-input-root-outlined"
                       style="width:100%; padding: 14px 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;" />
                <MudText Typo="Typo.caption" Class="mb-1 mt-3 d-block">Password</MudText>
                <input type="password"
                       name="password"
                       @bind="_password"
                       autocomplete="new-password"
                       class="mud-input-slot mud-input-root mud-input-root-outlined"
                       style="width:100%; padding: 14px 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;" />
                <MudText Typo="Typo.caption" Class="mb-1 mt-3 d-block">Confirm password</MudText>
                <input type="password"
                       name="confirmPassword"
                       @bind="_confirmPassword"
                       autocomplete="new-password"
                       class="mud-input-slot mud-input-root mud-input-root-outlined"
                       style="width:100%; padding: 14px 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;" />

                @if (!string.IsNullOrWhiteSpace(_info))
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@_info</MudAlert>
                }

                <input type="hidden" name="token" value="@Token" />

                <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" Class="mt-4">
                    Create account
                </MudButton>
            </form>
        }
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Info { get; set; }

    private bool _isLoading = true;
    private string _email = string.Empty;
    private string _displayName = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _error;
    private string? _info;

    protected override async Task OnInitializedAsync()
    {
        _error = Error;
        _info = Info;

        if (string.IsNullOrWhiteSpace(Token))
        {
            _error ??= "Invitation token is missing.";
            _isLoading = false;
            return;
        }

        var result = await UserInvitationService.GetValidInvitationAsync(Token);
        if (!result.Success || result.Data is null)
        {
            _error = result.Message;
            _isLoading = false;
            return;
        }

        _email = result.Data.Email;
        _isLoading = false;
    }
}
