@page "/settings"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using MoneyTracker.Application.DTOs.Auth
@using MoneyTracker.Application.DTOs.Gmail
@using MoneyTracker.Application.Constants.Configuration
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.UI.Components.Shared.EmailImport
@using MoneyTracker.UI.Helpers
@inject IUserProfileService UserProfileService
@inject IUserInvitationService UserInvitationService
@inject IEmailImportService EmailImportService
@inject IAccountService AccountService
@inject NavigationManager Navigation
@inject IOptions<ApplicationSettings> ApplicationOptions
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-1 pa-sm-0 mt-4 mt-sm-6 mb-4 mb-sm-6">
    <MudText Typo="Typo.h5" Class="mb-4">User Settings</MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Size="Size.Large" Color="Color.Primary" Style="overflow: hidden;">
                @if (!string.IsNullOrWhiteSpace(_avatarDataUrl))
                {
                    <MudImage Src="@_avatarDataUrl" Alt="User avatar" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Person" />
                }
            </MudAvatar>

            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@DisplayNameOrFallback</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_email</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-3">Profile</MudText>

        <MudTextField @bind-Value="_displayName" Label="Display name" Variant="Variant.Outlined" />
        <MudTextField Value="_email" Label="Email" Variant="Variant.Outlined" Class="mt-3" ReadOnly="true" />

        <MudStack Row="true" Spacing="2" Class="mt-3" AlignItems="AlignItems.Center">
            <InputFile OnChange="OnAvatarSelected" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Disabled="_isBusy || string.IsNullOrWhiteSpace(_avatarDataUrl)"
                       OnClick="RemoveAvatarAsync">
                Remove photo
            </MudButton>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2 d-block">Allowed: jpg, png, webp. Max size: 200KB.</MudText>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Class="mt-4"
                   OnClick="SaveProfileAsync"
                   Disabled="_isBusy">
            Save profile
        </MudButton>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-3">Change password</MudText>

        <MudTextField @bind-Value="_currentPassword"
                      Label="Current password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password" />
        <MudTextField @bind-Value="_newPassword"
                      Label="New password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Class="mt-3" />
        <MudTextField @bind-Value="_confirmPassword"
                      Label="Confirm new password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Class="mt-3" />

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Class="mt-4"
                   OnClick="ChangePasswordAsync"
                   Disabled="_isBusy">
            Update password
        </MudButton>
    </MudPaper>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.subtitle1" Class="mb-3">Security</MudText>
        <MudSwitch T="bool"
                   Value="_twoFactorEnabled"
                   ValueChanged="OnTwoFactorChanged"
                   Label="Require OTP on sign in"
                   Color="Color.Primary"
                   Disabled="_isBusy" />
        <MudText Typo="Typo.caption" Class="d-block mt-2">
            If enabled, password login requires an OTP code sent to your email.
        </MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.subtitle1" Class="mb-3">Account info</MudText>
        <MudText Typo="Typo.body2">Tenant: @_tenantId</MudText>
        <MudText Typo="Typo.body2">2FA enabled: @(_twoFactorEnabled ? "Yes" : "No")</MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.subtitle1" Class="mb-3">Beta invitations</MudText>
        <MudTextField @bind-Value="_inviteEmail"
                      Label="Invite email"
                      Variant="Variant.Outlined"
                      Disabled="_isBusy" />
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Class="mt-4"
                   OnClick="SendInviteAsync"
                   Disabled="_isBusy">
            Send invitation
        </MudButton>

        @if (!string.IsNullOrWhiteSpace(_latestInviteLink))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">
                Latest invite link:
                <MudLink Href="@_latestInviteLink" Target="_blank">@_latestInviteLink</MudLink>
            </MudAlert>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mt-4" id="email-import">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.subtitle1">Email import (Gmail)</MudText>
            @if (_pendingCount > 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="ReviewPendingAsync">
                    Review @_pendingCount pending
                </MudButton>
            }
        </MudStack>

        @if (_connection is null)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Connect your Gmail account to automatically detect bank transaction emails.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/integrations/gmail/connect">
                Connect Gmail
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-2">Connected as <b>@_connection.Email</b></MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                Last sync: @(_connection.LastSyncAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "never")
            </MudText>

            <MudStack Row="true" Spacing="2" Class="mb-3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_syncing" OnClick="SyncNowAsync">
                    @(_syncing ? "Syncing..." : "Sync now")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_isBusy" OnClick="DisconnectAsync">
                    Disconnect
                </MudButton>
            </MudStack>

            <MudSwitch T="bool"
                       Value="_autoSyncEnabled"
                       ValueChanged="OnAutoSyncChanged"
                       Label="Auto-sync in background"
                       Color="Color.Primary"
                       Disabled="_isBusy" />

            @if (_autoSyncEnabled)
            {
                <MudNumericField T="int"
                                 Value="_syncIntervalMinutes"
                                 Label="Interval (minutes)"
                                 Variant="Variant.Outlined"
                                 Min="15"
                                 Class="mt-2"
                                 Style="max-width: 220px"
                                 Immediate="false"
                                 ValueChanged="OnIntervalChanged" />
            }

            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Bank rules</MudText>
            @foreach (var rule in _rules)
            {
                <MudPaper Outlined="true" Class="@RuleRowClass(rule)" Style="cursor: pointer;" role="button" tabindex="0"
                          @onclick="@(() => StartEditRule(rule))" @onkeydown="@(e => OnRuleRowKeyDown(e, rule))">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1">@rule.BankLabel <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true">(@rule.SenderPattern)</MudText></MudText>
                            @if (!string.IsNullOrWhiteSpace(rule.SubjectExcludeKeywords))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Excludes: @rule.SubjectExcludeKeywords</MudText>
                            }
                        </MudStack>
                        <span @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           OnClick="@(() => DeleteRuleAsync(rule.Id))" />
                        </span>
                    </MudStack>
                </MudPaper>
            }

            <MudPaper Outlined="true" Class="pa-3 mt-2">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(IsEditingRule ? "Edit rule" : "New rule")</MudText>
                    <MudTextField @bind-Value="_ruleForm.BankLabel" Label="Bank name" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="_ruleForm.SenderPattern" Label="Sender email or domain (comma-separated)" Variant="Variant.Outlined"
                                  HelperText="e.g. bancocuscatlan.com, notificaciones@otrobanco.com" />
                    <MudTextField @bind-Value="_ruleForm.SubjectExcludeKeywords" Label="Exclude if subject contains (comma-separated)" Variant="Variant.Outlined"
                                  HelperText="e.g. inicio de sesion, codigo de acceso" />
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isBusy" OnClick="SaveRuleAsync">
                            @(IsEditingRule ? "Save changes" : "Add rule")
                        </MudButton>
                        @if (IsEditingRule)
                        {
                            <MudButton Variant="Variant.Text" Disabled="_isBusy" OnClick="ResetRuleForm">
                                Cancel
                            </MudButton>
                        }
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    </MudPaper>
</MudContainer>

@code {
    private const int MaxAvatarSizeBytes = 200 * 1024;
    private static readonly HashSet<string> AllowedContentTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "image/jpeg",
        "image/png",
        "image/webp"
    };

    private string? _displayName;
    private string? _email;
    private string _tenantId = "-";
    private bool _twoFactorEnabled;
    private string? _avatarDataUrl;

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _inviteEmail = string.Empty;
    private string? _latestInviteLink;
    private bool _isBusy;

    [SupplyParameterFromQuery(Name = "emailImport")] private string? EmailImportStatus { get; set; }
    [SupplyParameterFromQuery(Name = "message")] private string? EmailImportMessage { get; set; }

    private GmailConnectionDto? _connection;
    private List<EmailImportRuleDto> _rules = new();
    private EmailImportRuleDto _ruleForm = new();
    private int? _editingRuleId;
    private bool IsEditingRule => _editingRuleId.HasValue;
    private int _pendingCount;
    private bool _syncing;
    private bool _autoSyncEnabled;
    private int _syncIntervalMinutes = 30;

    private string DisplayNameOrFallback => string.IsNullOrWhiteSpace(_displayName) ? "User" : _displayName;
    private string PublicBaseUrl => string.IsNullOrWhiteSpace(ApplicationOptions.Value.PublicBaseUrl)
        ? Navigation.BaseUri.TrimEnd('/')
        : ApplicationOptions.Value.PublicBaseUrl.TrimEnd('/');

    protected override async Task OnInitializedAsync()
    {
        await LoadUserAsync();
        await LoadEmailImportAsync();

        if (!string.IsNullOrWhiteSpace(EmailImportMessage))
        {
            Snackbar.Add(EmailImportMessage, EmailImportStatus == "connected" ? Severity.Success : Severity.Error);
        }
    }

    private async Task LoadEmailImportAsync()
    {
        var connectionResult = await EmailImportService.GetConnectionAsync();
        if (connectionResult.Success)
        {
            _connection = connectionResult.Data;
            _autoSyncEnabled = _connection?.AutoSyncEnabled ?? false;
            _syncIntervalMinutes = _connection?.SyncIntervalMinutes ?? 30;
        }

        var rulesResult = await EmailImportService.GetRulesAsync();
        if (rulesResult.Success && rulesResult.Data is not null)
            _rules = rulesResult.Data;

        var pendingResult = await EmailImportService.GetPendingAsync();
        if (pendingResult.Success && pendingResult.Data is not null)
            _pendingCount = pendingResult.Data.Count;
    }

    private async Task SyncNowAsync()
    {
        _syncing = true;
        var result = await EmailImportService.SyncNowAsync();
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        if (result.Success)
        {
            await LoadEmailImportAsync();
        }
        _syncing = false;
    }

    private async Task DisconnectAsync()
    {
        var confirmed = await DialogService.ShowConfirmDialogAsync(
            "Disconnect Gmail",
            "This will stop email import and delete the stored connection. Continue?",
            "Disconnect",
            Color.Error,
            "Cancel");
        if (!confirmed) return;

        _isBusy = true;
        var result = await EmailImportService.DisconnectAsync();
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        if (result.Success)
        {
            _connection = null;
            _rules = new();
            ResetRuleForm();
        }
        _isBusy = false;
    }

    private async Task OnAutoSyncChanged(bool enabled)
    {
        _isBusy = true;
        var previous = _autoSyncEnabled;
        _autoSyncEnabled = enabled;

        var result = await EmailImportService.SetAutoSyncAsync(enabled, _syncIntervalMinutes);
        if (!result.Success)
        {
            _autoSyncEnabled = previous;
        }

        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        _isBusy = false;
    }

    private async Task OnIntervalChanged(int minutes)
    {
        _syncIntervalMinutes = minutes;
        if (!_autoSyncEnabled) return;

        var result = await EmailImportService.SetAutoSyncAsync(true, minutes);
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
    }

    private string RuleRowClass(EmailImportRuleDto rule) =>
        rule.Id == _editingRuleId ? "pa-3 mb-2 mud-border-primary" : "pa-3 mb-2";

    private void OnRuleRowKeyDown(KeyboardEventArgs e, EmailImportRuleDto rule)
    {
        if (e.Key is "Enter" or " ")
            StartEditRule(rule);
    }

    private void StartEditRule(EmailImportRuleDto rule)
    {
        _editingRuleId = rule.Id;
        _ruleForm = new EmailImportRuleDto
        {
            Id = rule.Id,
            SenderPattern = rule.SenderPattern,
            BankLabel = rule.BankLabel,
            SubjectIncludeKeywords = rule.SubjectIncludeKeywords,
            SubjectExcludeKeywords = rule.SubjectExcludeKeywords,
            DefaultAccountId = rule.DefaultAccountId,
            IsActive = rule.IsActive
        };
    }

    private void ResetRuleForm()
    {
        _editingRuleId = null;
        _ruleForm = new();
    }

    private async Task SaveRuleAsync()
    {
        if (string.IsNullOrWhiteSpace(_ruleForm.BankLabel) || string.IsNullOrWhiteSpace(_ruleForm.SenderPattern))
        {
            Snackbar.Add("Bank name and sender are required.", Severity.Error);
            return;
        }

        _isBusy = true;
        var result = await EmailImportService.SaveRuleAsync(_ruleForm);
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        if (result.Success)
        {
            ResetRuleForm();
            var rulesResult = await EmailImportService.GetRulesAsync();
            if (rulesResult.Success && rulesResult.Data is not null)
                _rules = rulesResult.Data;
        }
        _isBusy = false;
    }

    private async Task DeleteRuleAsync(int id)
    {
        var result = await EmailImportService.DeleteRuleAsync(id);
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        if (result.Success)
        {
            _rules = _rules.Where(r => r.Id != id).ToList();
            if (_editingRuleId == id)
                ResetRuleForm();
        }
    }

    private async Task ReviewPendingAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<EmailImportDialog>("Review bank emails", new DialogParameters(), options);
        await dialog.Result;
        await LoadEmailImportAsync();
    }

    private async Task LoadUserAsync()
    {
        var result = await UserProfileService.GetCurrentProfileAsync();
        if (!result.Success || result.Data is null)
        {
            Snackbar.Add(result.Message, Severity.Error);
            return;
        }

        _displayName = result.Data.DisplayName;
        _email = result.Data.Email;
        _tenantId = result.Data.TenantId;
        _twoFactorEnabled = result.Data.TwoFactorEnabled;
        _avatarDataUrl = result.Data.AvatarDataUrl;
    }

    private async Task SaveProfileAsync()
    {
        _isBusy = true;
        var result = await UserProfileService.UpdateDisplayNameAsync(_displayName);
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        _isBusy = false;
    }

    private async Task ChangePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword) ||
            string.IsNullOrWhiteSpace(_newPassword) ||
            string.IsNullOrWhiteSpace(_confirmPassword))
        {
            Snackbar.Add("All password fields are required.", Severity.Error);
            return;
        }

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            Snackbar.Add("New password and confirmation do not match.", Severity.Error);
            return;
        }

        _isBusy = true;
        var result = await UserProfileService.ChangePasswordAsync(_currentPassword, _newPassword);
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        if (result.Success)
        {
            _currentPassword = string.Empty;
            _newPassword = string.Empty;
            _confirmPassword = string.Empty;
        }
        _isBusy = false;
    }

    private async Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        if (file.Size > MaxAvatarSizeBytes)
        {
            Snackbar.Add("Avatar must be 200KB or less.", Severity.Error);
            return;
        }

        if (!AllowedContentTypes.Contains(file.ContentType))
        {
            Snackbar.Add("Only jpg, png, and webp are allowed.", Severity.Error);
            return;
        }

        _isBusy = true;
        await using var stream = file.OpenReadStream(MaxAvatarSizeBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        var result = await UserProfileService.UpdateAvatarAsync(file.ContentType, ms.ToArray());
        if (result.Success)
        {
            _avatarDataUrl = result.Data;
        }

        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        _isBusy = false;
    }

    private async Task RemoveAvatarAsync()
    {
        _isBusy = true;
        var result = await UserProfileService.RemoveAvatarAsync();
        if (result.Success)
        {
            _avatarDataUrl = null;
        }

        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        _isBusy = false;
    }

    private async Task OnTwoFactorChanged(bool enabled)
    {
        _isBusy = true;
        var previous = _twoFactorEnabled;
        _twoFactorEnabled = enabled;

        var result = await UserProfileService.UpdateTwoFactorPreferenceAsync(enabled);
        if (!result.Success)
        {
            _twoFactorEnabled = previous;
        }

        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        _isBusy = false;
    }

    private async Task SendInviteAsync()
    {
        _isBusy = true;

        var result = await UserInvitationService.CreateOrResendAsync(new CreateUserInvitationDto
        {
            Email = _inviteEmail,
            InviteUrlTemplate = $"{PublicBaseUrl}/invite/register?token={{token}}"
        });

        if (result.Success && result.Data is not null)
        {
            _latestInviteLink = result.Data.InviteUrl;
            _inviteEmail = string.Empty;
        }

        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        _isBusy = false;
    }
}
