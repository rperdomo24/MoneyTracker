@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Category
@using MoneyTracker.Domain.Enums.Filters
@using MoneyTracker.UI.Components.Shared.Selectors
@using MoneyTracker.UI.Helpers
@inject ICategoryService CategoryService

<MudOverlay Visible="@IsOpen" LockScroll="true" DarkBackground="true" AutoClose="false" />

<MudDrawer Open="@IsOpen"
           OpenChanged="OnDrawerOpenChanged"
           Anchor="Anchor.Right"
           Elevation="2"
           Variant="@DrawerVariant.Temporary"
           Width="400px">

    <MudDrawerHeader>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Medium" />
                <MudText Typo="Typo.h6">Filters</MudText>
            </MudStack>

            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           OnClick="Close"
                           Size="Size.Small" />
        </MudStack>
    </MudDrawerHeader>

    <MudDrawerContainer Class="pa-4">
        @if (_loadingCategories)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <MudText Typo="Typo.caption">Loading filters...</MudText>
            </MudStack>
        }
        else
        {
            <MudStack Spacing="3">

                <!-- Search -->
                <MudTextField Label="Search Transactions"
                              @bind-Value="_tempFilter.SearchText"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Placeholder="Search by description..."
                              Clearable="true"
                              Immediate="true" />

                <!-- Period -->
                <TimePeriodSelect Options="_periodOptions"
                                  @bind-Value="_tempFilter.TimePeriod"
                                  @bind-Value:after="OnTimePeriodChanged"
                                  AnchorOrigin="Origin.BottomCenter" />

                @if (_tempFilter.TimePeriod == TimePeriodFilter.Custom)
                {
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Start Date"
                                           @bind-Date="_tempFilter.FromDate"
                                           Variant="Variant.Outlined"
                                           MaxDate="_tempFilter.ToDate ?? DateTime.Today" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="End Date"
                                           @bind-Date="_tempFilter.ToDate"
                                           Variant="Variant.Outlined"
                                           MinDate="_tempFilter.FromDate"
                                           MaxDate="DateTime.Today" />
                        </MudItem>
                    </MudGrid>
                }

                <!-- Transaction Type -->
                <CategoryTypeSelect MultiSelection="true"
                                    Label="Transaction Type"
                                    @bind-SelectedValues="_tempSelectedTypes"
                                    @bind-SelectedValues:after="OnTypesChanged"
                                    AnchorOrigin="Origin.BottomCenter" />

                <!-- Category -->
                <MudTextField @bind-Value="_categorySearch"
                              Label="Category"
                              Placeholder="Search categories..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Disabled="@IsTransferOnlyFilter()"
                              Immediate="true"
                              Clearable="true"
                              Class="mb-1" />
                @{
                    var filteredCats = GetFilteredCategories().ToList();
                }
                @if (filteredCats.Any())
                {
                    <MudPaper Outlined="true" Style="max-height: 220px; overflow-y: auto;">
                        @foreach (var cat in filteredCats)
                        {
                            <MudCheckBox T="bool"
                                         Value="@_selectedCategoryIds.Contains(cat.Id)"
                                         ValueChanged="@((bool _) => ToggleCategory(cat.Id))"
                                         Dense="true"
                                         Class="w-100 px-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Size="Size.Small" Style="@($"background-color: {cat.Color}; width: 24px; height: 24px;")">
                                        <MudIcon Icon="@cat.Icon.ToIcon()" Color="Color.Surface" Size="Size.Small" />
                                    </MudAvatar>
                                    <MudText Typo="Typo.body2">@cat.Name</MudText>
                                </MudStack>
                            </MudCheckBox>
                        }
                    </MudPaper>
                }
                @if (_selectedCategoryIds.Any())
                {
                    <MudText Typo="Typo.caption" Class="mt-1 mud-text-secondary">@_selectedCategoryIds.Count selected</MudText>
                }

                @if (HasActiveFilters())
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        <MudText Typo="Typo.caption" Class="font-weight-bold">
                            @GetActiveFiltersCount() active filter(s)
                        </MudText>
                    </MudAlert>
                }
            </MudStack>
        }
    </MudDrawerContainer>

    <MudDivider />

    <MudPaper Class="pa-4" Square="true" Elevation="0">
        <MudStack Spacing="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Check"
                       OnClick="ApplyFilters">
                Apply Filters
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ClearFilters"
                       Disabled="@(!HasActiveFilters())">
                Reset Filters
            </MudButton>
        </MudStack>
    </MudPaper>

</MudDrawer>



@code {
    private static readonly IReadOnlyList<TimePeriodFilter> _periodOptions = new[]
    {
        TimePeriodFilter.Last7Days,
        TimePeriodFilter.Last30Days,
        TimePeriodFilter.Last90Days,
        TimePeriodFilter.ThisMonth,
        TimePeriodFilter.LastMonth,
        TimePeriodFilter.ThisYear,
        TimePeriodFilter.Custom,
        TimePeriodFilter.AllTime
    };

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public int AccountId { get; set; }
    [Parameter] public TransactionFilterDto Filter { get; set; } = new();
    [Parameter] public EventCallback<TransactionFilterDto> OnFiltersApplied { get; set; }

    private TransactionFilterDto _tempFilter = new();
    private List<CategoryDto>? _categories;
    private bool _loadingCategories = true;

    private IReadOnlyCollection<CategoryTypeEnum> _tempSelectedTypes = Array.Empty<CategoryTypeEnum>();
    private List<int> _selectedCategoryIds = new();
    private string _categorySearch = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        InitializeFilter();
    }

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            InitializeFilter();
        }
    }

    private void InitializeFilter()
    {
        _tempFilter = new TransactionFilterDto
        {
            SearchText = Filter.SearchText,
            TimePeriod = Filter.TimePeriod,
            FromDate = Filter.FromDate,
            ToDate = Filter.ToDate,
            Types = Filter.Types?.ToList() ?? new(),
            CategoryIds = Filter.CategoryIds?.ToList() ?? new(),
            AccountIds = new List<int> { AccountId }
        };

        _tempSelectedTypes = _tempFilter.Types.ToArray();
        _selectedCategoryIds = _tempFilter.CategoryIds.ToList();
    }

    private async Task LoadCategories()
    {
        _loadingCategories = true;
        StateHasChanged();

        try
        {
            var result = await CategoryService.GetAllWithChildAsync(false);
            if (result.Success && result.Data != null)
            {
                _categories = result.Data
                    .Where(c => !c.IsSystem)
                    .ToList();
            }
            else
            {
                _categories = new();
            }
        }
        catch
        {
            _categories = new();
        }
        finally
        {
            _loadingCategories = false;
            StateHasChanged();
        }
    }

    private void OnTypesChanged()
    {
        _tempFilter.Types = _tempSelectedTypes.ToList();
        if (_tempFilter.CategoryIds?.Any() == true && _tempFilter.Types.Any())
        {
            var validIds = GetFilteredCategories().Select(c => c.Id).ToHashSet();
            _tempFilter.CategoryIds = _tempFilter.CategoryIds.Where(id => validIds.Contains(id)).ToList();
            _selectedCategoryIds = _tempFilter.CategoryIds.ToList();
        }
    }

    private void ToggleCategory(int id)
    {
        if (_selectedCategoryIds.Contains(id))
            _selectedCategoryIds.Remove(id);
        else
            _selectedCategoryIds.Add(id);
        _tempFilter.CategoryIds = _selectedCategoryIds.ToList();
    }

    private bool IsTransferOnlyFilter()
        => _tempSelectedTypes.Any() && _tempSelectedTypes.All(t => t == CategoryTypeEnum.Transfer);

    private IEnumerable<CategoryDto> GetFilteredCategories()
    {
        if (_categories == null) return Enumerable.Empty<CategoryDto>();
        var cats = _categories.Where(c => !c.IsSystem);
        if (_tempSelectedTypes.Any(t => t != CategoryTypeEnum.Transfer))
        {
            var nonTransferTypes = _tempSelectedTypes.Where(t => t != CategoryTypeEnum.Transfer).ToList();
            cats = cats.Where(c => nonTransferTypes.Contains(c.Type));
        }
        if (!string.IsNullOrWhiteSpace(_categorySearch))
            cats = cats.Where(c => c.Name.Contains(_categorySearch, StringComparison.OrdinalIgnoreCase));
        return cats;
    }

    private string? GetTypesText(IReadOnlyList<string?>? selected)
    {
        if (selected == null || selected.Count == 0) return "All types";
        return string.Join(", ", _tempSelectedTypes.Select(t => t.ToString()));
    }

    private void OnTimePeriodChanged()
    {
        if (_tempFilter.TimePeriod != TimePeriodFilter.Custom)
        {
            _tempFilter.FromDate = null;
            _tempFilter.ToDate = null;
        }
    }

    private async Task ApplyFilters()
    {
        _tempFilter.AccountIds = new List<int> { AccountId };
        await OnFiltersApplied.InvokeAsync(_tempFilter);
        await Close();
    }

    private async Task ClearFilters()
    {
        _tempFilter = new TransactionFilterDto
        {
            TimePeriod = TimePeriodFilter.Last30Days,
            AccountIds = new List<int> { AccountId },
            Types = new(),
            CategoryIds = new(),
            SearchText = string.Empty,
            FromDate = null,
            ToDate = null
        };
        _tempSelectedTypes = Array.Empty<CategoryTypeEnum>();
        _selectedCategoryIds = new List<int>();
        _categorySearch = string.Empty;

        await ApplyFilters();
    }

    private bool HasActiveFilters()
    {
        return _tempFilter.TimePeriod != TimePeriodFilter.Last30Days ||
               !string.IsNullOrWhiteSpace(_tempFilter.SearchText) ||
               _tempFilter.Types?.Any() == true ||
               _tempFilter.CategoryIds?.Any() == true;
    }

    private int GetActiveFiltersCount()
    {
        int count = 0;
        if (_tempFilter.TimePeriod != TimePeriodFilter.Last30Days) count++;
        if (!string.IsNullOrWhiteSpace(_tempFilter.SearchText)) count++;
        if (_tempFilter.Types?.Any() == true) count++;
        if (_tempFilter.CategoryIds?.Any() == true) count++;
        return count;
    }

    private async Task OnDrawerOpenChanged(bool isOpen)
    {
        if (!isOpen) await Close();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
