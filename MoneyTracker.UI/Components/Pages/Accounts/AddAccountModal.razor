@using MoneyTracker.Application.Common
@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Application.Validators
@using MoneyTracker.Application.Constants
@using MoneyTracker.Domain.Enums
@using MoneyTracker.UI.Helpers
@inject IAccountService AccountService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3" Size="Size.Medium" />
            <MudText Typo="Typo.h6">Create New Account</MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="pa-0">

            <!-- Preview Card -->
            <MudPaper Class="pa-4 mb-4" Elevation="1" Style="@($"border-left: 4px solid {@_account.Color};")">
                <div class="d-flex align-center">
                    <MudIcon Icon="@_account.Icon.ToIcon()"
                             Style="@($"color: {_account.Color};")"
                             Size="Size.Large"
                             Class="mr-3" />
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-medium">
                            @(!string.IsNullOrEmpty(_account.Name) ? _account.Name : "Account Name")
                        </MudText>
                        <MudText Typo="Typo.body2">
                            @_account.Type.ToString() • $@_account.Balance.ToString("N2")
                        </MudText>
                    </div>
                    @if (_account.CreditLimit > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">
                            Credit: $@_account.CreditLimit.ToString("N2")
                        </MudChip>
                    }
                </div>
            </MudPaper>

            <MudForm Model="@_account" @ref="_form" Validation="validationRules.ValidateValue">

                <!-- Basic Information Section -->
                <MudText Typo="Typo.subtitle2" Class="mb-3 font-weight-medium">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-2" />
                    Basic Information
                </MudText>

                <MudGrid Class="mb-4">
                    <MudItem xs="12">
                        <MudTextField Label="Account Name"
                                      @bind-Value="_account.Name"
                                      For="@(() => _account.Name)"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Immediate="true"
                                      HelperText="Enter a descriptive name for your account"
                                      Placeholder="e.g., Chase Checking, Savings Account" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="AccountType"
                                   Label="Account Type"
                                   @bind-Value="_account.Type"
                                   Variant="Variant.Outlined"
                                   For="@(() => _account.Type)"
                                   Required="true"
                                   HelperText="Select the type of account">
                            @foreach (var type in Enum.GetValues<AccountType>())
                            {
                                <MudSelectItem Value="@type">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@type.ToIcon()" Class="mr-2" Size="Size.Small" />
                                        @type.ToLabel()
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="AccountIcon"
                                   Label="Icon"
                                   @bind-Value="_account.Icon"
                                   Variant="Variant.Outlined"
                                   For="@(() => _account.Icon)"
                                   HelperText="Choose an icon to represent this account">
                            @foreach (var icon in Enum.GetValues<AccountIcon>())
                            {
                                <MudSelectItem Value="@icon">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@icon.ToIcon()"
                                                 Style="@($"color: {_account.Color};")"
                                                 Class="mr-2"
                                                 Size="Size.Small" />
                                        @icon.ToString()
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <!-- Financial Information Section -->
                <MudText Typo="Typo.subtitle2" Class="mb-3 font-weight-medium">
                    <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Class="mr-2" />
                    Financial Details
                </MudText>

                <MudGrid Class="mb-4">
                    <MudItem xs="12" md="6">
                        <MudNumericField T="decimal"
                                         Label="Initial Balance"
                                         @bind-Value="_account.Balance"
                                         For="@(() => _account.Balance)"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                                         HelperText="Current balance of the account"
                                         Format="C2" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudNumericField T="decimal"
                                         Label="Credit Limit"
                                         @bind-Value="_account.CreditLimit"
                                         For="@(() => _account.CreditLimit)"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.CreditCard"
                                         HelperText="Leave 0 if not applicable"
                                         Format="C2"
                                         Min="0" />
                    </MudItem>

                    @if (_account.CreditLimit > 0)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Class="mt-2">
                                <div class="d-flex justify-space-between align-center">
                                    <span>Available Credit: <strong>@_account.GetAvailableCredit()</strong> </span>
                                    <span>Utilization: <strong>@_account.GetUtilizationPercentage()</strong></span>
                                </div>
                            </MudAlert>
                        </MudItem>
                    }

                </MudGrid>

                <!-- Appearance Section -->
                <MudText Typo="Typo.subtitle2" Class="mb-3 font-weight-medium">
                    <MudIcon Icon="@Icons.Material.Filled.Palette" Size="Size.Small" Class="mr-2" />
                    Appearance
                </MudText>

                <MudGrid Class="mb-4">
                    <MudItem xs="12" md="6">
                        <MudColorPicker Label="Account Color"
                                        ColorPickerMode="ColorPickerMode.HEX"
                                        Editable="true"
                                        ColorPickerView="ColorPickerView.Grid"
                                        PickerVariant="PickerVariant.Dialog"
                                        Placeholder="Select Color"
                                        HelperText="Choose a color to identify this account"
                                        @bind-Text="@_account.Color" />
                    </MudItem>

                    <MudItem xs="12" md="6" Class="d-flex align-center justify-center">
                        <div class="text-center">
                            <MudText Typo="Typo.caption" Class="mb-2">Preview</MudText>
                            <MudIcon Icon="@_account.Icon.ToIcon()"
                                     Style="@($"color: {_account.Color};")"
                                     Size="Size.Large" />
                        </div>
                    </MudItem>
                </MudGrid>

                <!-- Additional Information Section -->
                <MudText Typo="Typo.subtitle2" Class="mb-3 font-weight-medium">
                    <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Class="mr-2" />
                    Additional Information
                </MudText>

                <MudTextField T="string"
                              Label="Notes (Optional)"
                              @bind-Value="_account.Notes"
                              For="@(() => _account.Notes)"
                              MaxLength="300"
                              Variant="Variant.Outlined"
                              Lines="3"
                              HelperText="Add any additional notes about this account"
                              Placeholder="e.g., Joint account with spouse, Emergency fund only..." />
            </MudForm>
        </MudContainer>
    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-space-between align-center" style="width: 100%;">
            <MudText Typo="Typo.caption" Class="text-muted">
                @if (_form?.IsValid == false)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                    <span>Please fix the errors above</span>
                }
                else if (!string.IsNullOrEmpty(_account.Name))
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" Color="Color.Success" />
                    <span>Ready to create account</span>
                }
            </MudText>

            <div>
                <MudButton Color="Color.Default"
                           Variant="Variant.Text"
                           OnClick="Close"
                           Class="mr-2">
                    Cancel
                </MudButton>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="SaveAccount"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(_isSaving || string.IsNullOrWhiteSpace(_account.Name))">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Creating...</span>
                    }
                    else
                    {
                        <span>Create Account</span>
                    }
                </MudButton>
            </div>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public EventCallback OnAccountAdded { get; set; }

    private readonly AccountValidator validationRules = new();

    private AccountDto _account = new()
        {
            Color = "#1976d2",
            Icon = AccountIcon.Money,
            Type = AccountType.Cash,
            Balance = 0,
            CreditLimit = 0,
            Notes = string.Empty,
            Name = string.Empty
        };

    private MudForm _form = null!;
    private bool _isSaving = false;

    private void Close() => MudDialog?.Close(DialogResult.Cancel());

    private async Task SaveAccount()
    {
        if (_isSaving || string.IsNullOrWhiteSpace(_account.Name)) return;

        _isSaving = true;
        StateHasChanged();

        try
        {
            await _form.Validate();

            if (!_form.IsValid)
            {
                Snackbar.Add("Please fix the validation errors before saving.", Severity.Warning);
                return;
            }

            var result = await AccountService.CreateAsync(_account);
            if (result.Success)
            {
                Snackbar.Add($"Account '{_account.Name}' created successfully!", Severity.Success);
                await OnAccountAdded.InvokeAsync();
                MudDialog?.Close(DialogResult.Ok(_account));
            }
            else
            {
                Snackbar.Add(result.Message ?? "Failed to create account. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating account: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }
}