@using MoneyTracker.Application.Common.Extensions
@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums
@using MoneyTracker.Domain.Enums.Account
@using MoneyTracker.Domain.Enums.Transaction
@using MoneyTracker.UI.Helpers
@inject IAccountService AccountService
@inject ITransactionService TransactionService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center pa-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
            </div>
        }
        else if (_account is not null)
        {
            <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
                <!-- Account Header -->
                <MudPaper Class="pa-4 mb-4" Elevation="0">
                    <MudGrid AlignItems="Center">
                        <MudItem xs="12" sm="8">
                            <div class="d-flex align-center text-white">
                                <MudIcon Icon="@_account.Icon.ToIcon()" 
                                        Size="Size.Large" 
                                        Class="mr-3"
                                        Style="@($"color: {_account.Color}; background: white; border-radius: 50%; padding: 8px;")" />
                                <div>
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                                        @_account.Name
                                    </MudText>
                                    <MudText Typo="Typo.body2" Class="opacity-90">
                                        @_account.Type.ToString() Account
                                    </MudText>
                                </div>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="4" Class="text-right">
                            <MudText Typo="Typo.h4" Class="font-weight-bold text-white">
                                @_account.FormattedBalance
                            </MudText>
                            @if (_account.Type == AccountType.Credit && _account.CreditLimit > 0)
                            {
                                <MudText Typo="Typo.body2" Class="opacity-90">
                                    Available: @($"${_account.AvailableCredit:N2}")
                                </MudText>
                            }
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudGrid>
                    <!-- Account Details -->
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudText Typo="Typo.h6" Class="mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                                Account Details
                            </MudText>
                            
                            <MudList T="string" Dense="true">
                                <MudListItem Icon="@Icons.Material.Filled.AccountBalance">
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText>Account Type</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">
                                            @_account.Type.ToString()
                                        </MudChip>
                                    </div>
                                </MudListItem>
                                
                                <MudListItem Icon="@Icons.Material.Filled.AttachMoney">
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText>Current Balance</MudText>
                                        <MudText Class="@($"{GetBalanceColorClass(_account.CurrentBalance)} font-weight-bold")">
                                            @_account.FormattedBalance
                                        </MudText>
                                    </div>
                                </MudListItem>

                                @if (_account.Type == AccountType.Credit)
                                {
                                    <MudListItem Icon="@Icons.Material.Filled.CreditCard">
                                        <div class="d-flex justify-space-between align-center">
                                            <MudText>Credit Limit</MudText>
                                            <MudText Class="font-weight-medium">
                                                @(_account.CreditLimit > 0 ? $"${_account.CreditLimit:N2}" : "No Limit")
                                            </MudText>
                                        </div>
                                    </MudListItem>

                                    @if (_account.CreditLimit > 0)
                                    {
                                        <MudListItem Icon="@Icons.Material.Filled.AccountBalanceWallet">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText>Available Credit</MudText>
                                                <MudText >
                                                    @($"${_account.AvailableCredit:N2}")
                                                </MudText>
                                            </div>
                                        </MudListItem>

                                        <MudListItem Icon="@Icons.Material.Filled.TrendingUp">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText>Credit Utilization</MudText>
                                                @{
                                                    var utilization = _account.CreditLimit > 0 ? (Math.Abs(_account.CurrentBalance) / _account.CreditLimit) * 100 : 0;
                                                    var utilizationColor = utilization switch
                                                    {
                                                        <= 30 => Color.Success,
                                                        <= 70 => Color.Warning,
                                                        _ => Color.Error
                                                    };
                                                }
                                                <MudText Class="font-weight-medium">
                                                    <MudChip T="string" Size="Size.Small" Color="@utilizationColor">
                                                        @($"{utilization:F1}%")
                                                    </MudChip>
                                                </MudText>
                                            </div>
                                        </MudListItem>
                                    }
                                }

                                @if (!string.IsNullOrEmpty(_account.Notes))
                                {
                                    <MudListItem Icon="@Icons.Material.Filled.Notes">
                                        <div>
                                            <MudText Class="font-weight-medium">Notes</MudText>
                                            <MudText Typo="Typo.body2" Class="text-muted mt-1">
                                                @_account.Notes
                                            </MudText>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        </MudPaper>
                    </MudItem>

                    <!-- Recent Transactions -->
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudText Typo="Typo.h6" Class="mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
                                Recent Transactions
                            </MudText>

                            @if (_loadingTransactions)
                            {
                                <div class="d-flex justify-center pa-4">
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                </div>
                            }
                            else if (_recentTransactions.Any())
                            {
                                <MudList T="string" Dense="true">
                                    @foreach (var transaction in _recentTransactions.Take(5))
                                    {
                                        <MudListItem>
                                            <div class="d-flex justify-space-between align-center">
                                                <div>
                                                    <MudText Typo="Typo.body2" Class="font-weight-medium">
                                                        @transaction.Description
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Class="text-muted">
                                                        @transaction.Date.ToString("MMM dd, yyyy")
                                                    </MudText>
                                                </div>
                                                <MudText >
                                                    @(transaction.IsIncome() ? "+" : "-")@($"${transaction.Amount:N2}")
                                                </MudText>
                                            </div>
                                        </MudListItem>
                                    }
                                </MudList>

                                @if (_recentTransactions.Count > 5)
                                {
                                    <MudButton FullWidth="true" 
                                              Variant="Variant.Text" 
                                              Color="Color.Primary"
                                              Class="mt-2">
                                        View All Transactions (@_recentTransactions.Count)
                                    </MudButton>
                                }
                            }
                            else
                            {
                                <div class="text-center pa-4">
                                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Large" Class="text-muted mb-2" />
                                    <MudText Typo="Typo.body2" Class="text-muted">
                                        No transactions yet
                                    </MudText>
                                </div>
                            }
                        </MudPaper>
                    </MudItem>

                    <!-- Quick Actions -->
                    <MudItem xs="12">
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudText Typo="Typo.h6" Class="mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.FlashOn" Class="mr-2" />
                                Quick Actions
                            </MudText>
                            
                            <MudButtonGroup Variant="Variant.Outlined" Class="gap-2">
                                <MudButton Color="Color.Success"
                                          StartIcon="@Icons.Material.Filled.Add"
                                          OnClick="@(() => AddTransaction(TransactionTypeEnum.Income))">
                                    Add Income
                                </MudButton>
                                <MudButton Color="Color.Error"
                                          StartIcon="@Icons.Material.Filled.Remove"
                                          OnClick="@(() => AddTransaction(TransactionTypeEnum.Expense))">
                                    Add Expense
                                </MudButton>
                                <MudButton Color="Color.Primary"
                                          StartIcon="@Icons.Material.Filled.SwapHoriz"
                                          OnClick="@(() => AddTransaction(TransactionTypeEnum.Transfer))">
                                    Transfer Money
                                </MudButton>
                                <MudButton Color="Color.Secondary"
                                          StartIcon="@Icons.Material.Filled.Tune"
                                          OnClick="AdjustBalance">
                                    Adjust Balance
                                </MudButton>
                            </MudButtonGroup>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudContainer>
        }
        else
        {
            <div class="text-center pa-8">
                <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Class="text-error mb-2" />
                <MudText Typo="Typo.h6">Account not found</MudText>
            </div>
        }
    </DialogContent>
    
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Close</MudButton>
        @if (_account is not null)
        {
            <MudButton Color="Color.Secondary" 
                      StartIcon="@Icons.Material.Filled.Edit"
                      OnClick="EditAccount"
                      Variant="Variant.Filled">
                Edit Account
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int AccountId { get; set; }

    private AccountDto? _account;
    private List<TransactionDto> _recentTransactions = new();
    private bool _loading = true;
    private bool _loadingTransactions = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccount();
        await LoadRecentTransactions();
    }

    private async Task LoadAccount()
    {
        try
        {
            var result = await AccountService.GetByIdAsync(AccountId);
            if (result.Success && result.Data is not null)
            {
                _account = result.Data;
            }
            else
            {
                Snackbar.Add(result.Message ?? "Account not found", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading account: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadRecentTransactions()
    {
        try
        {
            var result = await TransactionService.GetAllAsync();
            if (result.Success && result.Data is not null)
            {
                _recentTransactions = result.Data
                    .Where(t => t.AccountId == AccountId)
                    .OrderByDescending(t => t.Date)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading transactions: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingTransactions = false;
        }
    }

    private string GetBalanceColorClass(decimal balance)
    {
        return balance switch
        {
            > 0 => "text-success",
            < 0 => "text-error",
            _ => "text-muted"
        };
    }

    private void Cancel() => MudDialog.Cancel();

    private void EditAccount()
    {
        // Close this dialog and open edit dialog
        MudDialog.Close(DialogResult.Ok($"edit:{AccountId}"));
    }

    private void AddTransaction(TransactionTypeEnum type)
    {
        // Close this dialog and open add transaction dialog
        MudDialog.Close(DialogResult.Ok($"transaction:{type}:{AccountId}"));
    }

    private void AdjustBalance()
    {
        // Close this dialog and open balance adjustment dialog
        MudDialog.Close(DialogResult.Ok($"adjust:{AccountId}"));
    }
}