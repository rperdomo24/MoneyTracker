@page "/accounts"
@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Account
@using MoneyTracker.UI.Components.Shared.Navigation
@using MoneyTracker.UI.Helpers
@using MoneyTracker.UI.Components.Shared
@inject IAccountService AccountService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Accounts - Money Tracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <Breadcrumb Items="@_breadcrumbItems" />

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog">
            Add Account
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Class="mt-4">Loading your accounts...</MudText>
        </MudStack>
    }
    else if (!_accounts.Any())
    {
        <MudPaper Class="pa-8" Elevation="1">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet"
                         Size="Size.Large"
                         Style="font-size: 4rem; opacity: 0.3;" />
                <MudText Typo="Typo.h6">No accounts yet</MudText>
                <MudText Typo="Typo.body2" Style="opacity: 0.7;">
                    Get started by adding your first financial account
                </MudText>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddDialog"
                           Size="Size.Large">
                    Add Your First Account
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        @foreach (var group in _accountGroups)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="1">
                <!-- Group Header -->
                <MudStack Row="true"
                          Justify="Justify.SpaceBetween"
                          AlignItems="AlignItems.Center"
                          Class="mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@group.Key.ToIcon()" />
                        <MudText Typo="Typo.h6">@group.Key.ToLabel()</MudText>
                        <MudChip Size="Size.Small" T="string">@group.Count()</MudChip>
                    </MudStack>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                        Total: @FormatBalance(group.Sum(a => a.CurrentBalance))
                    </MudText>
                </MudStack>

                <!-- Accounts List -->
                <MudStack Spacing="2">
                    @foreach (var account in group.OrderBy(a => a.Name))
                    {
                        <MudPaper Class="pa-3"
                                  Elevation="0"
                                  Style="border: 1px solid var(--mud-palette-divider);">
                            <MudStack Row="true"
                                      Justify="Justify.SpaceBetween"
                                      AlignItems="AlignItems.Center">
                                <!-- Account Info -->
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Size="Size.Medium"
                                               Style="@($"background-color: {account.Color};")">
                                        <MudIcon Icon="@account.Icon.ToIcon()"
                                                 Color="Color.Surface"
                                                 Size="Size.Small" />
                                    </MudAvatar>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body1" Class="font-weight-medium">
                                            @account.Name
                                        </MudText>
                                        <MudText Typo="Typo.caption" Style="opacity: 0.7;">
                                            @account.Type.ToString()
                                        </MudText>
                                    </MudStack>
                                </MudStack>

                                <!-- Balance & Actions -->
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                    <MudText Typo="Typo.h6" Class="@GetBalanceClass(account.CurrentBalance)">
                                        @account.FormattedBalance
                                    </MudText>

                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                             Size="Size.Small"
                                             AnchorOrigin="Origin.BottomRight"
                                             TransformOrigin="Origin.TopRight">
                                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                                     OnClick="@(() => ViewAccount(account.Id))">
                                            View
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.SyncAlt"
                                                     OnClick="@(() => OpenAdjustBalanceDialog(account))">
                                            Adjust Balance
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                                     OnClick="@(() => OpenEditDialog(account.Id))">
                                            Edit
                                        </MudMenuItem>
                                        <MudDivider />
                                        <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                                     IconColor="Color.Error"
                                                     OnClick="@(() => DeleteAccount(account.Id))">
                                            Delete
                                        </MudMenuItem>
                                    </MudMenu>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            </MudPaper>
        }
    }

</MudContainer>

@code {
    private List<AccountDto> _accounts = new();
    private bool _loading = true;
    private IEnumerable<IGrouping<AccountType, AccountDto>> _accountGroups = Enumerable.Empty<IGrouping<AccountType, AccountDto>>();

    private readonly List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Home", href: "/", icon: Icons.Material.Filled.Home),
        new BreadcrumbItem("Accounts", href: null, disabled: true)
    };

    private readonly DialogOptions _dialogOptions = new()
    {
        CloseButton = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Large,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var result = await AccountService.GetAccountsWithBalancesAsync();
            if (result.Success && result.Data is not null)
            {
                _accounts = result.Data;
                _accountGroups = _accounts.GroupBy(a => a.Type).OrderBy(g => g.Key);
            }
            else
            {
                Snackbar.Add(result.Message ?? "Failed to load accounts", Severity.Error);
                _accounts.Clear();
                _accountGroups = Enumerable.Empty<IGrouping<AccountType, AccountDto>>();
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Error loading accounts", Severity.Error);
            _accounts.Clear();
            _accountGroups = Enumerable.Empty<IGrouping<AccountType, AccountDto>>();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ViewAccount(int id)
    {
        var parameters = new DialogParameters { ["AccountId"] = id };
        await DialogService.ShowAsync<ViewAccountDialog>("Account Details", parameters, _dialogOptions);
    }

    private async Task OpenEditDialog(int id)
    {
        var parameters = new DialogParameters
        {
            ["AccountId"] = id,
            ["OnAccountUpdated"] = EventCallback.Factory.Create(this, LoadAccounts)
        };
        await DialogService.ShowAsync<UpdateAccountModal>("Update Account", parameters, _dialogOptions);
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters
        {
            ["OnAccountAdded"] = EventCallback.Factory.Create(this, LoadAccounts)
        };
        await DialogService.ShowAsync<AddAccountModal>("Add Account", parameters, _dialogOptions);
    }

    private async Task DeleteAccount(int id)
    {
        var account = _accounts.FirstOrDefault(a => a.Id == id);
        var accountName = account?.Name ?? "this account";

        bool confirmed = await DialogService.ShowMessageBox(
            "Delete Account",
            $"Are you sure you want to delete '{accountName}'? This action cannot be undone and will also delete all associated transactions.",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions { CloseButton = true }) ?? false;

        if (confirmed)
        {
            try
            {
                var result = await AccountService.DeleteAsync(id);
                if (result.Success)
                {
                    Snackbar.Add($"Account '{accountName}' deleted successfully", Severity.Success);
                    await LoadAccounts();
                }
                else
                {
                    Snackbar.Add(result.Message ?? "Failed to delete account", Severity.Error);
                }
            }
            catch (Exception)
            {
                Snackbar.Add("Error deleting account", Severity.Error);
            }
        }
    }

    private string FormatBalance(decimal balance)
    {
        return balance < 0 ? $"-${Math.Abs(balance):N2}" : $"${balance:N2}";
    }

    private string GetBalanceClass(decimal balance)
    {
        return balance switch
        {
            > 0 => "text-success",
            < 0 => "text-error",
            _ => ""
        };
    }

    private async Task OpenAdjustBalanceDialog(AccountDto account)
    {
        var parameters = new DialogParameters
        {
            ["AccountId"] = account.Id,
            ["AccountName"] = account.Name,
            ["AccountIcon"] = account.Icon.ToIcon(),
            ["AccountColor"] = account.Color,
            ["CurrentBalance"] = account.CurrentBalance,
            ["OnBalanceAdjusted"] = EventCallback.Factory.Create(this, LoadAccounts)
        };

        await DialogService.ShowAsync<AdjustBalanceModal>(
            "Adjust Balance",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small });
    }
}