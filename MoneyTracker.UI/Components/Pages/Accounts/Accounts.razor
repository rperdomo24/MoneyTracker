@page "/accounts"
@using System.Linq
@using MoneyTracker.Domain.Enums
@using MoneyTracker.UI.Helpers
@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.Interfaces
@inject IAccountService AccountService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Accounts - Money Tracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudPaper Class="pa-6 mb-4" Elevation="2">
        <MudGrid AlignItems="Center">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h4" Class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Class="mr-3" Size="Size.Large" />
                    My Accounts
                </MudText>
                <MudText Typo="Typo.body2" Class="text-muted mt-1">
                    Manage your financial accounts and track balances
                </MudText>
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex justify-end">
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddDialog"
                           Size="Size.Large"
                           Class="px-6">
                    Add New Account
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_loading)
    {
        <MudPaper Class="pa-8 text-center" Elevation="1">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4">Loading your accounts...</MudText>
        </MudPaper>
    }
    else if (!_accounts.Any())
    {
        <MudPaper Class="pa-8 text-center" Elevation="1">
            <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Large" Class="mb-4 text-muted" />
            <MudText Typo="Typo.h6" Class="mb-2">No accounts yet</MudText>
            <MudText Typo="Typo.body2" Class="text-muted mb-4">
                Get started by adding your first financial account
            </MudText>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDialog">
                Add Your First Account
            </MudButton>
        </MudPaper>
    }
    else
    {
        <!-- ✅ Statistics Cards - Corregidas -->
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.body2" Class="text-muted">Total Balance</MudText>
                    <MudText Typo="Typo.h5" Class="@GetTotalBalanceColorClass()">
                        @GetTotalBalance()
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.body2" Class="text-muted">Total Accounts</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        @_accounts.Count
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.body2" Class="text-muted">Account Types</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        @_accounts.GroupBy(a => a.Type).Count()
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.body2" Class="text-muted">Credit Available</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold text-success">
                        @GetTotalCreditAvailable()
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @foreach (var group in _accountGroups)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="1">
                <!-- Group Header -->
                <MudGrid Justify="Justify.Center" Class="mb-3">
                    <MudItem xs="12" sm="8">
                        <MudText Typo="Typo.h6" Class="d-flex align-center">
                            <MudIcon Icon="@group.Key.ToIcon()" Class="mr-2" />
                            @group.Key.ToLabel()
                            <MudChip Size="Size.Small" T="string" Class="ml-2">@group.Count() accounts</MudChip>
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4" Class="text-right">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                            Total: @GetGroupTotal(group)
                        </MudText>
                    </MudItem>
                </MudGrid>

                <!-- Accounts Table -->
                <MudTable Items="group.ToList()"
                          Hover="true"
                          Dense="false"
                          Striped="true"
                          Elevation="0"
                          Class="mud-table-responsive">
                    <HeaderContent>
                        <MudTh><MudText Typo="Typo.caption">Account</MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption">Balance</MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption">Credit Limit</MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption">Available</MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption">Actions</MudText></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@context.Icon.ToIcon()"
                                         Style="@($"color: {context.Color};")"
                                         Class="mr-3" />
                                <div>
                                    <MudText Typo="Typo.body2" Class="font-weight-medium">
                                        @context.Name
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="text-muted">
                                        @context.Type.ToString()
                                    </MudText>
                                </div>
                            </div>
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2" Class="@GetBalanceColorClass(context.CurrentBalance)">
                                @context.FormattedBalance
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2">
                                @if (context.Type == AccountType.Credit && context.CreditLimit > 0)
                                {
                                    @($"${context.CreditLimit:N2}")
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2">
                                @if (context.Type == AccountType.Credit && context.CreditLimit > 0)
                                {
                                    var available = context.AvailableCredit;
                                    var colorClass = context.IsOverLimit ? "text-error" : "text-success";
                                    <span class="@colorClass">@($"${available:N2}")</span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                                <MudButton Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Visibility"
                                           OnClick="@(() => ViewAccount(context.Id))"
                                           Title="View Details">
                                    View
                                </MudButton>
                                <MudButton Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.Edit"
                                           OnClick="@(() => OpenEditDialog(context.Id))"
                                           Title="Edit Account">
                                    Edit
                                </MudButton>
                                <MudButton Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           OnClick="@(() => DeleteAccount(context.Id))"
                                           Title="Delete Account">
                                    Delete
                                </MudButton>
                            </MudButtonGroup>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private List<AccountDto> _accounts = new();
    private bool _loading = true;
    private IEnumerable<IGrouping<AccountType, AccountDto>> _accountGroups = Enumerable.Empty<IGrouping<AccountType, AccountDto>>();

    private readonly DialogOptions _dialogOptions = new()
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Large,
            CloseOnEscapeKey = true
        };

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            // ✅ FIXED: Use GetAccountsWithBalancesAsync to get calculated balances
            var result = await AccountService.GetAccountsWithBalancesAsync();
            if (result.Success && result.Data is not null)
            {
                _accounts = result.Data;
                _accountGroups = _accounts.GroupBy(a => a.Type).OrderBy(g => g.Key);
            }
            else
            {
                Snackbar.Add(result.Message ?? "Failed to load accounts", Severity.Error);
                _accounts.Clear();
                _accountGroups = Enumerable.Empty<IGrouping<AccountType, AccountDto>>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading accounts: {ex.Message}", Severity.Error);
            _accounts.Clear();
            _accountGroups = Enumerable.Empty<IGrouping<AccountType, AccountDto>>();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ViewAccount(int id)
    {
        var parameters = new DialogParameters { ["AccountId"] = id };
        await DialogService.ShowAsync<ViewAccountDialog>("Account Details", parameters, _dialogOptions);
    }

    private async Task OpenEditDialog(int id)
    {
        var parameters = new DialogParameters
            {
                ["AccountId"] = id,
                ["OnAccountUpdated"] = EventCallback.Factory.Create(this, LoadAccounts)
            };
        await DialogService.ShowAsync<UpdateAccountModal>("Update Account", parameters, _dialogOptions);
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters
            {
                ["OnAccountAdded"] = EventCallback.Factory.Create(this, LoadAccounts)
            };
        await DialogService.ShowAsync<AddAccountModal>("Add Account", parameters, _dialogOptions);
    }

    private async Task DeleteAccount(int id)
    {
        var account = _accounts.FirstOrDefault(a => a.Id == id);
        var accountName = account?.Name ?? "this account";

        bool confirmed = await DialogService.ShowMessageBox(
            "Delete Account",
            $"Are you sure you want to delete '{accountName}'? This action cannot be undone and will also delete all associated transactions.",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions { CloseButton = true }) ?? false;

        if (confirmed)
        {
            try
            {
                var result = await AccountService.DeleteAsync(id);
                if (result.Success)
                {
                    Snackbar.Add($"Account '{accountName}' deleted successfully", Severity.Success);
                    await LoadAccounts();
                }
                else
                {
                    Snackbar.Add(result.Message ?? "Failed to delete account", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting account: {ex.Message}", Severity.Error);
            }
        }
    }

    // ✅ Helper Methods for Calculations
    private string GetBalanceColorClass(decimal balance)
    {
        return balance switch
        {
            > 0 => "text-success",
            < 0 => "text-error",
            _ => "text-muted"
        };
    }

    private string GetTotalBalanceColorClass()
    {
        var total = _accounts.Sum(a => a.CurrentBalance);
        return total switch
        {
            > 0 => "font-weight-bold text-success",
            < 0 => "font-weight-bold text-error",
            _ => "font-weight-bold text-muted"
        };
    }

    private string GetTotalBalance()
    {
        var total = _accounts.Sum(a => a.CurrentBalance);
        return $"${total:N2}";
    }

    private string GetTotalCreditAvailable()
    {
        var creditAccounts = _accounts.Where(a => a.Type == AccountType.Credit && a.CreditLimit > 0);
        var totalAvailable = creditAccounts.Sum(a => a.AvailableCredit);
        return $"${totalAvailable:N2}";
    }

    private string GetGroupTotal(IGrouping<AccountType, AccountDto> group)
    {
        var total = group.Sum(a => a.CurrentBalance);
        var colorClass = total >= 0 ? "text-success" : "text-error";
        return $"${total:N2}";
    }
}