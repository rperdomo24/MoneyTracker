@page "/accounts"
@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Account
@using MoneyTracker.UI.Components.Shared.Navigation
@using MoneyTracker.UI.Components.Shared.Selection
@using MoneyTracker.UI.Helpers
@using MoneyTracker.UI.Components.Shared
@using MoneyTracker.UI.Services.Components.Drawer
@inject IAccountService AccountService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>Accounts - Money Tracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-1 pa-sm-6">
    <!-- Header (Mobile) -->
    <MudHidden Breakpoint="Breakpoint.SmAndUp">
        <MudStack Spacing="3" Class="mb-4">
            <Breadcrumb Items="@_breadcrumbItems" />

            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDialog"
                       FullWidth="true"
                       Size="Size.Large">
                Add Account
            </MudButton>
        </MudStack>
    </MudHidden>

    <!-- Header (Tablet/Desktop) -->
    <MudHidden Breakpoint="Breakpoint.Xs">
        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mb-4">
            <Breadcrumb Items="@_breadcrumbItems" />

            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDialog">
                Add Account
            </MudButton>
        </MudStack>
    </MudHidden>

    @if (_loading)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-10">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Class="mt-4">Loading your accounts...</MudText>
        </MudStack>
    }
    else if (!_accounts.Any())
    {
        <MudPaper Class="pa-6 pa-sm-8" Elevation="1">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet"
                         Size="Size.Large"
                         Style="font-size: 4rem; opacity: 0.3;" />
                <MudText Typo="Typo.h6">No accounts yet</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center">
                    Get started by adding your first financial account
                </MudText>

                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddDialog"
                           FullWidth="true"
                           Size="Size.Large">
                    Add Your First Account
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <!-- Financial Overview -->
        <MudPaper Class="pa-4 pa-sm-5 mb-4" Elevation="1">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Style="gap:20px;">

                <!-- Net Worth -->
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Style="opacity:0.7;">Net Worth</MudText>
                    <MudText Typo="Typo.h5" Class="@($"font-weight-bold {GetBalanceClass(NetWorth)}")">
                        @FormatBalance(NetWorth)
                    </MudText>
                    <MudText Typo="Typo.caption" Style="opacity:0.6;">
                        Assets @FormatBalance(TotalAssets) · Liabilities @FormatBalance(TotalLiabilities)
                    </MudText>
                    @if (ExcludedCount > 0)
                    {
                        <MudText Typo="Typo.caption" Style="opacity:0.5;">
                            <MudIcon Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Small" Style="font-size:12px; vertical-align:middle;" />
                            @ExcludedCount account@(ExcludedCount > 1 ? "s" : "") excluded from net worth
                        </MudText>
                    }
                </MudStack>

                <!-- Financial metrics -->
                <MudStack Row="true" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Style="gap:20px;">

                    <!-- Liquidity -->
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Style="opacity:0.7;">Liquidity</MudText>
                        <MudText Typo="Typo.h6" Class="font-weight-bold mud-success-text">
                            @FormatBalance(TotalLiquidity)
                        </MudText>
                        <MudText Typo="Typo.caption" Style="opacity:0.55;">cash available</MudText>
                    </MudStack>

                    <!-- Credit utilization -->
                    @if (TotalCreditLimit > 0)
                    {
                        var utilPct = (double)(TotalCreditUsed / TotalCreditLimit) * 100d;
                        var utilCssClass = utilPct >= 70 ? "mud-error-text" : utilPct >= 30 ? "mud-warning-text" : "mud-success-text";
                        var utilLabel = utilPct >= 70 ? "high" : utilPct >= 30 ? "moderate" : "healthy";
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Style="opacity:0.7;">Credit usage</MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="1">
                                <MudText Typo="Typo.h6" Class="@($"font-weight-bold {utilCssClass}")">@($"{utilPct:F0}")%</MudText>
                                <MudText Typo="Typo.caption" Class="@utilCssClass">@utilLabel</MudText>
                            </MudStack>
                            <MudText Typo="Typo.caption" Style="opacity:0.55;">
                                @FormatBalance(TotalCreditUsed) / @FormatBalance(TotalCreditLimit)
                            </MudText>
                        </MudStack>
                    }

                    <!-- Monthly debt cost -->
                    @if (TotalMonthlyDebtCost > 0)
                    {
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Style="opacity:0.7;">Debt cost/mo</MudText>
                            <MudText Typo="Typo.h6" Class="font-weight-bold mud-error-text">
                                @FormatBalance(TotalMonthlyDebtCost)
                            </MudText>
                            <MudText Typo="Typo.caption" Style="opacity:0.55;">estimated interest</MudText>
                        </MudStack>
                    }

                </MudStack>

                <!-- Sync -->
                <MudTooltip Text="Recalculates balance for ALL accounts by summing their transactions">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Sync"
                               Size="Size.Small"
                               OnClick="ConfirmSyncAllBalances"
                               Disabled="@_syncingAll">
                        @if (_syncingAll)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                        }
                        Sync All
                    </MudButton>
                </MudTooltip>
            </MudStack>
        </MudPaper>

        <!-- Credit Card Alerts -->
        @if (_creditAlerts.Any())
        {
            <MudPaper Class="pa-3 mb-4" Elevation="0" Outlined="true"
                      Style="border-color: var(--mud-palette-warning); border-left: 4px solid var(--mud-palette-warning);">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Small" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2">Credit Card Alerts</MudText>
                    </MudStack>
                    @foreach (var alert in _creditAlerts)
                    {
                        <MudAlert Severity="@GetAlertSeverity(alert)"
                                  Dense="true"
                                  Icon="@GetAlertIcon(alert)">
                            @GetAlertMessage(alert)
                        </MudAlert>
                    }
                </MudStack>
            </MudPaper>
        }

        @foreach (var group in _accountGroups)
        {
            var groupTotal = group.Sum(a => a.CurrentBalance);
            var groupTotalColor = CurrencyHelper.GetAmountColor(groupTotal);

            <MudPaper Class="pa-4 pa-sm-5 mb-4" Elevation="1">

                <!-- Group Header (Mobile) -->
                <MudHidden Breakpoint="Breakpoint.SmAndUp">
                    <MudStack Spacing="2" Class="mb-3">

                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@group.Key.ToIcon()" />
                                <MudText Typo="Typo.h6">@group.Key.ToLabel()</MudText>
                                <MudChip Size="Size.Small" T="string">@group.Count()</MudChip>
                            </MudStack>

                            <MudChip T="string"
                                     Variant="Variant.Filled"
                                     Color="@groupTotalColor"
                                     Class="@($"font-weight-bold {GetBalanceClass(groupTotal)}")">
                                @FormatBalance(groupTotal)
                            </MudChip>
                        </MudStack>

                    </MudStack>
                </MudHidden>

                <!-- Group Header (Tablet/Desktop) -->
                <MudHidden Breakpoint="Breakpoint.Xs">
                    <MudStack Row="true"
                              Justify="Justify.SpaceBetween"
                              AlignItems="AlignItems.Center"
                              Class="mb-3">

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@group.Key.ToIcon()" />
                            <MudText Typo="Typo.h6">@group.Key.ToLabel()</MudText>
                            <MudChip Size="Size.Small" T="string">@group.Count()</MudChip>
                        </MudStack>

                        <!-- Reuse the same total UI -->
                        <MudChip T="string"
                                 Variant="Variant.Filled"
                                 Color="@groupTotalColor"
                                 Class="@($"font-weight-bold {GetBalanceClass(groupTotal)}")">
                            @FormatBalance(groupTotal)
                        </MudChip>

                    </MudStack>
                </MudHidden>

                <!-- Accounts List -->
                <MudStack Spacing="2">
                    @foreach (var account in group.OrderBy(a => a.Name))
                    {
                        <MudPaper Class="pa-3" Elevation="0" Outlined="true">

                            <!-- Item (Mobile) - Uniform -->
                            <MudHidden Breakpoint="Breakpoint.SmAndUp">
                                <MudStack Row="true"
                                          AlignItems="AlignItems.Center"
                                          Justify="Justify.SpaceBetween"
                                          Spacing="2">

                                    <!-- Left -->
                                    <MudAvatar Size="Size.Medium"
                                               Style="@($"background-color: {account.Color};")">
                                        @if (!string.IsNullOrEmpty(account.BankName))
                                        {
                                            <span style="color:white; font-size:10px; font-weight:700; letter-spacing:0.5px;">@GetBankInitials(account.BankName)</span>
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@account.Icon.ToIcon()" Color="Color.Surface" Size="Size.Small" />
                                        }
                                    </MudAvatar>

                                    <!-- Middle (dominant) -->
                                    <MudStack Spacing="0">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudText Typo="Typo.body1" Class="font-weight-medium text-nowrap">
                                                @account.Name
                                            </MudText>
                                            @if (NeedsBankWarning(account))
                                            {
                                                <MudTooltip Text="Bank/card details missing — view account to complete">
                                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" />
                                                </MudTooltip>
                                            }
                                        </MudStack>

                                        <MudText Typo="Typo.caption" Style="opacity: 0.7; white-space: nowrap;">
                                            @GetAccountSubtitle(account)
                                        </MudText>

                                        @if (account.Type == AccountType.Credit && !string.IsNullOrEmpty(account.CardDisplayName))
                                        {
                                            <MudText Typo="Typo.caption" Style="opacity:0.5; white-space:nowrap; font-family:monospace; letter-spacing:1px;">
                                                •••• @account.CardDisplayName
                                            </MudText>
                                        }

                                        <MudText Typo="Typo.h6"
                                                 Class="@($"font-weight-bold {GetBalanceClass(account.CurrentBalance)}")"
                                                 Style="white-space: nowrap;">
                                            @CurrencyHelper.FormatCurrency(account.CurrentBalance)
                                        </MudText>

                                        @if (account.Type == AccountType.Credit && account.CreditLimit > 0)
                                        {
                                            var used = (double)(Math.Abs(account.CurrentBalance) / account.CreditLimit) * 100d;
                                            var usedClamped = Math.Clamp(used, 0d, 100d);
                                            var limitColor = used >= 90 ? Color.Error : used >= 70 ? Color.Warning : Color.Success;
                                            <MudStack Spacing="1" Style="min-width:80px;">
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                    <MudText Typo="Typo.caption" Style="opacity:0.65;">Usage</MudText>
                                                    <MudText Typo="Typo.caption" Style="opacity:0.85; font-weight:600;">@($"{usedClamped:F0}")%</MudText>
                                                </MudStack>
                                                <MudProgressLinear Value="@usedClamped" Color="@limitColor" Size="Size.Small" />
                                                <MudText Typo="Typo.caption" Style="opacity:0.65;">
                                                    @CurrencyHelper.FormatCurrency(account.AvailableCredit) available
                                                </MudText>
                                            </MudStack>
                                        }

                                        @if (account.Type == AccountType.Credit && (account.CutDay.HasValue || account.PaymentDay.HasValue || account.AnnualInterestRate.HasValue))
                                        {
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Style="flex-wrap:wrap; gap:6px;">
                                                @if (account.CutDay.HasValue)
                                                {
                                                    var co = GetDayOffset(account.CutDay.Value);
                                                    var cl = co < 0 ? $"Cut · closed {Math.Abs(co)}d ago"
                                                           : co == 0 ? $"Cut · today!"
                                                           : $"Cut {account.CutDay} ({co}d)";
                                                    var cs = co < 0 ? "color:var(--mud-palette-info); opacity:0.85;"
                                                           : co == 0 ? "color:var(--mud-palette-warning); font-weight:700;"
                                                           : GetDayUrgencyStyle(co);
                                                    <MudText Typo="Typo.caption" Style="@($"white-space:nowrap; {cs}")">@cl</MudText>
                                                }
                                                @if (account.PaymentDay.HasValue)
                                                {
                                                    var po = GetDayOffset(account.PaymentDay.Value);
                                                    var pl = po < 0 ? $"Due · OVERDUE {Math.Abs(po)}d!"
                                                           : po == 0 ? $"Due · today!"
                                                           : $"Due {account.PaymentDay} ({po}d)";
                                                    var ps = po <= 0 ? "color:var(--mud-palette-error); font-weight:700;"
                                                           : GetDayUrgencyStyle(po);
                                                    <MudText Typo="Typo.caption" Style="@($"white-space:nowrap; {ps}")">@pl</MudText>
                                                }
                                                @if (account.AnnualInterestRate.HasValue)
                                                {
                                                    <MudText Typo="Typo.caption" Style="opacity:0.65; white-space:nowrap;">@($"{account.AnnualInterestRate:F1}")% APR</MudText>
                                                }
                                            </MudStack>
                                        }
                                    </MudStack>

                                    <!-- Right -->
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                                        <MudTooltip Text="@(account.IncludeInNetWorth ? "Included in net worth" : "Excluded from net worth")">
                                            <MudIconButton Icon="@(account.IncludeInNetWorth ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                                           Color="@(account.IncludeInNetWorth ? Color.Default : Color.Error)"
                                                           Size="Size.Small"
                                                           OnClick="@(() => ToggleNetWorthAsync(account))" />
                                        </MudTooltip>
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                             Size="Size.Medium"
                                             AnchorOrigin="Origin.BottomRight"
                                             TransformOrigin="Origin.TopRight">
                                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                                     OnClick="@(() => ViewAccount(account.Id))">
                                            View
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.SyncAlt"
                                                     OnClick="@(() => OpenAdjustBalanceDialog(account))">
                                            Adjust Balance
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                                     OnClick="@(() => OpenEditDialog(account.Id))">
                                            Edit
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Sync"
                                                     OnClick="@(() => ConfirmSyncBalance(account))">
                                            Sync Balance
                                        </MudMenuItem>
                                        <MudDivider />
                                        <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                                     IconColor="Color.Error"
                                                     OnClick="@(() => DeleteAccount(account.Id))">
                                            Delete
                                        </MudMenuItem>
                                    </MudMenu>
                                    </MudStack>

                                </MudStack>
                            </MudHidden>

                            <!-- Item (Tablet/Desktop) -->
                            <MudHidden Breakpoint="Breakpoint.Xs">
                                <MudStack Row="true"
                                          Justify="Justify.SpaceBetween"
                                          AlignItems="AlignItems.Center">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudAvatar Size="Size.Medium"
                                                   Style="@($"background-color: {account.Color};")">
                                            @if (!string.IsNullOrEmpty(account.BankName))
                                            {
                                                <span style="color:white; font-size:10px; font-weight:700; letter-spacing:0.5px;">@GetBankInitials(account.BankName)</span>
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@account.Icon.ToIcon()" Color="Color.Surface" Size="Size.Small" />
                                            }
                                        </MudAvatar>

                                        <MudStack Spacing="0">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudText Typo="Typo.body1" Class="font-weight-medium">
                                                    @account.Name
                                                </MudText>
                                                @if (NeedsBankWarning(account))
                                                {
                                                    <MudTooltip Text="Bank/card details missing — view account to complete">
                                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" />
                                                    </MudTooltip>
                                                }
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Style="opacity: 0.7;">
                                                @GetAccountSubtitle(account)
                                            </MudText>
                                            @if (account.Type == AccountType.Credit && !string.IsNullOrEmpty(account.CardDisplayName))
                                            {
                                                <MudText Typo="Typo.caption" Style="opacity:0.5; font-family:monospace; letter-spacing:1px;">
                                                    •••• @account.CardDisplayName
                                                </MudText>
                                            }
                                        </MudStack>
                                    </MudStack>

                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                        <MudStack Spacing="0" AlignItems="AlignItems.End">
                                            <MudText Typo="Typo.h6" Class="@($"font-weight-bold {GetBalanceClass(account.CurrentBalance)}")">
                                                @CurrencyHelper.FormatCurrency(account.CurrentBalance)
                                            </MudText>
                                            @if (account.Type == AccountType.Credit && account.CreditLimit > 0)
                                            {
                                                var used = (double)(Math.Abs(account.CurrentBalance) / account.CreditLimit) * 100d;
                                                var usedClamped = Math.Clamp(used, 0d, 100d);
                                                var limitColor = used >= 90 ? Color.Error : used >= 70 ? Color.Warning : Color.Success;
                                                <MudStack Spacing="1" Style="min-width:140px;">
                                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                        <MudText Typo="Typo.caption" Style="opacity:0.65;">Uso</MudText>
                                                        <MudText Typo="Typo.caption" Style="opacity:0.85; font-weight:600;">@($"{usedClamped:F0}")%</MudText>
                                                    </MudStack>
                                                    <MudProgressLinear Value="@usedClamped" Color="@limitColor" Size="Size.Small" />
                                                    <MudText Typo="Typo.caption" Style="opacity:0.65; text-align:right;">
                                                        @CurrencyHelper.FormatCurrency(account.AvailableCredit) available
                                                    </MudText>
                                                </MudStack>
                                            }

                                            @if (account.Type == AccountType.Credit && (account.CutDay.HasValue || account.PaymentDay.HasValue || account.AnnualInterestRate.HasValue))
                                            {
                                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Style="flex-wrap:wrap; gap:6px;">
                                                    @if (account.CutDay.HasValue)
                                                    {
                                                        var co = GetDayOffset(account.CutDay.Value);
                                                        var cl = co < 0 ? $"Cut · closed {Math.Abs(co)}d ago"
                                                               : co == 0 ? $"Cut · today!"
                                                               : $"Cut {account.CutDay} ({co}d)";
                                                        var cs = co < 0 ? "color:var(--mud-palette-info); opacity:0.85;"
                                                               : co == 0 ? "color:var(--mud-palette-warning); font-weight:700;"
                                                               : GetDayUrgencyStyle(co);
                                                        <MudText Typo="Typo.caption" Style="@($"white-space:nowrap; {cs}")">@cl</MudText>
                                                    }
                                                    @if (account.PaymentDay.HasValue)
                                                    {
                                                        var po = GetDayOffset(account.PaymentDay.Value);
                                                        var pl = po < 0 ? $"Due · OVERDUE {Math.Abs(po)}d!"
                                                               : po == 0 ? $"Due · today!"
                                                               : $"Due {account.PaymentDay} ({po}d)";
                                                        var ps = po <= 0 ? "color:var(--mud-palette-error); font-weight:700;"
                                                               : GetDayUrgencyStyle(po);
                                                        <MudText Typo="Typo.caption" Style="@($"white-space:nowrap; {ps}")">@pl</MudText>
                                                    }
                                                    @if (account.AnnualInterestRate.HasValue)
                                                    {
                                                        <MudText Typo="Typo.caption" Style="opacity:0.65; white-space:nowrap;">@($"{account.AnnualInterestRate:F1}")% APR</MudText>
                                                    }
                                                </MudStack>
                                            }
                                        </MudStack>

                                        <MudTooltip Text="@(account.IncludeInNetWorth ? "Included in net worth — click to exclude" : "Excluded from net worth — click to include")">
                                            <MudIconButton Icon="@(account.IncludeInNetWorth ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                                           Color="@(account.IncludeInNetWorth ? Color.Default : Color.Error)"
                                                           Size="Size.Small"
                                                           OnClick="@(() => ToggleNetWorthAsync(account))" />
                                        </MudTooltip>

                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                                 Size="Size.Small"
                                                 AnchorOrigin="Origin.BottomRight"
                                                 TransformOrigin="Origin.TopRight">
                                            <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                                         OnClick="@(() => ViewAccount(account.Id))">
                                                View
                                            </MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.SyncAlt"
                                                         OnClick="@(() => OpenAdjustBalanceDialog(account))">
                                                Adjust Balance
                                            </MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                                         OnClick="@(() => OpenEditDialog(account.Id))">
                                                Edit
                                            </MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.Sync"
                                                         OnClick="@(() => ConfirmSyncBalance(account))">
                                                Sync Balance
                                            </MudMenuItem>
                                            <MudDivider />
                                            <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                                         IconColor="Color.Error"
                                                         OnClick="@(() => DeleteAccount(account.Id))">
                                                Delete
                                            </MudMenuItem>
                                        </MudMenu>
                                    </MudStack>
                                </MudStack>
                            </MudHidden>

                        </MudPaper>
                    }
                </MudStack>
            </MudPaper>
        }
    }

    <QuickActionsFab OnTransactionAdded="@LoadAccounts" />
      
</MudContainer>

@code {
    private List<AccountDto> _accounts = new();
    private bool _loading = true;
    private bool _syncingAll = false;

    private decimal TotalAssets => _accounts.Where(a => a.IncludeInNetWorth && a.Type != AccountType.Credit).Sum(a => a.CurrentBalance);
    private decimal TotalLiabilities => _accounts.Where(a => a.IncludeInNetWorth && a.Type == AccountType.Credit).Sum(a => Math.Abs(a.CurrentBalance));
    private decimal NetWorth => TotalAssets - TotalLiabilities;
    private int ExcludedCount => _accounts.Count(a => !a.IncludeInNetWorth);

    private decimal TotalLiquidity => _accounts
        .Where(a => a.Type is AccountType.Bank or AccountType.Checking or AccountType.Savings or AccountType.Cash)
        .Sum(a => a.CurrentBalance);

    private decimal TotalCreditUsed => _accounts
        .Where(a => a.Type == AccountType.Credit && a.CreditLimit > 0)
        .Sum(a => Math.Abs(a.CurrentBalance));

    private decimal TotalCreditLimit => _accounts
        .Where(a => a.Type == AccountType.Credit && a.CreditLimit > 0)
        .Sum(a => a.CreditLimit);

    private decimal TotalMonthlyDebtCost => _accounts
        .Where(a => a.Type == AccountType.Credit && a.AnnualInterestRate.HasValue && a.CurrentBalance < 0)
        .Sum(a => Math.Abs(a.CurrentBalance) * (a.AnnualInterestRate!.Value / 100m) / 12m);
    private IEnumerable<IGrouping<AccountType, AccountDto>> _accountGroups = Enumerable.Empty<IGrouping<AccountType, AccountDto>>();
    private IReadOnlyList<CreditAlert> _creditAlerts = [];

    private readonly List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Home", href: "/", icon: Icons.Material.Filled.Home),
        new BreadcrumbItem("Accounts", href: null, disabled: true)
    };

    private readonly DialogOptions _dialogOptions = new()
    {
        CloseButton = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Large,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
        => await LoadAccounts();

    private async Task LoadAccounts()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var result = await AccountService.GetAccountsWithBalancesAsync();
            if (result.Success && result.Data is not null)
            {
                _accounts = result.Data;
                _creditAlerts = BuildCreditAlerts();
                _accountGroups = _accounts.GroupBy(a => a.Type)
                    .OrderBy(g => g.Key switch
                    {
                        AccountType.Bank      => 0,
                        AccountType.Checking  => 1,
                        AccountType.Savings   => 2,
                        AccountType.Credit    => 3,
                        AccountType.Investment=> 4,
                        AccountType.Cash      => 5,
                        _                    => 6
                    });
            }
            else
            {
                Snackbar.Add(result.Message ?? "Failed to load accounts", Severity.Error);
                _accounts.Clear();
                _accountGroups = Enumerable.Empty<IGrouping<AccountType, AccountDto>>();
            }
        }
        catch
        {
            Snackbar.Add("Error loading accounts", Severity.Error);
            _accounts.Clear();
            _accountGroups = Enumerable.Empty<IGrouping<AccountType, AccountDto>>();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ViewAccount(int id) => NavigationManager.NavigateTo($"/accounts/{id}");

    private async Task OpenEditDialog(int id)
    {
        var parameters = new DialogParameters
        {
            ["AccountId"] = id,
            ["OnAccountUpdated"] = EventCallback.Factory.Create(this, LoadAccounts)
        };
        await DialogService.ShowAsync<UpdateAccountModal>("Update Account", parameters, _dialogOptions);
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters
        {
            ["OnAccountAdded"] = EventCallback.Factory.Create(this, LoadAccounts)
        };
        await DialogService.ShowAsync<AddAccountModal>("Add Account", parameters, _dialogOptions);
    }

    private async Task DeleteAccount(int id)
    {
        var account = _accounts.FirstOrDefault(a => a.Id == id);
        var accountName = account?.Name ?? "this account";

        bool confirmed = await DialogService.ShowConfirmDialogAsync(
            "Delete Account",
            $"WARNING: '{accountName}' will be logically deleted. All related transactions and dependent records will also be logically deleted and hidden from reports. Continue?",
            confirmText: "Delete",
            color: Color.Error);

        if (!confirmed) return;

        try
        {
            var result = await AccountService.DeleteAsync(id);
            if (result.Success)
            {
                Snackbar.Add($"Account '{accountName}' deleted successfully", Severity.Success);
                await LoadAccounts();
                AccountsDrawer.RequestRefresh();
            }
            else
            {
                Snackbar.Add(result.Message ?? "Failed to delete account", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Error deleting account", Severity.Error);
        }
    }

