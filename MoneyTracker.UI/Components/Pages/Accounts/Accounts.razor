    private static string GetBankInitials(string? bankName)
    {
        if (string.IsNullOrWhiteSpace(bankName)) return string.Empty;
        var words = bankName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length == 1
            ? bankName[..Math.Min(4, bankName.Length)].ToUpper()
            : string.Concat(words.Take(3).Select(w => w[0])).ToUpper();
    }

    private static string GetAccountSubtitle(AccountDto account)
        => !string.IsNullOrEmpty(account.BankName) ? account.BankName : account.Type.ToLabel();

    // Days until next occurrence of this day-of-month (always positive, wraps to next month)
    private static int GetDaysUntil(int day)
    {
        var today = DateTime.Today;
        var target = new DateTime(today.Year, today.Month, Math.Min(day, DateTime.DaysInMonth(today.Year, today.Month)));
        if (target <= today)
        {
            var next = today.AddMonths(1);
            target = new DateTime(next.Year, next.Month, Math.Min(day, DateTime.DaysInMonth(next.Year, next.Month)));
        }
        return (target - today).Days;
    }

    // Days relative to this month's occurrence (negative = already passed this month)
    private static int GetDayOffset(int day)
    {
        var today = DateTime.Today;
        var target = new DateTime(today.Year, today.Month, Math.Min(day, DateTime.DaysInMonth(today.Year, today.Month)));
        return (target - today).Days;
    }

    private static string GetDayUrgencyStyle(int days) => days <= 3
        ? "color:var(--mud-palette-error); font-weight:700;"
        : days <= 7
            ? "color:var(--mud-palette-warning-darken); font-weight:600;"
            : "opacity:0.7;";

    private record CreditAlert(string AccountName, string EventType, int Day, int Offset);

    private IReadOnlyList<CreditAlert> BuildCreditAlerts()
    {
        var result = new List<CreditAlert>();
        foreach (var a in _accounts.Where(a => a.Type == AccountType.Credit))
        {
            if (a.CutDay.HasValue)
            {
                var off = GetDayOffset(a.CutDay.Value);
                if (off >= -3 && off <= 7)
                    result.Add(new CreditAlert(a.Name, "Cut", a.CutDay.Value, off));
            }
            if (a.PaymentDay.HasValue)
            {
                var off = GetDayOffset(a.PaymentDay.Value);
                if (off >= -2 && off <= 10)
                    result.Add(new CreditAlert(a.Name, "Due", a.PaymentDay.Value, off));
            }
        }
        return result.OrderBy(e => e.Offset).ToList();
    }

    private static Severity GetAlertSeverity(CreditAlert alert)
    {
        if (alert.EventType == "Due" && alert.Offset <= 0) return Severity.Error;
        if (alert.EventType == "Due" && alert.Offset <= 3) return Severity.Error;
        if (alert.EventType == "Due") return Severity.Warning;
        if (alert.EventType == "Cut" && alert.Offset < 0) return Severity.Info;
        if (alert.EventType == "Cut" && alert.Offset == 0) return Severity.Warning;
        return Severity.Warning;
    }

    private static string GetAlertIcon(CreditAlert alert) =>
        alert.EventType == "Due" && alert.Offset <= 0
            ? Icons.Material.Filled.PriorityHigh
            : alert.EventType == "Due"
                ? Icons.Material.Filled.Payment
                : Icons.Material.Filled.Receipt;

    private static string GetAlertMessage(CreditAlert alert)
    {
        if (alert.EventType == "Due" && alert.Offset < 0)
            return $"{alert.AccountName} — payment was due {Math.Abs(alert.Offset)}d ago!";
        if (alert.EventType == "Due" && alert.Offset == 0)
            return $"{alert.AccountName} — payment due TODAY (day {alert.Day})";
        if (alert.EventType == "Due")
            return $"{alert.AccountName} — payment due in {alert.Offset}d (day {alert.Day})";
        if (alert.EventType == "Cut" && alert.Offset < 0)
            return $"{alert.AccountName} — statement closed {Math.Abs(alert.Offset)}d ago · check your statement";
        if (alert.EventType == "Cut" && alert.Offset == 0)
            return $"{alert.AccountName} — statement closes TODAY (day {alert.Day})";
        return $"{alert.AccountName} — statement closes in {alert.Offset}d (day {alert.Day})";
    }

    private async Task ConfirmSyncBalance(AccountDto account)
    {
        var confirmed = await DialogService.ShowConfirmDialogAsync(
            "Sync Balance",
            $"This will recalculate the balance for '{account.Name}' by summing all its transactions and overwrite the stored balance. Continue?",
            confirmText: "Sync");

        if (!confirmed)
            return;

        try
        {
            var result = await AccountService.SyncBalanceAsync(account.Id);

            if (result.Success)
            {
                Snackbar.Add(result.Message ?? "Balance synced", Severity.Success);
                await LoadAccounts();
                AccountsDrawer.RequestRefresh();
            }
            else
            {
                Snackbar.Add(result.Message ?? "Failed to sync balance", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Error syncing balance", Severity.Error);
        }
    }
