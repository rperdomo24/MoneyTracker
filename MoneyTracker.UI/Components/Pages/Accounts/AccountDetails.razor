@page "/accounts/{id:int}"
@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Account
@using MoneyTracker.Domain.Enums.Filters
@using MoneyTracker.Domain.Enums.Transaction
@using MoneyTracker.UI.Components.Pages
@using MoneyTracker.UI.Components.Pages.Transactions
@using MoneyTracker.UI.Components.Shared
@using MoneyTracker.UI.Components.Shared.Navigation
@using MoneyTracker.UI.Helpers
@inject IAccountService AccountService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>@(_account?.Name ?? "Account") - Money Tracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">

    @if (_loading)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Class="mt-4">Loading account...</MudText>
        </MudStack>
    }
    else if (_account == null)
    {
        <MudPaper Class="pa-8" Elevation="1">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Error"
                         Size="Size.Large"
                         Style="font-size: 4rem; opacity: 0.3;" />
                <MudText Typo="Typo.h6">Account not found</MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="GoToAccounts">
                    Back to Accounts
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <!-- Breadcrumbs & Menu -->
        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mb-4">
            <Breadcrumb Items="@_breadcrumbItems" />

            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight">
                <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                             OnClick="OpenEditDialog">
                    Edit Account
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.SyncAlt"
                             OnClick="OpenAdjustBalanceDialog">
                    Adjust Balance
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                             IconColor="Color.Error"
                             OnClick="DeleteAccount">
                    <MudText Color="Color.Error">Delete Account</MudText>
                </MudMenuItem>
            </MudMenu>
        </MudStack>

        <!-- Chart Placeholder -->
        <MudPaper Class="pa-4 mb-4" Elevation="1" Style="min-height: 200px;">
            <MudStack AlignItems="AlignItems.Center"
                      Justify="Justify.Center"
                      Style="height: 200px;">
                <MudIcon Icon="@Icons.Material.Filled.ShowChart"
                         Size="Size.Large"
                         Style="opacity: 0.3; font-size: 3rem;" />
                <MudText Typo="Typo.body2" Style="opacity: 0.5;">
                    Balance chart coming soon
                </MudText>
            </MudStack>
        </MudPaper>

        <!-- Account Info Card -->
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center">
                <!-- Left: Icon + Name + Type -->
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Size="Size.Large"
                               Style="@($"background-color: {_account.Color}; width: 64px; height: 64px;")">
                        <MudIcon Icon="@_account.Icon.ToIcon()"
                                 Color="Color.Surface"
                                 Size="Size.Large" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h5" Class="font-weight-bold">
                            @_account.Name
                        </MudText>
                        <MudText Typo="Typo.body2" Style="opacity: 0.7;">
                            @_account.Type.ToLabel()
                        </MudText>
                    </MudStack>
                </MudStack>

                <!-- Right: Balance Info -->
                <MudStack Spacing="1" AlignItems="AlignItems.End">
                    <MudText Typo="Typo.h4" Class="@($"font-weight-bold {GetBalanceClass(_account.CurrentBalance)}")">
                        @_account.FormattedBalance
                    </MudText>
                    @if (_account.Type == AccountType.Credit && _account.CreditLimit > 0)
                    {
                        <MudStack Spacing="0" AlignItems="AlignItems.End">
                            <MudText Typo="Typo.body2" Style="opacity: 0.7;">
                                Available: @FormatBalance(_account.AvailableCredit)
                            </MudText>
                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">
                                @{
                                    var utilization = _account.CreditLimit > 0
                                    ? (Math.Abs(_account.CurrentBalance) / _account.CreditLimit) * 100
                                    : 0;
                                }
                                Utilization: @($"{utilization:F1}%")
                            </MudText>
                        </MudStack>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        <!-- Filters & Actions Bar -->
        <MudPaper Class="pa-3 mb-4" Elevation="1">
            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_filterDto.SearchText"
                              @bind-Value:after="OnSearchChanged"
                              Placeholder="Search transactions"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true"
                              Immediate="true"
                              Style="max-width: 300px;" />

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.FilterList"
                               OnClick="ToggleFiltersDrawer">
                        Filters
                        @if (HasActiveFilters())
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Primary"
                                     Class="ml-2">
                                @GetActiveFiltersCount()
                            </MudChip>
                        }
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenAddTransactionDialog">
                        New Transaction
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <!-- Transactions List Component -->
        <AccountTransactionsList AccountId="@Id"
                                 Filter="_filterDto"
                                 OnTransactionChanged="OnTransactionChanged"
                                 OnClearFilters="ClearAllFilters" />

    }

    <!-- AccountFilters Component -->
    <AccountFilters @bind-IsOpen="_filtersDrawerOpen"
                    AccountId="@Id"
                    Filter="_filterDto"
                    OnFiltersApplied="OnFiltersApplied" />

    <!-- QuickActionsFab -->
    <QuickActionsFab OnTransactionAdded="OnTransactionChanged" />

</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private AccountDto? _account;
    private bool _loading = true;
    private bool _filtersDrawerOpen = false;

    private TransactionFilterDto _filterDto = new()
    {
        TimePeriod = TimePeriodFilter.Last30Days
    };

    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Home", href: "/", icon: Icons.Material.Filled.Home),
        new BreadcrumbItem("Accounts", href: "/accounts", icon: Icons.Material.Filled.AccountBalance),
        new BreadcrumbItem("Loading...", href: null, disabled: true)
    };

    private readonly DialogOptions _dialogOptions = new()
    {
        CloseButton = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Large
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAccount();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_account?.Id != Id)
        {
            await LoadAccount();
        }
    }

    private async Task LoadAccount()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var result = await AccountService.GetByIdAsync(Id);
            if (result.Success && result.Data != null)
            {
                _account = result.Data;
                UpdateBreadcrumb();
            }
            else
            {
                Snackbar.Add(result.Message ?? "Account not found", Severity.Error);
                _account = null;
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Error loading account", Severity.Error);
            _account = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void UpdateBreadcrumb()
    {
        if (_account != null)
        {
            _breadcrumbItems[2] = new BreadcrumbItem(_account.Name, href: null, disabled: true);
        }
    }

    private void GoToAccounts()
    {
        NavigationManager.NavigateTo("/accounts");
    }

    private async Task OpenEditDialog()
    {
        var parameters = new DialogParameters
        {
            ["AccountId"] = Id,
            ["OnAccountUpdated"] = EventCallback.Factory.Create(this, LoadAccount)
        };

        await DialogService.ShowAsync<UpdateAccountModal>(
            "Edit Account",
            parameters,
            _dialogOptions);
    }

    private async Task OpenAdjustBalanceDialog()
    {
        if (_account == null) return;

        var parameters = new DialogParameters
        {
            ["AccountId"] = Id,
            ["AccountName"] = _account.Name,
            ["AccountIcon"] = _account.Icon.ToIcon(),
            ["AccountColor"] = _account.Color,
            ["CurrentBalance"] = _account.CurrentBalance,
            ["OnBalanceAdjusted"] = EventCallback.Factory.Create(this, LoadAccount)
        };

        await DialogService.ShowAsync<AdjustBalanceModal>(
            "Adjust Balance",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small });
    }

    private async Task DeleteAccount()
    {
        if (_account == null) return;

        bool confirmed = await DialogService.ShowMessageBox(
            "Delete Account",
            $"Are you sure you want to delete '{_account.Name}'? This will also delete all associated transactions.",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions { CloseButton = true }) ?? false;

        if (confirmed)
        {
            try
            {
                var result = await AccountService.DeleteAsync(Id);
                if (result.Success)
                {
                    Snackbar.Add($"Account '{_account.Name}' deleted successfully", Severity.Success);
                    NavigationManager.NavigateTo("/accounts");
                }
                else
                {
                    Snackbar.Add(result.Message ?? "Failed to delete account", Severity.Error);
                }
            }
            catch (Exception)
            {
                Snackbar.Add("Error deleting account", Severity.Error);
            }
        }
    }

    private async Task OpenAddTransactionDialog()
    {
        var parameters = new DialogParameters
        {
            ["TransactionType"] = TransactionTypeEnum.Expense,
            ["PreselectedAccountId"] = Id,
            ["OnTransactionAdded"] = EventCallback.Factory.Create(this, OnTransactionChanged)
        };

        await DialogService.ShowAsync<AddTransactionModal>(
            "New Transaction",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = true,
                BackdropClick = true
            });
    }

    private void ToggleFiltersDrawer()
    {
        _filtersDrawerOpen = !_filtersDrawerOpen;
    }

    private async Task OnFiltersApplied(TransactionFilterDto filter)
    {
        _filterDto = filter;
        StateHasChanged();
    }

    private async Task OnSearchChanged()
    {
        // Search is reactive through @bind-Value
        StateHasChanged();
    }

    private async Task ClearAllFilters()
    {
        _filterDto = new TransactionFilterDto
        {
            TimePeriod = TimePeriodFilter.Last30Days,
            AccountIds = new List<int> { Id }
        };
        StateHasChanged();
    }

    private async Task OnTransactionChanged()
    {
        await LoadAccount(); // Refresh account balance
        StateHasChanged();
    }

    private bool HasActiveFilters()
    {
        return _filterDto.TimePeriod != TimePeriodFilter.Last30Days ||
               !string.IsNullOrWhiteSpace(_filterDto.SearchText) ||
               _filterDto.Type.HasValue ||
               _filterDto.CategoryId.HasValue;
    }

    private int GetActiveFiltersCount()
    {
        int count = 0;

        if (_filterDto.TimePeriod != TimePeriodFilter.Last30Days) count++;
        if (!string.IsNullOrWhiteSpace(_filterDto.SearchText)) count++;
        if (_filterDto.Type.HasValue) count++;
        if (_filterDto.CategoryId.HasValue) count++;

        return count;
    }

    private string FormatBalance(decimal balance)
    {
        return balance < 0 ? $"-${Math.Abs(balance):N2}" : $"${balance:N2}";
    }

    private string GetBalanceClass(decimal balance)
    {
        return balance switch
        {
            > 0 => "text-success",
            < 0 => "text-error",
            _ => ""
        };
    }
}