@* Components/Pages/Accounts/AccountTransactionList.razor *@
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.UI.Components.Pages.Transactions
@using MoneyTracker.UI.Components.Shared
@using MoneyTracker.UI.Components.Shared.Navigation
@using MoneyTracker.UI.Components.Shared.Selection
@inject ITransactionService TransactionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<!-- Transactions List Component -->
<TransactionListBase GroupedTransactions="@_groupedTransactions"
                 Loading="@_loading"
                 ShowAccounts="false"
                 HasActiveFilters="@_hasActiveFilters"
                 EmptyStateMessage="Start by adding your first transaction for this account"
                 TotalTransactions="@_totalTransactions"
                 CurrentPage="@_currentPage"
                 TotalPages="@_totalPages"
                 RowsPerPage="@_rowsPerPage"
                 PageSizeOptions="@(new List<int> { 5, 10, 25, 50, 100 })"
                 SelectedTransactionIds="@_selectedTransactionIds"
                 SelectedTransactionIdsChanged="@OnSelectedTransactionsChanged"
                 AllTransactions="@_transactionSummary?.Transactions"
                 OnEdit="EditTransaction"
                 OnDuplicate="DuplicateTransaction"
                 OnDelete="DeleteTransaction"
                 OnClearFilters="OnClearFilters"
                 OnDeleteSelected="DeleteSelectedTransactions"
                 OnPageChanged="HandlePageChanged"
                 OnRowsPerPageChanged="HandleRowsPerPageChanged" />

<SelectionActionBar SelectedCount="@_selectedTransactionIds.Count"
                    OnClearSelection="ClearSelection"
                    OnDeleteSelected="DeleteSelectedTransactions" />

<UpdateTransactionDrawer @bind-IsOpen="_drawerOpen"
                         TransactionId="@_selectedTransactionId"
                         OnTransactionUpdated="OnTransactionUpdatedHandler" />

@code {
    [Parameter] public int AccountId { get; set; }
    [Parameter] public TransactionFilterDto Filter { get; set; } = new();
    [Parameter] public EventCallback OnTransactionChanged { get; set; }
    [Parameter] public EventCallback OnClearFilters { get; set; }

    private bool _loading = true;
    private bool _hasActiveFilters = false;
    private List<TransactionGroupDto> _groupedTransactions = new();
    private int _currentPage = 1;
    private int _totalPages = 1;
    private int _rowsPerPage = 10;
    private int _totalTransactions = 0;
    private TransactionSummaryDto? _transactionSummary;
    private HashSet<int> _selectedTransactionIds = new();
    private bool _drawerOpen = false;
    private int _selectedTransactionId = 0;

    protected override async Task OnInitializedAsync() => await LoadTransactions();
    protected override async Task OnParametersSetAsync() => await LoadTransactions();

    private async Task LoadTransactions()
    {
        _loading = true;
        _selectedTransactionIds.Clear();
        StateHasChanged();

        try
        {
            if (AccountId > 0)
            {
                Filter.AccountIds = new List<int> { AccountId };
            }

            var result = await TransactionService.GetFilteredAsync(Filter);
            
            if (result.Success && result.Data != null)
            {
                _transactionSummary = result.Data;
                _hasActiveFilters = HasActiveFilters(Filter);
                GroupTransactions();
            }
            else
            {
                _transactionSummary = new TransactionSummaryDto();
                _groupedTransactions = new();
            }
        }
        catch { Snackbar.Add("Error loading transactions", Severity.Error); }
        finally { _loading = false; StateHasChanged(); }
    }

    private void GroupTransactions()
    {
        if (_transactionSummary?.Transactions == null)
        {
            _groupedTransactions = new();
            _totalPages = 1;
            _totalTransactions = 0;
            return;
        }

        _totalTransactions = _transactionSummary.Transactions.Count;
        _totalPages = (int)Math.Ceiling(_totalTransactions / (double)_rowsPerPage);

        var pagedTransactions = _transactionSummary.Transactions
            .OrderByDescending(t => t.Date)
            .Skip((_currentPage - 1) * _rowsPerPage)
            .Take(_rowsPerPage)
            .ToList();

        _groupedTransactions = pagedTransactions
            .GroupBy(t => t.Date.Date)
            .OrderByDescending(g => g.Key)
            .Select(g => new TransactionGroupDto
            {
                Date = g.Key,
                Transactions = g.OrderByDescending(t => t.Date).ToList()
            })
            .ToList();
    }

    private async Task OnSelectedTransactionsChanged(HashSet<int> selectedIds)
    {
        _selectedTransactionIds = selectedIds;
        StateHasChanged();
    }

    private async Task HandlePageChanged(int page)
    {
        _currentPage = page;
        GroupTransactions();
        StateHasChanged();
    }

    private async Task HandleRowsPerPageChanged(int newSize)
    {
        _rowsPerPage = newSize;
        _currentPage = 1;
        GroupTransactions();
        StateHasChanged();
    }

    private void EditTransaction(TransactionDto tx) { _selectedTransactionId = tx.Id; _drawerOpen = true; }

    private async Task DuplicateTransaction(TransactionDto tx)
    {
        try
        {
            var result = await TransactionService.DuplicateTransactionAsync(tx.Id);
            if (result.Success) { 
                Snackbar.Add("Transaction duplicated", Severity.Success); 
                await LoadTransactions(); 
                await OnTransactionChanged.InvokeAsync(); 
            }
            else Snackbar.Add("Error duplicating", Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
    }

    private async Task DeleteTransaction(TransactionDto tx)
    {
        var isTransfer = tx.TransferPairId.HasValue;
        var message = isTransfer ? 
            "Delete this transfer? This will delete both transactions." : 
            $"Delete '{tx.Name}'?";
        
        bool confirmed = await DialogService.ShowMessageBox(
            $"Delete {(isTransfer ? "Transfer" : "Transaction")}", 
            message, yesText: "Delete", cancelText: "Cancel") ?? false;
        
        if (confirmed)
        {
            var result = isTransfer ? 
                await TransactionService.DeleteTransferAsync(tx.Id) : 
                await TransactionService.DeleteAsync(tx.Id);
            
            if (result.Success) { 
                Snackbar.Add("Deleted", Severity.Success); 
                await LoadTransactions(); 
                await OnTransactionChanged.InvokeAsync(); 
            }
            else Snackbar.Add("Error deleting", Severity.Error);
        }
    }

    private async Task DeleteSelectedTransactions()
    {
        if (_selectedTransactionIds.Count == 0) return;
        
        bool confirmed = await DialogService.ShowMessageBox(
            "Delete Transactions", 
            $"Delete {_selectedTransactionIds.Count} transaction(s)?", 
            yesText: "Delete", cancelText: "Cancel") ?? false;
        
        if (confirmed)
        {
            int successCount = 0;
            foreach (var id in _selectedTransactionIds.ToList())
            {
                var tx = _transactionSummary?.Transactions?.FirstOrDefault(t => t.Id == id);
                if (tx == null) continue;
                
                var result = tx.TransferPairId.HasValue ? 
                    await TransactionService.DeleteTransferAsync(id) : 
                    await TransactionService.DeleteAsync(id);
                
                if (result.Success) successCount++;
            }
            
            if (successCount > 0) { 
                Snackbar.Add($"{successCount} deleted", Severity.Success); 
                _selectedTransactionIds.Clear(); 
                await LoadTransactions(); 
                await OnTransactionChanged.InvokeAsync(); 
            }
        }
    }

    private void ClearSelection() { _selectedTransactionIds.Clear(); StateHasChanged(); }

    private async Task OnTransactionUpdatedHandler() { 
        await LoadTransactions(); 
        await OnTransactionChanged.InvokeAsync(); 
    }

    private bool HasActiveFilters(TransactionFilterDto filter)
    {
        return !string.IsNullOrEmpty(filter.SearchText) ||
               filter.AccountIds.Any() ||
               filter.CategoryId.HasValue ||
               filter.Type.HasValue;
    }
}