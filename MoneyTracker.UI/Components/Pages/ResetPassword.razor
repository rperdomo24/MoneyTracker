@page "/reset-password"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-12">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h5" Class="mb-2">Reset password</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">Use the code sent to your email.</MudText>

        @if (!string.IsNullOrWhiteSpace(Info))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@Info</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@Error</MudAlert>
        }

        <form method="post" action="/auth/reset-password">
            <AntiforgeryToken />
            <MudText Typo="Typo.caption" Class="mb-1 d-block">Email</MudText>
            <input type="email"
                   name="email"
                   @bind="_email"
                   autocomplete="username"
                   class="mud-input-slot mud-input-root mud-input-root-outlined"
                   style="width:100%; padding: 14px 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;" />
            <MudText Typo="Typo.caption" Class="mb-1 mt-3 d-block">Reset code</MudText>
            <input type="text"
                   name="code"
                   @bind="_code"
                   autocomplete="one-time-code"
                   class="mud-input-slot mud-input-root mud-input-root-outlined"
                   style="width:100%; padding: 14px 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;" />
            <MudText Typo="Typo.caption" Class="mb-1 mt-3 d-block">New password</MudText>
            <input type="password"
                   name="newPassword"
                   @bind="_newPassword"
                   autocomplete="new-password"
                   class="mud-input-slot mud-input-root mud-input-root-outlined"
                   style="width:100%; padding: 14px 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;" />
            <MudText Typo="Typo.caption" Class="mb-1 mt-3 d-block">Confirm password</MudText>
            <input type="password"
                   name="confirmPassword"
                   @bind="_confirmPassword"
                   autocomplete="new-password"
                   class="mud-input-slot mud-input-root mud-input-root-outlined"
                   style="width:100%; padding: 14px 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;" />
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" Class="mt-4">
                Update password
            </MudButton>
        </form>

        <MudText Typo="Typo.body2" Class="mt-3">
            <MudLink Href="/login">Back to sign in</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Info { get; set; }

    private string _email = string.Empty;
    private string _code = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Email))
        {
            _email = Email;
        }
    }
}
