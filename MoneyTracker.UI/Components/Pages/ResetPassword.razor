@page "/reset-password"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout

<MudText Typo="Typo.h5" Align="Align.Center" Class="font-weight-bold">Reset password</MudText>
<MudText Typo="Typo.body2" Align="Align.Center" Class="mb-3">Use the code sent to your email.</MudText>

@if (!string.IsNullOrWhiteSpace(Info))
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@Info</MudAlert>
}

@if (!string.IsNullOrWhiteSpace(Error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@Error</MudAlert>
}

<form method="post" action="/auth/reset-password">
    <AntiforgeryToken />
    <MudTextField @bind-Value="_email"
                  Label="Email"
                  Variant="Variant.Outlined"
                  InputType="InputType.Email"
                  FullWidth="true"
                  Class="mt-3" />
    <MudTextField @bind-Value="_code"
                  Label="Reset code"
                  Variant="Variant.Outlined"
                  FullWidth="true"
                  Class="mt-3" />
    <MudTextField @bind-Value="_newPassword"
                  Label="New password"
                  Variant="Variant.Outlined"
                  InputType="@NewPasswordInputType"
                  Adornment="Adornment.End"
                  AdornmentIcon="@NewPasswordAdornmentIcon"
                  OnAdornmentClick="ToggleNewPasswordVisibility"
                  FullWidth="true"
                  Class="mt-3" />
    <MudTextField @bind-Value="_confirmPassword"
                  Label="Confirm password"
                  Variant="Variant.Outlined"
                  InputType="@ConfirmPasswordInputType"
                  Adornment="Adornment.End"
                  AdornmentIcon="@ConfirmPasswordAdornmentIcon"
                  OnAdornmentClick="ToggleConfirmPasswordVisibility"
                  FullWidth="true"
                  Class="mt-3" />
    <input type="hidden" name="email" value="@_email" />
    <input type="hidden" name="code" value="@_code" />
    <input type="hidden" name="newPassword" value="@_newPassword" />
    <input type="hidden" name="confirmPassword" value="@_confirmPassword" />
    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" Class="mt-4">
        Update password
    </MudButton>
</form>

<MudText Typo="Typo.body2" Align="Align.Center" Class="mt-3">
    <MudLink Href="/login">Back to sign in</MudLink>
</MudText>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Info { get; set; }

    private string _email = string.Empty;
    private string _code = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _showNewPassword;
    private bool _showConfirmPassword;
    private InputType NewPasswordInputType => _showNewPassword ? InputType.Text : InputType.Password;
    private InputType ConfirmPasswordInputType => _showConfirmPassword ? InputType.Text : InputType.Password;
    private string NewPasswordAdornmentIcon => _showNewPassword
        ? Icons.Material.Filled.VisibilityOff
        : Icons.Material.Filled.Visibility;
    private string ConfirmPasswordAdornmentIcon => _showConfirmPassword
        ? Icons.Material.Filled.VisibilityOff
        : Icons.Material.Filled.Visibility;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Email))
        {
            _email = Email;
        }
    }

    private void ToggleNewPasswordVisibility()
    {
        _showNewPassword = !_showNewPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        _showConfirmPassword = !_showConfirmPassword;
    }
}
