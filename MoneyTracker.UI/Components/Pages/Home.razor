@page "/"

<MudPaper Class="pa-6 mb-4" Elevation="4">
    <MudText Typo="Typo.h4" GutterBottom="true">Bienvenido a <b>MoneyTracker</b></MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        Administra tus ingresos, gastos y metas de ahorro con claridad.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SayHello">Presióname</MudButton>
</MudPaper>

@code {
    [Inject] ISnackbar Snackbar { get; set; } = default!;

    void SayHello()
    {
        Snackbar.Add("Hola desde MudBlazor 🎉", Severity.Success);
    }
}
