@page "/loans"
@using MoneyTracker.Application.DTOs.Loans
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Loans
@using MoneyTracker.UI.Helpers
@using MoneyTracker.UI.Services.Print
@inject ILoanService LoanService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILoanPrintService LoanPrintService

<PageTitle>Loans - Money Tracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-1 pa-sm-6">

    <!-- Header (Mobile) -->
    <MudHidden Breakpoint="Breakpoint.SmAndUp">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3 px-1">
            <MudText Typo="Typo.h5" Class="font-weight-bold">Loans</MudText>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDialog"
                       Size="Size.Small">
                New
            </MudButton>
        </MudStack>
    </MudHidden>

    <!-- Header (Tablet/Desktop) -->
    <MudHidden Breakpoint="Breakpoint.Xs">
        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mb-4">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5" Class="font-weight-bold">Loans</MudText>
                <MudText Typo="Typo.body2" Style="opacity:0.6;">Money you've lent out</MudText>
            </MudStack>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDialog">
                New Loan
            </MudButton>
        </MudStack>
    </MudHidden>

    <!-- Summary chips (always from full dataset) -->
    @if (_allLoans.Any())
    {
        var totalLent = _allLoans.Sum(l => l.PrincipalAmount);
        var totalOutstanding = _allLoans.Where(l => l.Status == LoanStatus.Active).Sum(l => l.Balance);
        var totalOverdue = _allLoans.Count(l => l.IsOverdue);

        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="6" sm="@(totalOverdue > 0 ? 4 : 6)">
                <MudPaper Outlined="true" Class="pa-3 pa-sm-4" Style="height:100%;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Style="opacity:0.6;" />
                        <MudStack Spacing="0" Style="min-width:0;">
                            <MudText Typo="Typo.caption" Style="opacity:0.7;">Lent</MudText>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                @CurrencyHelper.FormatCurrency(totalLent)
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="@(totalOverdue > 0 ? 4 : 6)">
                <MudPaper Outlined="true" Class="pa-3 pa-sm-4" Style="height:100%; border-color: var(--mud-palette-warning);">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Warning" />
                        <MudStack Spacing="0" Style="min-width:0;">
                            <MudText Typo="Typo.caption" Style="opacity:0.7;">Outstanding</MudText>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                @CurrencyHelper.FormatCurrency(totalOutstanding)
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
            @if (totalOverdue > 0)
            {
                <MudItem xs="12" sm="4">
                    <MudPaper Outlined="true" Class="pa-3 pa-sm-4" Style="height:100%; border-color: var(--mud-palette-error);">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" />
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Style="opacity:0.7;">Overdue</MudText>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@totalOverdue @(totalOverdue == 1 ? "loan" : "loans")</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }

    <!-- Status filter -->
    @if (_allLoans.Any())
    {
        <MudStack Row="true" Spacing="1" Class="mb-3" AlignItems="AlignItems.Center" Wrap="Wrap.NoWrap" Style="overflow-x:auto; padding-bottom:4px;">
            @foreach (var opt in _loanFilterOptions)
            {
                var isActive = _loanStatusFilter == opt.Value;
                <MudChip T="string"
                         Color="@GetStatusColor(opt.Value)"
                         Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                         Size="Size.Small"
                         OnClick="@(() => SetLoanFilter(opt.Value))"
                         Icon="@opt.Icon">
                    @opt.Label
                    @if (opt.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Inline="true" Style="opacity:0.7;"> (@opt.Count)</MudText>
                    }
                </MudChip>
            }
        </MudStack>
    }

    @if (_loading)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-10">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Class="mt-4">Loading loans...</MudText>
        </MudStack>
    }
    else if (!_allLoans.Any())
    {
        <MudPaper Class="pa-6 pa-sm-8" Elevation="1">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Handshake"
                         Size="Size.Large"
                         Style="font-size: 4rem; opacity: 0.3;" />
                <MudText Typo="Typo.h6">No loans tracked yet</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center">
                    Track money you've lent and register payments as they come in.
                </MudText>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddDialog"
                           Size="Size.Large">
                    Add First Loan
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else if (!_displayedLoans.Any())
    {
        <MudPaper Class="pa-6" Elevation="1">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.FilterListOff" Size="Size.Large" Style="font-size: 3rem; opacity: 0.3;" />
                <MudText Typo="Typo.body1">No loans match the current filter.</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SetLoanFilter(null))">Show All</MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="2">
            @foreach (var loan in _displayedLoans)
            {
                var borderColor = loan.IsOverdue
                    ? "var(--mud-palette-error)"
                    : $"var(--mud-palette-{GetStatusColor(loan.Status).ToString().ToLowerInvariant()})";

                var contactLoanCount = GetContactLoans(loan.ContactName).Count;

                <MudItem xs="12" sm="6" lg="4" xl="3">
                    <MudCard Outlined="true" Elevation="1" Style="@($"border-left: 4px solid {borderColor}; height: 100%; display:flex; flex-direction:column;")">
                        <MudCardContent Class="pa-3 pa-sm-4" Style="flex:1;">
                            <!-- Title + outstanding -->
                            <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Spacing="2" Class="mb-2">
                                <MudStack Spacing="0" Style="min-width:0; flex:1;">
                                    <MudText Typo="Typo.h6" Class="font-weight-medium"
                                             Style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                        @loan.ContactName
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(loan.Description))
                                    {
                                        <MudText Typo="Typo.caption"
                                                 Style="opacity:0.6; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                            @loan.Description
                                        </MudText>
                                    }
                                </MudStack>

                                <MudStack Spacing="0" AlignItems="AlignItems.End" Style="flex-shrink:0;">
                                    @if (loan.Status == LoanStatus.PaidOff)
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="ma-0" Icon="@Icons.Material.Filled.CheckCircle">
                                            Paid Off
                                        </MudChip>
                                    }
                                    else if (loan.Status == LoanStatus.Forgiven)
                                    {
                                        <MudChip T="string" Color="Color.Default" Size="Size.Small" Class="ma-0">Forgiven</MudChip>
                                        @if (loan.Balance > 0)
                                        {
                                            <MudText Typo="Typo.caption" Style="opacity:0.7;">
                                                Written off @CurrencyHelper.FormatCurrency(loan.Balance)
                                            </MudText>
                                        }
                                    }
                                    else if (loan.OverpaymentAmount > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Warning">Overpaid</MudText>
                                        <MudText Typo="Typo.h6" Color="Color.Warning" Class="font-weight-bold">
                                            @CurrencyHelper.FormatCurrency(loan.OverpaymentAmount)
                                        </MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Style="opacity:0.7;">
                                            @(loan.IsOverdue ? "Overdue" : "Outstanding")
                                        </MudText>
                                        <MudText Typo="Typo.h6"
                                                 Color="@(loan.IsOverdue ? Color.Error : Color.Default)"
                                                 Class="font-weight-bold">
                                            @CurrencyHelper.FormatCurrency(loan.Balance)
                                        </MudText>
                                    }
                                </MudStack>
                            </MudStack>

                            <!-- Progress bar -->
                            <MudStack Spacing="1" Class="mb-2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">
                                        @CurrencyHelper.FormatCurrency(loan.TotalPaid)
                                        <MudText Typo="Typo.caption" Style="opacity:0.6;" Inline="true">
                                            / @CurrencyHelper.FormatCurrency(loan.TotalOwed)
                                        </MudText>
                                    </MudText>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">
                                        @loan.ProgressPercent%
                                    </MudText>
                                </MudStack>
                                <MudProgressLinear Value="@((double)loan.ProgressPercent)"
                                                   Color="@GetStatusColor(loan.Status)"
                                                   Rounded="true"
                                                   Size="Size.Medium" />
                            </MudStack>

                            <!-- Meta line: due · payments · installments -->
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                @if (loan.DueDate.HasValue && loan.Status == LoanStatus.Active)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Style="opacity:0.6; font-size:1rem;" />
                                    <MudText Typo="Typo.caption" Color="@(loan.IsOverdue ? Color.Error : Color.Default)">
                                        Due @loan.DueDate.Value.ToString("MMM d, yyyy")
                                    </MudText>
                                    <MudText Typo="Typo.caption" Style="opacity:0.5;">·</MudText>
                                }
                                <MudText Typo="Typo.caption" Style="opacity:0.6;">
                                    @loan.Payments.Count payment@(loan.Payments.Count != 1 ? "s" : "")
                                </MudText>
                                @if (loan.Installments.Any())
                                {
                                    var paidCount = loan.Installments.Count(i => i.IsPaid);
                                    <MudText Typo="Typo.caption" Style="opacity:0.5;">·</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity:0.6;">
                                        @paidCount/@loan.Installments.Count installments
                                    </MudText>
                                }
                            </MudStack>

                            <!-- Notes -->
                            @if (!string.IsNullOrWhiteSpace(loan.Notes))
                            {
                                <MudTooltip Text="@loan.Notes">
                                    <MudText Typo="Typo.caption"
                                             Style="opacity:0.7; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;"
                                             Class="mt-1">
                                        @loan.Notes
                                    </MudText>
                                </MudTooltip>
                            }
                        </MudCardContent>

                        <MudDivider />

                        <MudCardActions Class="px-2 py-1">
                            @if (loan.Status == LoanStatus.Active)
                            {
                                <MudButton Color="Color.Primary"
                                           Variant="Variant.Text"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Payments"
                                           OnClick="@(() => OpenAddPaymentDialog(loan))">
                                    Pay
                                </MudButton>
                            }
                            <MudTooltip Text="Payment History">
                                <MudIconButton Icon="@Icons.Material.Filled.History"
                                               Color="Color.Default"
                                               Size="Size.Small"
                                               Disabled="@(!loan.Payments.Any())"
                                               OnClick="@(() => OpenPaymentsHistory(loan))" />
                            </MudTooltip>
                            <MudTooltip Text="Installment Schedule">
                                <MudIconButton Icon="@Icons.Material.Filled.TableChart"
                                               Color="Color.Default"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenInstallmentsDialog(loan))" />
                            </MudTooltip>
                            <MudSpacer />
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                     Size="Size.Small"
                                     AnchorOrigin="Origin.BottomRight"
                                     TransformOrigin="Origin.TopRight">
                                <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                             OnClick="@(() => OpenEditDialog(loan))">
                                    Edit
                                </MudMenuItem>
                                @if (loan.Status == LoanStatus.Active)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.CheckCircle"
                                                 IconColor="Color.Success"
                                                 OnClick="@(() => MarkPaidOff(loan))">
                                        Mark as Paid Off
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Handshake"
                                                 IconColor="Color.Warning"
                                                 OnClick="@(() => OpenForgiveDialog(loan))">
                                        Forgive balance
                                    </MudMenuItem>
                                }
                                else
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.Replay"
                                                 OnClick="@(() => ReopenLoan(loan))">
                                        Reopen loan
                                    </MudMenuItem>
                                }
                                <MudMenuItem Icon="@Icons.Material.Filled.Print"
                                             OnClick="@(() => PrintReport(loan.ContactName))">
                                    @(contactLoanCount > 1 ? $"Print report ({contactLoanCount} loans)" : "Print report")
                                </MudMenuItem>
                                <MudDivider />
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                             IconColor="Color.Error"
                                             OnClick="@(() => DeleteLoan(loan))">
                                    Delete
                                </MudMenuItem>
                            </MudMenu>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

</MudContainer>

@code {
    private List<LoanDto> _allLoans = new();
    private List<LoanDto> _displayedLoans = new();
    private LoanStatus? _loanStatusFilter = LoanStatus.Active;
    private bool _loading = true;

    private readonly DialogOptions _dialogOptions = new()
    {
        CloseButton = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Small,
        CloseOnEscapeKey = true
    };

    private record LoanFilterOption(string Label, LoanStatus? Value, string Icon, int Count);

    private IEnumerable<LoanFilterOption> _loanFilterOptions => new[]
    {
        new LoanFilterOption("Active",   LoanStatus.Active,   Icons.Material.Filled.PendingActions, _allLoans.Count(l => l.Status == LoanStatus.Active)),
        new LoanFilterOption("Paid Off", LoanStatus.PaidOff,  Icons.Material.Filled.CheckCircle,   _allLoans.Count(l => l.Status == LoanStatus.PaidOff)),
        new LoanFilterOption("Forgiven", LoanStatus.Forgiven, Icons.Material.Filled.Handshake,     _allLoans.Count(l => l.Status == LoanStatus.Forgiven)),
        new LoanFilterOption("All",      null,                Icons.Material.Filled.List,           _allLoans.Count),
    };

    // Single source of truth for status colors; null = "All" filter.
    private static Color GetStatusColor(LoanStatus? status) => status switch
    {
        LoanStatus.Active => Color.Warning,
        LoanStatus.PaidOff => Color.Success,
        LoanStatus.Forgiven => Color.Default,
        _ => Color.Primary
    };

    private void SetLoanFilter(LoanStatus? status)
    {
        _loanStatusFilter = status;
        ApplyLoanFilter();
    }

    private void ApplyLoanFilter()
    {
        _displayedLoans = _loanStatusFilter.HasValue
            ? _allLoans.Where(l => l.Status == _loanStatusFilter.Value).ToList()
            : _allLoans;
    }

    protected override async Task OnInitializedAsync()
        => await LoadLoans();

    private async Task LoadLoans()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var result = await LoanService.GetAllAsync();
            if (result.Success && result.Data is not null)
                _allLoans = result.Data;
            else
            {
                Snackbar.Add(result.Message ?? "Failed to load loans.", Severity.Error);
                _allLoans.Clear();
            }
        }
        catch
        {
            Snackbar.Add("Error loading loans.", Severity.Error);
            _allLoans.Clear();
        }
        finally
        {
            ApplyLoanFilter();
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(LoanEditorDialog.Loan)] = null,
            [nameof(LoanEditorDialog.LoanService)] = LoanService,
            [nameof(LoanEditorDialog.OnSaved)] = EventCallback.Factory.Create(this, LoadLoans)
        };
        await DialogService.ShowAsync<LoanEditorDialog>("New Loan", parameters, _dialogOptions);
    }

    private async Task OpenEditDialog(LoanDto loan)
    {
        var parameters = new DialogParameters
        {
            [nameof(LoanEditorDialog.Loan)] = loan,
            [nameof(LoanEditorDialog.LoanService)] = LoanService,
            [nameof(LoanEditorDialog.OnSaved)] = EventCallback.Factory.Create(this, LoadLoans)
        };
        await DialogService.ShowAsync<LoanEditorDialog>("Edit Loan", parameters, _dialogOptions);
    }

    private async Task OpenAddPaymentDialog(LoanDto loan)
    {
        var parameters = new DialogParameters
        {
            [nameof(AddLoanPaymentDialog.Loan)] = loan,
            [nameof(AddLoanPaymentDialog.LoanService)] = LoanService,
            [nameof(AddLoanPaymentDialog.OnSaved)] = EventCallback.Factory.Create(this, LoadLoans)
        };
        await DialogService.ShowAsync<AddLoanPaymentDialog>("Register Payment", parameters, _dialogOptions);
    }

    private async Task OpenPaymentsHistory(LoanDto loan)
    {
        var refreshedResult = await LoanService.GetByIdAsync(loan.Id);
        var current = refreshedResult.Success && refreshedResult.Data is not null ? refreshedResult.Data : loan;

        var parameters = new DialogParameters
        {
            [nameof(LoanPaymentsDialog.Loan)] = current,
            [nameof(LoanPaymentsDialog.LoanService)] = LoanService,
            [nameof(LoanPaymentsDialog.OnChanged)] = EventCallback.Factory.Create(this, LoadLoans)
        };
        var opts = _dialogOptions with { MaxWidth = MaxWidth.Medium };
        await DialogService.ShowAsync<LoanPaymentsDialog>("Payment History", parameters, opts);
    }

    private async Task OpenInstallmentsDialog(LoanDto loan)
    {
        var refreshedResult = await LoanService.GetByIdAsync(loan.Id);
        var current = refreshedResult.Success && refreshedResult.Data is not null ? refreshedResult.Data : loan;

        var parameters = new DialogParameters
        {
            [nameof(LoanInstallmentsDialog.Loan)] = current,
            [nameof(LoanInstallmentsDialog.LoanService)] = LoanService,
            [nameof(LoanInstallmentsDialog.OnChanged)] = EventCallback.Factory.Create(this, LoadLoans)
        };
        var opts = _dialogOptions with { MaxWidth = MaxWidth.Medium };
        await DialogService.ShowAsync<LoanInstallmentsDialog>("Installment Schedule", parameters, opts);
    }

    private async Task MarkPaidOff(LoanDto loan)
    {
        var confirmed = await DialogService.ShowConfirmDialogAsync(
            "Mark as Paid Off",
            $"Mark '{loan.ContactName}' loan as fully paid off?",
            confirmText: "Mark Paid Off",
            color: Color.Success);

        if (!confirmed) return;

        try
        {
            var result = await LoanService.MarkPaidOffAsync(loan.Id);
            if (result.Success)
            {
                Snackbar.Add("Loan marked as paid off.", Severity.Success);
                await LoadLoans();
            }
            else Snackbar.Add(result.Message ?? "Failed to update.", Severity.Error);
        }
        catch
        {
            Snackbar.Add("Error updating loan.", Severity.Error);
        }
    }

    private async Task OpenForgiveDialog(LoanDto loan)
    {
        var parameters = new DialogParameters
        {
            [nameof(ForgiveLoanDialog.Loan)] = loan,
            [nameof(ForgiveLoanDialog.LoanService)] = LoanService,
            [nameof(ForgiveLoanDialog.OnSaved)] = EventCallback.Factory.Create(this, LoadLoans)
        };
        await DialogService.ShowAsync<ForgiveLoanDialog>("Forgive Loan", parameters, _dialogOptions);
    }

    private async Task ReopenLoan(LoanDto loan)
    {
        var confirmed = await DialogService.ShowConfirmDialogAsync(
            "Reopen Loan",
            $"Reopen '{loan.ContactName}' loan and set it back to Active?",
            confirmText: "Reopen",
            color: Color.Primary);

        if (!confirmed) return;

        try
        {
            var result = await LoanService.ReopenAsync(loan.Id);
            if (result.Success)
            {
                Snackbar.Add("Loan reopened.", Severity.Success);
                await LoadLoans();
            }
            else Snackbar.Add(result.Message ?? "Failed to reopen.", Severity.Error);
        }
        catch
        {
            Snackbar.Add("Error reopening loan.", Severity.Error);
        }
    }

    private List<LoanDto> GetContactLoans(string contactName)
        => _allLoans.Where(l => l.ContactName.Equals(contactName, StringComparison.OrdinalIgnoreCase)).ToList();

    private async Task PrintReport(string contactName)
    {
        try
        {
            var contactLoans = GetContactLoans(contactName);
            var refreshed = new List<LoanDto>();
            foreach (var l in contactLoans)
            {
                var r = await LoanService.GetByIdAsync(l.Id);
                refreshed.Add(r.Success && r.Data is not null ? r.Data : l);
            }

            var bytes = LoanPrintService.GenerateReport(refreshed);
            var filename = $"loan-report-{contactName.ToLower().Replace(" ", "-")}-{DateTime.Today:yyyy-MM-dd}.pdf";

            var parameters = new DialogParameters
            {
                [nameof(LoanReportPreviewDialog.PdfBytes)] = bytes,
                [nameof(LoanReportPreviewDialog.FileName)] = filename
            };
            var opts = new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = true
            };
            await DialogService.ShowAsync<LoanReportPreviewDialog>($"Report — {contactName}", parameters, opts);
        }
        catch
        {
            Snackbar.Add("Error generating report.", Severity.Error);
        }
    }

    private async Task DeleteLoan(LoanDto loan)
    {
        var confirmed = await DialogService.ShowConfirmDialogAsync(
            "Delete Loan",
            $"Delete loan for '{loan.ContactName}'? All payments will be removed.",
            confirmText: "Delete",
            color: Color.Error);

        if (!confirmed) return;

        try
        {
            var result = await LoanService.DeleteAsync(loan.Id);
            if (result.Success)
            {
                Snackbar.Add("Loan deleted.", Severity.Success);
                await LoadLoans();
            }
            else Snackbar.Add(result.Message ?? "Failed to delete.", Severity.Error);
        }
        catch
        {
            Snackbar.Add("Error deleting loan.", Severity.Error);
        }
    }
}
