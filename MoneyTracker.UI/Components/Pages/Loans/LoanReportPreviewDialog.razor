@using MoneyTracker.UI.Helpers
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Medium" />
            <MudText Typo="Typo.h6">Report Preview</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_blobUrl is null)
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:300px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Class="mt-2">Loading preview...</MudText>
            </MudStack>
        }
        else
        {
            <iframe src="@_blobUrl"
                    style="width:100%; height:70vh; border:none; border-radius:4px;"
                    title="Loan Report Preview" />
        }
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="Close">Close</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="Download"
                   Disabled="@(_blobUrl is null)">
            Download PDF
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public byte[] PdfBytes { get; set; } = default!;
    [Parameter] public string FileName { get; set; } = "report.pdf";

    private string? _blobUrl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _blobUrl is null)
        {
            _blobUrl = await JS.InvokeAsync<string>("createBlobUrl", PdfBytes);
            StateHasChanged();
        }
    }

    private async Task Download()
    {
        try
        {
            await JS.InvokeVoidAsync("downloadBinaryFile", FileName, PdfBytes);
        }
        catch
        {
            Snackbar.Add("Download failed.", Severity.Error);
        }
    }

    private void Close() => MudDialog.Cancel();

    public async ValueTask DisposeAsync()
    {
        if (_blobUrl is not null)
        {
            try { await JS.InvokeVoidAsync("revokeBlobUrl", _blobUrl); }
            catch { /* tab may already be closed */ }
        }
    }
}
