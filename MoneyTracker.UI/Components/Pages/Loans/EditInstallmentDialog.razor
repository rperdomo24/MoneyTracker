@using MoneyTracker.Application.DTOs.Loans
@using MoneyTracker.Application.Interfaces
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Installment #@Installment.InstallmentNumber</MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="pa-0">
            <MudNumericField Label="Expected Amount"
                             @bind-Value="_expectedAmount"
                             Variant="Variant.Outlined"
                             Min="0.01m"
                             Format="N2"
                             Culture="@System.Globalization.CultureInfo.InvariantCulture"
                             Adornment="Adornment.Start"
                             AdornmentText="$"
                             Class="mb-4" />

            <MudDatePicker Label="Due Date"
                           @bind-Date="_dueDate"
                           Variant="Variant.Outlined"
                           Class="mb-4" />

            <MudTextField Label="Notes (optional)"
                          @bind-Value="_notes"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mb-2"
                          Placeholder="e.g., includes $31 mora" />
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            <span>Save</span>
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public LoanInstallmentDto Installment { get; set; } = default!;
    [Parameter] public ILoanService LoanService { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private decimal _expectedAmount;
    private DateTime? _dueDate;
    private string? _notes;
    private bool _isSaving;

    protected override void OnInitialized()
    {
        _expectedAmount = Installment.ExpectedAmount;
        _dueDate = Installment.DueDate;
        _notes = Installment.Notes;
    }

    private async Task Save()
    {
        _isSaving = true;
        StateHasChanged();
        try
        {
            var dto = new LoanInstallmentDto
            {
                Id = Installment.Id,
                LoanId = Installment.LoanId,
                InstallmentNumber = Installment.InstallmentNumber,
                DueDate = _dueDate ?? Installment.DueDate,
                ExpectedAmount = _expectedAmount,
                Notes = _notes
            };
            var result = await LoanService.UpdateInstallmentAsync(dto);
            if (result.Success)
            {
                Snackbar.Add("Installment updated.", Severity.Success);
                await OnSaved.InvokeAsync();
                MudDialog.Close(DialogResult.Ok(true));
            }
            else Snackbar.Add(result.Message ?? "Failed.", Severity.Error);
        }
        catch { Snackbar.Add("An error occurred.", Severity.Error); }
        finally { _isSaving = false; StateHasChanged(); }
    }

    private void Cancel() => MudDialog.Cancel();
}
