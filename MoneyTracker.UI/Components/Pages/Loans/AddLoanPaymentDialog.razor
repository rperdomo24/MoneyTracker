@using MoneyTracker.Application.DTOs.Loans
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Transaction
@using MoneyTracker.UI.Helpers
@inject ISnackbar Snackbar
@inject ITransactionService TransactionService

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Medium" />
            <MudText Typo="Typo.h6">Register Payment</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
            <MudText Typo="Typo.body2" Class="mb-1" Style="opacity:0.7;">
                Loan: <strong>@Loan.ContactName</strong>
                @if (!string.IsNullOrWhiteSpace(Loan.Description))
                {
                    <span> — @Loan.Description</span>
                }
            </MudText>

            <MudText Typo="Typo.caption" Class="mb-4" Style="opacity:0.6;">
                Balance: <strong>@CurrencyHelper.FormatCurrency(Loan.Balance)</strong>
                @if (Loan.OverpaymentAmount > 0)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="ml-2">
                        Overpaid @CurrencyHelper.FormatCurrency(Loan.OverpaymentAmount)
                    </MudChip>
                }
            </MudText>

            <MudNumericField Label="Amount Received"
                             @bind-Value="_amount"
                             Variant="Variant.Outlined"
                             Min="0.01m"
                             Format="N2"
                             Culture="@System.Globalization.CultureInfo.InvariantCulture"
                             Adornment="Adornment.Start"
                             AdornmentText="$"
                             Class="mb-4"
                             Placeholder="0.00" />

            <MudDatePicker Label="Date"
                           @bind-Date="_date"
                           Variant="Variant.Outlined"
                           Class="mb-4" />

            <MudAutocomplete T="TransactionDto"
                             Label="Link to Transaction (optional)"
                             @bind-Value="_selectedTransaction"
                             SearchFunc="SearchTransactions"
                             ToStringFunc="TransactionLabel"
                             Variant="Variant.Outlined"
                             Class="mb-1"
                             Clearable="true"
                             HelperText="@(_selectedTransaction is null ? "Search by description, date or amount" : $"Transaction #{_selectedTransaction.Id} linked")"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             MinCharacters="0"
                             MaxItems="30">
                <ItemTemplate Context="tx">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="px-2 py-1">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2" Class="font-weight-medium">@tx.Name</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:0.6;">
                                @tx.Date.ToString("MMM d, yyyy")
                                @if (tx.Account is not null)
                                {
                                    <span> · @tx.Account.Name</span>
                                }
                            </MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Class="font-weight-bold ml-3">
                            @CurrencyHelper.FormatCurrency(tx.Amount)
                        </MudText>
                    </MudStack>
                </ItemTemplate>
            </MudAutocomplete>

            @if (_selectedTransaction is not null)
            {
                <MudChip T="string"
                         Color="Color.Info"
                         Size="Size.Small"
                         Icon="@Icons.Material.Filled.Link"
                         OnClose="@ClearTransaction"
                         Class="mb-3">
                    #@_selectedTransaction.Id — @_selectedTransaction.Name — @CurrencyHelper.FormatCurrency(_selectedTransaction.Amount)
                </MudChip>
            }
            else
            {
                <div class="mb-3"></div>
            }

            <MudTextField Label="Notes (optional)"
                          @bind-Value="_notes"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mb-2"
                          Placeholder="e.g., covers Feb + Mar payment" />
        </MudContainer>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>Add Payment</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public LoanDto Loan { get; set; } = default!;
    [Parameter] public ILoanService LoanService { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private decimal _amount;
    private DateTime? _date = DateTime.Today;
    private TransactionDto? _selectedTransaction;
    private string? _notes;
    private bool _isSaving;
    private List<TransactionDto> _transactions = new();

    protected override async Task OnInitializedAsync()
    {
        _amount = Loan.Balance > 0 ? Loan.Balance : 0m;
        var result = await TransactionService.GetAllAsync();
        if (result.Success && result.Data is not null)
            _transactions = result.Data
                .Where(t => t.TransactionType == TransactionTypeEnum.Income)
                .OrderByDescending(t => t.Date)
                .ToList();
    }

    private Task<IEnumerable<TransactionDto>> SearchTransactions(string text, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult(_transactions.Take(30));

        var lower = text.Trim().ToLowerInvariant();
        var matches = _transactions.Where(t =>
            t.Name.Contains(lower, StringComparison.OrdinalIgnoreCase) ||
            (t.Description?.Contains(lower, StringComparison.OrdinalIgnoreCase) ?? false) ||
            t.Amount.ToString("N2").Contains(lower) ||
            t.Date.ToString("MMM d").Contains(lower, StringComparison.OrdinalIgnoreCase) ||
            t.Id.ToString() == lower
        );
        return Task.FromResult(matches);
    }

    private string TransactionLabel(TransactionDto? tx)
        => tx is null ? string.Empty : $"#{tx.Id} — {tx.Date:MMM d, yyyy} — {tx.Name} — {CurrencyHelper.FormatCurrency(tx.Amount)}";

    private void ClearTransaction()
    {
        _selectedTransaction = null;
        StateHasChanged();
    }

    private async Task Save()
    {
        if (_amount <= 0)
        {
            Snackbar.Add("Amount must be greater than 0.", Severity.Warning);
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var dto = new AddLoanPaymentDto
            {
                LoanId = Loan.Id,
                TransactionId = _selectedTransaction?.Id,
                Amount = _amount,
                Date = _date ?? DateTime.Today,
                Notes = _notes
            };

            var result = await LoanService.AddPaymentAsync(dto);

            if (result.Success)
            {
                Snackbar.Add("Payment registered.", Severity.Success);
                await OnSaved.InvokeAsync();
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? "Failed to register payment.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("An error occurred.", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
