@using MoneyTracker.Application.DTOs.Loans
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Transaction
@using MoneyTracker.UI.Components.Shared.Selectors
@using MoneyTracker.UI.Helpers
@inject ISnackbar Snackbar
@inject ITransactionService TransactionService

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Medium" />
            <MudText Typo="Typo.h6">Edit Payment</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
            <MudNumericField Label="Amount"
                             @bind-Value="_amount"
                             Variant="Variant.Outlined"
                             Min="0.01m"
                             Format="N2"
                             Culture="@System.Globalization.CultureInfo.InvariantCulture"
                             Adornment="Adornment.Start"
                             AdornmentText="$"
                             Class="mb-4"
                             Placeholder="0.00" />

            <MudDatePicker Label="Date"
                           @bind-Date="_date"
                           Variant="Variant.Outlined"
                           Class="mb-4" />

            <TransactionLinkAutocomplete Transactions="_transactions"
                                         @bind-SelectedTransaction="_selectedTransaction" />

            <MudTextField Label="Notes (optional)"
                          @bind-Value="_notes"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mb-2" />
        </MudContainer>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>Save Changes</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public LoanPaymentDto Payment { get; set; } = default!;
    [Parameter] public ILoanService LoanService { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private decimal _amount;
    private DateTime? _date;
    private TransactionDto? _selectedTransaction;
    private string? _notes;
    private bool _isSaving;
    private List<TransactionDto> _transactions = new();

    protected override async Task OnInitializedAsync()
    {
        _amount = Payment.Amount;
        _date = Payment.Date.ToLocalTime();
        _notes = Payment.Notes;

        var result = await TransactionService.GetAllAsync();
        if (result.Success && result.Data is not null)
        {
            _transactions = result.Data
                .Where(t => t.TransactionType == TransactionTypeEnum.Income)
                .OrderByDescending(t => t.Date)
                .ToList();

            if (Payment.TransactionId.HasValue)
                _selectedTransaction = _transactions.FirstOrDefault(t => t.Id == Payment.TransactionId.Value);
        }
    }

    private async Task Save()
    {
        if (_amount <= 0)
        {
            Snackbar.Add("Amount must be greater than 0.", Severity.Warning);
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var dto = new UpdateLoanPaymentDto
            {
                Id = Payment.Id,
                TransactionId = _selectedTransaction?.Id,
                Amount = _amount,
                Date = _date ?? DateTime.Today,
                Notes = _notes
            };

            var result = await LoanService.UpdatePaymentAsync(dto);

            if (result.Success)
            {
                Snackbar.Add("Payment updated.", Severity.Success);
                await OnSaved.InvokeAsync();
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? "Failed to update payment.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("An error occurred.", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
