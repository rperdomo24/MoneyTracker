@page "/goals"
@using MoneyTracker.Application.DTOs.Goals
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.UI.Helpers
@inject ISavingsGoalService GoalService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Savings Goals - Money Tracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-1 pa-sm-6">

    <!-- Header (Mobile) -->
    <MudHidden Breakpoint="Breakpoint.SmAndUp">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3 px-1">
            <MudText Typo="Typo.h5" Class="font-weight-bold">Savings Goals</MudText>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDialog"
                       Size="Size.Small">
                New
            </MudButton>
        </MudStack>
    </MudHidden>

    <!-- Header (Tablet/Desktop) -->
    <MudHidden Breakpoint="Breakpoint.Xs">
        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mb-4">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5" Class="font-weight-bold">Savings Goals</MudText>
                <MudText Typo="Typo.body2" Style="opacity:0.6;">Money you're setting aside</MudText>
            </MudStack>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDialog">
                New Goal
            </MudButton>
        </MudStack>
    </MudHidden>

    <!-- Summary chips (always from full dataset) -->
    @if (_allGoals.Any())
    {
        var totalSaved = _allGoals.Sum(g => g.CurrentAmount);
        var totalRemaining = _allGoals.Where(g => !g.IsCompleted).Sum(g => g.AmountRemaining);
        var totalOverdue = _allGoals.Count(g => g.IsOverdue);

        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="6" sm="@(totalOverdue > 0 ? 4 : 6)">
                <MudPaper Outlined="true" Class="pa-3 pa-sm-4" Style="height:100%;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Savings" Style="opacity:0.6;" />
                        <MudStack Spacing="0" Style="min-width:0;">
                            <MudText Typo="Typo.caption" Style="opacity:0.7;">Saved</MudText>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                @CurrencyHelper.FormatCurrency(totalSaved)
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="@(totalOverdue > 0 ? 4 : 6)">
                <MudPaper Outlined="true" Class="pa-3 pa-sm-4" Style="height:100%; border-color: var(--mud-palette-primary);">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Flag" Color="Color.Primary" />
                        <MudStack Spacing="0" Style="min-width:0;">
                            <MudText Typo="Typo.caption" Style="opacity:0.7;">Remaining</MudText>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                @CurrencyHelper.FormatCurrency(totalRemaining)
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
            @if (totalOverdue > 0)
            {
                <MudItem xs="12" sm="4">
                    <MudPaper Outlined="true" Class="pa-3 pa-sm-4" Style="height:100%; border-color: var(--mud-palette-error);">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" />
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Style="opacity:0.7;">Overdue</MudText>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@totalOverdue @(totalOverdue == 1 ? "goal" : "goals")</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }

    <!-- Status filter -->
    @if (_allGoals.Any())
    {
        <MudStack Row="true" Spacing="1" Class="mb-3" AlignItems="AlignItems.Center" Wrap="Wrap.NoWrap" Style="overflow-x:auto; padding-bottom:4px;">
            @foreach (var opt in _goalFilterOptions)
            {
                var isActive = _goalShowCompleted == opt.Value;
                <MudChip T="string"
                         Color="@GetStatusColor(opt.Value)"
                         Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                         Size="Size.Small"
                         OnClick="@(() => SetGoalFilter(opt.Value))"
                         Icon="@opt.Icon">
                    @opt.Label
                    @if (opt.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Inline="true" Style="opacity:0.7;"> (@opt.Count)</MudText>
                    }
                </MudChip>
            }
        </MudStack>
    }

    @if (_loading)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-10">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Class="mt-4">Loading goals...</MudText>
        </MudStack>
    }
    else if (!_allGoals.Any())
    {
        <MudPaper Class="pa-6 pa-sm-8" Elevation="1">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Savings"
                         Size="Size.Large"
                         Style="font-size: 4rem; opacity: 0.3;" />
                <MudText Typo="Typo.h6">No savings goals yet</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center">
                    Start tracking your financial goals by adding your first one.
                </MudText>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddDialog"
                           Size="Size.Large">
                    Add Your First Goal
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else if (!_displayedGoals.Any())
    {
        <MudPaper Class="pa-6" Elevation="1">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.FilterListOff" Size="Size.Large" Style="font-size: 3rem; opacity: 0.3;" />
                <MudText Typo="Typo.body1">No goals match the current filter.</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SetGoalFilter(null))">Show All</MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="2">
            @foreach (var goal in _displayedGoals)
            {
                <MudItem xs="12" sm="6" lg="4" xl="3">
                    <MudCard Outlined="true" Elevation="1" Style="@($"border-left: 4px solid {goal.Color}; height: 100%; display:flex; flex-direction:column;")">
                        <MudCardContent Class="pa-3 pa-sm-4" Style="flex:1;">
                            <!-- Title + remaining -->
                            <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Spacing="2" Class="mb-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="min-width:0; flex:1;">
                                    <MudIcon Icon="@Icons.Material.Filled.Circle"
                                             Size="Size.Small"
                                             Style="@($"color: {goal.Color}; flex-shrink:0;")" />
                                    <MudText Typo="Typo.h6" Class="font-weight-medium"
                                             Style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                        @goal.Name
                                    </MudText>
                                </MudStack>

                                <MudStack Spacing="0" AlignItems="AlignItems.End" Style="flex-shrink:0;">
                                    @if (goal.IsCompleted)
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="ma-0" Icon="@Icons.Material.Filled.CheckCircle">
                                            Done
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Style="opacity:0.7;">
                                            @(goal.IsOverdue ? "Overdue" : "Remaining")
                                        </MudText>
                                        <MudText Typo="Typo.h6"
                                                 Color="@(goal.IsOverdue ? Color.Error : Color.Default)"
                                                 Class="font-weight-bold">
                                            @CurrencyHelper.FormatCurrency(goal.AmountRemaining)
                                        </MudText>
                                    }
                                </MudStack>
                            </MudStack>

                            <!-- Progress -->
                            <MudStack Spacing="1" Class="mb-2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">
                                        @CurrencyHelper.FormatCurrency(goal.CurrentAmount)
                                        <MudText Typo="Typo.caption" Style="opacity:0.6;" Inline="true">
                                            / @CurrencyHelper.FormatCurrency(goal.TargetAmount)
                                        </MudText>
                                    </MudText>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold" Style="@($"color:{goal.Color}")">
                                        @goal.ProgressPercent%
                                    </MudText>
                                </MudStack>
                                <MudProgressLinear Value="@((double)goal.ProgressPercent)"
                                                   Color="Color.Primary"
                                                   Rounded="true"
                                                   Size="Size.Medium"
                                                   Style="@($"--mud-palette-primary: {goal.Color};")" />
                            </MudStack>

                            <!-- Meta line: target date · days left · contributions · pace -->
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                @if (goal.TargetDate.HasValue && !goal.IsCompleted)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Style="opacity:0.6; font-size:1rem;" />
                                    <MudText Typo="Typo.caption" Color="@(goal.IsOverdue ? Color.Error : Color.Default)">
                                        @GetTargetDateLabel(goal)
                                    </MudText>
                                    <MudText Typo="Typo.caption" Style="opacity:0.5;">·</MudText>
                                }
                                <MudText Typo="Typo.caption" Style="opacity:0.6;">
                                    @goal.Contributions.Count contribution@(goal.Contributions.Count != 1 ? "s" : "")
                                </MudText>
                                @if (goal.MonthlyPaceNeeded.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Style="opacity:0.5;">·</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity:0.6;">
                                        ~@CurrencyHelper.FormatCurrency(goal.MonthlyPaceNeeded.Value)/mo needed
                                    </MudText>
                                }
                            </MudStack>

                            <!-- Notes -->
                            @if (!string.IsNullOrWhiteSpace(goal.Notes))
                            {
                                <MudTooltip Text="@goal.Notes">
                                    <MudText Typo="Typo.caption"
                                             Style="opacity:0.7; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;"
                                             Class="mt-1">
                                        @goal.Notes
                                    </MudText>
                                </MudTooltip>
                            }
                        </MudCardContent>

                        <MudDivider />

                        <MudCardActions Class="px-2 py-1">
                            @if (!goal.IsCompleted)
                            {
                                <MudButton Color="Color.Primary"
                                           Variant="Variant.Text"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.AddCircle"
                                           OnClick="@(() => OpenAddContributionDialog(goal))">
                                    Contribute
                                </MudButton>
                            }
                            <MudTooltip Text="Contributions History">
                                <MudIconButton Icon="@Icons.Material.Filled.History"
                                               Color="Color.Default"
                                               Size="Size.Small"
                                               Disabled="@(!goal.Contributions.Any())"
                                               OnClick="@(() => OpenContributionsHistory(goal))" />
                            </MudTooltip>
                            <MudSpacer />
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                     Size="Size.Small"
                                     AnchorOrigin="Origin.BottomRight"
                                     TransformOrigin="Origin.TopRight">
                                <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                             OnClick="@(() => OpenEditDialog(goal))">
                                    Edit
                                </MudMenuItem>
                                @if (goal.IsCompleted)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.Replay"
                                                 OnClick="@(() => ReopenGoal(goal))">
                                        Reopen goal
                                    </MudMenuItem>
                                }
                                else
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.CheckCircle"
                                                 IconColor="Color.Success"
                                                 OnClick="@(() => MarkComplete(goal))">
                                        Mark as Complete
                                    </MudMenuItem>
                                }
                                <MudDivider />
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                             IconColor="Color.Error"
                                             OnClick="@(() => DeleteGoal(goal))">
                                    Delete
                                </MudMenuItem>
                            </MudMenu>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

</MudContainer>

@code {
    private List<SavingsGoalDto> _allGoals = new();
    private List<SavingsGoalDto> _displayedGoals = new();
    private bool? _goalShowCompleted = false;
    private bool _loading = true;

    private readonly DialogOptions _dialogOptions = new()
    {
        CloseButton = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Small,
        CloseOnEscapeKey = true
    };

    private record GoalFilterOption(string Label, bool? Value, string Icon, int Count);

    private IEnumerable<GoalFilterOption> _goalFilterOptions => new[]
    {
        new GoalFilterOption("In Progress", false, Icons.Material.Filled.PendingActions, _allGoals.Count(g => !g.IsCompleted)),
        new GoalFilterOption("Completed",   true,  Icons.Material.Filled.CheckCircle,    _allGoals.Count(g => g.IsCompleted)),
        new GoalFilterOption("All",         null,  Icons.Material.Filled.List,           _allGoals.Count),
    };

    // Single source of truth for status colors; null = "All" filter.
    private static Color GetStatusColor(bool? showCompleted) => showCompleted switch
    {
        true => Color.Success,
        _ => Color.Primary
    };

    private static string GetTargetDateLabel(SavingsGoalDto goal)
    {
        var date = goal.TargetDate!.Value.ToString("MMM d, yyyy");
        return goal.DaysRemaining switch
        {
            < 0 => $"Due {date}",
            0 => "Due today",
            { } days => $"{date} ({days} days left)",
            _ => date
        };
    }

    private void SetGoalFilter(bool? showCompleted)
    {
        _goalShowCompleted = showCompleted;
        ApplyGoalFilter();
    }

    private void ApplyGoalFilter()
    {
        _displayedGoals = _goalShowCompleted.HasValue
            ? _allGoals.Where(g => g.IsCompleted == _goalShowCompleted.Value).ToList()
            : _allGoals;
    }

    protected override async Task OnInitializedAsync()
        => await LoadGoals();

    private async Task LoadGoals()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var result = await GoalService.GetAllAsync();
            if (result.Success && result.Data is not null)
                _allGoals = result.Data;
            else
            {
                Snackbar.Add(result.Message ?? "Failed to load goals.", Severity.Error);
                _allGoals.Clear();
            }
        }
        catch
        {
            Snackbar.Add("Error loading goals.", Severity.Error);
            _allGoals.Clear();
        }
        finally
        {
            ApplyGoalFilter();
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(GoalEditorDialog.Goal)] = null,
            [nameof(GoalEditorDialog.GoalService)] = GoalService,
            [nameof(GoalEditorDialog.OnSaved)] = EventCallback.Factory.Create(this, LoadGoals)
        };
        await DialogService.ShowAsync<GoalEditorDialog>("Add Goal", parameters, _dialogOptions);
    }

    private async Task OpenEditDialog(SavingsGoalDto goal)
    {
        var parameters = new DialogParameters
        {
            [nameof(GoalEditorDialog.Goal)] = goal,
            [nameof(GoalEditorDialog.GoalService)] = GoalService,
            [nameof(GoalEditorDialog.OnSaved)] = EventCallback.Factory.Create(this, LoadGoals)
        };
        await DialogService.ShowAsync<GoalEditorDialog>("Edit Goal", parameters, _dialogOptions);
    }

    private async Task OpenContributionsHistory(SavingsGoalDto goal)
    {
        var refreshedResult = await GoalService.GetByIdAsync(goal.Id);
        var current = refreshedResult.Success && refreshedResult.Data is not null ? refreshedResult.Data : goal;

        var parameters = new DialogParameters
        {
            [nameof(GoalContributionsDialog.Goal)] = current,
            [nameof(GoalContributionsDialog.GoalService)] = GoalService,
            [nameof(GoalContributionsDialog.OnChanged)] = EventCallback.Factory.Create(this, LoadGoals)
        };
        var opts = _dialogOptions with { MaxWidth = MaxWidth.Medium };
        await DialogService.ShowAsync<GoalContributionsDialog>("Contributions", parameters, opts);
    }

    private async Task OpenAddContributionDialog(SavingsGoalDto goal)
    {
        var parameters = new DialogParameters
        {
            [nameof(AddContributionDialog.Goal)] = goal,
            [nameof(AddContributionDialog.GoalService)] = GoalService,
            [nameof(AddContributionDialog.OnSaved)] = EventCallback.Factory.Create(this, LoadGoals)
        };
        await DialogService.ShowAsync<AddContributionDialog>("Add Contribution", parameters, _dialogOptions);
    }

    private async Task MarkComplete(SavingsGoalDto goal)
    {
        var confirmed = await DialogService.ShowConfirmDialogAsync(
            "Mark as Complete",
            $"Mark '{goal.Name}' as complete?",
            confirmText: "Mark Complete",
            color: Color.Success);

        if (!confirmed) return;

        await ToggleComplete(goal, "Marked as complete!");
    }

    private async Task ReopenGoal(SavingsGoalDto goal)
    {
        var confirmed = await DialogService.ShowConfirmDialogAsync(
            "Reopen Goal",
            $"Reopen '{goal.Name}' and set it back to In Progress?",
            confirmText: "Reopen",
            color: Color.Primary);

        if (!confirmed) return;

        await ToggleComplete(goal, "Goal reopened.");
    }

    private async Task ToggleComplete(SavingsGoalDto goal, string successMessage)
    {
        try
        {
            var result = await GoalService.ToggleCompletedAsync(goal.Id);
            if (result.Success)
            {
                Snackbar.Add(successMessage, Severity.Success);
                await LoadGoals();
            }
            else
                Snackbar.Add(result.Message ?? "Failed to update goal.", Severity.Error);
        }
        catch
        {
            Snackbar.Add("Error updating goal.", Severity.Error);
        }
    }

    private async Task DeleteGoal(SavingsGoalDto goal)
    {
        var confirmed = await DialogService.ShowConfirmDialogAsync(
            "Delete Goal",
            $"Delete '{goal.Name}'? This cannot be undone.",
            confirmText: "Delete",
            color: Color.Error);

        if (!confirmed) return;

        try
        {
            var result = await GoalService.DeleteAsync(goal.Id);
            if (result.Success)
            {
                Snackbar.Add($"'{goal.Name}' deleted.", Severity.Success);
                await LoadGoals();
            }
            else
                Snackbar.Add(result.Message ?? "Failed to delete goal.", Severity.Error);
        }
        catch
        {
            Snackbar.Add("Error deleting goal.", Severity.Error);
        }
    }
}
