@using MoneyTracker.Application.Common
@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Goals
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.UI.Helpers
@inject ISnackbar Snackbar
@inject ITransactionService TransactionService
@inject ITimeZoneService TimeZoneService

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(IsEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.AddCircle)" Size="Size.Medium" />
            <MudText Typo="Typo.h6">@(IsEditMode ? "Edit Contribution" : "Add Contribution")</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
            <MudText Typo="Typo.body2" Class="mb-1" Style="opacity:0.7;">
                Goal: <strong>@Goal.Name</strong>
            </MudText>

            <MudText Typo="Typo.caption" Class="mb-4" Style="opacity:0.6;">
                Remaining: <strong>@CurrencyHelper.FormatCurrency(Goal.AmountRemaining)</strong>
            </MudText>

            <MudNumericField Label="Amount"
                             @bind-Value="_amount"
                             Variant="Variant.Outlined"
                             Min="0.01m"
                             Format="N2"
                             Culture="@System.Globalization.CultureInfo.InvariantCulture"
                             Adornment="Adornment.Start"
                             AdornmentText="$"
                             Class="mb-4"
                             Placeholder="0.00" />

            <MudDatePicker Label="Date"
                           @bind-Date="_date"
                           Variant="Variant.Outlined"
                           Class="mb-4" />

            <MudAutocomplete T="TransactionDto"
                             Label="Link to Transaction (optional)"
                             @bind-Value="_linkedTransaction"
                             SearchFunc="SearchTransactions"
                             ToStringFunc="TransactionLabel"
                             Variant="Variant.Outlined"
                             Class="mb-1"
                             Clearable="true"
                             HelperText="@LinkedTransactionHelperText"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             MinCharacters="0"
                             MaxItems="30">
                <ItemTemplate Context="tx">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="px-2 py-1">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2" Class="font-weight-medium">@tx.Name</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:0.6;">
                                @tx.Date.ToString("MMM d, yyyy")
                                @if (tx.Account is not null)
                                {
                                    <span> · @tx.Account.Name</span>
                                }
                            </MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2"
                                 Class="font-weight-bold ml-3"
                                 Style="@AmountColorStyle(tx.Amount)">
                            @CurrencyHelper.FormatCurrency(Math.Abs(tx.Amount))
                        </MudText>
                    </MudStack>
                </ItemTemplate>
            </MudAutocomplete>

            @if (_linkedTransaction is not null)
            {
                <MudChip T="string"
                         Color="Color.Info"
                         Size="Size.Small"
                         Icon="@Icons.Material.Filled.Link"
                         OnClose="@ClearTransaction"
                         Class="mb-3">
                    #@_linkedTransaction.Id — @_linkedTransaction.Name — @CurrencyHelper.FormatCurrency(Math.Abs(_linkedTransaction.Amount))
                </MudChip>
            }
            else
            {
                <div class="mb-3"></div>
            }

            <MudTextField Label="Notes (optional)"
                          @bind-Value="_notes"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mb-2"
                          Placeholder="Optional note" />
        </MudContainer>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>@(IsEditMode ? "Save" : "Add")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public SavingsGoalDto Goal { get; set; } = default!;
    [Parameter] public ISavingsGoalService GoalService { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public SavingsContributionDto? ExistingContribution { get; set; }

    private bool IsEditMode => ExistingContribution is not null;

    private decimal _amount = 0m;
    private DateTime? _date;
    private string? _notes;
    private TransactionDto? _linkedTransaction;
    private List<TransactionDto> _transactions = new();
    private bool _isSaving = false;

    private DateTime Today => TimeZoneService.GetLocalTimeInConfiguredTimeZone().Date;

    private string LinkedTransactionHelperText => _linkedTransaction is null
        ? "Search by description, date or amount"
        : $"Transaction #{_linkedTransaction.Id} linked";

    private static string AmountColorStyle(decimal amount)
        => $"color:{(amount >= 0 ? "var(--mud-palette-success)" : "var(--mud-palette-error)")};";

    protected override async Task OnInitializedAsync()
    {
        _date = Today;

        if (ExistingContribution is not null)
            ApplyExistingContribution(ExistingContribution);
        else if (Goal.ContributionReminderAmount is > 0)
            _amount = Goal.ContributionReminderAmount.Value;

        var result = await TransactionService.GetAllAsync();
        if (result.Success && result.Data is not null)
            _transactions = result.Data
                .OrderByDescending(t => t.Date)
                .ToList();
        else
            Snackbar.Add("Could not load transactions to link.", Severity.Warning);
    }

    private void ApplyExistingContribution(SavingsContributionDto existing)
    {
        _amount = existing.Amount;
        _date = existing.Date;
        _notes = existing.Notes;

        if (existing.LinkedTransactionId.HasValue && existing.LinkedTransactionName is not null)
        {
            _linkedTransaction = new TransactionDto
            {
                Id = existing.LinkedTransactionId.Value,
                Name = existing.LinkedTransactionName,
                Date = existing.LinkedTransactionDate ?? existing.Date,
                Amount = existing.LinkedTransactionAmount ?? 0m,
                Account = new AccountDto { Name = existing.LinkedTransactionAccount ?? string.Empty }
            };
        }
    }

    private Task<IEnumerable<TransactionDto>> SearchTransactions(string text, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult(_transactions.Take(30));

        var lower = text.Trim().ToLowerInvariant();
        var matches = _transactions.Where(t =>
            t.Name.Contains(lower, StringComparison.OrdinalIgnoreCase) ||
            (t.Description?.Contains(lower, StringComparison.OrdinalIgnoreCase) ?? false) ||
            t.Amount.ToString("N2").Contains(lower) ||
            t.Date.ToString("MMM d").Contains(lower, StringComparison.OrdinalIgnoreCase) ||
            t.Id.ToString() == lower
        );
        return Task.FromResult(matches);
    }

    private string TransactionLabel(TransactionDto? tx)
        => tx is null ? string.Empty : $"#{tx.Id} — {tx.Date:MMM d, yyyy} — {tx.Name} — {CurrencyHelper.FormatCurrency(Math.Abs(tx.Amount))}";

    private void ClearTransaction()
    {
        _linkedTransaction = null;
        StateHasChanged();
    }

    private async Task Save()
    {
        if (_amount <= 0)
        {
            Snackbar.Add("Amount must be greater than 0.", Severity.Warning);
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            OperationResult result;

            if (IsEditMode)
            {
                var dto = new SavingsContributionDto
                {
                    Id = ExistingContribution!.Id,
                    GoalId = ExistingContribution.GoalId,
                    Amount = _amount,
                    Date = _date ?? Today,
                    Notes = _notes,
                    LinkedTransactionId = _linkedTransaction?.Id
                };
                result = await GoalService.UpdateContributionAsync(dto);
                if (result.Success) Snackbar.Add("Contribution updated.", Severity.Success);
            }
            else
            {
                var dto = new SavingsContributionDto
                {
                    GoalId = Goal.Id,
                    Amount = _amount,
                    Date = _date ?? Today,
                    Notes = _notes,
                    LinkedTransactionId = _linkedTransaction?.Id
                };
                result = await GoalService.AddContributionAsync(dto);
                if (result.Success) Snackbar.Add("Contribution added.", Severity.Success);
            }

            if (result.Success)
            {
                await OnSaved.InvokeAsync();
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? "Failed to save contribution.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("An error occurred.", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
