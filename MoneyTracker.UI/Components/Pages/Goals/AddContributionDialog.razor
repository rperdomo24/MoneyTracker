@using MoneyTracker.Application.DTOs.Goals
@using MoneyTracker.Application.Interfaces
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AddCircle" Size="Size.Medium" />
            <MudText Typo="Typo.h6">Add Contribution</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
            <MudText Typo="Typo.body2" Class="mb-4" Style="opacity:0.7;">
                Goal: <strong>@(Goal?.Name ?? "Unknown")</strong>
            </MudText>

            <MudNumericField Label="Amount"
                             @bind-Value="_amount"
                             Variant="Variant.Outlined"
                             Min="0.01m"
                             Format="N2"
                             Culture="@System.Globalization.CultureInfo.InvariantCulture"
                             Adornment="Adornment.Start"
                             AdornmentText="$"
                             Class="mb-4"
                             Placeholder="0.00" />

            <MudDatePicker Label="Date"
                           @bind-Date="_date"
                           Variant="Variant.Outlined"
                           Class="mb-4" />

            <MudTextField Label="Notes (optional)"
                          @bind-Value="_notes"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mb-2"
                          Placeholder="Optional note" />
        </MudContainer>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>Add</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public SavingsGoalDto Goal { get; set; } = default!;
    [Parameter] public ISavingsGoalService GoalService { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private decimal _amount = 0m;
    private DateTime? _date = DateTime.Today;
    private string? _notes;
    private bool _isSaving = false;

    private async Task Save()
    {
        if (_amount <= 0)
        {
            Snackbar.Add("Amount must be greater than 0.", Severity.Warning);
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var dto = new SavingsContributionDto
            {
                GoalId = Goal.Id,
                Amount = _amount,
                Date = _date ?? DateTime.Today,
                Notes = _notes
            };

            var result = await GoalService.AddContributionAsync(dto);

            if (result.Success)
            {
                Snackbar.Add("Contribution added.", Severity.Success);
                await OnSaved.InvokeAsync();
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? "Failed to add contribution.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("An error occurred.", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
