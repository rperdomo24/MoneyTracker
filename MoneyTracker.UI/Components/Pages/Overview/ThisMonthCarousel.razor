<MudGrid Class="mb-6">
    <MudItem xs="12" md="12">
        <MudGrid Justify="Justify.Center" Class="mb-4">
            <MudItem xs="6">
                <MudText Typo="Typo.h6" Color="Color.Dark">This month</MudText>
            </MudItem>
            <MudItem xs="6" Class="d-flex justify-end">
                <MudIconButton Icon="@Icons.Material.Filled.BarChart" Color="Color.Default" />
            </MudItem>
        </MudGrid>

        <!-- CAROUSEL CARDS -->
        <div style="overflow-x: auto; margin-bottom: 16px;">
            <div style="display: flex; gap: 16px; padding-bottom: 8px; min-width: max-content;">
                <!-- CREDIT CARD SPENDING -->
                <MudPaper Class="pa-4" Elevation="1" Style="background-color: #E3F2FD; min-width: 280px; flex-shrink: 0;">
                    <MudGrid Justify="Justify.Center">
                        <MudItem xs="3">
                            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Color="Color.Primary" Size="Size.Large" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.body1" Color="Color.Primary">Credit Card Spending</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Primary">$1,250</MudText>
                        </MudItem>
                        <MudItem xs="3" Class="text-right">
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Label="true">PREMIUM</MudChip>
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.body2" Color="Color.Primary" Class="mb-2">Top categories</MudText>
                    <MudGrid>
                        <MudItem xs="6">
                            <MudGrid Justify="Justify.Center">
                                <MudItem xs="3">
                                    <div style="width: 8px; height: 8px; background-color: #FF9800; border-radius: 50%;"></div>
                                </MudItem>
                                <MudItem xs="9">
                                    <MudText Typo="Typo.caption" Color="Color.Primary">Restaurants</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Primary">$450</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        <MudItem xs="6">
                            <MudGrid Justify="Justify.Center">
                                <MudItem xs="3">
                                    <div style="width: 8px; height: 8px; background-color: #9C27B0; border-radius: 50%;"></div>
                                </MudItem>
                                <MudItem xs="9">
                                    <MudText Typo="Typo.caption" Color="Color.Primary">Entertainment</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Primary">$325</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- TOTAL SPENDING -->
                <MudPaper Class="pa-4" Elevation="1" Style="background-color: #F3E5F5; min-width: 280px; flex-shrink: 0;">
                    <MudGrid Justify="Justify.Center">
                        <MudItem xs="3">
                            <MudIcon Icon="@Icons.Material.Filled.Receipt" Style="color: #9C27B0;" Size="Size.Large" />
                        </MudItem>
                        <MudItem xs="9">
                            <MudText Typo="Typo.body1" Style="color: #9C27B0;">Total Spending</MudText>
                            <MudText Typo="Typo.h6" Style="color: #9C27B0;">$2,845</MudText>
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.body2" Style="color: #9C27B0;" Class="mb-2">This month vs last</MudText>
                    <MudGrid Justify="Justify.Center">
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Style="color: #9C27B0;">Current</MudText>
                            <MudText Typo="Typo.body2" Style="color: #9C27B0;">$2,845</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Style="color: #9C27B0;">Previous</MudText>
                            <MudText Typo="Typo.body2" Style="color: #9C27B0;">$3,120</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- SAVINGS GOAL -->
                <MudPaper Class="pa-4" Elevation="1" Style="background-color: #E8F5E8; min-width: 280px; flex-shrink: 0;">
                    <MudGrid Justify="Justify.Center">
                        <MudItem xs="3">
                            <MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Success" Size="Size.Large" />
                        </MudItem>
                        <MudItem xs="9">
                            <MudText Typo="Typo.body1" Color="Color.Success">Savings Goal</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Success">$1,200</MudText>
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.body2" Color="Color.Success" Class="mb-2">Progress: 75%</MudText>
                    <MudProgressLinear Color="Color.Success" Size="Size.Medium" Value="75" Class="mb-2" />
                    <MudGrid>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Color="Color.Success">Saved</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Success">$900</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Color="Color.Success">Remaining</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Success">$300</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- BUDGET OVERVIEW -->
                <MudPaper Class="pa-4" Elevation="1" Style="background-color: #FFF3E0; min-width: 280px; flex-shrink: 0;">
                    <MudGrid Justify="Justify.Center">
                        <MudItem xs="3">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Style="color: #FF9800;" Size="Size.Large" />
                        </MudItem>
                        <MudItem xs="9">
                            <MudText Typo="Typo.body1" Style="color: #FF9800;">Budget Overview</MudText>
                            <MudText Typo="Typo.h6" Style="color: #FF9800;">$3,500</MudText>
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.body2" Style="color: #FF9800;" Class="mb-2">Monthly budget</MudText>
                    <MudGrid>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Style="color: #FF9800;">Spent</MudText>
                            <MudText Typo="Typo.body2" Style="color: #FF9800;">$2,845</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Style="color: #FF9800;">Available</MudText>
                            <MudText Typo="Typo.body2" Style="color: #FF9800;">$655</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </div>
        </div>
    </MudItem>
</MudGrid>
