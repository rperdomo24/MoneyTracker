@page "/"
@page "/overview"
@using MoneyTracker.UI.Components.Pages.Overview.Components
@using MoneyTracker.UI.Components.Shared
@using System.Security.Claims
@using MudBlazor
@using MoneyTracker.Application.DTOs.Dashboard
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Filters
@using MoneyTracker.UI.Services.Filters.Interface
@using MoneyTracker.UI.Helpers
@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Goals
@using MoneyTracker.Domain.Enums.Account
@using System.Threading
@inject IDashboardService DashboardService
@inject IDashboardFilterStateService DashboardFilterState
@inject ISavingsGoalService GoalService
@inject IAccountService AccountService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard - MoneyTracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 overview-shell">
    <MudGrid Spacing="3">

        @* Compact header *@
        <MudItem xs="12">
            <MudStack Row="true"
                      Wrap="Wrap.Wrap"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Class="px-1"
                      Spacing="2">
                <MudText Typo="Typo.h5" Style="font-weight:600;">@UserDisplayName</MudText>
                <MudStack Row Spacing="1" AlignItems="AlignItems.Center" Class="flex-grow-1 flex-sm-grow-0">
                    <MudSelect T="TimePeriodFilter"
                               Label="Period"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Margin="Margin.Dense"
                               Style="min-width:170px;"
                               Class="flex-grow-1 flex-sm-grow-0"
                               Value="_selectedPeriod"
                               ValueChanged="OnPeriodChanged">
                        @foreach (var periodOption in _periodOptions)
                        {
                            <MudSelectItem Value="@periodOption.Value">
                                <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@GetPeriodIcon(periodOption.Value)" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@periodOption.Label</MudText>
                                </MudStack>
                            </MudSelectItem>
                        }
                    </MudSelect>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   OnClick="RefreshDashboard"
                                   title="Refresh dashboard" />
                </MudStack>
            </MudStack>
        </MudItem>

        @if (_selectedPeriod == TimePeriodFilter.Custom)
        {
            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6">
                            <MudDatePicker Label="From"
                                           Variant="Variant.Outlined"
                                           Editable="false"
                                           Date="_customFromDate"
                                           DateChanged="OnFromDateChanged" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudDatePicker Label="To"
                                           Variant="Variant.Outlined"
                                           Editable="false"
                                           Date="_customToDate"
                                           DateChanged="OnToDateChanged" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        }

        @if (_isLoading)
        {
            @* KPI skeletons *@
            <MudItem xs="6" sm="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" /></MudItem>
            <MudItem xs="6" sm="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" /></MudItem>
            <MudItem xs="6" sm="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" /></MudItem>
            <MudItem xs="6" sm="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" /></MudItem>
            <MudItem xs="12">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="380px" />
            </MudItem>
        }
        else
        {
            @* KPI strip — 4 cards, 2-per-row on mobile, 4-in-a-row on sm+ *@
            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-3 kpi-card" Elevation="0">
                    <MudStack Spacing="0">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowCircleUp" Color="Color.Success" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Income</MudText>
                        </MudStack>
                        <MudText Typo="Typo.h6" Class="mud-success-text" Style="font-weight:600;">
                            @CurrencyHelper.FormatCurrency(_cashFlow?.TotalIncome ?? 0)
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-3 kpi-card" Elevation="0">
                    <MudStack Spacing="0">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowCircleDown" Color="Color.Error" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Expenses</MudText>
                        </MudStack>
                        <MudText Typo="Typo.h6" Class="mud-error-text" Style="font-weight:600;">
                            @CurrencyHelper.FormatCurrency(_cashFlow?.TotalExpenses ?? 0)
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-3 kpi-card" Elevation="0">
                    <MudStack Spacing="0">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.SwapVert" Color="Color.Default" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Net Cash Flow</MudText>
                        </MudStack>
                        <MudText Typo="Typo.h6"
                                 Class="@(_cashFlow?.NetCashFlow >= 0 ? "mud-success-text" : "mud-error-text")"
                                 Style="font-weight:600;">
                            @CurrencyHelper.FormatSignedCurrency(_cashFlow?.NetCashFlow ?? 0)
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-3 kpi-card" Elevation="0">
                    <MudStack Spacing="0">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Info" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Savings Rate</MudText>
                        </MudStack>
                        <MudText Typo="Typo.h6"
                                 Class="@(_savingsRate >= 20 ? "mud-success-text" : _savingsRate > 0 ? "mud-warning-text" : "mud-error-text")"
                                 Style="font-weight:600;">
                            @(_savingsRate.ToString("N1"))%
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            @* Alerts — full width, only visible when there are active alerts *@
            @if (_alerts.Any(a => a.Type != "Healthy"))
            {
                <MudItem xs="12">
                    <AlertsCard Data="_alerts" />
                </MudItem>
            }

            @* Main row: Net Worth hero + Category breakdown *@
            <MudItem xs="12" md="8">
                <BalanceTrendCard Data="_balanceTrend" PeriodLabel="@_selectedPeriodLabel" />
            </MudItem>

            <MudItem xs="12" md="4">
                <CategoryBreakdownCard Data="_categoryBreakdown" />
            </MudItem>

            @* Secondary row: 3 cards *@
            <MudItem xs="12" sm="6" md="4">
                <RecentTransactionsCard Data="_recentTransactions" />
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <BudgetSummaryCard Data="_budgetSummary" />
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <GoalsSummaryCard Data="_goals" />
            </MudItem>

            @* Credit Card Calendar — full width *@
            <MudItem xs="12">
                <CreditCardEventsCard Data="_creditCards" />
            </MudItem>
        }
    </MudGrid>
</MudContainer>

<style>
    .overview-shell {
        width: calc(100% - 8px);
        max-width: 2200px;
        overflow-x: hidden;
    }

    @@media (min-width: 2000px) {
        .overview-shell {
            width: calc(100% - 40px);
            max-width: 2440px;
        }
    }

    .kpi-card {
        border: 1px solid var(--mud-palette-divider);
        border-radius: 12px;
        height: 100%;
    }
</style>

@code {
    private bool _isLoading = true;
    private List<BalanceTrendDto> _balanceTrend = new();
    private DashboardBudgetSummaryDto _budgetSummary = new();
    private List<CategoryBreakdownDto> _categoryBreakdown = new();
    private List<RecentTransactionDto> _recentTransactions = new();
    private CashFlowDto? _cashFlow;
    private List<FinancialAlertDto> _alerts = new();
    private List<SavingsGoalDto> _goals = new();
    private List<AccountDto> _creditCards = new();
    private TimePeriodFilter _selectedPeriod = TimePeriodFilter.Last30Days;
    private DateTime? _customFromDate;
    private DateTime? _customToDate;
    private string? _userDisplayName;
    private readonly SemaphoreSlim _loadLock = new(1, 1);

    private string UserDisplayName => string.IsNullOrWhiteSpace(_userDisplayName) ? "User" : _userDisplayName;

    private decimal _savingsRate => _cashFlow is { TotalIncome: > 0 }
        ? ((_cashFlow.TotalIncome - _cashFlow.TotalExpenses) / _cashFlow.TotalIncome) * 100m
        : 0m;

    private string _selectedPeriodLabel =>
        _periodOptions.FirstOrDefault(x => x.Value == _selectedPeriod).Label ?? "Period";
    private static readonly List<(TimePeriodFilter Value, string Label)> _periodOptions =
    [
        (TimePeriodFilter.AllTime, "All time"),
        (TimePeriodFilter.Last30Days, "Last 30 days"),
        (TimePeriodFilter.Last90Days, "Last 90 days"),
        (TimePeriodFilter.ThisMonth, "This month"),
        (TimePeriodFilter.LastMonth, "Last month"),
        (TimePeriodFilter.ThisYear, "This year"),
        (TimePeriodFilter.Custom, "Custom range")
    ];

    // Temporarily hidden: Transactions filter options.
    // private static readonly List<(DashboardTransactionFilter Value, string Label)> _transactionFilterOptions =
    // [
    //     (DashboardTransactionFilter.All, "All"),
    //     (DashboardTransactionFilter.Income, "Income"),
    //     (DashboardTransactionFilter.Expense, "Expenses")
    // ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadCurrentUserNameAsync();
            // Temporarily hidden: account selector.
            // await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _isLoading = false;
            Snackbar.Add($"Error initializing dashboard: {ex.Message}", Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await LoadSavedFiltersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not restore saved filters: {ex.Message}", Severity.Warning);
        }

        await LoadDashboardData();
    }

    private async Task LoadCurrentUserNameAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var preferredName =
            user.FindFirstValue("display_name") ??
            user.FindFirstValue("name") ??
            user.FindFirstValue(ClaimTypes.GivenName) ??
            user.FindFirstValue(ClaimTypes.Name);

        if (string.IsNullOrWhiteSpace(preferredName))
        {
            _userDisplayName = "User";
            return;
        }

        _userDisplayName = NormalizeDisplayName(preferredName);
    }

    private static string NormalizeDisplayName(string rawName)
    {
        var trimmed = rawName.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
            return "User";

        if (trimmed.Contains('@'))
        {
            var alias = trimmed.Split('@')[0]
                .Replace('.', ' ')
                .Replace('_', ' ')
                .Replace('-', ' ')
                .Trim();

            return string.IsNullOrWhiteSpace(alias) ? "User" : alias;
        }

        return trimmed;
    }

    // Temporarily hidden: account selector loading.
    // private async Task LoadAccountsAsync()
    // {
    //     try
    //     {
    //         var accountsResult = await AccountService.GetAccountsWithBalancesAsync();
    //         if (!accountsResult.Success)
    //         {
    //             Snackbar.Add($"Could not load accounts for filters: {accountsResult.Message}", Severity.Warning);
    //             return;
    //         }
    //         if (accountsResult.Data is null)
    //         {
    //             Snackbar.Add("No accounts were returned for filters.", Severity.Warning);
    //             return;
    //         }
    //
    //         _accounts = accountsResult.Data
    //             .OrderBy(a => a.Name)
    //             .ToList();
    //     }
    //     catch (Exception ex)
    //     {
    //         Snackbar.Add($"Error loading accounts for filters: {ex.Message}", Severity.Warning);
    //     }
    // }

    private async Task LoadSavedFiltersAsync()
    {
        var saved = await DashboardFilterState.GetAsync();
        if (saved is null)
            return;

        _selectedPeriod = saved.TimePeriod;
        if (_periodOptions.All(x => x.Value != _selectedPeriod))
        {
            _selectedPeriod = TimePeriodFilter.Last30Days;
        }

        // Temporarily hidden: account and transaction filters.
        // _selectedTransactionFilter = saved.TransactionFilter;
        // _selectedAccountIds = saved.AccountIds?.ToArray() ?? Array.Empty<int>();
        _customFromDate = saved.FromDate;
        _customToDate = saved.ToDate;

        if (_selectedPeriod != TimePeriodFilter.Custom)
        {
            _customFromDate = null;
            _customToDate = null;
        }
    }

    private async Task LoadDashboardData()
    {
        await _loadLock.WaitAsync();

        _isLoading = true;
        StateHasChanged();

        try
        {
            var filter = new DashboardFilterDto
            {
                TimePeriod = _selectedPeriod,
                FromDate = _selectedPeriod == TimePeriodFilter.Custom ? _customFromDate : null,
                ToDate = _selectedPeriod == TimePeriodFilter.Custom ? _customToDate : null,
                AccountIds = [],
                TransactionFilter = DashboardTransactionFilter.All
            };

            var balanceTrendResult = await DashboardService.GetBalanceTrendAsync(filter);
            var budgetSummaryResult = await DashboardService.GetBudgetSummaryAsync(filter);
            var categoryBreakdownResult = await DashboardService.GetCategoryBreakdownAsync(filter);
            var cashFlowResult = await DashboardService.GetCashFlowAsync(filter);
            var recentFilter = new DashboardFilterDto
            {
                TimePeriod = filter.TimePeriod,
                FromDate = filter.FromDate,
                ToDate = filter.ToDate,
                AccountIds = filter.AccountIds,
                TransactionFilter = DashboardTransactionFilter.All,
                ExcludeTransfers = true
            };
            var recentTransactionsResult = await DashboardService.GetRecentTransactionsAsync(recentFilter, 6);
            var alertsResult = await DashboardService.GetAlertsAsync();
            var goalsResult = await GoalService.GetAllAsync();
            var accountsResult = await AccountService.GetAccountsWithBalancesAsync();
            if (!balanceTrendResult.Success)
            {
                Snackbar.Add($"Error loading Net Worth Trend: {balanceTrendResult.Message}", Severity.Error);
                return;
            }
            if (balanceTrendResult.Data is null)
            {
                Snackbar.Add("No Net Worth Trend data was returned.", Severity.Error);
                return;
            }
            if (!budgetSummaryResult.Success)
            {
                Snackbar.Add($"Error loading Budget Summary: {budgetSummaryResult.Message}", Severity.Error);
                return;
            }
            if (budgetSummaryResult.Data is null)
            {
                Snackbar.Add("No Budget Summary data was returned.", Severity.Error);
                return;
            }
            if (!categoryBreakdownResult.Success)
            {
                Snackbar.Add($"Error loading Category Breakdown: {categoryBreakdownResult.Message}", Severity.Error);
                return;
            }
            if (categoryBreakdownResult.Data is null)
            {
                Snackbar.Add("No Category Breakdown data was returned.", Severity.Error);
                return;
            }
            if (!recentTransactionsResult.Success)
            {
                Snackbar.Add($"Error loading Recent Transactions: {recentTransactionsResult.Message}", Severity.Error);
                return;
            }
            if (recentTransactionsResult.Data is null)
            {
                Snackbar.Add("No Recent Transactions data was returned.", Severity.Error);
                return;
            }
            _balanceTrend = balanceTrendResult.Data;
            _budgetSummary = budgetSummaryResult.Data;
            _categoryBreakdown = categoryBreakdownResult.Data;
            _recentTransactions = recentTransactionsResult.Data;
            _cashFlow = cashFlowResult.Data;
            _alerts = alertsResult.Success ? (alertsResult.Data ?? []) : [];
            _goals = goalsResult.Success ? (goalsResult.Data ?? []) : [];
            _creditCards = accountsResult.Success && accountsResult.Data is not null
                ? accountsResult.Data.Where(a => a.Type == AccountType.Credit).ToList()
                : [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Critical error loading dashboard: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
            }
            finally
            {
                _loadLock.Release();
            }
        }
    }

    private void SetEmptyDashboardData()
    {
        _balanceTrend = new();
        _budgetSummary = new DashboardBudgetSummaryDto();
        _categoryBreakdown = new();
        _recentTransactions = new();
        _cashFlow = null;
        _alerts = new();
        _goals = new();
        _creditCards = new();
    }

    private async Task RefreshDashboard()
    {
        await LoadDashboardData();
    }

    private async Task OnPeriodChanged(TimePeriodFilter period)
    {
        _selectedPeriod = period;
        if (_selectedPeriod != TimePeriodFilter.Custom)
        {
            _customFromDate = null;
            _customToDate = null;
            await ApplyFiltersAsync();
        }
    }

    private async Task OnFromDateChanged(DateTime? date)
    {
        _customFromDate = date;
        if (_selectedPeriod == TimePeriodFilter.Custom && _customFromDate.HasValue && _customToDate.HasValue)
        {
            await ApplyFiltersAsync();
        }
    }

    private async Task OnToDateChanged(DateTime? date)
    {
        _customToDate = date;
        if (_selectedPeriod == TimePeriodFilter.Custom && _customFromDate.HasValue && _customToDate.HasValue)
        {
            await ApplyFiltersAsync();
        }
    }

    // Temporarily hidden: account selector callback.
    // private Task OnSelectedAccountsChanged(IReadOnlyCollection<int> selectedValues)
    // {
    //     _selectedAccountIds = selectedValues;
    //     return Task.CompletedTask;
    // }

    private async Task ApplyFiltersAsync()
    {
        if (_selectedPeriod == TimePeriodFilter.Custom && (!_customFromDate.HasValue || !_customToDate.HasValue))
        {
            Snackbar.Add("Select both from and to dates for custom range.", Severity.Warning);
            return;
        }

        if (_selectedPeriod == TimePeriodFilter.Custom && _customFromDate > _customToDate)
        {
            Snackbar.Add("From date cannot be greater than to date.", Severity.Warning);
            return;
        }

        var filterToSave = new DashboardFilterDto
        {
            TimePeriod = _selectedPeriod,
            FromDate = _selectedPeriod == TimePeriodFilter.Custom ? _customFromDate : null,
            ToDate = _selectedPeriod == TimePeriodFilter.Custom ? _customToDate : null,
            AccountIds = [],
            TransactionFilter = DashboardTransactionFilter.All
        };

        await DashboardFilterState.SaveAsync(filterToSave);
        await LoadDashboardData();
    }

    private static string GetPeriodIcon(TimePeriodFilter period)
    {
        return period switch
        {
            TimePeriodFilter.AllTime => Icons.Material.Filled.AllInclusive,
            TimePeriodFilter.Last30Days => Icons.Material.Filled.DateRange,
            TimePeriodFilter.Last90Days => Icons.Material.Filled.EventNote,
            TimePeriodFilter.ThisMonth => Icons.Material.Filled.CalendarMonth,
            TimePeriodFilter.LastMonth => Icons.Material.Filled.History,
            TimePeriodFilter.ThisYear => Icons.Material.Filled.CalendarToday,
            TimePeriodFilter.Custom => Icons.Material.Filled.Tune,
            _ => Icons.Material.Filled.Schedule
        };
    }

}

