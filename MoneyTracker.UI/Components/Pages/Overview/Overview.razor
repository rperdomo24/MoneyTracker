@page "/"
@page "/overview"
@using MoneyTracker.UI.Components.Pages.Overview.Components
@using MoneyTracker.UI.Components.Shared
@using System.Security.Claims
@using MudBlazor
@using MoneyTracker.Application.DTOs.Dashboard
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.UI.Helpers
@inject IDashboardService DashboardService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard - MoneyTracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudGrid Spacing="3">
        @* Header *@
        <MudItem xs="12">
            <MudPaper Class="pa-4" Style="background: linear-gradient(135deg, var(--mud-palette-primary), var(--mud-palette-secondary));">
                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h4" Style="color: white; font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="mr-2" />
                            Bienvenido, @UserDisplayName
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.8);">
                            Aquí tienes tu resumen financiero de hoy. Última actualización: @DateTime.Now.ToString("dddd, dd MMMM yyyy - HH:mm")
                        </MudText>
                    </MudStack>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               Style="color: white; border-color: white;"
                               OnClick="RefreshDashboard">
                        Actualizar
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        @if (_isLoading)
        {
            @* Loading Skeletons *@
            @for (int i = 0; i < 6; i++)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
                </MudItem>
            }
        }
        else
        {
            @* Row 1: Summary Cards *@
            <MudItem xs="12" sm="6" md="4">
                <NetWorthCard Data="_summary" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <CashFlowCard Data="_cashFlow" />
            </MudItem>
            <MudItem xs="12" md="4">
                <AlertsCard Data="_alerts" />
            </MudItem>

            @* Row 2: Balance Trend Chart *@
            <MudItem xs="12">
                <BalanceTrendCard Data="_balanceTrend" />
            </MudItem>

            @* Row 3: Analytics *@
            <MudItem xs="12" md="6">
                <CategoryBreakdownCard Data="_categoryBreakdown" />
            </MudItem>
            <MudItem xs="12" md="6">
                <AccountActivityCard Data="_accountActivity" />
            </MudItem>

            @* Row 4: Recent Transactions & Monthly Comparison *@
            <MudItem xs="12" md="8">
                <RecentTransactionsCard Data="_recentTransactions" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MonthlyComparisonCard Data="_monthlyComparison" />
            </MudItem>

            @* Row 5: Quick Actions *@
            <MudItem xs="12">
                <QuickActionsCard />
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code {
    private bool _isLoading = true;
    private DashboardSummaryDto? _summary;
    private CashFlowDto? _cashFlow;
    private List<FinancialAlertDto> _alerts = new();
    private List<BalanceTrendDto> _balanceTrend = new();
    private List<CategoryBreakdownDto> _categoryBreakdown = new();
    private List<AccountActivityDto> _accountActivity = new();
    private List<RecentTransactionDto> _recentTransactions = new();
    private List<MonthlyComparisonDto> _monthlyComparison = new();
    private string? _userDisplayName;

    private string UserDisplayName => string.IsNullOrWhiteSpace(_userDisplayName) ? "Usuario" : _userDisplayName;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserNameAsync();
        await LoadDashboardData();
    }

    private async Task LoadCurrentUserNameAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            return;
        }

        _userDisplayName =
            user.FindFirstValue(ClaimTypes.Name) ??
            user.FindFirstValue(ClaimTypes.GivenName) ??
            user.FindFirstValue(ClaimTypes.Email) ??
            user.Identity?.Name;
    }

    private async Task LoadDashboardData()
    {
        _isLoading = true;
        StateHasChanged();

        var errors = new List<string>();

        try
        {
            // Load ALL data sequentially to avoid DbContext concurrency issues
            // Critical data first
            try
            {
                var summaryResult = await DashboardService.GetSummaryAsync();
                _summary = summaryResult.Success ? summaryResult.Data : null;
                if (!summaryResult.Success) errors.Add($"Summary: {summaryResult.Message}");
            }
            catch (Exception ex)
            {
                errors.Add($"Summary: {ex.Message}");
            }

            try
            {
                var cashFlowResult = await DashboardService.GetCashFlowAsync();
                _cashFlow = cashFlowResult.Success ? cashFlowResult.Data : null;
                if (!cashFlowResult.Success) errors.Add($"Cash Flow: {cashFlowResult.Message}");
            }
            catch (Exception ex)
            {
                errors.Add($"Cash Flow: {ex.Message}");
            }

            try
            {
                var alertsResult = await DashboardService.GetAlertsAsync();
                _alerts = alertsResult.Success ? alertsResult.Data : new();
                if (!alertsResult.Success) errors.Add($"Alerts: {alertsResult.Message}");
            }
            catch (Exception ex)
            {
                errors.Add($"Alerts: {ex.Message}");
            }

            // Load secondary data sequentially (NO parallel execution)
            await LoadAccountActivity();
            await LoadRecentTransactions();
            await LoadCategoryBreakdown();
            await LoadMonthlyComparison();

            // Load heavy data last
            try
            {
                var balanceTrendResult = await DashboardService.GetBalanceTrendAsync();
                _balanceTrend = balanceTrendResult.Success ? balanceTrendResult.Data : new();
                if (!balanceTrendResult.Success) errors.Add($"Balance Trend: {balanceTrendResult.Message}");
            }
            catch (Exception ex)
            {
                errors.Add($"Balance Trend: {ex.Message}");
            }

            // Show any accumulated errors
            if (errors.Any())
            {
                var errorMessage = string.Join(", ", errors);
                Snackbar.Add($"Algunos datos no se cargaron: {errorMessage}", Severity.Warning);
            }
            else
            {
                Snackbar.Add("Dashboard cargado exitosamente", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error crítico cargando dashboard: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAccountActivity()
    {
        try
        {
            var result = await DashboardService.GetAccountActivityAsync();
            _accountActivity = result.Success ? result.Data : new();
            if (!result.Success)
            {
                // Opcionalmente agregar a lista de errores si es necesario
            }
        }
        catch (Exception ex)
        {
            _accountActivity = new();
            // Log error si es necesario
        }
    }

    private async Task LoadRecentTransactions()
    {
        try
        {
            var result = await DashboardService.GetRecentTransactionsAsync();
            _recentTransactions = result.Success ? result.Data : new();
            if (!result.Success)
            {
                // Opcionalmente agregar a lista de errores si es necesario
            }
        }
        catch (Exception ex)
        {
            _recentTransactions = new();
            // Log error si es necesario
        }
    }

    private async Task LoadCategoryBreakdown()
    {
        try
        {
            var result = await DashboardService.GetCategoryBreakdownAsync();
            _categoryBreakdown = result.Success ? result.Data : new();
            if (!result.Success)
            {
                // Opcionalmente agregar a lista de errores si es necesario
            }
        }
        catch (Exception ex)
        {
            _categoryBreakdown = new();
            // Log error si es necesario
        }
    }

    private async Task LoadMonthlyComparison()
    {
        try
        {
            var result = await DashboardService.GetMonthlyComparisonAsync();
            _monthlyComparison = result.Success ? result.Data : new();
            if (!result.Success)
            {
                // Opcionalmente agregar a lista de errores si es necesario
            }
        }
        catch (Exception ex)
        {
            _monthlyComparison = new();
            // Log error si es necesario
        }
    }


    private async Task RefreshDashboard()
    {
        await LoadDashboardData();
    }

}

<QuickActionsFab />
