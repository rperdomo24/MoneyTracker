
@using MoneyTracker.Application.DTOs.Dashboard
@using MoneyTracker.UI.Helpers

<MudCard Class="dashboard-card">
    <MudCardContent>
        <MudStack Spacing="3">
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Color="Color.Primary" Size="Size.Medium">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6">Patrimonio Neto</MudText>
                </MudStack>
            </MudStack>

            @if (Data != null)
            {
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h4" Class="@CurrencyHelper.GetAmountClass(Data.NetWorth)">
                        @CurrencyHelper.FormatCurrency(Data.NetWorth)
                    </MudText>

                    <MudStack Row Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            Activos: @CurrencyHelper.FormatCurrency(Data.TotalAssets)
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            Deudas: @CurrencyHelper.FormatCurrency(Data.TotalLiabilities)
                        </MudText>
                    </MudStack>

                    <MudDivider />

                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudChip T="string" Color="@(Data.IsPositiveChange ? Color.Success : Color.Error)"
                                 Size="Size.Small"
                                 Icon="@(Data.IsPositiveChange ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)">
                            @CurrencyHelper.FormatCurrency(Math.Abs(Data.MonthlyChange)) (@(Data.MonthlyChangePercentage)%)
                        </MudChip>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">vs mes anterior</MudText>
                    </MudStack>

                    @if (Data.Last6MonthsNetWorth.Count > 0)
                    {
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Tendencia últimos 6 meses</MudText>
                        @* Here you could add a small chart using Chart.js or simple progress indicators *@
                    }
                </MudStack>
            }
            else
            {
                <MudStack Spacing="2">
                    <MudSkeleton Height="40px" />
                    <MudSkeleton Height="20px" />
                    <MudSkeleton Height="20px" />
                </MudStack>
            }
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public DashboardSummaryDto? Data { get; set; }
}
