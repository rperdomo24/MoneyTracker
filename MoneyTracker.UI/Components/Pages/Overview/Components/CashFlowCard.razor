@using MoneyTracker.Application.DTOs.Dashboard
@using MudBlazor.Charts

<MudCard Class="dashboard-card">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                <MudAvatar Color="Color.Secondary" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" />
                </MudAvatar>
                <MudText Typo="Typo.h6">Cashflow Sankey</MudText>
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        @if (Data is not null)
        {
            <MudStack Spacing="2">
                @if (_series.Any() && _series[0].Data.Any())
                {
                    <MudChart T="int"
                              ChartType="ChartType.Sankey"
                              Width="100%"
                              Height="420px"
                              ChartSeries="@_series"
                              ChartOptions="@_chartOptions" />
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        No hay suficiente data para construir el Sankey en este rango.
                    </MudAlert>
                }

                <MudStack Row Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Class="mud-success-text">
                        Income: @FormatCurrency(Data.TotalIncome)
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mud-error-text">
                        Expenses: @FormatCurrency(Data.TotalExpenses)
                    </MudText>
                    <MudText Typo="Typo.body2" Class="@GetBalanceColorClass(Data.NetCashFlow)">
                        Net: @FormatCurrency(Data.NetCashFlow)
                    </MudText>
                </MudStack>
            </MudStack>
        }
        else
        {
            <MudStack Spacing="2">
                <MudSkeleton Height="280px" />
            </MudStack>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public CashFlowDto? Data { get; set; }

    private List<ChartSeries<int>> _series = new();
    private readonly SankeyChartOptions _chartOptions = new()
    {
        ShowLabels = true,
        ShowNodeValues = true,
        ShowEdgeLabels = false,
        HighlightOnHover = true,
        NodeWidth = 16,
        OrderNodesByValue = true,
        LabelFontSize = "0.80rem"
    };

    protected override void OnParametersSet()
    {
        if (Data is null)
        {
            _series = new();
            return;
        }

        var edges = new List<SankeyEdge<int>>();
        var incomeCategories = GetTopCategories(Data.IncomeByCategory, 5, "Other Income");
        var expenseCategories = GetTopCategories(Data.ExpenseByCategory, 6, "Other Expenses");

        foreach (var category in incomeCategories)
        {
            edges.Add(new SankeyEdge<int>(category.CategoryName, "Income", ToSankeyValue(category.Amount)));
        }

        foreach (var category in expenseCategories)
        {
            edges.Add(new SankeyEdge<int>("Expenses", category.CategoryName, ToSankeyValue(category.Amount)));
        }

        var expenses = ToSankeyValue(Data.TotalExpenses);
        if (expenses > 0)
        {
            edges.Add(new SankeyEdge<int>("Income", "Expenses", expenses));
        }

        var net = Data.NetCashFlow;
        if (net >= 0)
        {
            var savings = ToSankeyValue(net);
            if (savings > 0)
            {
                edges.Add(new SankeyEdge<int>("Income", "Savings", savings));
            }
        }
        else
        {
            var deficit = ToSankeyValue(Math.Abs(net));
            if (deficit > 0)
            {
                edges.Add(new SankeyEdge<int>("Deficit", "Expenses", deficit));
            }
        }

        _series = new List<ChartSeries<int>>
        {
            new()
            {
                Name = "Cashflow",
                Data = edges
            }
        };
    }

    private static int ToSankeyValue(decimal amount)
    {
        var absValue = Math.Abs(amount);
        if (absValue <= 0)
            return 0;

        return (int)Math.Max(1, Math.Round(absValue, MidpointRounding.AwayFromZero));
    }

    private static List<CashFlowCategoryDto> GetTopCategories(
        List<CashFlowCategoryDto> categories,
        int maxItems,
        string otherName)
    {
        if (categories.Count <= maxItems)
            return categories;

        var top = categories
            .Take(maxItems)
            .ToList();
        var otherAmount = categories
            .Skip(maxItems)
            .Sum(x => x.Amount);

        if (otherAmount > 0)
        {
            top.Add(new CashFlowCategoryDto
            {
                CategoryName = otherName,
                Amount = otherAmount
            });
        }

        return top;
    }

    private static string FormatCurrency(decimal amount)
        => amount < 0 ? $"-${Math.Abs(amount):N2}" : $"${amount:N2}";

    private static string GetBalanceColorClass(decimal balance)
        => balance >= 0 ? "mud-success-text" : "mud-error-text";
}
