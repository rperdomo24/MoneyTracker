@using MudBlazor
@using MoneyTracker.Application.DTOs.Dashboard

<MudCard Class="dashboard-card">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                <MudAvatar Color="Color.Warning" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Filled.PieChart" />
                </MudAvatar>
                <MudText Typo="Typo.h6">Gastos por Categoría</MudText>
            </MudStack>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                           Color="Color.Default"
                           OnClick="ShowFilterOptions" />
        </CardHeaderActions>
    </MudCardHeader>

    <MudCardContent>
        @if (Data?.Any() == true && _validCategories.Any())
        {
            <MudStack Spacing="3">

                <div style="display:flex; justify-content:center;">
                    <MudChart T="double"
                              ChartType="ChartType.Pie"
                              ChartSeries="@_chartSeries"
                              ChartLabels="@_chartLabels"
                              @bind-SelectedIndex="_selectedIndex"
                              Width="240px"
                              Height="240px"
                              ChartOptions="@_chartOptions" />
                </div>

                @if (_selectedIndex >= 0 && _selectedIndex < _validCategories.Count)
                {
                    var selectedCategory = _validCategories[_selectedIndex];

                    <MudAlert Severity="Severity.Warning" Variant="Variant.Text">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <div style="@($"width:16px;height:16px;border-radius:50%;background-color:{selectedCategory.CategoryColor}")"></div>
                            <div>
                                <MudText Typo="Typo.body2">
                                    <strong>@selectedCategory.CategoryName:</strong> $@(selectedCategory.Amount)
                                    (@(selectedCategory.Percentage)%)
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @selectedCategory.TransactionCount transacciones • Promedio: $@(selectedCategory.AverageTransaction)
                                </MudText>
                            </div>
                        </MudStack>
                    </MudAlert>
                }

                <MudDivider />

                <!-- Category List (igual que lo tenías) -->
                <MudStack Spacing="2">
                    @foreach (var category in _validCategories.Take(5))
                    {
                        <MudPaper Elevation="0"
                                  Class="@($"pa-2 cursor-pointer {(_selectedIndex == GetCategoryIndex(category.CategoryName) ? "mud-elevation-2" : "")}")"
                                  Style="@($"border-left:4px solid {category.CategoryColor}; transition:all 0.2s ease; {(_selectedIndex == GetCategoryIndex(category.CategoryName) ? "transform: translateX(4px);" : "")}")"
                                  @onclick="@(() => SelectCategory(category.CategoryName))">
                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                    <div style="@($"width:12px;height:12px;border-radius:50%;background-color:{category.CategoryColor}")"></div>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2">@category.CategoryName</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @category.TransactionCount transacciones • Promedio: $@(category.AverageTransaction)
                                        </MudText>
                                    </MudStack>
                                </MudStack>

                                <MudStack AlignItems="AlignItems.End" Spacing="0">
                                    <MudText Typo="Typo.body2" Class="mud-error-text" Style="font-weight:600;">
                                        $@(category.Amount)
                                    </MudText>
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @(category.Percentage)%
                                        </MudText>
                                        @if (category.Change != 0)
                                        {
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@(category.IsIncrease ? Color.Error : Color.Success)"
                                                     Variant="Variant.Text"
                                                     Class="pa-1"
                                                     Style="height:16px;">
                                                <MudIcon Icon="@(category.IsIncrease? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)"
                                                         Size="Size.Small" />
                                                @(Math.Abs(category.Change))%
                                            </MudChip>
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }

                    @if (_validCategories.Count > 5)
                    {
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.ExpandMore"
                                   OnClick="@(() => _showAllCategories = !_showAllCategories)">
                            @(_showAllCategories ? "Mostrar menos" : $"Ver {_validCategories.Count - 5} categorías más")
                        </MudButton>

                        @if (_showAllCategories)
                        {
                            <MudCollapse Expanded="_showAllCategories">
                                <MudStack Spacing="2">
                                    @foreach (var category in _validCategories.Skip(5))
                                    {
                                        <MudPaper Elevation="0"
                                                  Class="@($"pa-2 cursor-pointer {(_selectedIndex == GetCategoryIndex(category.CategoryName) ? "mud-elevation-2" : "")}")"
                                                  Style="@($"border-left:4px solid {category.CategoryColor}; transition:all 0.2s ease; {(_selectedIndex == GetCategoryIndex(category.CategoryName) ? "transform: translateX(4px);" : "")}")"
                                                  @onclick="@(() => SelectCategory(category.CategoryName))">
                                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                    <div style="@($"width:12px;height:12px;border-radius:50%;background-color:{category.CategoryColor}")"></div>
                                                    <MudStack Spacing="0">
                                                        <MudText Typo="Typo.body2">@category.CategoryName</MudText>
                                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                            @category.TransactionCount trans. • $@(category.AverageTransaction) prom.
                                                        </MudText>
                                                    </MudStack>
                                                </MudStack>

                                                <MudStack AlignItems="AlignItems.End" Spacing="0">
                                                    <MudText Typo="Typo.body2" Class="mud-error-text" Style="font-weight:600;">
                                                        $@(category.Amount)
                                                    </MudText>
                                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                            @(category.Percentage)%
                                                        </MudText>
                                                        @if (category.Change != 0)
                                                        {
                                                            <MudChip T="string"
                                                                     Size="Size.Small"
                                                                     Color="@(category.IsIncrease ? Color.Error : Color.Success)"
                                                                     Variant="Variant.Text"
                                                                     Class="pa-1"
                                                                     Style="height:16px;">
                                                                <MudIcon Icon="@(category.IsIncrease? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)"
                                                                         Size="Size.Small" />
                                                                @(Math.Abs(category.Change))%
                                                            </MudChip>
                                                        }
                                                    </MudStack>
                                                </MudStack>
                                            </MudStack>
                                        </MudPaper>
                                    }
                                </MudStack>
                            </MudCollapse>
                        }
                    }
                </MudStack>

                <MudDivider />

                <!-- Summary Statistics (igual) -->
                <MudGrid>
                    <MudItem xs="6" sm="3">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Text" Class="pa-2">
                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Total Gastos</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight:600;">
                                    $@(_validCategories.Sum(x => x.Amount))
                                </MudText>
                            </MudStack>
                        </MudAlert>
                    </MudItem>

                    <MudItem xs="6" sm="3">
                        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="pa-2">
                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Categoría Principal</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight:600;">
                                    @(_validCategories.OrderByDescending(x => x.Amount).FirstOrDefault()?.CategoryName ?? "N/A")
                                </MudText>
                            </MudStack>
                        </MudAlert>
                    </MudItem>

                    <MudItem xs="6" sm="3">
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Class="pa-2">
                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Total Transacciones</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight:600;">
                                    @(_validCategories.Sum(x => x.TransactionCount))
                                </MudText>
                            </MudStack>
                        </MudAlert>
                    </MudItem>

                    <MudItem xs="6" sm="3">
                        <MudAlert Severity="Severity.Success" Variant="Variant.Text" Class="pa-2">
                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Gasto Promedio</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight:600;">
                                    $@(GetOverallAverageTransaction())
                                </MudText>
                            </MudStack>
                        </MudAlert>
                    </MudItem>
                </MudGrid>

                @if (GetBiggestChange() != null)
                {
                    var biggestChange = GetBiggestChange();
                    <MudAlert Severity="@(biggestChange.Value.isIncrease? Severity.Error: Severity.Success)" Variant="Variant.Text">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@(biggestChange.Value.isIncrease? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)" />
                            <div>
                                <MudText Typo="Typo.body2">
                                    <strong>Mayor cambio:</strong> @biggestChange.Value.categoryName
                                    @(biggestChange.Value.isIncrease ? "aumentó" : "disminuyó") @(Math.Abs(biggestChange.Value.change))%
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    Comparado con el mes anterior
                                </MudText>
                            </div>
                        </MudStack>
                    </MudAlert>
                }

                <MudStack Row Justify="Justify.SpaceBetween">
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.TrendingUp"
                               OnClick="ViewCategoryTrends">
                        Ver tendencias
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Analytics"
                               OnClick="ViewDetailedAnalysis">
                        Análisis detallado
                    </MudButton>
                </MudStack>

            </MudStack>
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                <MudIcon Icon="@Icons.Material.Filled.PieChart"
                         Color="Color.Default"
                         Size="Size.Large" />
                <MudText Typo="Typo.body1" Align="Align.Center">
                    No hay gastos registrados
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary">
                    Los gastos aparecerán aquí cuando agregues transacciones
                </MudText>
            </MudStack>
        }
    </MudCardContent>
</MudCard>

<style>
    .cursor-pointer {
        cursor: pointer;
    }
</style>

@code {
    [Parameter] public List<CategoryBreakdownDto>? Data { get; set; }

    private int _selectedIndex = -1;
    private bool _showAllCategories = false;

    private List<CategoryBreakdownDto> _validCategories = new();
    private string[] _chartLabels = Array.Empty<string>();
    private List<ChartSeries<double>> _chartSeries = new();
    private ChartOptions _chartOptions = new();

    protected override void OnParametersSet()
    {
        UpdateChartData();
    }

    private void UpdateChartData()
    {
        _selectedIndex = -1;

        if (Data?.Any() != true)
        {
            _validCategories = new();
            _chartLabels = Array.Empty<string>();
            _chartSeries = new();
            _chartOptions = new();
            return;
        }

        _validCategories = Data
            .Where(x => x.Amount > 0)
            .ToList();

        if (!_validCategories.Any())
        {
            _chartLabels = Array.Empty<string>();
            _chartSeries = new();
            _chartOptions = new();
            return;
        }

        _chartLabels = _validCategories.Select(x => x.CategoryName).ToArray();

        // ✅ Pie in MudBlazor 9 = 1 series con los valores
        var data = _validCategories.Select(x => (double)x.Amount).ToArray();
        _chartSeries = new List<ChartSeries<double>>
        {
            new() { Name = "Expenses", Data = data }
        };

        // ✅ Colores en el MISMO orden que labels/data
        _chartOptions = new ChartOptions
        {
            ChartPalette = _validCategories.Select(x => x.CategoryColor).ToArray()
        };
    }

    private void ShowFilterOptions() { }

    private void ViewCategoryTrends() { }

    private void ViewDetailedAnalysis() { }

    private int GetCategoryIndex(string categoryName)
        => Array.IndexOf(_chartLabels, categoryName);

    private void SelectCategory(string categoryName)
    {
        _selectedIndex = GetCategoryIndex(categoryName);
        StateHasChanged();
    }

    private decimal GetOverallAverageTransaction()
    {
        if (_validCategories.Any() != true) return 0;

        var totalAmount = _validCategories.Sum(x => x.Amount);
        var totalTransactions = _validCategories.Sum(x => x.TransactionCount);

        return totalTransactions > 0 ? totalAmount / totalTransactions : 0;
    }

    private (string categoryName, decimal change, bool isIncrease)? GetBiggestChange()
    {
        if (_validCategories.Any() != true) return null;

        var categoriesWithChange = _validCategories.Where(x => x.Change != 0).ToList();
        if (!categoriesWithChange.Any()) return null;

        var biggestChange = categoriesWithChange.OrderByDescending(x => Math.Abs(x.Change)).First();
        return (biggestChange.CategoryName, biggestChange.Change, biggestChange.IsIncrease);
    }
}