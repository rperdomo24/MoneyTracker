@using MudBlazor
@using MoneyTracker.Application.DTOs.Dashboard
@using MoneyTracker.UI.Helpers
@inject NavigationManager NavigationManager

<MudPaper Elevation="1" Class="pa-4 dashboard-card" Style="border-radius:16px;">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween">
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Gastos por Categoria</MudText>
                <MudText Typo="Typo.caption" Style="opacity:0.75;">
                    Desglose de gastos del periodo
                </MudText>
            </MudStack>

            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                       OnClick="NavigateToTransactions">
                Ver transacciones
            </MudButton>
        </MudStack>

        @if (_hasChartData)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                <MudChart ChartType="ChartType.Donut"
                          Width="280px"
                          Height="280px"
                          ChartSeries="@_chartData.AsChartDataSet()"
                          ChartLabels="@_chartLabels">
                    <CustomGraphics>
                        <text x="50%" y="38%" dominant-baseline="middle" text-anchor="middle"
                              fill="var(--mud-palette-text-primary)"
                              font-family="Helvetica" font-size="14" style="opacity:0.75;">
                            Gastado
                        </text>

                        <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle"
                              fill="var(--mud-palette-text-primary)"
                              font-family="Helvetica" font-size="26" font-weight="700">
                            @CurrencyHelper.FormatCurrency(_totalExpenses)
                        </text>

                        <text x="50%" y="70%" dominant-baseline="middle" text-anchor="middle"
                              fill="var(--mud-palette-text-secondary)"
                              font-family="Helvetica" font-size="12" style="opacity:0.8;">
                            @_totalTransactions transacciones
                        </text>
                    </CustomGraphics>
                </MudChart>
            </MudStack>

            <MudStack Spacing="1">
                @foreach (var item in _legendCategories)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                              Class="category-row" @onclick="NavigateToTransactions">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudAvatar Size="Size.Small" Style="@($"background-color:{item.CategoryColor};")" />
                            <MudText Typo="Typo.body2">@item.CategoryName</MudText>
                        </MudStack>

                        <MudStack AlignItems="AlignItems.End" Spacing="0">
                            <MudText Typo="Typo.body2" Class="font-weight-medium">@CurrencyHelper.FormatCurrency(item.Amount)</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @($"{item.Percentage:N1}%")
                            </MudText>
                        </MudStack>
                    </MudStack>
                }
            </MudStack>
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2" Class="pa-6">
                <MudText Typo="Typo.h5" Style="opacity:0.6;">@CurrencyHelper.FormatCurrency(0)</MudText>
                <MudButton Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.ReceiptLong"
                           OnClick="NavigateToTransactions">
                    Ver transacciones
                </MudButton>
            </MudStack>
        }

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="0" Class="pa-3" Style="border-radius:12px; border:1px solid var(--mud-palette-divider);">
                    <MudText Typo="Typo.caption" Style="opacity:0.75;">Categorias</MudText>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">@_validCategories.Count</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudPaper Elevation="0" Class="pa-3" Style="border-radius:12px; border:1px solid var(--mud-palette-divider);">
                    <MudText Typo="Typo.caption" Style="opacity:0.75;">Promedio por transaccion</MudText>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">@CurrencyHelper.FormatCurrency(_averageTransaction)</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudPaper>

<style>
    .category-row {
        cursor: pointer;
        border-radius: 10px;
        padding: 8px;
    }
</style>

@code {
    [Parameter] public List<CategoryBreakdownDto>? Data { get; set; }

    private bool _hasChartData;
    private List<CategoryBreakdownDto> _validCategories = new();
    private List<CategoryBreakdownDto> _legendCategories = new();
    private double[] _chartData = Array.Empty<double>();
    private string[] _chartLabels = Array.Empty<string>();
    private decimal _totalExpenses;
    private int _totalTransactions;
    private decimal _averageTransaction;

    protected override void OnParametersSet()
    {
        _hasChartData = false;
        _validCategories = Data?
            .Where(x => x.Amount > 0)
            .OrderByDescending(x => x.Amount)
            .ToList() ?? new();

        _totalExpenses = _validCategories.Sum(x => x.Amount);
        _totalTransactions = _validCategories.Sum(x => x.TransactionCount);
        _averageTransaction = _totalTransactions > 0
            ? _totalExpenses / _totalTransactions
            : 0;

        if (!_validCategories.Any())
        {
            _legendCategories = new();
            _chartData = Array.Empty<double>();
            _chartLabels = Array.Empty<string>();
            return;
        }

        _legendCategories = _validCategories.Take(6).ToList();
        _chartData = _legendCategories.Select(x => (double)x.Amount).ToArray();
        _chartLabels = _legendCategories.Select(x => x.CategoryName).ToArray();
        _hasChartData = _chartData.Any();
    }

    private void NavigateToTransactions()
        => NavigationManager.NavigateTo("/transactions");

}
