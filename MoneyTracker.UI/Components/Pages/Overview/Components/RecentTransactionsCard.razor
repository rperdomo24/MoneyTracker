@using MoneyTracker.Application.DTOs.Dashboard
@using MoneyTracker.Domain.Enums.Transaction
@using MoneyTracker.UI.Helpers
@inject NavigationManager NavigationManager

<MudCard Class="dashboard-card">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudAvatar Color="Color.Info" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
                </MudAvatar>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">Recent Transactions</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Latest recorded activity
                    </MudText>
                </MudStack>
            </MudStack>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.List"
                       OnClick="GoToTransactions">
                View transactions
            </MudButton>
        </CardHeaderActions>
    </MudCardHeader>

    <MudCardContent>
        @if (_items.Any())
        {
            <MudStack Spacing="1">
                @foreach (var transaction in _items)
                {
                    <MudPaper Elevation="0" Class="pa-2 tx-row" @onclick="GoToTransactions">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="min-width:0;">
                                <MudAvatar Size="Size.Small"
                                           Style="@($"background-color:{transaction.CategoryColor}20;color:{transaction.CategoryColor};")">
                                    <MudIcon Icon="@GetTransactionIcon(transaction.Type)" Size="Size.Small" />
                                </MudAvatar>
                                <MudStack Spacing="0" Style="min-width:0;">
                                    <MudText Typo="Typo.body2" Class="text-truncate">@GetPrimaryText(transaction)</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @transaction.RelativeTime | @transaction.CategoryName
                                    </MudText>
                                </MudStack>
                            </MudStack>

                            <MudStack AlignItems="AlignItems.End" Spacing="0">
                                <MudText Typo="Typo.body2"
                                         Class="@GetAmountColorClass(transaction)"
                                         Style="font-weight:600;">
                                    @GetFormattedAmount(transaction)
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @transaction.AccountName
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" />
                <MudText Typo="Typo.body1" Align="Align.Center">No recent transactions</MudText>
                <MudButton Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.List"
                           OnClick="GoToTransactions">
                    View transactions
                </MudButton>
            </MudStack>
        }
    </MudCardContent>
</MudCard>

<style>
    .tx-row {
        cursor: pointer;
        border: 1px solid var(--mud-palette-divider);
        border-radius: 10px;
    }
</style>

@code {
    [Parameter] public List<RecentTransactionDto>? Data { get; set; }

    private IReadOnlyList<RecentTransactionDto> _items = Array.Empty<RecentTransactionDto>();

    protected override void OnParametersSet()
    {
        _items = Data?
            .OrderByDescending(x => x.Date)
            .Take(6)
            .ToList() ?? new List<RecentTransactionDto>();
    }

    private void GoToTransactions()
        => NavigationManager.NavigateTo("/transactions");

    private static string GetTransactionIcon(TransactionTypeEnum type)
        => type.GetTransactionTypeIcon();

    private static string GetAmountColorClass(RecentTransactionDto transaction) => transaction.Type switch
    {
        TransactionTypeEnum.Income => "mud-success-text",
        TransactionTypeEnum.Expense => "mud-error-text",
        TransactionTypeEnum.Transfer => "mud-info-text",
        _ => string.Empty
    };

    private static string GetFormattedAmount(RecentTransactionDto transaction) => transaction.Type switch
    {
        TransactionTypeEnum.Income => $"+${transaction.Amount:N2}",
        TransactionTypeEnum.Expense => $"-${transaction.Amount:N2}",
        TransactionTypeEnum.Transfer => $"${transaction.Amount:N2}",
        _ => $"${transaction.Amount:N2}"
    };

    private static string GetPrimaryText(RecentTransactionDto transaction)
    {
        if (!string.IsNullOrWhiteSpace(transaction.Description))
            return transaction.Description;

        if (!string.IsNullOrWhiteSpace(transaction.Name))
            return transaction.Name;

        return "Transaction without description";
    }
}
