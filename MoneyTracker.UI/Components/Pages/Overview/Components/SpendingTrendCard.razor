@using MoneyTracker.Application.DTOs.Dashboard

<MudCard Class="dashboard-card">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudAvatar Color="Color.Error" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingDown" />
                </MudAvatar>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">Spending Trend</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Como cambia tu gasto durante el periodo
                    </MudText>
                </MudStack>
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        @if (Data?.Any() == true)
        {
            <MudStack Spacing="2" AlignItems="AlignItems.Stretch" Style="width:100%;">
                <MudText Typo="Typo.h4" Class="mud-error-text">
                    @FormatCurrency(_total)
                </MudText>

                <MudText Typo="Typo.body2" Class="@GetChangeClass()">
                    @FormatSignedCurrency(_change) (@FormatSignedPercent(_changePercent)) vs inicio del periodo
                </MudText>

                <MudPaper Class="chart-panel" Elevation="0">
                    <MudHidden Breakpoint="Breakpoint.SmAndUp">
                        <MudChart T="double"
                                  Class="spending-minimal-chart"
                                  ChartType="ChartType.Line"
                                  ChartSeries="@_chartSeries"
                                  ChartLabels="@_chartLabels"
                                  Width="100%"
                                  Height="280px"
                                  ChartOptions="@_chartOptions" />
                    </MudHidden>

                    <MudHidden Breakpoint="Breakpoint.Xs">
                        <MudChart T="double"
                                  Class="spending-minimal-chart"
                                  ChartType="ChartType.Line"
                                  ChartSeries="@_chartSeries"
                                  ChartLabels="@_chartLabels"
                                  Width="100%"
                                  Height="390px"
                                  ChartOptions="@_chartOptions" />
                    </MudHidden>
                </MudPaper>

                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Promedio: @FormatCurrency(_average)
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Pico: @FormatCurrency(_peak) (@_peakLabel)
                    </MudText>
                </MudStack>

                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Periodo: @_startDateLabel a @_endDateLabel
                </MudText>
            </MudStack>
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Large" />
                <MudText Typo="Typo.body1" Align="Align.Center">
                    No spending data available
                </MudText>
            </MudStack>
        }
    </MudCardContent>
</MudCard>

<style>
    .chart-host {
        width: 100%;
        min-width: 0;
    }

    .chart-panel {
        width: 100%;
        border: 1px solid color-mix(in srgb, var(--mud-palette-error) 20%, transparent);
        border-radius: 12px;
        padding: 8px;
        background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.00));
    }

    .spending-minimal-chart {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0;
    }

    .spending-minimal-chart > div {
        width: 100% !important;
        max-width: 100% !important;
    }

    .spending-minimal-chart .mud-charts {
        width: 100% !important;
        max-width: none !important;
    }

    .spending-minimal-chart .mud-chart-line {
        width: 100% !important;
        max-width: none !important;
    }

    .spending-minimal-chart svg {
        width: 100% !important;
        max-width: 100% !important;
    }

    .spending-minimal-chart .mud-chart-legend {
        display: none;
    }

    .spending-minimal-chart .mud-charts-yaxis text {
        display: none;
    }

    .spending-minimal-chart .mud-charts-xaxis text {
        display: none;
    }
</style>

@code {
    [Parameter] public List<DashboardSpendingTrendDto>? Data { get; set; }

    private string[] _chartLabels = Array.Empty<string>();
    private List<ChartSeries<double>> _chartSeries = new();
    private decimal _total;
    private decimal _average;
    private decimal _peak;
    private decimal _change;
    private decimal _changePercent;
    private string _peakLabel = "-";
    private string _startDateLabel = "-";
    private string _endDateLabel = "-";

    private readonly LineChartOptions _chartOptions = new()
    {
        ChartPalette = new[] { "#e53935" },
        ShowLegend = false,
        ShowDataMarkers = false,
        YAxisRequireZeroPoint = false,
        MaxNumYAxisTicks = 5,
        YAxisToStringFunc = _ => string.Empty,
        TooltipTitleFormat = "{{X_VALUE}}",
        TooltipSubtitleFormat = "{{Y_VALUE}}"
    };

    protected override void OnParametersSet()
    {
        if (Data?.Any() != true)
        {
            _chartLabels = Array.Empty<string>();
            _chartSeries = new();
            _total = 0;
            _average = 0;
            _peak = 0;
            _change = 0;
            _changePercent = 0;
            _peakLabel = "-";
            _startDateLabel = "-";
            _endDateLabel = "-";
            return;
        }

        var sorted = Data.OrderBy(x => x.Date).ToList();
        _chartLabels = sorted.Select(x => x.Date.ToString("dd MMM yyyy")).ToArray();
        _chartSeries = new List<ChartSeries<double>>
        {
            new()
            {
                Name = "Spending",
                TooltipYValueFormat = "$#,0.00",
                Data = sorted.Select(x => (double)x.Amount).ToArray()
            }
        };

        _total = sorted.Sum(x => x.Amount);
        _average = sorted.Average(x => x.Amount);
        _peak = sorted.Max(x => x.Amount);

        var first = sorted.First().Amount;
        var last = sorted.Last().Amount;
        _change = last - first;
        _changePercent = first == 0 ? 0 : (_change / first) * 100m;

        var peakPoint = sorted.OrderByDescending(x => x.Amount).First();
        _peakLabel = peakPoint.Date.ToString("dd MMM yyyy");
        _startDateLabel = sorted.First().Date.ToString("dd MMM yyyy");
        _endDateLabel = sorted.Last().Date.ToString("dd MMM yyyy");
    }

    private string GetChangeClass()
        => _change <= 0 ? "mud-success-text" : "mud-error-text";

    private static string FormatCurrency(decimal amount)
        => amount < 0 ? $"-${Math.Abs(amount):N2}" : $"${amount:N2}";

    private static string FormatSignedCurrency(decimal amount)
        => amount < 0 ? $"-${Math.Abs(amount):N2}" : $"+${amount:N2}";

    private static string FormatSignedPercent(decimal percent)
        => percent < 0 ? $"{percent:N1}%" : $"+{percent:N1}%";
}
