@using MoneyTracker.Application.DTOs.Dashboard

<MudCard Class="dashboard-card">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudAvatar Color="Color.Primary" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Filled.ShowChart" />
                </MudAvatar>
                <MudText Typo="Typo.h6">Net Worth Trend</MudText>
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        @if (Data?.Any() == true)
        {
            <MudGrid Spacing="3">
                <MudItem xs="12" lg="3">
                    <MudPaper Class="summary-panel" Elevation="0">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h4" Class="@(_delta >= 0 ? "mud-success-text" : "mud-error-text")">
                                @FormatCurrency(_endValue)
                            </MudText>

                            <MudText Typo="Typo.body2" Class="@(_delta >= 0 ? "mud-success-text" : "mud-error-text")">
                                @FormatSignedCurrency(_delta) (@FormatSignedPercent(_deltaPercent)) vs inicio del periodo
                            </MudText>

                            <MudDivider Class="my-2" />

                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Desde: @_startDateLabel
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Hasta: @_endDateLabel
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" lg="9">
                    <MudPaper Class="chart-panel" Elevation="0">
                        <MudHidden Breakpoint="Breakpoint.SmAndUp">
                            <MudChart T="double"
                                      Class="net-worth-minimal-chart"
                                      ChartType="ChartType.Line"
                                      ChartSeries="@_chartSeries"
                                      ChartLabels="@_chartLabels"
                                      Width="100%"
                                      Height="300px"
                                      ChartOptions="@_chartOptions" />
                        </MudHidden>

                        <MudHidden Breakpoint="Breakpoint.Xs">
                            <MudChart T="double"
                                      Class="net-worth-minimal-chart"
                                      ChartType="ChartType.Line"
                                      ChartSeries="@_chartSeries"
                                      ChartLabels="@_chartLabels"
                                      Width="100%"
                                      Height="420px"
                                      ChartOptions="@_chartOptions" />
                        </MudHidden>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                <MudIcon Icon="@Icons.Material.Filled.ShowChart"
                         Color="Color.Default"
                         Size="Size.Large" />
                <MudText Typo="Typo.body1" Align="Align.Center">
                    No trend data available
                </MudText>
            </MudStack>
        }
    </MudCardContent>
</MudCard>

<style>
    .chart-host {
        width: 100%;
        min-width: 0;
    }

    .chart-panel {
        width: 100%;
        border: 1px solid color-mix(in srgb, var(--mud-palette-primary) 20%, transparent);
        border-radius: 12px;
        padding: 8px;
        background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.00));
    }

    .summary-panel {
        height: 100%;
        border: 1px solid color-mix(in srgb, var(--mud-palette-primary) 20%, transparent);
        border-radius: 12px;
        padding: 16px;
        background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.00));
    }

    .net-worth-minimal-chart {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0;
    }

    .net-worth-minimal-chart > div {
        width: 100% !important;
        max-width: 100% !important;
    }

    .net-worth-minimal-chart .mud-charts {
        width: 100% !important;
        max-width: none !important;
    }

    .net-worth-minimal-chart .mud-chart-line {
        width: 100% !important;
        max-width: none !important;
    }

    .net-worth-minimal-chart svg {
        width: 100% !important;
        max-width: 100% !important;
    }

    .net-worth-minimal-chart .mud-chart-legend {
        display: none;
    }

    .net-worth-minimal-chart .mud-charts-xaxis text {
        display: none;
    }

    .net-worth-minimal-chart .mud-charts-yaxis text {
        display: none;
    }
</style>

@code {
    [Parameter] public List<BalanceTrendDto>? Data { get; set; }

    private string[] _chartLabels = Array.Empty<string>();
    private List<ChartSeries<double>> _chartSeries = new();
    private decimal _endValue;
    private decimal _delta;
    private decimal _deltaPercent;
    private string _startDateLabel = "-";
    private string _endDateLabel = "-";

    private readonly LineChartOptions _chartOptions = new()
    {
        ChartPalette = new[] { "#00d1a0" },
        ShowLegend = false,
        ShowDataMarkers = false,
        YAxisRequireZeroPoint = false,
        MaxNumYAxisTicks = 5,
        YAxisToStringFunc = _ => string.Empty,
        TooltipTitleFormat = "{{X_VALUE}}",
        TooltipSubtitleFormat = "{{Y_VALUE}}"
    };

    protected override void OnParametersSet()
    {
        if (Data?.Any() != true)
        {
            _chartLabels = Array.Empty<string>();
            _chartSeries = new();
            _endValue = 0;
            _delta = 0;
            _deltaPercent = 0;
            _startDateLabel = "-";
            _endDateLabel = "-";
            return;
        }

        var sorted = Data
            .OrderBy(x => x.Date)
            .ToList();

        _chartLabels = sorted
            .Select(x => x.Date.ToString("MMMM dd, yyyy"))
            .ToArray();

        _chartSeries = new List<ChartSeries<double>>
        {
            new()
            {
                Name = "Net Worth",
                TooltipYValueFormat = "$#,0.00;-$#,0.00",
                Data = sorted.Select(x => (double)x.TotalBalance).ToArray()
            }
        };

        var start = sorted.First().TotalBalance;
        _endValue = sorted.Last().TotalBalance;
        _delta = _endValue - start;
        _deltaPercent = start == 0 ? 0 : (_delta / Math.Abs(start)) * 100m;

        _startDateLabel = sorted.First().Date.ToString("dd MMM yyyy");
        _endDateLabel = sorted.Last().Date.ToString("dd MMM yyyy");
    }

    private static string FormatCurrency(decimal amount)
        => amount < 0 ? $"-${Math.Abs(amount):N2}" : $"${amount:N2}";

    private static string FormatSignedCurrency(decimal amount)
        => amount < 0 ? $"-${Math.Abs(amount):N2}" : $"+${amount:N2}";

    private static string FormatSignedPercent(decimal percent)
        => percent < 0 ? $"{percent:N1}%" : $"+{percent:N1}%";
}
