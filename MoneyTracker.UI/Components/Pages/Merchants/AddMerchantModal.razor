@using MoneyTracker.Application.DTOs.Merchants
@using MoneyTracker.Application.Interfaces
@inject IMerchantService MerchantService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Store" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">New Merchant</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField Label="Merchant name"
                          Variant="Variant.Outlined"
                          @bind-Value="_name"
                          Required="true"
                          RequiredError="Name is required"
                          MaxLength="150"
                          Immediate="true" />
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel" Disabled="@_saving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@(_saving ? null : Icons.Material.Filled.Save)"
                   OnClick="SaveAsync"
                   Disabled="@_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">Saving...</MudText>
            }
            else
            {
                <span>Save</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private MudForm _form = default!;
    private bool _saving = false;
    private string _name = string.Empty;

    private async Task SaveAsync()
    {
        if (_saving) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        _saving = true;
        StateHasChanged();

        try
        {
            var result = await MerchantService.CreateAsync(new MerchantDto { Name = _name });

            if (result.Success)
            {
                Snackbar.Add(result.Message ?? "Merchant created", Severity.Success);
                await OnSaved.InvokeAsync();
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? "Error creating merchant", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
