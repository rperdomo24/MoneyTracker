@page "/my-profile"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Entities
@using MoneyTracker.Infrastructure.Persistence
@inject UserManager<ApplicationUser> UserManager
@inject ICurrentUserService CurrentUserService
@inject ITenantContext TenantContext
@inject MoneyTrackerDbContext DbContext
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h5" Class="mb-4">My Profile</MudText>

        <MudTextField @bind-Value="_displayName" Label="Display name" Variant="Variant.Outlined" />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveDisplayName" Disabled="_isBusy" Class="mt-3">
            Save display name
        </MudButton>

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.subtitle1">Avatar</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">Allowed: jpg, png, webp. Max size: 200KB.</MudText>

        @if (!string.IsNullOrWhiteSpace(_avatarDataUrl))
        {
            <MudImage Src="@_avatarDataUrl" Alt="Avatar" Width="120" Height="120" ObjectFit="ObjectFit.Cover" Class="mb-3" />
        }

        <InputFile OnChange="OnAvatarSelected" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
    </MudPaper>
</MudContainer>

@code {
    private const int MaxAvatarSizeBytes = 200 * 1024;
    private static readonly HashSet<string> AllowedContentTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "image/jpeg",
        "image/png",
        "image/webp"
    };

    private string? _displayName;
    private string? _avatarDataUrl;
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        var userId = CurrentUserService.UserId;
        if (!userId.HasValue)
        {
            return;
        }

        var user = await UserManager.FindByIdAsync(userId.Value.ToString());
        if (user is null)
        {
            return;
        }

        _displayName = user.DisplayName;

        var avatar = await DbContext.UserAvatars
            .AsNoTracking()
            .SingleOrDefaultAsync(a => a.UserId == user.Id);

        if (avatar is not null && avatar.Content.Length > 0)
        {
            _avatarDataUrl = $"data:{avatar.ContentType};base64,{Convert.ToBase64String(avatar.Content)}";
        }
    }

    private async Task SaveDisplayName()
    {
        var userId = CurrentUserService.UserId;
        if (!userId.HasValue)
        {
            Snackbar.Add("Unauthorized.", Severity.Error);
            return;
        }

        _isBusy = true;

        var user = await UserManager.FindByIdAsync(userId.Value.ToString());
        if (user is null)
        {
            Snackbar.Add("User not found.", Severity.Error);
            _isBusy = false;
            return;
        }

        user.DisplayName = string.IsNullOrWhiteSpace(_displayName) ? null : _displayName.Trim();
        var result = await UserManager.UpdateAsync(user);
        if (result.Succeeded)
        {
            Snackbar.Add("Display name updated.", Severity.Success);
        }
        else
        {
            Snackbar.Add(string.Join(" ", result.Errors.Select(e => e.Description)), Severity.Error);
        }

        _isBusy = false;
    }

    private async Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        if (file.Size > MaxAvatarSizeBytes)
        {
            Snackbar.Add("Avatar must be 200KB or less.", Severity.Error);
            return;
        }

        if (!AllowedContentTypes.Contains(file.ContentType))
        {
            Snackbar.Add("Only jpg, png, and webp are allowed.", Severity.Error);
            return;
        }

        var userId = CurrentUserService.UserId;
        var tenantId = TenantContext.TenantId;
        if (!userId.HasValue || !tenantId.HasValue)
        {
            Snackbar.Add("Unauthorized.", Severity.Error);
            return;
        }

        await using var stream = file.OpenReadStream(MaxAvatarSizeBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var content = ms.ToArray();

        var avatar = await DbContext.UserAvatars.SingleOrDefaultAsync(a => a.UserId == userId.Value);
        if (avatar is null)
        {
            avatar = new UserAvatar
            {
                UserId = userId.Value,
                TenantId = tenantId.Value
            };
            DbContext.UserAvatars.Add(avatar);
        }

        avatar.ContentType = file.ContentType.ToLowerInvariant();
        avatar.SizeBytes = content.Length;
        avatar.Content = content;
        avatar.UpdatedAt = DateTime.UtcNow;

        await DbContext.SaveChangesAsync();
        _avatarDataUrl = $"data:{avatar.ContentType};base64,{Convert.ToBase64String(avatar.Content)}";
        Snackbar.Add("Avatar updated.", Severity.Success);
    }
}
