@using MoneyTracker.Application.Common
@using MoneyTracker.Application.Constants
@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Application.Validators
@using MoneyTracker.Domain.Enums.Category
@using MoneyTracker.UI.Components.Shared.Pickers
@using MoneyTracker.UI.Helpers
@inject ICategoryService CategoryService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Medium" />
            <MudText Typo="Typo.h6">Create Category</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_category != null)
        {
            <MudContainer MaxWidth="MaxWidth.Medium" Class="pa-0">
                <MudForm Model="@_category" @ref="_form" Validation="validationRules.ValidateValue">

                    <!-- Preview Card -->
                    <MudPaper Class="pa-4 mb-4" Elevation="1" Style="background-color: var(--mud-palette-background-grey);">
                        <MudStack AlignItems="AlignItems.Center" Spacing="3">
                            <MudAvatar Size="Size.Large"
                                       Style="@($"background-color: {_category.Color}; width: 80px; height: 80px;")">
                                <MudIcon Icon="@_category.Icon.ToIcon()"
                                         Color="Color.Surface"
                                         Style="font-size: 2.5rem;" />
                            </MudAvatar>

                            <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.h5">
                                    @(!string.IsNullOrWhiteSpace(_category.Name) ? _category.Name : "Category Name")
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Color="@_category.Type.GetColor()">
                                    @_category.Type.GetDisplayName()
                                </MudChip>
                                @if (_parentCategory != null)
                                {
                                    <MudText Typo="Typo.caption" Style="opacity: 0.7;">
                                        Subcategory of @_parentCategory.Name
                                    </MudText>
                                }
                                else if (_category.ParentId.HasValue)
                                {
                                    var selectedParent = _availableParents.FirstOrDefault(p => p.Id == _category.ParentId.Value);
                                    if (selectedParent != null)
                                    {
                                        <MudText Typo="Typo.caption" Style="opacity: 0.7;">
                                            Subcategory of @selectedParent.Name
                                        </MudText>
                                    }
                                }
                            </MudStack>
                        </MudStack>
                    </MudPaper>

                    <!-- Category Name -->
                    <MudTextField Label="Category Name"
                                  @bind-Value="_category.Name"
                                  For="@(() => _category.Name)"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Immediate="true"
                                  Class="mb-4"
                                  Placeholder="e.g., Groceries, Salary" />

                    <!-- Category Type -->
                    @if (_parentCategory == null)
                    {
                        <MudSelect T="CategoryTypeEnum"
                                   Label="Category Type"
                                   @bind-Value="_category.Type"
                                   @bind-Value:after="OnTypeChanged"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   Disabled="@(_predefinedType.HasValue)"
                                   Class="mb-4">
                            @foreach (var type in Enum.GetValues<CategoryTypeEnum>())
                            {
                                <MudSelectItem T="CategoryTypeEnum" Value="@type">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@type.GetIcon()" Size="Size.Small" />
                                        <MudText>@type.GetDisplayName()</MudText>
                                    </MudStack>
                                </MudSelectItem>
                            }
                        </MudSelect>

                        <!-- Parent Category -->
                        <MudSelect T="int?"
                                   Label="Parent Category (Optional)"
                                   @bind-Value="_category.ParentId"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   Class="mb-4"
                                   HelperText="Leave empty for main category">
                            <MudSelectItem T="int?" Value="null">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Clear" Size="Size.Small" />
                                    <MudText><strong>None</strong> - Main Category</MudText>
                                </MudStack>
                            </MudSelectItem>
                            @foreach (var parent in GetAvailableParents())
                            {
                                <MudSelectItem T="int?" Value="@parent.Id">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudAvatar Size="Size.Small" Style="@($"background-color: {parent.Color};")">
                                            <MudIcon Icon="@parent.Icon.ToIcon()" Color="Color.Surface" Size="Size.Small" />
                                        </MudAvatar>
                                        <MudText>@parent.Name</MudText>
                                    </MudStack>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-4">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Size="Size.Small" Style="@($"background-color: {_parentCategory.Color};")">
                                    <MudIcon Icon="@_parentCategory.Icon.ToIcon()" Color="Color.Surface" Size="Size.Small" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body2">
                                        <strong>Subcategory of:</strong> @_parentCategory.Name
                                    </MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.7;">
                                        Type: @_parentCategory.Type.GetDisplayName()
                                    </MudText>
                                </div>
                            </MudStack>
                        </MudAlert>
                    }

                    <!-- ✅ COLOR PICKER REUTILIZABLE -->
                    <ColorPicker @bind-SelectedColor="_category.Color"
                                 Label="Color"
                                 AllowCustomColor="true"
                                 Class="mb-4" />

                    <!-- ✅ ICON PICKER REUTILIZABLE -->
                    <IconPicker @bind-SelectedIcon="_category.Icon"
                                Label="Icon" />
                </MudForm>
            </MudContainer>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="Cancel">
            Cancel
        </MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@(_isSaving || string.IsNullOrWhiteSpace(_category?.Name))">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Creating...</span>
            }
            else
            {
                <span>Create</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public CategoryTypeEnum? CategoryType { get; set; }
    [Parameter] public int? ParentId { get; set; }
    [Parameter] public EventCallback OnCategoryUpdated { get; set; }

    private readonly CategoryValidator validationRules = new();
    private CategoryDto _category = new();
    private CategoryDto? _parentCategory = null;
    private CategoryTypeEnum? _predefinedType = null;
    private List<CategoryDto> _availableParents = new();
    private MudForm _form = null!;
    private bool _isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableParents();
        InitializeCategory();

        if (ParentId.HasValue)
        {
            await LoadParentCategory();
        }
    }

    private async Task LoadAvailableParents()
    {
        try
        {
            var result = await CategoryService.GetAllAsync();
            if (result.Success && result.Data != null)
            {
                _availableParents = result.Data
                    .Where(c => c.ParentId == null)
                    .OrderBy(c => c.Name)
                    .ToList();
            }
        }
        catch (Exception)
        {
            Snackbar.Add(OperationMessages.UnexpectedError, Severity.Error);
        }
    }

    private async Task LoadParentCategory()
    {
        try
        {
            var result = await CategoryService.GetByIdAsync(ParentId!.Value);
            if (result.Success && result.Data != null)
            {
                _parentCategory = result.Data;
                _category.ParentId = ParentId.Value;
                _category.Type = _parentCategory.Type;
                _predefinedType = _parentCategory.Type;
            }
        }
        catch (Exception)
        {
            Snackbar.Add(OperationMessages.UnexpectedError, Severity.Error);
        }
    }

    private void InitializeCategory()
    {
        _category = new CategoryDto
        {
            Color = "#ef4444",
            Icon = CategoryIcon.LocalCafe,
            Type = CategoryType ?? CategoryTypeEnum.Expense
        };

        if (CategoryType.HasValue)
        {
            _predefinedType = CategoryType.Value;
        }
    }

    private IEnumerable<CategoryDto> GetAvailableParents()
    {
        return _availableParents
            .Where(p => p.Type == _category.Type)
            .OrderBy(p => p.Name);
    }

    private void OnTypeChanged()
    {
        if (_category.ParentId.HasValue)
        {
            var selectedParent = _availableParents.FirstOrDefault(p => p.Id == _category.ParentId.Value);
            if (selectedParent != null && selectedParent.Type != _category.Type)
            {
                _category.ParentId = null;
            }
        }
    }

    private void Cancel() => MudDialog?.Close(DialogResult.Cancel());

    private async Task Save()
    {
        if (_isSaving || string.IsNullOrWhiteSpace(_category?.Name))
            return;

        _isSaving = true;
        StateHasChanged();

        try
        {
            await _form.Validate();

            if (!_form.IsValid)
            {
                Snackbar.Add(OperationMessages.ValidationError, Severity.Warning);
                return;
            }

            var result = await CategoryService.CreateAsync(_category);
            if (result.Success)
            {
                Snackbar.Add(OperationMessages.Created, Severity.Success);
                await OnCategoryUpdated.InvokeAsync();
                MudDialog?.Close(DialogResult.Ok(_category));
            }
            else
            {
                Snackbar.Add(result.Message ?? OperationMessages.UnexpectedError, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(OperationMessages.UnexpectedError, Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }
}