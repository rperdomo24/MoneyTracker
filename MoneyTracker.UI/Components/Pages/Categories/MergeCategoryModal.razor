@using MoneyTracker.Application.Common
@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Transactions
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Filters
@using MoneyTracker.UI.Components.Shared.Selectors
@using MoneyTracker.UI.Helpers
@inject ICategoryService CategoryService
@inject ITransactionService TransactionService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.CallMerge" Size="Size.Medium" />
            <MudText Typo="Typo.h6">Merge Category</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_source != null)
        {
            @if (IsFullMove)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    All transactions in <strong>@_source.Name</strong> are selected, so this is a
                    <strong>full merge</strong>: its budgets and subcategories move too, and
                    <strong>@_source.Name</strong> gets deleted afterward. This cannot be undone.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    Only the checked transactions below will move to the target.
                    <strong>@_source.Name</strong> is kept as-is — its budgets, subcategories, and
                    unchecked transactions are not touched.
                </MudAlert>
            }

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
                <MudAvatar Size="Size.Medium" Style="@($"background-color: {_source.Color};")">
                    <MudIcon Icon="@_source.Icon.ToIcon()" Color="Color.Surface" Size="Size.Small" />
                </MudAvatar>
                <MudText Typo="Typo.body1">@_source.Name</MudText>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Default" />
                <MudText Typo="Typo.body2" Color="Color.Default">Select target below</MudText>
            </MudStack>

            <CategorySelector SelectedCategory="_target"
                               SelectedCategoryChanged="OnTargetChanged"
                               Categories="@_candidateTargets"
                               Label="Merge into"
                               Required="true"
                               Clearable="true"
                               ShowAddButton="false" />

            @if (_target != null && IsFullMove)
            {
                <MudDivider Class="my-4" />

                @if (_loadingPreview)
                {
                    <MudStack AlignItems="AlignItems.Center" Class="pa-2">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                    </MudStack>
                }
                else if (_preview != null && (_preview.Budgets.Any() || _preview.SubcategoryNames.Any()))
                {
                    <MudStack Spacing="1" Class="mb-4">
                        @if (_preview.Budgets.Any())
                        {
                            var dropped = _preview.Budgets.Count(b => b.WillBeDropped);
                            var moved = _preview.Budgets.Count - dropped;
                            <MudAlert Severity="@(dropped > 0 ? Severity.Warning : Severity.Info)" Dense="true">
                                @moved budget(s) will move to @_target.Name.
                                @if (dropped > 0)
                                {
                                    <text> @dropped will be dropped instead (target already has a budget for that same month).</text>
                                }
                            </MudAlert>
                        }
                        @if (_preview.SubcategoryNames.Any())
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                @_preview.SubcategoryNames.Count subcategor@(_preview.SubcategoryNames.Count == 1 ? "y" : "ies")
                                will move under @_target.Name: @string.Join(", ", _preview.SubcategoryNames)
                            </MudAlert>
                        }
                    </MudStack>
                }
            }

            <MudDivider Class="my-4" />

            @if (_loadingTransactions)
            {
                <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                </MudStack>
            }
            else if (_transactions.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Default">
                    No transactions found in @_source.Name. Only budgets/subcategories (if any) will move.
                </MudText>
            }
            else
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle2">
                        Review transactions currently in @_source.Name (@_selectedTransactionIds.Count of @_transactions.Count selected to move)
                    </MudText>
                    <MudStack Row="true" Spacing="1">
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SelectAllTransactions">Select all</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearAllTransactions">Clear</MudButton>
                    </MudStack>
                </MudStack>

                <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 4px; max-height: 280px; overflow-y: auto;">
                    @foreach (var t in _transactions)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                  Class="px-3 py-1" Style="border-bottom: 1px solid var(--mud-palette-divider);">
                            <MudCheckBox T="bool"
                                         Value="@_selectedTransactionIds.Contains(t.Id)"
                                         ValueChanged="@((bool v) => ToggleTransaction(t.Id, v))"
                                         Dense="true">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@t.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Default">
                                        @t.Date.ToString("MMM dd, yyyy") - @t.Account?.Name
                                    </MudText>
                                </MudStack>
                            </MudCheckBox>
                            <MudText Typo="Typo.body2" Class="font-weight-medium">
                                @t.Amount.ToString("C")
                            </MudText>
                        </MudStack>
                    }
                </MudPaper>
            }
        }
        else
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Color="@(IsFullMove ? Color.Error : Color.Primary)"
                   Variant="Variant.Filled"
                   OnClick="Confirm"
                   StartIcon="@Icons.Material.Filled.CallMerge"
                   Disabled="@(_isMerging || _target == null)">

            @if (_isMerging)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>@(IsFullMove ? "Merging..." : "Moving...")</span>
            }
            else
            {
                <span>@(IsFullMove ? "Merge (deletes source)" : "Move selected transactions")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public int SourceCategoryId { get; set; }
    [Parameter] public EventCallback OnCategoryUpdated { get; set; }

    private CategoryDto? _source;
    private CategoryDto? _target;
    private List<CategoryDto> _candidateTargets = new();
    private bool _isMerging = false;

    private bool _loadingTransactions = true;
    private List<TransactionDto> _transactions = new();
    private HashSet<int> _selectedTransactionIds = new();

    private bool _loadingPreview = false;
    private CategoryMergePreviewDto? _preview;

    private bool IsFullMove => _transactions.Count == 0 || _selectedTransactionIds.Count == _transactions.Count;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await CategoryService.GetAllWithChildAsync(false);
            if (result.Success && result.Data != null)
            {
                var flat = result.Data
                    .Where(c => c.ParentId == null)
                    .SelectMany(c => new[] { c }.Concat(c.Children))
                    .ToList();
                _source = flat.FirstOrDefault(c => c.Id == SourceCategoryId);

                if (_source != null)
                {
                    _candidateTargets = flat
                        .Where(c => c.Id != _source.Id && !c.IsSystem && c.Type == _source.Type)
                        .OrderBy(c => c.Name)
                        .ToList();
                }
            }

            if (_source != null)
                await LoadTransactions();
        }
        catch
        {
            Snackbar.Add(OperationMessages.UnexpectedError, Severity.Error);
        }
    }

    private async Task LoadTransactions()
    {
        _loadingTransactions = true;

        try
        {
            var filter = new TransactionFilterDto
            {
                TimePeriod = TimePeriodFilter.AllTime,
                CategoryIds = new List<int> { SourceCategoryId }
            };

            var result = await TransactionService.GetFilteredAsync(filter);
            if (result.Success && result.Data != null)
            {
                _transactions = result.Data.Transactions.OrderByDescending(t => t.Date).ToList();
                // Default to selecting everything so a no-review merge behaves like before.
                _selectedTransactionIds = _transactions.Select(t => t.Id).ToHashSet();
            }
        }
        catch
        {
            Snackbar.Add(OperationMessages.UnexpectedError, Severity.Error);
        }
        finally
        {
            _loadingTransactions = false;
        }
    }

    private void ToggleTransaction(int id, bool selected)
    {
        if (selected)
            _selectedTransactionIds.Add(id);
        else
            _selectedTransactionIds.Remove(id);
    }

    private async Task OnTargetChanged(CategoryDto? target)
    {
        _target = target;
        _preview = null;

        if (_source == null || _target == null)
            return;

        _loadingPreview = true;
        StateHasChanged();

        try
        {
            var result = await CategoryService.GetMergePreviewAsync(_source.Id, _target.Id);
            if (result.Success)
                _preview = result.Data;
        }
        catch
        {
            Snackbar.Add(OperationMessages.UnexpectedError, Severity.Error);
        }
        finally
        {
            _loadingPreview = false;
            StateHasChanged();
        }
    }

    private void SelectAllTransactions() => _selectedTransactionIds = _transactions.Select(t => t.Id).ToHashSet();

    private void ClearAllTransactions() => _selectedTransactionIds.Clear();

    private void Cancel() => MudDialog?.Close(DialogResult.Cancel());

    private async Task Confirm()
    {
        if (_isMerging || _source == null || _target == null)
            return;

        if (IsFullMove)
        {
            var confirmed = await DialogService.ShowConfirmDialogAsync(
                "Delete Source Category?",
                $"This will delete '{_source.Name}' after moving its budgets and subcategories into '{_target.Name}'. This cannot be undone.",
                "Delete and Merge",
                Color.Error
            );

            if (!confirmed)
                return;
        }

        _isMerging = true;
        StateHasChanged();

        try
        {
            var result = await CategoryService.MergeAsync(_source.Id, _target.Id, _selectedTransactionIds.ToList());

            if (result.Success)
            {
                Snackbar.Add(result.Message ?? OperationMessages.CategoryMerged, Severity.Success);
                await OnCategoryUpdated.InvokeAsync();
                MudDialog?.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? OperationMessages.UnexpectedError, Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add(OperationMessages.UnexpectedError, Severity.Error);
        }
        finally
        {
            _isMerging = false;
            StateHasChanged();
        }
    }
}
