@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Application.Constants
@using MoneyTracker.Domain.Enums
@using MoneyTracker.UI.Helpers
@inject ICategoryService CategoryService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        @if (_category is not null)
        {
            <div class="d-flex align-center">
                <MudAvatar Size="Size.Medium" 
                          Style="@($"background-color: {_category.Color ?? "#6366f1"}; margin-right: 16px;")">
                    <MudIcon Icon="@_category.Icon.ToIcon()" Color="Color.Surface" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">@_category.Name</MudText>
                    <MudText Typo="Typo.body2" Class="text-muted">@_category.Type.GetDisplayName()</MudText>
                </div>
            </div>
        }
        else
        {
            <MudText Typo="Typo.h6">Category Details</MudText>
        }
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <div class="text-center pa-6">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Class="mt-3">Loading category...</MudText>
            </div>
        }
        else if (_category is not null)
        {
            <MudStack Spacing="4">
                <!-- Basic Information -->
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">Basic Information</MudText>
                    <MudGrid>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Class="text-muted">NAME</MudText>
                            <MudText Typo="Typo.body1">@_category.Name</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Class="text-muted">TYPE</MudText>
                            <MudChip T="string" Color="@_category.Type.GetColor()" Size="Size.Small">
                                @_category.Type.GetDisplayName()
                            </MudChip>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Class="text-muted">ICON</MudText>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@_category.Icon.ToIcon()" 
                                        Style="@($"color: {_category.Color ?? "#6366f1"};")" 
                                        Class="mr-2" />
                                <MudText Typo="Typo.body2">@_category.Icon.ToString()</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Class="text-muted">COLOR</MudText>
                            <MudChip T="string" Style="@($"background-color: {_category.Color}; color: white;")" Size="Size.Small">
                                @(_category.Color ?? "#6366f1")
                            </MudChip>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Parent Category -->
                @if (_category.ParentId.HasValue && _parentCategory is not null)
                {
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">Parent Category</MudText>
                        <div class="d-flex align-center">
                            <MudAvatar Size="Size.Small" 
                                      Style="@($"background-color: {_parentCategory.Color}; margin-right: 12px;")">
                                <MudIcon Icon="@_parentCategory.Icon.ToIcon()" Color="Color.Surface" Size="Size.Small" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body1">@_parentCategory.Name</MudText>
                                <MudText Typo="Typo.body2" Class="text-muted">@_parentCategory.Type.GetDisplayName()</MudText>
                            </div>
                        </div>
                    </MudPaper>
                }

                <!-- Subcategories -->
                @if (_category.Children?.Any() == true)
                {
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-medium">
                            Subcategories (@_category.Children.Count)
                        </MudText>
                        <MudList T="string" Dense="true">
                            @foreach (var sub in _category.Children)
                            {
                                <MudListItem>
                                    <div class="d-flex align-center">
                                        <MudAvatar Size="Size.Small" 
                                                  Style="@($"background-color: {sub.Color}; margin-right: 12px;")">
                                            <MudIcon Icon="@sub.Icon.ToIcon()" Color="Color.Surface" Size="Size.Small" />
                                        </MudAvatar>
                                        <MudText>@sub.Name</MudText>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                }
            </MudStack>
        }
        else
        {
            <MudAlert Severity="Severity.Error">
                Category not found or failed to load.
            </MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="Close">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int CategoryId { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private CategoryDto? _category;
    private CategoryDto? _parentCategory;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategory();
    }

    private async Task LoadCategory()
    {
        try
        {
            var result = await CategoryService.GetByIdAsync(CategoryId);
            
            if (result.Success && result.Data is not null)
            {
                _category = result.Data;
                
                // Load parent if exists
                if (_category.ParentId.HasValue)
                {
                    var parentResult = await CategoryService.GetByIdAsync(_category.ParentId.Value);
                    if (parentResult.Success)
                    {
                        _parentCategory = parentResult.Data;
                    }
                }
            }
            else
            {
                Snackbar.Add(result.Message ?? "Category not found", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading category", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void Close() => MudDialog.Close();
}