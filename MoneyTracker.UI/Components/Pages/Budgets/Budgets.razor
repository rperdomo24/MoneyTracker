@page "/budgets"
@using MoneyTracker.Application.DTOs.Budgets
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Category
@using MoneyTracker.UI.Components.Shared
@using MoneyTracker.UI.Components.Shared.Drawer
@using MoneyTracker.UI.Helpers
@using MoneyTracker.UI.Helpers.VM
@using MoneyTracker.UI.Services.Components.Drawer
@using MoneyTracker.UI.Services.Filters.Interface
@inject IBudgetService BudgetService
@inject IBudgetFilterStateService BudgetFilterState
@inject ITransactionService TransactionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar


<PageTitle>Budgets - MoneyTracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-2 pa-sm-6">

    <MudIconButton Icon="@Icons.Material.Filled.AccountBalanceWallet"
                   OnClick="AccountsDrawerState.Toggle" />
    <!-- Header -->
    <MudGrid Spacing="2" Justify="Justify.Center" Class="mb-4">

        <!-- Title -->
        <MudItem xs="12" md="4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h5" Class="font-weight-bold">Budgets</MudText>
            </MudStack>
        </MudItem>

        <!-- Desktop: month nav + switch (NO Add button) -->
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudItem xs="12" md="8">
                <MudStack Row="true"
                          Wrap="Wrap.Wrap"
                          Spacing="2"
                          AlignItems="AlignItems.Center">

                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                   Color="Color.Secondary"
                                   OnClick="PrevMonth" />

                    <MudText Typo="Typo.subtitle1" Class="font-weight-medium">
                        @_currentMonthLabel
                    </MudText>

                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                   Color="Color.Secondary"
                                   OnClick="NextMonth" />

                    <MudSwitch T="bool"
                               Color="Color.Secondary"
                               @bind-Checked="_onlyWithActivity"
                               ValueChanged="OnOnlyWithActivityChanged"
                               Label="Only with activity" />
                </MudStack>
            </MudItem>
        </MudHidden>

        <!-- Mobile: month nav + switch (compact) -->
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudItem xs="12">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                       Color="Color.Secondary"
                                       OnClick="PrevMonth" />

                        <MudText Typo="Typo.subtitle1" Class="font-weight-medium">
                            @_currentMonthLabel
                        </MudText>

                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                       Color="Color.Secondary"
                                       OnClick="NextMonth" />
                    </MudStack>

                    <MudSwitch T="bool"
                               Color="Color.Secondary"
                               @bind-Checked="_onlyWithActivity"
                               ValueChanged="OnOnlyWithActivityChanged" />
                </MudStack>

                <MudText Typo="Typo.caption" Style="opacity:0.75;" Class="mt-1">
                    Only with activity
                </MudText>
            </MudItem>
        </MudHidden>

    </MudGrid>

    <!-- MAIN LAYOUT: Overview (left) + List (right) -->
    <MudGrid Spacing="3">

        <!-- LEFT: Overview -->
        <MudItem xs="12" md="5">
            <BudgetsOverviewCard MonthLabel="@_currentMonthLabel"
                                 IsExpenseTab="@(_activeTabIndex == 0)"
                                 Summary="@CurrentSummary"
                                 Slices="@CurrentSlices"
                                 OnAddBudget="OpenAddBudgetModalFromTab" />
        </MudItem>

        <!-- RIGHT: Tabs + Lists -->
        <MudItem xs="12" md="7">

            <!-- Desktop Tabs -->
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudTabs Rounded="true"
                         Border="true"
                         Elevation="0"
                         ActivePanelIndex="@_activeTabIndex"
                         ActivePanelIndexChanged="OnTabChanged"
                         ApplyEffectsToContainer="true">

                    <MudTabPanel Text="Expenses" Icon="@Icons.Material.Filled.TrendingDown">
                        <BudgetsList Items="@_expenseBudgets"
                                     Loading="@_loading"
                                     EmptyMessage="No expense budgets for this month."
                                     OnEdit="HandleEdit"
                                     OnDelete="HandleDelete"
                                     OnViewTransactions="HandleViewTransactions" />
                    </MudTabPanel>

                    <MudTabPanel Text="Income" Icon="@Icons.Material.Filled.TrendingUp">
                        <BudgetsList Items="@_incomeBudgets"
                                     Loading="@_loading"
                                     EmptyMessage="No income budgets for this month."
                                     OnEdit="HandleEdit"
                                     OnDelete="HandleDelete"
                                     OnViewTransactions="HandleViewTransactions" />
                    </MudTabPanel>
                </MudTabs>
            </MudHidden>

            <!-- Mobile Tabs (icons only) -->
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudTabs Rounded="true"
                         Border="true"
                         Elevation="0"
                         ActivePanelIndex="@_activeTabIndex"
                         ActivePanelIndexChanged="OnTabChanged"
                         ApplyEffectsToContainer="true"
                         Centered="true">

                    <MudTabPanel Icon="@Icons.Material.Filled.TrendingDown">
                        <BudgetsList Items="@_expenseBudgets"
                                     Loading="@_loading"
                                     EmptyMessage="No expense budgets for this month."
                                     OnEdit="HandleEdit"
                                     OnDelete="HandleDelete"
                                     OnViewTransactions="HandleViewTransactions" />
                    </MudTabPanel>

                    <MudTabPanel Icon="@Icons.Material.Filled.TrendingUp">
                        <BudgetsList Items="@_incomeBudgets"
                                     Loading="@_loading"
                                     EmptyMessage="No income budgets for this month."
                                     OnEdit="HandleEdit"
                                     OnDelete="HandleDelete"
                                     OnViewTransactions="HandleViewTransactions" />
                    </MudTabPanel>

                </MudTabs>
            </MudHidden>

        </MudItem>

    </MudGrid>
    <QuickActionsFab OnTransactionAdded="@LoadBudgets" />
</MudContainer>

@code {
    private bool _loading = true;
    private int _activeTabIndex = 0;

    private int _year;
    private int _month;
    private string _currentMonthLabel = string.Empty;

    // Default ON (si no hay saved filter, queda true)
    private bool _onlyWithActivity = true;

    private List<BudgetListItemVm> _expenseBudgets = new();
    private List<BudgetListItemVm> _incomeBudgets = new();

    private BudgetMonthlySummaryDto _expenseSummary = new();
    private BudgetMonthlySummaryDto _incomeSummary = new();

    private List<BudgetCategorySliceVm> _expenseSlices = new();
    private List<BudgetCategorySliceVm> _incomeSlices = new();

    private BudgetMonthlySummaryDto CurrentSummary
        => _activeTabIndex == 0 ? _expenseSummary : _incomeSummary;

    private List<BudgetCategorySliceVm> CurrentSlices
        => _activeTabIndex == 0 ? _expenseSlices : _incomeSlices;

    private bool _initializedFromStorage = false;

    protected override void OnInitialized()
    {
        var today = DateTime.Today;
        _year = today.Year;
        _month = today.Month;
        BuildMonthLabel();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initializedFromStorage)
            return;

        _initializedFromStorage = true;

        var today = DateTime.Today;

        var saved = await BudgetFilterState.GetAsync();
        if (saved is not null)
        {
            _year = saved.Year ?? today.Year;
            _month = saved.Month ?? today.Month;
            _activeTabIndex = saved.ActiveTabIndex;
            _onlyWithActivity = saved.OnlyWithActivity; // respeta lo guardado
        }

        BuildMonthLabel();
        await LoadBudgets();
        StateHasChanged();
    }

    private async Task OnOnlyWithActivityChanged(bool value)
    {
        _onlyWithActivity = value;
        await PersistStateAsync();
        await LoadBudgets();
    }

    private async Task LoadBudgets()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var result = await BudgetService.GetMonthlyWithUsageAsync(_year, _month);

            if (!result.Success || result.Data is null)
            {
                ResetState();
                Snackbar.Add(result.Message ?? "Error loading budgets", Severity.Error);
                return;
            }

            var all = result.Data.Select(MapToVm).ToList();

            if (_onlyWithActivity)
                all = ApplyOnlyWithActivity(all);

            _expenseBudgets = all.Where(x => x.CategoryType == CategoryTypeEnum.Expense).ToList();
            _incomeBudgets = all.Where(x => x.CategoryType == CategoryTypeEnum.Income).ToList();

            _expenseSummary = BuildSummaryDto(all, CategoryTypeEnum.Expense);
            _incomeSummary = BuildSummaryDto(all, CategoryTypeEnum.Income);

            _expenseSlices = BuildSlices(all, CategoryTypeEnum.Expense);
            _incomeSlices = BuildSlices(all, CategoryTypeEnum.Income);
        }
        catch (Exception ex)
        {
            ResetState();
            Snackbar.Add($"Error loading budgets: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ResetState()
    {
        _expenseBudgets = new();
        _incomeBudgets = new();
        _expenseSummary = new();
        _incomeSummary = new();
        _expenseSlices = new();
        _incomeSlices = new();
    }

    // Expense negative / Income positive
    private BudgetMonthlySummaryDto BuildSummaryDto(List<BudgetListItemVm> all, CategoryTypeEnum type)
    {
        var parents = all
            .Where(x => x.CategoryType == type && x.ParentCategoryId is null)
            .ToList();

        var totalBudgeted = parents.Sum(x => x.Amount);

        decimal totalUsedDisplay;

        if (type == CategoryTypeEnum.Expense)
            totalUsedDisplay = parents.Sum(x => NormalizeExpenseUsed(x.Used));
        else
            totalUsedDisplay = parents.Sum(x => NormalizeIncomeUsed(x.Used));

        return new BudgetMonthlySummaryDto
        {
            Year = _year,
            Month = _month,
            TotalBudgeted = totalBudgeted,
            TotalUsed = totalUsedDisplay
        };
    }

    // All categories (no "Others")
    private List<BudgetCategorySliceVm> BuildSlices(List<BudgetListItemVm> all, CategoryTypeEnum type)
    {
        var parents = all
            .Where(x => x.CategoryType == type && x.ParentCategoryId is null)
            .ToList();

        var slices = parents
            .Select(x =>
            {
                var value = type == CategoryTypeEnum.Expense
                    ? NormalizeExpenseUsed(x.Used)
                    : NormalizeIncomeUsed(x.Used);

                return new BudgetCategorySliceVm
                {
                    CategoryId = x.CategoryId,
                    Name = x.CategoryName,
                    Color = x.CategoryColor,
                    Used = value
                };
            })
            .Where(x => x.Used > 0)
            .OrderByDescending(x => x.Used)
            .ToList();

        var total = slices.Sum(x => x.Used);
        if (total <= 0) return new();

        foreach (var s in slices)
            s.Percent = (int)Math.Round((double)(s.Used / total) * 100d);

        return slices;
    }

    private static List<BudgetListItemVm> ApplyOnlyWithActivity(List<BudgetListItemVm> items)
    {
        var childrenByParent = items
            .Where(x => x.ParentCategoryId.HasValue)
            .GroupBy(x => x.ParentCategoryId!.Value)
            .ToDictionary(g => g.Key, g => g.ToList());

        var memo = new Dictionary<int, bool>();

        bool HasActivityTree(int categoryId)
        {
            if (memo.TryGetValue(categoryId, out var cached))
                return cached;

            var current = items.FirstOrDefault(x => x.CategoryId == categoryId);
            if (current is null)
                return memo[categoryId] = false;

            if (Math.Abs(current.Used) > 0.01m)
                return memo[categoryId] = true;

            if (!childrenByParent.TryGetValue(categoryId, out var children))
                return memo[categoryId] = false;

            foreach (var child in children)
            {
                if (HasActivityTree(child.CategoryId))
                    return memo[categoryId] = true;
            }

            return memo[categoryId] = false;
        }

        return items.Where(x => HasActivityTree(x.CategoryId)).ToList();
    }

    private static BudgetListItemVm MapToVm(BudgetWithUsageDto x) => new()
    {
        Id = x.Budget.Id,
        CategoryId = x.Budget.CategoryId,
        CategoryName = x.CategoryName,
        CategoryType = x.CategoryType,
        Amount = x.Budget.Amount,
        Used = x.Used,
        IncludeChildren = x.Budget.IncludeChildren,
        RolloverEnabled = x.Budget.RolloverEnabled,
        RolloverMode = x.Budget.RolloverMode,
        CategoryColor = x.CategoryColor ?? "#757575",
        CategoryIcon = x.CategoryIcon,
        ParentCategoryId = x.ParentCategoryId,
        ChildrenCount = x.ChildrenCount
    };

    private void BuildMonthLabel()
    {
        var date = new DateTime(_year, _month, 1);
        _currentMonthLabel = date.ToString("MMMM yyyy");
    }

    private Task PersistStateAsync()
    {
        return BudgetFilterState.SaveAsync(new BudgetFilterDto
        {
            Year = _year,
            Month = _month,
            ActiveTabIndex = _activeTabIndex,
            OnlyWithActivity = _onlyWithActivity
        });
    }

    private async Task PrevMonth()
    {
        var date = new DateTime(_year, _month, 1).AddMonths(-1);
        _year = date.Year;
        _month = date.Month;

        BuildMonthLabel();
        await PersistStateAsync();
        await LoadBudgets();
    }

    private async Task NextMonth()
    {
        var date = new DateTime(_year, _month, 1).AddMonths(1);
        _year = date.Year;
        _month = date.Month;

        BuildMonthLabel();
        await PersistStateAsync();
        await LoadBudgets();
    }

    private async Task OnTabChanged(int index)
    {
        _activeTabIndex = index;
        await PersistStateAsync();
        StateHasChanged();
    }

    private async Task OpenAddBudgetModalFromTab()
    {
        var type = _activeTabIndex == 0 ? CategoryTypeEnum.Expense : CategoryTypeEnum.Income;
        await OpenAddBudgetModal(type);
    }

    private async Task OpenAddBudgetModal(CategoryTypeEnum type, int categoryId = 0)
    {
        var parameters = new DialogParameters
        {
            ["Year"] = _year,
            ["Month"] = _month,
            ["CategoryType"] = type,
            ["CategoryId"] = categoryId,
            ["OnBudgetSaved"] = EventCallback.Factory.Create(this, async () => await LoadBudgets())
        };

        await DialogService.ShowAsync<AddBudgetModal>("Add Budget", parameters, DialogHelper.DefaultOptions);
    }

    private async Task HandleEdit(BudgetListItemVm item)
    {
        if (item.Id <= 0)
        {
            await OpenAddBudgetModal(item.CategoryType, item.CategoryId);
            return;
        }

        var result = await BudgetService.GetByIdAsync(item.Id);
        if (!result.Success || result.Data is null)
        {
            Snackbar.Add(result.Message ?? "Could not load budget", Severity.Error);
            return;
        }

        await OpenUpdateBudgetModal(result.Data);
    }

    private Task HandleDelete(BudgetListItemVm item)
    {
        Snackbar.Add("Delete not implemented yet", Severity.Info);
        return Task.CompletedTask;
    }

    private async Task OpenUpdateBudgetModal(BudgetDto budget)
    {
        var parameters = new DialogParameters
        {
            ["Budget"] = budget,
            ["OnBudgetSaved"] = EventCallback.Factory.Create(this, async () => await LoadBudgets())
        };

        await DialogService.ShowAsync<UpdateBudgetModal>("Update Budget", parameters, DialogHelper.DefaultOptions);
    }

    private async Task HandleViewTransactions(BudgetListItemVm item)
    {
        var result = await TransactionService.GetByCategoryForMonthAsync(item.CategoryId, _year, _month);

        if (!result.Success || result.Data is null)
        {
            Snackbar.Add(result.Message ?? "Error loading transactions", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Transactions"] = result.Data,
            ["CategoryName"] = item.CategoryName
        };

        await DialogService.ShowAsync<BudgetTransactionsModal>("Transactions", parameters, DialogHelper.DefaultOptions);
    }

    private static decimal NormalizeExpenseUsed(decimal used)
    {
        // Si viene negativo => lo convertimos a positivo
        // Si viene positivo => lo dejamos positivo
        return used < 0 ? -used : used;
    }

    private static decimal NormalizeIncomeUsed(decimal used)
    {
        // Income debería ser positivo; si viniera negativo por error, lo volvemos positivo
        return used < 0 ? -used : used;
    }

}

