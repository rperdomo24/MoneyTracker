@using MoneyTracker.UI.Helpers
@using MoneyTracker.UI.Helpers.VM
@using MoneyTracker.Domain.Enums.Budgets
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

@if (TableView)
{
    @if (Loading)
    {
        <MudStack Class="pa-6" AlignItems="AlignItems.Center" Justify="Justify.Center">
            <MudProgressCircular Indeterminate="true" />
        </MudStack>
    }
    else if (Items?.Any() != true)
    {
        <MudPaper Class="pa-6" Elevation="0">
            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Wallet" Size="Size.Large" />
                <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@EmptyMessage</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        var tableChildrenByParent = Items!
            .Where(x => x.ParentCategoryId is not null)
            .GroupBy(x => x.ParentCategoryId!.Value)
            .ToDictionary(g => g.Key, g => g.ToList());

        <MudSimpleTable Hover="true" Dense="true" Style="overflow-x:auto;">
            <thead>
                <tr>
                    <th style="min-width:180px;">Category</th>
                    <th style="text-align:right;">Budget</th>
                    <th style="text-align:right;">Used</th>
                    <th style="text-align:right;">Remaining</th>
                    <th style="min-width:140px;">Progress</th>
                    <th style="text-align:center;">Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (item, depth) in GetFlatItems())
                {
                    var rowChildren = depth == 0
                        ? tableChildrenByParent.GetValueOrDefault(item.CategoryId)
                        : null;
                    var color = GetBudgetColor(item, rowChildren);
                    var progress = GetProgressValue(item, rowChildren);
                    var progressLabel = GetProgressLabel(item, rowChildren);
                    var displayBudget = GetDisplayBudget(item, rowChildren);
                    var displayUsed = GetDisplayUsed(item, rowChildren);
                    var remaining = displayBudget - displayUsed;
                    var isGroupOnly = IsGroupOnly(item, rowChildren);
                    <tr>
                        <td>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"
                                      Style="@($"padding-left:{depth * 20}px;")">
                                @if (depth > 0)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight"
                                             Size="Size.Small" Style="opacity:0.5;" />
                                }
                                <MudAvatar Size="Size.Small" Style="@($"background-color:{item.CategoryColor}; width:20px; height:20px;")">
                                    <MudIcon Icon="@(item.CategoryIcon.ToIcon())" Color="Color.Surface" Size="Size.Small"
                                             Style="font-size:12px;" />
                                </MudAvatar>
                                <MudText Typo="Typo.body2" Class="@(depth == 0 ? "font-weight-bold" : "")">
                                    @item.CategoryName
                                </MudText>
                                @if (item.HasBudget)
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@PaycheckChipColor(item.PaycheckPeriod)"
                                             Style="height:18px; font-size:10px; padding: 0 6px; min-width:0;">
                                        @PaycheckChipLabel(item.PaycheckPeriod)
                                    </MudChip>
                                }
                            </MudStack>
                        </td>
                        <td style="text-align:right;">
                            <MudText Typo="Typo.body2">
                                @(item.HasBudget || isGroupOnly ? CurrencyHelper.FormatCurrency(displayBudget) : "—")
                            </MudText>
                        </td>
                        <td style="text-align:right;">
                            <MudText Typo="Typo.body2" Color="@(remaining < 0 && (item.HasBudget || isGroupOnly) ? Color.Error : Color.Default)">
                                @CurrencyHelper.FormatCurrency(displayUsed)
                            </MudText>
                        </td>
                        <td style="text-align:right;">
                            @if (item.HasBudget || isGroupOnly)
                            {
                                <MudText Typo="Typo.body2"
                                         Color="@(remaining < 0 ? Color.Error : Color.Success)">
                                    @CurrencyHelper.FormatCurrency(remaining)
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="opacity:0.5;">—</MudText>
                            }
                        </td>
                        <td style="min-width:140px;">
                            <MudStack Spacing="0">
                                <MudProgressLinear Value="@progress" Color="@color" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Style="opacity:0.7;">@progressLabel</MudText>
                            </MudStack>
                        </td>
                        <td style="text-align:center;">
                            <MudChip T="string" Size="Size.Small" Color="@color">
                                @GetHealthLabel(item, rowChildren)
                            </MudChip>
                        </td>
                        <td>
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" Size="Size.Small">
                                <MudMenuItem OnClick="@(() => OnViewTransactions.InvokeAsync(item))">
                                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="mr-2" Size="Size.Small" /> Transactions
                                </MudMenuItem>
                                @if (!item.HasBudget && OnAddBudget.HasDelegate)
                                {
                                    <MudMenuItem OnClick="@(() => OnAddBudget.InvokeAsync(item))">
                                        <MudIcon Icon="@Icons.Material.Filled.Savings" Class="mr-2" Size="Size.Small" /> Add Budget
                                    </MudMenuItem>
                                }
                                <MudMenuItem OnClick="@(() => OnEdit.InvokeAsync(item))">
                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" Size="Size.Small" /> Edit
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => OnDelete.InvokeAsync(item))">
                                    <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-2" Size="Size.Small" /> Delete
                                </MudMenuItem>
                            </MudMenu>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @{
                    var totalBudget = Items!
                        .Where(x => x.ParentCategoryId is null)
                        .Sum(x => GetDisplayBudget(x, tableChildrenByParent.GetValueOrDefault(x.CategoryId)));
                    var totalUsed = Items!
                        .Where(x => x.ParentCategoryId is null)
                        .Sum(x => GetDisplayUsed(x, tableChildrenByParent.GetValueOrDefault(x.CategoryId)));
                    var totalRemaining = totalBudget - totalUsed;
                    // totalBudget already uses QuincenaAmount when PaycheckView>0 via GetDisplayBudget
                    var totalQuincena = 0m; // unused, totalBudget handles it
                }
                <tr style="border-top: 2px solid var(--mud-palette-divider); font-weight: bold;">
                    <td><MudText Typo="Typo.body2" Class="font-weight-bold">Total</MudText></td>
                    <td style="text-align:right;">
                        <MudText Typo="Typo.body2" Class="font-weight-bold">@CurrencyHelper.FormatCurrency(totalBudget)</MudText>
                    </td>
                    <td style="text-align:right;">
                        <MudText Typo="Typo.body2" Class="font-weight-bold" Color="@(totalRemaining < 0 ? Color.Error : Color.Default)">
                            @CurrencyHelper.FormatCurrency(totalUsed)
                        </MudText>
                    </td>
                    <td style="text-align:right;">
                        <MudText Typo="Typo.body2" Class="font-weight-bold" Color="@(totalRemaining < 0 ? Color.Error : Color.Success)">
                            @CurrencyHelper.FormatCurrency(totalRemaining)
                        </MudText>
                    </td>
                    <td colspan="3"></td>
                </tr>
            </tfoot>
        </MudSimpleTable>
    }
}
else
{

@if (Loading)
{
    <MudStack Class="pa-6" AlignItems="AlignItems.Center" Justify="Justify.Center">
        <MudProgressCircular Indeterminate="true" />
        <MudText Class="mt-2">Loading budgets...</MudText>
    </MudStack>
}
else if (Items?.Any() != true)
{
    <MudPaper Class="pa-6" Elevation="0">
        <MudStack AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Wallet" Size="Size.Large" />
            <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@EmptyMessage</MudText>
            <MudText Typo="Typo.caption" Style="opacity:0.75;">Add a budget to start tracking.</MudText>
        </MudStack>
    </MudPaper>
}
else
{
    var parents = Items!
        .Where(x => x.ParentCategoryId is null)
        .OrderByDescending(x => Math.Abs(x.Used) > 0.01m)
        .ThenByDescending(x => x.Amount > 0)
        .ThenBy(x => x.CategoryName)
        .ToList();

    var childrenByParent = Items!
        .Where(x => x.ParentCategoryId is not null)
        .GroupBy(x => x.ParentCategoryId!.Value)
        .ToDictionary(
            g => g.Key,
            g => g
                .OrderByDescending(x => Math.Abs(x.Used) > 0.01m)
                .ThenByDescending(x => x.Amount > 0)
                .ThenBy(x => x.CategoryName)
                .ToList()
        );

    <MudStack Spacing="2" Class="mt-2">
        @foreach (var parent in parents)
        {
            var hasChildren = childrenByParent.TryGetValue(parent.CategoryId, out var children) && children.Count > 0;
            var isExpanded = hasChildren && _expandedParents.Contains(parent.CategoryId);
            var displayBudget = GetDisplayBudget(parent, children);
            var displayUsed = GetDisplayUsed(parent, children);
            var displayRemaining = displayBudget - displayUsed;
            var displayColor = GetBudgetColor(parent, children);
            var displayProgress = GetProgressValue(parent, children);
            var healthLabel = GetHealthLabel(parent, children);
            var isGroupOnly = IsGroupOnly(parent, children);

            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:16px;">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar Size="Size.Medium" Style="@($"background-color:{parent.CategoryColor};")">
                                <MudIcon Icon="@(parent.CategoryIcon.ToIcon())"
                                         Color="Color.Surface"
                                         Size="Size.Medium" />
                            </MudAvatar>

                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@parent.CategoryName</MudText>
                                <MudText Typo="Typo.caption" Style="opacity:0.75;">
                                    @if (isGroupOnly)
                                    {
                                        <span>Grouped by child budgets</span>
                                    }
                                    else if (displayRemaining < 0)
                                    {
                                        <span style="color: var(--mud-palette-error);">
                                            @CurrencyHelper.FormatCurrency(Math.Abs(displayRemaining)) over
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--mud-palette-success);">
                                            @CurrencyHelper.FormatCurrency(displayRemaining) left
                                        </span>
                                    }

                                    @if (hasChildren)
                                    {
                                        <span style="opacity:0.75;"> - @children!.Count subcategories</span>
                                    }
                                </MudText>
                            </MudStack>
                        </MudStack>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Filled"
                                     Color="@displayColor">
                                @healthLabel
                            </MudChip>

                            @if (hasChildren)
                            {
                                <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                               Color="Color.Inherit"
                                               Size="Size.Small"
                                               OnClick="@(() => ToggleParent(parent.CategoryId))" />
                            }

                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true">
                                <MudMenuItem OnClick="@(() => OnViewTransactions.InvokeAsync(parent))">
                                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="mr-2" /> View transactions
                                </MudMenuItem>
                                @if (!parent.HasBudget && OnAddBudget.HasDelegate)
                                {
                                    <MudMenuItem OnClick="@(() => OnAddBudget.InvokeAsync(parent))">
                                        <MudIcon Icon="@Icons.Material.Filled.Savings" Class="mr-2" /> Add Budget
                                    </MudMenuItem>
                                }
                                <MudMenuItem OnClick="@(() => OnEdit.InvokeAsync(parent))">
                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" /> Edit
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => OnDelete.InvokeAsync(parent))">
                                    <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-2" /> Delete
                                </MudMenuItem>
                            </MudMenu>
                        </MudStack>
                    </MudStack>

                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.End">
                        <div>
                            <MudText Typo="Typo.caption" Style="opacity:0.7;">@(isGroupOnly ? "Children budgets" : "Budget")</MudText>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">@CurrencyHelper.FormatCurrency(displayBudget)</MudText>
                        </div>

                        <div style="text-align:right;">
                            <MudText Typo="Typo.caption" Style="opacity:0.7;">@(isGroupOnly ? "Total used" : "Used")</MudText>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-medium">
                                @CurrencyHelper.FormatCurrency(displayUsed)
                            </MudText>
                        </div>
                    </MudStack>

                    <MudStack Spacing="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.caption" Style="opacity:0.75;">Usage</MudText>
                            <MudText Typo="Typo.caption" Class="font-weight-medium">
                                @GetProgressLabel(parent, children)
                            </MudText>
                        </MudStack>

                        <MudProgressLinear Value="@displayProgress"
                                           Color="@displayColor"
                                           Size="Size.Large" />
                    </MudStack>

                    @if (parent.IncludeChildren && hasChildren && Math.Abs(parent.DirectUsed) > 0.01m)
                    {
                        var childrenUsed = displayUsed - parent.DirectUsed;
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-1">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                Direct: @CurrencyHelper.FormatCurrency(Math.Abs(parent.DirectUsed))
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                Children: @CurrencyHelper.FormatCurrency(Math.Abs(childrenUsed))
                            </MudChip>
                        </MudStack>
                    }

                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                        @if (parent.HasBudget)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Color="@PaycheckChipColor(parent.PaycheckPeriod)">
                                @PaycheckChipLabel(parent.PaycheckPeriod)
                            </MudChip>
                        }
                        @if (parent.IncludeChildren)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Include Children</MudChip>
                        }
                        @if (parent.RolloverEnabled)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Rollover</MudChip>
                        }
                        @if (!parent.HasBudget && Math.Abs(parent.Used) > 0.01m)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">Activity without budget</MudChip>
                        }
                        @if (isGroupOnly)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">Using child budgets</MudChip>
                        }
                        @if (PaycheckView > 0)
                        {
                            var qLabel = PaycheckView == 1 ? "Q1" : "Q2";
                            var qAmt = parent.QuincenaAmount(PaycheckView);
                            var qColor = parent.IsActiveInView(PaycheckView) ? Color.Primary : Color.Default;
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@qColor">
                                @qLabel: @CurrencyHelper.FormatCurrency(qAmt)
                            </MudChip>
                        }
                    </MudStack>

                    @if (hasChildren)
                    {
                        <MudCollapse Expanded="@isExpanded">
                            <MudStack Spacing="1" Class="mt-2">
                                @foreach (var child in children!)
                                {
                                    <MudPaper Elevation="0"
                                              Class="pa-3"
                                              Style="border-radius:12px; border:1px solid var(--mud-palette-divider);">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="7">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                    <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Style="opacity:0.7;" />
                                                    <MudAvatar Size="Size.Small" Style="@($"background-color:{child.CategoryColor};")">
                                                        <MudIcon Icon="@(child.CategoryIcon.ToIcon())"
                                                                 Color="Color.Surface"
                                                                 Size="Size.Small" />
                                                    </MudAvatar>

                                                    <MudStack Spacing="0">
                                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@child.CategoryName</MudText>
                                                        <MudText Typo="Typo.caption" Style="opacity:0.75;">
                                                            @if (child.Remaining < 0)
                                                            {
                                                                <span style="color: var(--mud-palette-error);">
                                                                    @CurrencyHelper.FormatCurrency(Math.Abs(child.Remaining)) over
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span style="color: var(--mud-palette-success);">
                                                                    @CurrencyHelper.FormatCurrency(child.Remaining) left
                                                                </span>
                                                            }
                                                        </MudText>
                                                    </MudStack>
                                                </MudStack>
                                            </MudItem>

                                            <MudItem xs="9" sm="4">
                                                <MudStack AlignItems="AlignItems.End" Spacing="0">
                                                    <MudChip T="string"
                                                             Size="Size.Small"
                                                             Color="@GetBudgetColor(child)">
                                                        @GetHealthLabel(child)
                                                    </MudChip>
                                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                                                        @CurrencyHelper.FormatCurrency(child.Used)
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Style="opacity:0.75;">
                                                        from @CurrencyHelper.FormatCurrency(child.Amount)
                                                    </MudText>
                                                </MudStack>
                                            </MudItem>

                                            <MudItem xs="3" sm="1">
                                                <MudStack AlignItems="AlignItems.End">
                                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true">
                                                        <MudMenuItem OnClick="@(() => OnViewTransactions.InvokeAsync(child))">
                                                            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="mr-2" /> View transactions
                                                        </MudMenuItem>
                                                        <MudMenuItem OnClick="@(() => OnEdit.InvokeAsync(child))">
                                                            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" /> Edit
                                                        </MudMenuItem>
                                                        <MudMenuItem OnClick="@(() => OnDelete.InvokeAsync(child))">
                                                            <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-2" /> Delete
                                                        </MudMenuItem>
                                                    </MudMenu>
                                                </MudStack>
                                            </MudItem>

                                            <MudItem xs="12">
                                                <MudStack Spacing="1">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                        <MudText Typo="Typo.caption" Style="opacity:0.75;">Usage</MudText>
                                                        <MudText Typo="Typo.caption" Class="font-weight-medium">
                                                            @GetProgressLabel(child)
                                                        </MudText>
                                                    </MudStack>

                                                    <MudProgressLinear Value="@GetProgressValue(child)"
                                                                       Color="@GetBudgetColor(child)"
                                                                       Size="Size.Medium" />
                                                </MudStack>
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                }
                            </MudStack>
                        </MudCollapse>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}

} @* end else (card view) *@

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool TableView { get; set; }
    [Parameter] public int PaycheckView { get; set; } = 0;
    [Parameter] public string EmptyMessage { get; set; } = "No budgets found.";
    [Parameter] public List<BudgetListItemVm>? Items { get; set; }

    [Parameter] public EventCallback<BudgetListItemVm> OnEdit { get; set; }
    [Parameter] public EventCallback<BudgetListItemVm> OnDelete { get; set; }
    [Parameter] public EventCallback<BudgetListItemVm> OnViewTransactions { get; set; }
    [Parameter] public EventCallback<BudgetListItemVm> OnAddBudget { get; set; }

    private readonly HashSet<int> _expandedParents = new();

    protected override void OnParametersSet()
    {
        if (Items is null) return;

        var childrenByParent = Items
            .Where(x => x.ParentCategoryId is not null)
            .GroupBy(x => x.ParentCategoryId!.Value)
            .ToDictionary(g => g.Key, g => g.ToList());

        foreach (var parent in Items.Where(x => x.ParentCategoryId is null))
        {
            if (!childrenByParent.TryGetValue(parent.CategoryId, out var children)) continue;
            var hasProblematicChild = children.Any(c => c.IsOverBudget || c.IsNearLimit);
            if (hasProblematicChild)
                _expandedParents.Add(parent.CategoryId);
        }
    }

    private IEnumerable<(BudgetListItemVm Item, int Depth)> GetFlatItems()
    {
        if (Items is null) yield break;

        var parents = Items
            .Where(x => x.ParentCategoryId is null)
            .OrderByDescending(x => Math.Abs(x.Used) > 0.01m)
            .ThenByDescending(x => x.Amount > 0)
            .ThenBy(x => x.CategoryName);

        var childrenByParent = Items
            .Where(x => x.ParentCategoryId is not null)
            .GroupBy(x => x.ParentCategoryId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(x => x.CategoryName).ToList());

        foreach (var parent in parents)
        {
            yield return (parent, 0);
            if (!childrenByParent.TryGetValue(parent.CategoryId, out var children)) continue;
            foreach (var child in children)
                yield return (child, 1);
        }
    }

    private void ToggleParent(int parentCategoryId)
    {
        if (!_expandedParents.Add(parentCategoryId))
            _expandedParents.Remove(parentCategoryId);
    }

    private static string PaycheckChipLabel(PaycheckPeriod p) => p switch
    {
        PaycheckPeriod.FirstOnly  => "Q1",
        PaycheckPeriod.SecondOnly => "Q2",
        _                         => "÷2"
    };

    private static Color PaycheckChipColor(PaycheckPeriod p) => p switch
    {
        PaycheckPeriod.FirstOnly  => Color.Primary,
        PaycheckPeriod.SecondOnly => Color.Secondary,
        _                         => Color.Default
    };

    private static bool IsGroupOnly(BudgetListItemVm item, List<BudgetListItemVm>? children)
        => !item.HasBudget && children?.Any(x => x.HasBudget) == true;

    private decimal GetDisplayBudget(BudgetListItemVm item, List<BudgetListItemVm>? children)
    {
        if (!IsGroupOnly(item, children))
            return PaycheckView > 0 ? item.QuincenaAmount(PaycheckView) : item.Amount;

        return (children ?? new()).Sum(x => PaycheckView > 0 ? x.QuincenaAmount(PaycheckView) : x.Amount);
    }

    private static decimal GetDisplayUsed(BudgetListItemVm item, List<BudgetListItemVm>? children)
    {
        if (!IsGroupOnly(item, children))
            return item.Used;

        return item.Used + (children ?? new()).Sum(x => x.Used);
    }

    private Color GetBudgetColor(BudgetListItemVm item, List<BudgetListItemVm>? children = null)
    {
        if (IsGroupOnly(item, children))
        {
            var remaining = GetDisplayBudget(item, children) - GetDisplayUsed(item, children);
            if (remaining < 0) return Color.Error;

            var budget = GetDisplayBudget(item, children);
            if (budget <= 0) return Color.Info;

            var progress = (int)Math.Round((double)(GetDisplayUsed(item, children) / budget) * 100d);
            if (progress >= 80) return Color.Warning;

            return Color.Info;
        }

        if (item.IsOverBudget)
            return Color.Error;

        if (!item.HasBudget)
            return Color.Default;

        if (item.IsNearLimit)
            return Color.Warning;

        return Color.Success;
    }

    private double GetProgressValue(BudgetListItemVm item, List<BudgetListItemVm>? children = null)
    {
        if (IsGroupOnly(item, children))
        {
            var budget = GetDisplayBudget(item, children);
            if (budget <= 0) return 0d;

            var ratio = (double)(GetDisplayUsed(item, children) / budget) * 100d;
            return Math.Clamp(ratio, 0d, 100d);
        }

        if (!item.HasBudget)
            return 0d;

        var denominator = PaycheckView > 0 ? item.QuincenaAmount(PaycheckView) : item.Amount;
        var percent = denominator == 0 ? 0d : (double)(item.Used / denominator) * 100d;
        return Math.Clamp(percent, 0d, 100d);
    }

    private string GetProgressLabel(BudgetListItemVm item, List<BudgetListItemVm>? children = null)
    {
        if (IsGroupOnly(item, children))
        {
            var budget = GetDisplayBudget(item, children);
            if (budget <= 0)
                return "Child budgets pending";

            var progress = (int)Math.Round((double)(GetDisplayUsed(item, children) / budget) * 100d);
            return $"{Math.Clamp(progress, 0, 100)}% across children";
        }

        if (!item.HasBudget)
            return Math.Abs(item.Used) > 0.01m ? "No budget set" : "Waiting for budget";

        var denominator = PaycheckView > 0 ? item.QuincenaAmount(PaycheckView) : item.Amount;
        if (denominator == 0) return "0% used";
        var pct = (int)Math.Round((double)(item.Used / denominator) * 100d);
        return $"{Math.Clamp(pct, 0, 100)}% used";
    }

    private static string GetHealthLabel(BudgetListItemVm item, List<BudgetListItemVm>? children = null)
    {
        if (IsGroupOnly(item, children))
            return "Grouped";

        return item.HealthState switch
        {
            BudgetHealthState.OverBudget => "Over",
            BudgetHealthState.Warning => "Near limit",
            BudgetHealthState.Healthy => "On track",
            _ => "No budget"
        };
    }
}
