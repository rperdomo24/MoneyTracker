@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Budgets
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Budgets
@using MoneyTracker.Domain.Enums.Category
@using MoneyTracker.UI.Components.Shared.Selectors
@using MoneyTracker.UI.Helpers
@inject ICategoryService CategoryService
@inject IBudgetService BudgetService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6" Class="font-weight-bold">Add Budget</MudText>
                <MudText Typo="Typo.body2" Style="opacity: .7;">@($"{Month:D2}/{Year} • {CategoryType}")</MudText>
            </div>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-6">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Class="mt-3">Loading...</MudText>
            </MudStack>
        }
        else
        {
            <MudForm @ref="_form">
                <MudStack Spacing="3">

                    <CategorySelector @bind-SelectedCategory="_selectedCategory"
                                      Categories="@(_categories ?? new())"
                                      FilterByType="@CategoryType"
                                      Disabled="@IsCategoryLocked"
                                      ShowAddButton="false" />

                    <MudNumericField T="decimal"
                                     Label="Budget Amount"
                                     Variant="Variant.Outlined"
                                     @bind-Value="_amount"
                                     Required="true"
                                     Min="0.01m"
                                     Format="F2"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$"
                                     HideSpinButtons="false" />

                    <MudSelect T="PaycheckPeriod"
                               Label="Paycheck period"
                               @bind-Value="_paycheckPeriod"
                               Variant="Variant.Outlined"
                               HelperText="Which paycheck covers this expense?">
                        <MudSelectItem Value="PaycheckPeriod.Both">Ambas quincenas (÷2 cada una)</MudSelectItem>
                        <MudSelectItem Value="PaycheckPeriod.FirstOnly">Solo Q1 (días 1-15)</MudSelectItem>
                        <MudSelectItem Value="PaycheckPeriod.SecondOnly">Solo Q2 (días 16-fin)</MudSelectItem>
                    </MudSelect>

                    <MudCheckBox @bind-Value="_includeChildren" Color="Color.Primary" Dense="true">
                        <MudText Typo="Typo.body2">Include children categories</MudText>
                    </MudCheckBox>

                    <MudCheckBox @bind-Value="_rolloverEnabled" Color="Color.Primary" Dense="true">
                        <MudText Typo="Typo.body2">Rollover unused amount to next month</MudText>
                    </MudCheckBox>

                </MudStack>
            </MudForm>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel" Disabled="@_saving">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@(_saving ? null : Icons.Material.Filled.Save)"
                   OnClick="SaveAsync"
                   Disabled="@(_loading || _saving)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">Saving...</MudText>
            }
            else
            {
                <span>Save</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; } // 1..12
    [Parameter] public CategoryTypeEnum CategoryType { get; set; } = CategoryTypeEnum.Expense;

    // ✅ Optional preselected category (when coming from a category context)
    [Parameter] public int? CategoryId { get; set; }

    [Parameter] public EventCallback OnBudgetSaved { get; set; }

    private MudForm _form = default!;
    private bool _loading = true;
    private bool _saving = false;

    private List<CategoryDto>? _categories;
    private CategoryDto? _selectedCategory;

    private decimal _amount = 0;
    private bool _includeChildren = true;
    private bool _rolloverEnabled = false;
    private PaycheckPeriod _paycheckPeriod = PaycheckPeriod.Both;

    private bool IsCategoryLocked => CategoryId.HasValue && CategoryId.Value > 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            // ✅ Standardized categories source/shape (same behavior everywhere)
            var result = await CategoryService.GetAllWithChildAsync(false);

            if (result.Success && result.Data != null)
            {
                _categories = result.Data
                    .Where(c => !c.IsSystem && c.Type == CategoryType)
                    .ToList();

                // ✅ If CategoryId is provided, preselect and lock
                if (IsCategoryLocked)
                {
                    _selectedCategory = _categories.FirstOrDefault(c => c.Id == CategoryId!.Value);
                }
                else
                {
                    // Ensure selection is valid if list changed
                    if (_selectedCategory != null && !_categories.Any(c => c.Id == _selectedCategory.Id))
                        _selectedCategory = null;
                }
            }
            else
            {
                _categories = new();
                _selectedCategory = null;
                Snackbar.Add(result.Message ?? "Error loading categories", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            _categories = new();
            _selectedCategory = null;
            Snackbar.Add($"Error loading categories: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (_saving) return;

        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (_selectedCategory == null)
        {
            Snackbar.Add("Category is required", Severity.Warning);
            return;
        }

        if (_amount <= 0)
        {
            Snackbar.Add("Amount must be greater than zero", Severity.Warning);
            return;
        }

        _saving = true;
        StateHasChanged();

        try
        {
            var dto = new BudgetDto
            {
                Id = 0,
                CategoryId = _selectedCategory.Id,
                Year = Year,
                Month = Month,
                Amount = _amount,
                IncludeChildren = _includeChildren,
                RolloverEnabled = _rolloverEnabled,
                RolloverMode = MoneyTracker.Domain.Enums.Budgets.RolloverMode.None,
                PaycheckPeriod = _paycheckPeriod
            };

            var result = await BudgetService.CreateOrUpdateAsync(dto);

            if (result.Success)
            {
                Snackbar.Add(result.Message ?? "Budget created", Severity.Success);
                await OnBudgetSaved.InvokeAsync();
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? "Error creating budget", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
