@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.Budgets
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Category
@using MoneyTracker.UI.Helpers
@inject ICategoryService CategoryService
@inject IBudgetService BudgetService
@inject ISnackbar Snackbar

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6" Class="font-weight-bold">Add Budget</MudText>
                <MudText Typo="Typo.body2" Style="opacity: .7;">@($"{Month:D2}/{Year} • {CategoryType}")</MudText>
            </div>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-6">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Class="mt-3">Loading...</MudText>
            </MudStack>
        }
        else
        {
            <MudForm @ref="_form">
                <MudStack Spacing="3">
                    <MudSelect T="int"
                               Label="Category"
                               Variant="Variant.Outlined"
                               @bind-Value="_categoryId"
                               Required="true"
                               AnchorOrigin="Origin.BottomCenter">
                        @if (_categories?.Any() == true)
                        {
                            @foreach (var c in _categories.OrderBy(x => x.Name))
                            {
                                <MudSelectItem Value="@c.Id">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudAvatar Size="Size.Small" Style="@($"background-color: {c.Color}; width: 24px; height: 24px;")">
                                            <MudIcon Icon="@c.Icon.ToIcon()" Color="Color.Surface" Size="Size.Small" />
                                        </MudAvatar>
                                        <MudText>@c.Name</MudText>
                                    </MudStack>
                                </MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudNumericField T="decimal"
                                     Label="Budget Amount"
                                     Variant="Variant.Outlined"
                                     @bind-Value="_amount"
                                     Required="true"
                                     Min="0.01m"
                                     Format="F2"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$"
                                     HideSpinButtons="false" />

                    <MudCheckBox @bind-Value="_includeChildren" Color="Color.Primary" Dense="true">
                        <MudText Typo="Typo.body2">Include children categories</MudText>
                    </MudCheckBox>

                    <MudCheckBox @bind-Value="_rolloverEnabled" Color="Color.Primary" Dense="true">
                        <MudText Typo="Typo.body2">Enable rollover</MudText>
                    </MudCheckBox>

                    <MudSelect T="int"
                               Label="Rollover Mode"
                               Variant="Variant.Outlined"
                               @bind-Value="_rolloverMode"
                               Disabled="@(!_rolloverEnabled)"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="0">Carry remaining balance</MudSelectItem>
                        <MudSelectItem Value="1">Carry overspend</MudSelectItem>
                        <MudSelectItem Value="2">Carry both (advanced)</MudSelectItem>
                    </MudSelect>
                </MudStack>
            </MudForm>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel" Disabled="@_saving">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@(_saving ? null : Icons.Material.Filled.Save)"
                   OnClick="SaveAsync"
                   Disabled="@(_loading || _saving)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">Saving...</MudText>
            }
            else
            {
                <span>Save</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; } // 1..12
    [Parameter] public CategoryTypeEnum CategoryType { get; set; } = CategoryTypeEnum.Expense;

    // Parent will refresh budgets list
    [Parameter] public EventCallback OnBudgetSaved { get; set; }

    private MudForm _form = default!;
    private bool _loading = true;
    private bool _saving = false;

    private List<CategoryDto>? _categories;

    private int _categoryId;
    private decimal _amount = 0;
    private bool _includeChildren = true;

    private bool _rolloverEnabled = false;
    private int _rolloverMode = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var result = await CategoryService.GetAllAsync();
            if (result.Success && result.Data != null)
            {
                _categories = result.Data
                    .Where(c => c.Type == CategoryType)
                    .ToList();
            }
            else
            {
                _categories = new();
                Snackbar.Add(result.Message ?? "Error loading categories", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            _categories = new();
            Snackbar.Add($"Error loading categories: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (_saving) return;

        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (_categoryId <= 0)
        {
            Snackbar.Add("Category is required", Severity.Warning);
            return;
        }

        if (_amount <= 0)
        {
            Snackbar.Add("Amount must be greater than zero", Severity.Warning);
            return;
        }

        _saving = true;
        StateHasChanged();

        try
        {
            var dto = new BudgetDto
            {
                Id = 0,
                CategoryId = _categoryId,
                Year = Year,
                Month = Month,
                Amount = _amount,
                IncludeChildren = _includeChildren,
                RolloverEnabled = _rolloverEnabled,
                // RolloverMode = _rolloverMode
            };

            var result = await BudgetService.CreateOrUpdateAsync(dto);

            if (result.Success)
            {
                Snackbar.Add(result.Message ?? "Budget created", Severity.Success);
                await OnBudgetSaved.InvokeAsync();
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? "Error creating budget", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
