@using MudBlazor
@using ApexCharts
@using MoneyTracker.Application.DTOs.Budgets
@using MoneyTracker.UI.Helpers
@using MoneyTracker.UI.Helpers.VM

<MudPaper Elevation="1" Class="pa-4" Style="border-radius:16px;">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween">
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@MonthLabel</MudText>
                <MudText Typo="Typo.caption" Style="opacity:0.75;">
                    @(IsExpenseTab ? "Expenses overview" : "Income overview")
                </MudText>
            </MudStack>

            <MudButton Variant="Variant.Filled"
                       Color="MudBlazor.Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Size="MudBlazor.Size.Small"
                       OnClick="OnAddBudget">
                New budget
            </MudButton>
        </MudStack>

        @if (_hasChartData)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                <ApexChart TItem="BudgetSlicePoint" Options="_chartOptions" Height="300">
                    <ApexPointSeries TItem="BudgetSlicePoint"
                                     Items="_chartPoints"
                                     Name="Budget"
                                     SeriesType="SeriesType.Donut"
                                     XValue="point => point.Name"
                                     YValue="point => point.Used" />
                </ApexChart>

                <MudText Typo="Typo.caption" Style="opacity:0.75;">
                    @(IsExpenseTab ? "Spent" : "Earned")
                </MudText>
                <MudText Typo="Typo.h6" Class="font-weight-bold">
                    @CurrencyHelper.FormatCurrency(Summary.TotalUsed)
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    of @CurrencyHelper.FormatCurrency(Summary.TotalBudgeted)
                </MudText>
            </MudStack>

            <MudStack Spacing="1">
                @foreach (var s in _legendSlices)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudAvatar Size="MudBlazor.Size.Small" Style="@($"background-color:{s.Color};")" />
                            <MudText Typo="Typo.body2">@s.Name</MudText>
                        </MudStack>

                        <MudText Typo="Typo.body2" Class="font-weight-medium">
                            @($"{s.Percent}%")
                        </MudText>
                    </MudStack>
                }
            </MudStack>
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2" Class="pa-6">
                <MudText Typo="Typo.h4" Style="opacity:0.5;">
                    @CurrencyHelper.FormatCurrency(0)
                </MudText>

                <MudButton Variant="Variant.Filled"
                           Color="MudBlazor.Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OnAddBudget">
                    New budget
                </MudButton>
            </MudStack>
        }

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="0" Class="pa-3" Style="border-radius:12px; border:1px solid var(--mud-palette-divider);">
                    <MudText Typo="Typo.caption" Style="opacity:0.75;">Budgeted</MudText>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">@CurrencyHelper.FormatCurrency(Summary.TotalBudgeted)</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudPaper Elevation="0" Class="pa-3" Style="border-radius:12px; border:1px solid var(--mud-palette-divider);">
                    <MudText Typo="Typo.caption" Style="opacity:0.75;">Remaining</MudText>
                    <MudText Typo="Typo.h6"
                             Class="font-weight-bold"
                             Style="@(Summary.TotalRemaining < 0 ? "color: var(--mud-palette-error);" : "color: var(--mud-palette-success);")">
                        @CurrencyHelper.FormatCurrency(Summary.TotalRemaining)
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public string MonthLabel { get; set; } = "";
    [Parameter] public bool IsExpenseTab { get; set; }
    [Parameter] public BudgetMonthlySummaryDto Summary { get; set; } = new();
    [Parameter] public List<BudgetCategorySliceVm>? Slices { get; set; }
    [Parameter] public EventCallback OnAddBudget { get; set; }

    private bool _hasChartData;
    private ApexChartOptions<BudgetSlicePoint> _chartOptions = BuildChartOptions(new List<string>());
    private List<BudgetSlicePoint> _chartPoints = new();
    private List<BudgetCategorySliceVm> _legendSlices = new();

    protected override void OnParametersSet()
    {
        _hasChartData = false;
        _chartPoints = new();
        _legendSlices = new();
        _chartOptions = BuildChartOptions(new List<string>());

        if (Slices?.Any() != true)
            return;

        var cleaned = Slices
            .Where(x => x.Used > 0)
            .ToList();

        if (!cleaned.Any())
            return;

        _legendSlices = cleaned;
        _chartPoints = cleaned
            .Select(x => new BudgetSlicePoint
            {
                Name = x.Name,
                Used = x.Used
            })
            .ToList();

        _chartOptions = BuildChartOptions(cleaned.Select(x => x.Color).ToList());
        _hasChartData = true;
    }

    private static ApexChartOptions<BudgetSlicePoint> BuildChartOptions(List<string> colors)
        => new()
        {
            Chart = new Chart
            {
                Background = "transparent",
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false },
                Animations = new Animations
                {
                    Enabled = false
                }
            },
            DataLabels = new DataLabels { Enabled = false },
            Colors = colors,
            Legend = new Legend { Show = false }
        };

    private sealed class BudgetSlicePoint
    {
        public string Name { get; set; } = string.Empty;
        public decimal Used { get; set; }
    }
}
