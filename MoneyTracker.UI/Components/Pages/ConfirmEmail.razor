@page "/confirm-email"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@using MoneyTracker.Application.Interfaces
@inject IEmailConfirmationService EmailConfirmationService

<MudText Typo="Typo.h5" Align="Align.Center" Class="font-weight-bold">Email confirmation</MudText>

@if (_isLoading)
{
    <MudStack AlignItems="AlignItems.Center" Class="mt-4">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </MudStack>
}
else if (_succeeded)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mt-4">
        Email confirmed successfully. You can now <MudLink Href="/login">sign in</MudLink>.
    </MudAlert>
}
else
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">
        @(_error ?? "Invalid or expired confirmation link.")
    </MudAlert>
}

@code {
    [SupplyParameterFromQuery] public string? UserId { get; set; }
    [SupplyParameterFromQuery] public string? Code { get; set; }

    private bool _isLoading = true;
    private bool _succeeded;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var result = await EmailConfirmationService.ConfirmEmailAsync(UserId, Code);
        _succeeded = result.Success;
        if (!result.Success)
            _error = result.Message;
        _isLoading = false;
    }
}
