@page "/login-otp"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@implements IDisposable

<MudText Typo="Typo.h5" Align="Align.Center" Class="font-weight-bold">Email verification code</MudText>
<MudText Typo="Typo.body2" Align="Align.Center" Class="mb-3">Enter the code sent to your email.</MudText>
@if (_remainingSeconds > 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
        This code expires in @FormatRemaining(_remainingSeconds).
    </MudAlert>
}
else if (_hasExpiry)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">
        This code has expired. Request a new code.
    </MudAlert>
}

@if (!string.IsNullOrWhiteSpace(Info))
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@Info</MudAlert>
}

@if (!string.IsNullOrWhiteSpace(Error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@Error</MudAlert>
}

<form method="post" action="/auth/login-otp">
    <AntiforgeryToken />
    <MudText Typo="Typo.caption" Class="mb-1 d-block mt-3">OTP code</MudText>
    <input type="text"
           name="code"
           @bind="_code"
           autocomplete="one-time-code"
           inputmode="numeric"
           pattern="[0-9]*"
           class="mud-input-slot mud-input-root mud-input-root-outlined"
           style="width:100%; padding: 14px 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;" />
    <input type="hidden" name="rememberMe" value="@RememberMe.ToString().ToLowerInvariant()" />
    <input type="hidden" name="returnUrl" value="@SafeReturnUrl(ReturnUrl)" />
    <input type="hidden" name="expiresAtUtc" value="@ExpiresAtUtc" />

    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" Class="mt-4">
        Verify and sign in
    </MudButton>
</form>

<form method="post" action="/auth/login-otp/resend">
    <AntiforgeryToken />
    <input type="hidden" name="rememberMe" value="@RememberMe.ToString().ToLowerInvariant()" />
    <input type="hidden" name="returnUrl" value="@SafeReturnUrl(ReturnUrl)" />
    <input type="hidden" name="expiresAtUtc" value="@ExpiresAtUtc" />
    <MudButton ButtonType="ButtonType.Submit" Color="Color.Default" Variant="Variant.Outlined" FullWidth="true" Class="mt-2">
        Resend code
    </MudButton>
</form>

<MudButton Href="/login"
           Color="Color.Secondary"
           Variant="Variant.Text"
           FullWidth="true"
           Class="mt-2">
    Back to sign in
</MudButton>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public bool RememberMe { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Info { get; set; }
    [SupplyParameterFromQuery] public string? ExpiresAtUtc { get; set; }

    private string _code = string.Empty;
    private int _remainingSeconds;
    private bool _hasExpiry;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override Task OnParametersSetAsync()
    {
        StartOrRefreshTimer();
        return Task.CompletedTask;
    }

    private static string SafeReturnUrl(string? returnUrl)
        => !string.IsNullOrWhiteSpace(returnUrl) && returnUrl.StartsWith('/') ? returnUrl : "/";

    private void StartOrRefreshTimer()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();

        _hasExpiry = false;
        _remainingSeconds = 0;

        if (!TryParseUtc(ExpiresAtUtc, out var expiresAt))
        {
            return;
        }

        _hasExpiry = true;
        _remainingSeconds = Math.Max(0, (int)Math.Ceiling((expiresAt - DateTime.UtcNow).TotalSeconds));

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = TickAsync(_timer, _cts.Token);
    }

    private async Task TickAsync(PeriodicTimer timer, CancellationToken cancellationToken)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                _remainingSeconds = Math.Max(0, _remainingSeconds - 1);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // No-op.
        }
    }

    private static bool TryParseUtc(string? value, out DateTime result)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            result = default;
            return false;
        }

        return DateTime.TryParse(
            value,
            null,
            System.Globalization.DateTimeStyles.AdjustToUniversal | System.Globalization.DateTimeStyles.AssumeUniversal,
            out result);
    }

    private static string FormatRemaining(int totalSeconds)
    {
        var minutes = totalSeconds / 60;
        var seconds = totalSeconds % 60;
        return $"{minutes:D2}:{seconds:D2}";
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
    }
}
