@using MoneyTracker.Application.DTOs
@using MoneyTracker.Application.DTOs.CardBenefits
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Application.Validators.CardBenefits
@using MoneyTracker.Domain.Enums.CardBenefits
@inject ICardBenefitService CardBenefitService
@inject IAccountService AccountService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Medium" />
            <MudText Typo="Typo.h6">@(_isEdit ? "Edit Benefit Rule" : "Add Benefit Rule")</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
            <MudForm @ref="_form" Model="_dto" Validation="_validator.ValidateValue">

                <MudSelect T="int"
                           Label="Card / Account"
                           @bind-Value="_dto.AccountId"
                           For="@(() => _dto.AccountId)"
                           Variant="Variant.Outlined"
                           Required="true"
                           Class="mb-4">
                    @foreach (var account in _accounts)
                    {
                        <MudSelectItem T="int" Value="@account.Id">@account.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudTextField Label="Benefit Rule Name"
                              @bind-Value="_dto.Name"
                              For="@(() => _dto.Name)"
                              Variant="Variant.Outlined"
                              Required="true"
                              Immediate="true"
                              Class="mb-4"
                              Placeholder="e.g., 5% Cashback on Groceries" />

                <MudSelect T="BenefitType"
                           Label="Benefit Type"
                           @bind-Value="_dto.BenefitType"
                           For="@(() => _dto.BenefitType)"
                           Variant="Variant.Outlined"
                           Required="true"
                           Class="mb-4">
                    @foreach (BenefitType type in Enum.GetValues<BenefitType>())
                    {
                        <MudSelectItem T="BenefitType" Value="@type">@type.ToString()</MudSelectItem>
                    }
                </MudSelect>

                <MudNumericField Label="Benefit Rate"
                                 @bind-Value="_dto.BenefitRate"
                                 For="@(() => _dto.BenefitRate)"
                                 Variant="Variant.Outlined"
                                 Min="0.0001m"
                                 Max="1m"
                                 Step="0.01m"
                                 Format="P1"
                                 Culture="@System.Globalization.CultureInfo.InvariantCulture"
                                 Class="mb-4"
                                 HelperText="Enter as decimal: 0.05 = 5%, 0.10 = 10%" />

                <MudTextField Label="Merchant Pattern (optional)"
                              @bind-Value="_dto.MerchantPattern"
                              For="@(() => _dto.MerchantPattern)"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Class="mb-4"
                              HelperText="Partial match on transaction name, e.g. 'Walmart', 'UBER'" />

                <MudNumericField Label="Monthly Cap (optional)"
                                 @bind-Value="_dto.MaxMonthlyCap"
                                 Variant="Variant.Outlined"
                                 Format="N2"
                                 Culture="@System.Globalization.CultureInfo.InvariantCulture"
                                 Class="mb-4"
                                 Adornment="Adornment.Start"
                                 AdornmentText="$"
                                 HelperText="Maximum benefit per month (leave empty for no cap)" />

                <MudSwitch T="bool"
                           @bind-Value="_dto.IsActive"
                           Label="Active"
                           Color="Color.Primary"
                           Class="mb-2" />
            </MudForm>
        </MudContainer>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@_isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>@(_isEdit ? "Update" : "Create")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public CardBenefitDto? ExistingBenefit { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private MudForm _form = default!;
    private CardBenefitDto _dto = new();
    private bool _isSubmitting = false;
    private bool _isEdit => ExistingBenefit is not null;
    private List<AccountDto> _accounts = new();

    private readonly CardBenefitValidator _validator = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await AccountService.GetAllAsync();
        if (result.Success)
            _accounts = result.Data ?? new();

        if (ExistingBenefit is not null)
        {
            _dto = new CardBenefitDto
            {
                Id = ExistingBenefit.Id,
                AccountId = ExistingBenefit.AccountId,
                Name = ExistingBenefit.Name,
                CategoryId = ExistingBenefit.CategoryId,
                MerchantPattern = ExistingBenefit.MerchantPattern,
                BenefitType = ExistingBenefit.BenefitType,
                BenefitRate = ExistingBenefit.BenefitRate,
                MaxMonthlyCap = ExistingBenefit.MaxMonthlyCap,
                IsActive = ExistingBenefit.IsActive
            };
        }
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var result = _isEdit
                ? await CardBenefitService.UpdateAsync(_dto)
                : await CardBenefitService.CreateAsync(_dto);

            if (result.Success)
            {
                Snackbar.Add(result.Message ?? "Saved successfully", Severity.Success);
                await OnSaved.InvokeAsync();
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? "Failed to save", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Unexpected error", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
