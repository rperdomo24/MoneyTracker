@page "/reports/monthly"
@using MoneyTracker.Application.DTOs.Budgets
@using MoneyTracker.Application.DTOs.Reports
@using MoneyTracker.Application.Interfaces
@using MoneyTracker.Domain.Enums.Transaction
@using MoneyTracker.UI.Helpers
@using MoneyTracker.UI.Services.Filters.Interface
@using System.Text
@using Markdig
@inject IReportService ReportService
@inject IBudgetService BudgetService
@inject IMonthlyReportStateService ReportState
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Monthly Report - MoneyTracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-1 pa-sm-6">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5" Class="font-weight-bold">Monthly Report</MudText>
            @if (IsCurrentMonth)
            {
                <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.Today">
                    @_daysLeft days left
                </MudChip>
            }
        </MudStack>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                           Color="Color.Secondary"
                           OnClick="PrevMonth" />

            <MudText Typo="Typo.subtitle1" Class="font-weight-medium" Style="min-width: 160px; text-align: center;">
                @MonthLabel
            </MudText>

            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                           Color="Color.Secondary"
                           OnClick="NextMonth"
                           Disabled="@IsCurrentMonth" />
        </MudStack>
    </MudStack>

    @if (_loading)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-10">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Class="mt-4">Generating report...</MudText>
        </MudStack>
    }
    else if (_report is null)
    {
        <MudPaper Class="pa-8" Elevation="1">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6">No data for @MonthLabel</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">@_report.MonthName — Summary</MudText>
        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Class="pa-4 text-center" Elevation="1" Style="border-left: 4px solid var(--mud-palette-success);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Income</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Success">@_report.Summary.TotalIncome.ToString("C2")</MudText>
                    @if (IsCurrentMonth && _elapsed > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @((_report.Summary.TotalIncome / _elapsed).ToString("C0"))/day
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Class="pa-4 text-center" Elevation="1" Style="border-left: 4px solid var(--mud-palette-error);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Expenses</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Error">@_report.Summary.TotalExpenses.ToString("C2")</MudText>
                    @if (IsCurrentMonth && _elapsed > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @((_report.Summary.TotalExpenses / _elapsed).ToString("C0"))/day
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Class="pa-4 text-center" Elevation="1"
                          Style="@(_report.Summary.FinalBalance >= 0 ? "border-left: 4px solid var(--mud-palette-success);" : "border-left: 4px solid var(--mud-palette-error);")">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Balance</MudText>
                    <MudText Typo="Typo.h6" Color="@(_report.Summary.FinalBalance >= 0 ? Color.Success : Color.Error)">
                        @_report.Summary.FinalBalance.ToString("C2")
                    </MudText>
                    @if (IsCurrentMonth && _report.Summary.TotalIncome > 0)
                    {
                        var pct = (int)(_report.Summary.FinalBalance / _report.Summary.TotalIncome * 100);
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@pct% saved</MudText>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Class="pa-4 text-center" Elevation="1">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Card Payments</MudText>
                    <MudText Typo="Typo.h6">@_report.Summary.TotalCard.ToString("C2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Class="pa-4 text-center" Elevation="1">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Cash Payments</MudText>
                    <MudText Typo="Typo.h6">@_report.Summary.TotalCash.ToString("C2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Class="pa-4 text-center" Elevation="1" Style="border-left: 4px solid var(--mud-palette-info);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Transactions</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Info">@_report.Summary.TransactionCount</MudText>
                    @if (IsCurrentMonth && _elapsed > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @((_report.Summary.TransactionCount / (decimal)_elapsed).ToString("F1"))/day
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (_budgets.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold" Style="opacity:0.75;">Budget Status</MudText>
            <MudPaper Elevation="1" Class="pa-3 mb-5">
                <MudStack Spacing="0">
                    @foreach (var b in _budgets.OrderByDescending(x => x.ProgressPercent))
                    {
                        var prog = b.ProgressPercent;
                        var barColor = prog >= 90 ? Color.Error : prog >= 70 ? Color.Warning : Color.Success;
                        var pctStyle = prog >= 90
                            ? "color: var(--mud-palette-error); font-weight:600; min-width:38px; text-align:right;"
                            : prog >= 70
                                ? "color: var(--mud-palette-warning); font-weight:600; min-width:38px; text-align:right;"
                                : "color: var(--mud-palette-success); font-weight:600; min-width:38px; text-align:right;";
                        <MudStack Spacing="0" Class="py-2" Style="border-bottom: 1px solid rgba(0,0,0,0.06);">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@b.CategoryIcon.ToIcon()" Size="Size.Small"
                                             Style="@($"color:{b.CategoryColor}; font-size:18px;")" />
                                    <MudText Typo="Typo.body2">@b.CategoryName</MudText>
                                    @if (prog >= 90)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Error" />
                                    }
                                </MudStack>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @b.Used.ToString("C0") / @b.Budget.Amount.ToString("C0")
                                    </MudText>
                                    <MudText Typo="Typo.caption" Style="@pctStyle">@prog%</MudText>
                                </MudStack>
                            </MudStack>
                            <MudProgressLinear Value="@Math.Min(prog, 100)" Color="@barColor"
                                              Size="Size.Small" Rounded="true" Class="mt-1" />
                            @if (b.Remaining < 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">
                                    Over budget by @Math.Abs(b.Remaining).ToString("C0")
                                </MudText>
                            }
                            else if (IsCurrentMonth && _daysLeft > 0 && b.Budget.Amount > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                    @b.Remaining.ToString("C0") remaining · @(b.Remaining / _daysLeft).ToString("C0")/day budget
                                </MudText>
                            }
                        </MudStack>
                    }
                </MudStack>
            </MudPaper>
        }

        <ReportChartsPanel CategorySummary="@_report.CategorySummary"
                           Summary="@_report.Summary"
                           Class="mb-6" />

        <MudPaper Elevation="1" Class="mb-6">
            <MudTabs Elevation="0">
                <MudTabPanel Text="By Category" Icon="@Icons.Material.Filled.Category">
                    <div class="pa-4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                            Click rows to filter the transactions table below. Multiple selections allowed.
                        </MudText>
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Color="Color.Error" Style="vertical-align:middle;" />
                                    Expenses
                                </MudText>
                                @if (!_report.CategorySummary.Any())
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">No expense transactions this month.</MudText>
                                }
                                else
                                {
                                    <MudSimpleTable Hover="true" Dense="true">
                                        <thead>
                                            <tr>
                                                <th>Category</th>
                                                <th>Total</th>
                                                <th>Txn</th>
                                                <th>%</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var cat in _report.CategorySummary)
                                            {
                                                var isActive = _selectedCategories.Contains(cat.CategoryName);
                                                var pct = _report.Summary.TotalExpenses > 0
                                                    ? cat.TotalSpent / _report.Summary.TotalExpenses * 100 : 0m;
                                                <tr style="cursor:pointer; @(isActive ? "background: var(--mud-palette-primary-hover);" : "")"
                                                    @onclick="async () => await ToggleCategoryFilter(cat.CategoryName)">
                                                    <td>
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                            @if (isActive)
                                                            {
                                                                <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" Color="Color.Primary" />
                                                            }
                                                            <MudIcon Icon="@cat.Icon.ToIcon()" Size="Size.Small"
                                                                     Style="@($"font-size:15px; color:{cat.Color ?? "inherit"};")" />
                                                            <span>@cat.CategoryName</span>
                                                        </MudStack>
                                                    </td>
                                                    <td>@cat.TotalSpent.ToString("C2")</td>
                                                    <td>@cat.TransactionCount</td>
                                                    <td>@pct.ToString("F1")%</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                }
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Color="Color.Success" Style="vertical-align:middle;" />
                                    Income
                                </MudText>
                                @if (!_report.IncomeCategorySummary.Any())
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">No income transactions this month.</MudText>
                                }
                                else
                                {
                                    <MudSimpleTable Hover="true" Dense="true">
                                        <thead>
                                            <tr>
                                                <th>Category</th>
                                                <th>Total</th>
                                                <th>Txn</th>
                                                <th>%</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var cat in _report.IncomeCategorySummary)
                                            {
                                                var isActive = _selectedCategories.Contains(cat.CategoryName);
                                                var totalIncome = _report.Summary.TotalIncome;
                                                var pct = totalIncome > 0 ? cat.TotalSpent / totalIncome * 100 : 0m;
                                                <tr style="cursor:pointer; @(isActive ? "background: var(--mud-palette-primary-hover);" : "")"
                                                    @onclick="async () => await ToggleCategoryFilter(cat.CategoryName)">
                                                    <td>
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                            @if (isActive)
                                                            {
                                                                <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" Color="Color.Primary" />
                                                            }
                                                            <MudIcon Icon="@cat.Icon.ToIcon()" Size="Size.Small"
                                                                     Style="@($"font-size:15px; color:{cat.Color ?? "inherit"};")" />
                                                            <span>@cat.CategoryName</span>
                                                        </MudStack>
                                                    </td>
                                                    <td>@cat.TotalSpent.ToString("C2")</td>
                                                    <td>@cat.TransactionCount</td>
                                                    <td>@pct.ToString("F1")%</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                }
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="By Card" Icon="@Icons.Material.Filled.CreditCard">
                    <div class="pa-4">
                    @if (!_report.CardSummary.Any())
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No card transactions this month.</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                            Click a row to see what was purchased with that card below.
                        </MudText>
                        <MudSimpleTable Hover="true" Dense="true">
                            <thead>
                                <tr>
                                    <th>Card</th>
                                    <th>Bank</th>
                                    <th>Total Spent</th>
                                    <th>Biggest Category</th>
                                    <th>Est. Benefit</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var card in _report.CardSummary)
                                {
                                    var isActive = _activeCardFilter == card.CardName;
                                    var topCat = GetTopCategoryForCard(card.CardName);
                                    <tr style="cursor:pointer; @(isActive ? "background: var(--mud-palette-primary-hover);" : "")"
                                        @onclick="async () => await SetCardFilter(card.CardName)">
                                        <td>
                                            @if (isActive)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small"
                                                         Color="Color.Primary" Class="mr-1" Style="vertical-align:middle;" />
                                            }
                                            @card.CardName
                                        </td>
                                        <td>@(card.BankName ?? "—")</td>
                                        <td>@card.TotalSpent.ToString("C2")</td>
                                        <td>@(topCat ?? "—")</td>
                                        <td>
                                            @if (card.EstimatedBenefit > 0)
                                            {
                                                <MudText Color="Color.Success">@card.EstimatedBenefit.ToString("C2")</MudText>
                                            }
                                            else
                                            {
                                                <MudText Color="Color.Secondary">—</MudText>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                    </div>
                </MudTabPanel>
            </MudTabs>
        </MudPaper>

        @if (_report.Recommendations.Any())
        {
            <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">Recommendations</MudText>
            <MudGrid Spacing="2" Class="mb-6">
                @foreach (var rec in _report.Recommendations)
                {
                    <MudItem xs="12" md="6">
                        <MudAlert Severity="@GetRecommendationSeverity(rec.Type)" Dense="true">
                            <MudText Typo="Typo.body2">@rec.Message</MudText>
                            @if (rec.EstimatedLoss.HasValue)
                            {
                                <MudText Typo="Typo.caption" Class="mt-1">
                                    Missed benefit: @rec.EstimatedLoss.Value.ToString("C2")
                                </MudText>
                            }
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        }

        <MudPaper Class="pa-4 mb-6" Elevation="1">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">AI Analysis</MudText>
                </MudStack>
                @if (string.IsNullOrWhiteSpace(_report.AiAnalysis))
                {
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Psychology"
                               OnClick="@(() => RequestAiAnalysis(false))"
                               Disabled="@_aiLoading">
                        @if (_aiLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Analyzing...</span>
                        }
                        else
                        {
                            <span>Analyze with AI</span>
                        }
                    </MudButton>
                }
                else
                {
                    <MudButton Color="Color.Secondary"
                               Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="@(() => RequestAiAnalysis(true))"
                               Disabled="@_aiLoading">
                        @if (_aiLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Analyzing...</span>
                        }
                        else
                        {
                            <span>Re-analyze</span>
                        }
                    </MudButton>
                }
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(_report.AiAnalysis))
            {
                <div class="ai-report-content">@((MarkupString)RenderMarkdown(_report.AiAnalysis))</div>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Click "Analyze with AI" to get personalized recommendations based on this month's data.
                </MudText>
            }
        </MudPaper>

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-2" Wrap="Wrap.Wrap">
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="flex-wrap:wrap; gap:6px;">
                    <MudText Typo="Typo.h6" Class="font-weight-bold">
                        @TransactionSectionTitle
                    </MudText>
                    @if (_selectedCategories.Count == 1)
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small"
                                 OnClose="@(async _ => await ClearCategoryFilters())">
                            @_selectedCategories.First()
                        </MudChip>
                    }
                    else if (_selectedCategories.Count > 1)
                    {
                        @foreach (var cat in _selectedCategories.ToList())
                        {
                            var catName = cat;
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small"
                                     OnClose="@(async _ => await ToggleCategoryFilter(catName))">
                                @catName
                            </MudChip>
                        }
                    }
                    @if (_activeCardFilter is not null)
                    {
                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small"
                                 OnClose="@(async _ => await ClearCardFilter())">
                            @_activeCardFilter
                        </MudChip>
                    }
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Style="flex-wrap:wrap;">
                    <MudText Typo="Typo.caption" Color="Color.Success">
                        <b>@_ft.Income.ToString("C2")</b> income
                    </MudText>
                    <MudText Typo="Typo.caption" Style="opacity:0.4;">·</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Error">
                        <b>@_ft.Expenses.ToString("C2")</b> expenses
                    </MudText>
                    <MudText Typo="Typo.caption" Style="opacity:0.4;">·</MudText>
                    <MudText Typo="Typo.caption" Color="@(_ft.Net >= 0 ? Color.Success : Color.Error)">
                        <b>@_ft.Net.ToString("C2")</b> net
                    </MudText>
                    <MudText Typo="Typo.caption" Style="opacity:0.4;">·</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_ft.Total rows</MudText>
                </MudStack>
            </MudStack>
            <MudButton StartIcon="@Icons.Material.Filled.Download"
                       Size="Size.Small"
                       Variant="Variant.Outlined"
                       OnClick="ExportCsv">
                Export CSV
            </MudButton>
        </MudStack>

        <MudDataGrid T="ReportTransactionDto"
                     Items="@FilteredTransactions"
                     Filterable="true"
                     SortMode="SortMode.Multiple"
                     Dense="true"
                     Elevation="1">
            <Columns>
                <PropertyColumn Property="x => x.Date" Title="Date" Format="MM/dd/yyyy" />
                <PropertyColumn Property="x => x.Name" Title="Name" />
                <PropertyColumn Property="x => x.CategoryName" Title="Category" />
                <TemplateColumn Title="Amount" SortBy="@(x => x.Amount)">
                    <CellTemplate>
                        <MudText Typo="Typo.body2"
                                 Color="@(context.Item.IsExpense ? Color.Error : Color.Success)">
                            @context.Item.Amount.ToString("C2")
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Payment">
                    <CellTemplate>
                        <MudText Typo="Typo.caption">@(context.Item.PaymentMethod?.ToString() ?? "—")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.CardName" Title="Card" />
                <PropertyColumn Property="x => x.AccountName" Title="Account" />
                <PropertyColumn Property="x => x.BankName" Title="Bank" />
                <PropertyColumn Property="x => x.Description" Title="Notes" />
            </Columns>
        </MudDataGrid>
    }
</MudContainer>

@code {
    private MonthlyReportFilterDto _filter = new()
    {
        Year = DateTime.Today.Year,
        Month = DateTime.Today.Month
    };

    private MonthlyReportDto? _report;
    private List<BudgetWithUsageDto> _budgets = new();
    private bool _loading;
    private bool _aiLoading;

    private int _daysLeft => IsCurrentMonth ? DateTime.DaysInMonth(_filter.Year, _filter.Month) - DateTime.Today.Day : 0;
    private int _elapsed => IsCurrentMonth ? Math.Max(1, DateTime.Today.Day - 1) : DateTime.DaysInMonth(_filter.Year, _filter.Month);

    private HashSet<string> _selectedCategories = new();
    private string? _activeCardFilter;

    private string MonthLabel =>
        new DateTime(_filter.Year, _filter.Month, 1).ToString("MMMM yyyy");

    private bool IsCurrentMonth =>
        _filter.Year == DateTime.Today.Year && _filter.Month == DateTime.Today.Month;

    private string TransactionSectionTitle
    {
        get
        {
            var parts = new List<string>();
            if (_selectedCategories.Count == 1)
                parts.Add(_selectedCategories.First());
            else if (_selectedCategories.Count > 1)
                parts.Add($"{_selectedCategories.Count} Categories");
            if (_activeCardFilter is not null)
                parts.Add(_activeCardFilter);
            return parts.Count > 0 ? $"Transactions — {string.Join(" + ", parts)}" : "All Transactions";
        }
    }

    private IEnumerable<ReportTransactionDto> FilteredTransactions
    {
        get
        {
            if (_report is null) return [];
            var tx = _report.Transactions.AsEnumerable();
            if (_selectedCategories.Count > 0)
                tx = tx.Where(t => _selectedCategories.Contains(t.CategoryName));
            if (_activeCardFilter is not null)
                tx = tx.Where(t => t.CardName == _activeCardFilter);
            return tx;
        }
    }

    private (decimal Income, decimal Expenses, decimal Net, int IncomeCount, int ExpenseCount, int Total) _ft
    {
        get
        {
            var list = FilteredTransactions.ToList();
            var income   = list.Where(t => !t.IsExpense).Sum(t => Math.Abs(t.Amount));
            var expenses = list.Where(t =>  t.IsExpense).Sum(t => Math.Abs(t.Amount));
            return (income, expenses, income - expenses,
                    list.Count(t => !t.IsExpense),
                    list.Count(t =>  t.IsExpense),
                    list.Count);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var saved = await ReportState.GetAsync();
        if (saved is not null)
        {
            _filter = new MonthlyReportFilterDto { Year = saved.Year, Month = saved.Month };
            _selectedCategories = saved.SelectedCategories.ToHashSet();
            _activeCardFilter = saved.ActiveCardFilter;
        }
        await LoadReport();
    }

    private async Task LoadReport()
    {
        _loading = true;
        _report = null;
        _budgets = new();
        StateHasChanged();

        var reportTask = ReportService.GetMonthlyReportAsync(_filter);
        var budgetTask = BudgetService.GetMonthlyWithUsageAsync(_filter.Year, _filter.Month);
        await Task.WhenAll(reportTask, budgetTask);

        var result = reportTask.Result;
        if (result.Success)
            _report = result.Data;
        else
            Snackbar.Add(result.Message, Severity.Error);

        if (_report is not null)
        {
            var cached = await ReportService.GetCachedAiAnalysisAsync(_filter.Year, _filter.Month);
            if (cached.Success)
                _report.AiAnalysis = cached.Data;
        }

        var br = budgetTask.Result;
        if (br.Success && br.Data is not null)
            _budgets = br.Data.Where(b => b.Budget.Amount > 0).ToList();

        _loading = false;
    }

    private Task SaveState() => ReportState.SaveAsync(new MonthlyReportStateDto
    {
        Year = _filter.Year,
        Month = _filter.Month,
        SelectedCategories = _selectedCategories.ToList(),
        ActiveCardFilter = _activeCardFilter
    });

    private static string RenderMarkdown(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return string.Empty;
        return Markdown.ToHtml(markdown, new MarkdownPipelineBuilder().UseAdvancedExtensions().Build());
    }

    private async Task RequestAiAnalysis(bool forceRefresh)
    {
        if (_report is null) return;
        _aiLoading = true;
        StateHasChanged();

        var result = await ReportService.GetAiAnalysisAsync(_report, forceRefresh);
        if (result.Success)
            _report.AiAnalysis = result.Data;
        else
            Snackbar.Add(result.Message, Severity.Warning);

        _aiLoading = false;
    }

    private async Task PrevMonth()
    {
        var d = new DateTime(_filter.Year, _filter.Month, 1).AddMonths(-1);
        _filter = new MonthlyReportFilterDto { Year = d.Year, Month = d.Month };
        _selectedCategories = new();
        _activeCardFilter = null;
        await SaveState();
        await LoadReport();
    }

    private async Task NextMonth()
    {
        var d = new DateTime(_filter.Year, _filter.Month, 1).AddMonths(1);
        _filter = new MonthlyReportFilterDto { Year = d.Year, Month = d.Month };
        _selectedCategories = new();
        _activeCardFilter = null;
        await SaveState();
        await LoadReport();
    }

    private async Task ToggleCategoryFilter(string categoryName)
    {
        if (_selectedCategories.Contains(categoryName))
            _selectedCategories.Remove(categoryName);
        else
            _selectedCategories.Add(categoryName);
        await SaveState();
    }

    private async Task SetCardFilter(string cardName)
    {
        _activeCardFilter = _activeCardFilter == cardName ? null : cardName;
        await SaveState();
    }

    private async Task ClearCategoryFilters()
    {
        _selectedCategories = new();
        await SaveState();
    }

    private async Task ClearCardFilter()
    {
        _activeCardFilter = null;
        await SaveState();
    }

    private string? GetTopCategoryForCard(string cardName) =>
        _report?.Transactions
            .Where(t => t.CardName == cardName && t.IsExpense)
            .GroupBy(t => t.CategoryName)
            .OrderByDescending(g => g.Sum(t => Math.Abs(t.Amount)))
            .FirstOrDefault()?.Key;

    private async Task ExportCsv()
    {
        if (_report is null) return;

        var sb = new StringBuilder();
        sb.AppendLine("Date,Name,Merchant,Category,Amount,CardName,PaymentMethod,Account,Bank,Notes");
        foreach (var t in FilteredTransactions)
        {
            sb.AppendLine($"{t.Date:yyyy-MM-dd},{Esc(t.Name)},{Esc(t.Merchant)},{Esc(t.CategoryName)},{t.Amount},{Esc(t.CardName)},{t.PaymentMethod?.ToString() ?? string.Empty},{Esc(t.AccountName)},{Esc(t.BankName ?? string.Empty)},{Esc(t.Description ?? string.Empty)}");
        }

        var suffix = _selectedCategories.Count == 1
            ? $"_{_selectedCategories.First()}"
            : _selectedCategories.Count > 1
                ? $"_{_selectedCategories.Count}_categories"
                : _activeCardFilter is not null
                    ? $"_{_activeCardFilter}"
                    : string.Empty;

        var filename = $"report_{_filter.Year}_{_filter.Month:00}{suffix}.csv";
        await JS.InvokeVoidAsync("downloadTextFile", filename, sb.ToString());
    }

    private static string Esc(string s) => "\"" + s.Replace("\"", "\"\"") + "\"";

    private static Severity GetRecommendationSeverity(RecommendationType type) => type switch
    {
        RecommendationType.WrongCardUsed => Severity.Warning,
        RecommendationType.MissedBenefit => Severity.Warning,
        RecommendationType.TopSpendingCategory => Severity.Info,
        RecommendationType.HighCashUsage => Severity.Info,
        _ => Severity.Normal
    };
}
