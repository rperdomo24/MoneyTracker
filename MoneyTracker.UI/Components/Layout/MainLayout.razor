@using System.Reflection
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using MoneyTracker.UI.Components.Shared.Drawer
@using MoneyTracker.UI.Services.Components.Drawer
@inject ProtectedSessionStorage SessionStorage
@inject AccountsDrawerState AccountsDrawer
@inject AccountsDrawerState AccountsDrawerState

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <!-- Top AppBar -->
    <MudAppBar Elevation="2" Color="Color.Default" Fixed="true">

        <!-- Solo icono (SIN toggle) -->
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudIcon Icon="@Icons.Material.Filled.Menu" Class="mr-2" />
        </MudHidden>

        <MudIcon Icon="@Icons.Material.Filled.AttachMoney"
                 Size="Size.Medium"
                 Class="mr-2" />

        <!-- App name (Desktop/Tablet only) -->
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudText Typo="Typo.h6" Class="font-weight-bold">
                Money Tracker
            </MudText>
        </MudHidden>

        <MudSpacer />

        <!-- Desktop/Tablet only: Quick Balance mock -->
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            @if (_showQuickBalance)
            {
                <MudChip T="string"
                         Size="Size.Small"
                         Color="Color.Success"
                         Icon="@Icons.Material.Filled.AttachMoney"
                         Class="mr-3">
                    $12,345.67
                </MudChip>
            }
        </MudHidden>

        <!-- Accounts Drawer toggle (ALL pages, from layout) -->
        <MudIconButton Icon="@Icons.Material.Filled.AccountBalanceWallet"
                       Color="Color.Inherit"
                       Class="mr-1"
                       OnClick="ToggleAccountsDrawer" />

        <!-- Notifications -->
        <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                       Color="Color.Inherit"
                       Class="mr-1"
                       Title="Notifications">
            <MudBadge Content="3"
                      Color="Color.Error"
                      Overlap="true"
                      Bordered="true">
            </MudBadge>
        </MudIconButton>

        <!-- User Menu -->
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                 Color="Color.Inherit"
                 Dense="true"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight">
            <ChildContent>

                <MudMenuItem Icon="@DarkLightModeButtonIcon" OnClick="@DarkModeToggle">
                    @(_isDarkMode ? "Light mode" : "Dark mode")
                </MudMenuItem>

                <MudDivider />

                <MudMenu Dense="true"
                         AnchorOrigin="Origin.CenterRight"
                         TransformOrigin="Origin.CenterLeft">
                    <ActivatorContent>
                        <MudMenuItem Icon="@Icons.Material.Filled.Settings">
                            Settings
                        </MudMenuItem>
                    </ActivatorContent>

                    <ChildContent>
                        <MudMenuItem Href="/accounts" Icon="@Icons.Material.Filled.AccountBalanceWallet">
                            Accounts
                        </MudMenuItem>

                        <MudMenuItem Href="/categories" Icon="@Icons.Material.Filled.Category">
                            Categories
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>

                <MudDivider />

                <MudMenuItem Icon="@Icons.Material.Filled.Help">
                    Help & Support
                </MudMenuItem>

                <MudMenuItem Icon="@Icons.Material.Filled.Logout">
                    Sign Out
                </MudMenuItem>

            </ChildContent>
        </MudMenu>

    </MudAppBar>

    <!-- LEFT DRAWER (Desktop/Tablet): SOLO ICONOS SIEMPRE -->
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudDrawer Open="true"
                   Variant="DrawerVariant.Mini"
                   MiniWidth="72px"
                   Width="72px"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="2"
                   Overlay="true"
                   Class="drawer-custom">

            <!-- Header mini -->
            <div class="pa-3 d-flex align-center justify-center"
                 style="min-height: 80px; border-bottom: 1px solid var(--mud-palette-divider);">
                <MudAvatar Size="Size.Medium"
                           Style="background: linear-gradient(135deg, var(--mud-palette-primary), var(--mud-palette-secondary));">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Surface" />
                </MudAvatar>
            </div>

            <!-- Navigation Menu -->
            <NavMenu />

            <!-- Footer mini -->
            <div class="mt-auto pa-2 d-flex justify-center"
                 style="border-top: 1px solid var(--mud-palette-divider);">
                <MudText Typo="Typo.caption" Class="text-muted">
                    v@(GetAppVersion())
                </MudText>
            </div>

        </MudDrawer>
    </MudHidden>

    <!-- MAIN CONTENT -->
    <MudMainContent Class="main-content-custom">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6">

            @if (_showBreadcrumbs)
            {
                <MudBreadcrumbs Items="_breadcrumbItems" Class="mb-4">
                    <ItemTemplate Context="item">
                        <MudLink Href="@item.Href" Class="d-flex align-center">
                            @if (!string.IsNullOrEmpty(item.Icon))
                            {
                                <MudIcon Icon="@item.Icon" Size="Size.Small" Class="mr-1" />
                            }
                            @item.Text
                        </MudLink>
                    </ItemTemplate>
                </MudBreadcrumbs>
            }

            <div class="page-content">
                @Body
            </div>
        </MudContainer>

        <!-- Footer -->
        <footer class="footer-custom mt-auto">
            <MudDivider />
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
                <MudGrid Justify="Justify.Center">
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Class="text-muted">
                            <MudIcon Icon="@Icons.Material.Filled.Copyright" Size="Size.Small" Class="mr-1" />
                            Money Tracker © @DateTime.Now.Year - All rights reserved
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" md="6" Class="text-right">
                        <MudStack Row Spacing="3" Justify="Justify.FlexEnd" Class="d-none d-md-flex">
                            <MudLink Href="/privacy" Typo="Typo.caption" Class="text-muted">Privacy</MudLink>
                            <MudLink Href="/terms" Typo="Typo.caption" Class="text-muted">Terms</MudLink>
                            <MudLink Href="/support" Typo="Typo.caption" Class="text-muted">Support</MudLink>
                        </MudStack>

                        <MudText Typo="Typo.caption" Class="text-muted d-block d-md-none">
                            v@(GetAppVersion())
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudContainer>
        </footer>
    </MudMainContent>

    <!-- MOBILE BOTTOM NAV (only mobile) -->
    <MudHidden Breakpoint="Breakpoint.SmAndUp">
        <MudAppBar Bottom="true" Fixed="true" Elevation="8" Color="Color.Surface">

            <MudIconButton Icon="@Icons.Material.Filled.AccountBalanceWallet"
                           Color="Color.Inherit"
                           Href="/accounts"
                           Title="accounts" />

            <MudSpacer />

            <MudIconButton Icon="@Icons.Material.Filled.Dashboard"
                           Color="Color.Inherit"
                           Href="/"
                           Title="Home" />

            <MudSpacer />

            <MudIconButton Icon="@Icons.Material.Filled.ListAlt"
                           Color="Color.Inherit"
                           Href="/transactions"
                           Title="Transactions" />

            <MudSpacer />

            <MudIconButton Icon="@Icons.Material.Filled.PieChart"
                           Color="Color.Inherit"
                           Href="/budgets"
                           Title="Budgets" />
        </MudAppBar>
    </MudHidden>

    <!-- ✅ ACCOUNTS DRAWER (Mobile: modal con overlay) -->
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudDrawer Anchor="Anchor.End"
                   Variant="DrawerVariant.Temporary"
                   Elevation="6"
                   OverlayAutoClose="true"
                   Overlay="false"
                   Width="400px"
                   @bind-Open="AccountsDrawerOpen">

            <AccountsQuickDrawer IsOpen="AccountsDrawerOpen"
                                 OnClose="CloseAccountsDrawer"
                                 @key="AccountsDrawerOpen" />
        </MudDrawer>
    </MudHidden>

    <!-- ✅ ACCOUNTS DRAWER (Desktop/Tablet: persistent SIN overlay) -->
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudDrawer Anchor="Anchor.End"
                   Variant="DrawerVariant.Persistent"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="2"
                   Width="420px"
                   Overlay="true"
                   OverlayAutoClose="false"
                   @bind-Open="AccountsDrawerOpen">

            <AccountsQuickDrawer IsOpen="AccountsDrawerOpen"
                                 OnClose="CloseAccountsDrawer"
                                 @key="AccountsDrawerOpen" />
        </MudDrawer>
    </MudHidden>

</MudLayout>

<!-- Blazor Error UI -->
<div id="blazor-error-ui" class="blazor-error-ui">
    <div class="error-content">
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Error" Class="mr-2" />
                <div>
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Application Error</MudText>
                    <MudText Typo="Typo.body2">An unexpected error has occurred. Please reload the page.</MudText>
                </div>
            </div>
            <div class="mt-3">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Surface"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="() => { }"
                           Class="reload mr-2">
                    Reload Page
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Surface"
                           StartIcon="@Icons.Material.Filled.Close"
                           Class="dismiss">
                    Dismiss
                </MudButton>
            </div>
        </MudAlert>
    </div>
</div>

<style>
    .main-content-custom {
        background: var(--mud-palette-background);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .page-content {
        flex: 1;
        min-height: calc(100vh - 200px);
    }

    .footer-custom {
        margin-top: auto;
        background: var(--mud-palette-surface);
    }

    /* ✅ IMPORTANTE: ocultar texto del NavMenu para que quede SOLO ICONOS */
    .mud-drawer .mud-nav-link-text,
    .mud-drawer .mud-navmenu .mud-nav-link-text {
        display: none !important;
    }

    /* Centrar items (se ve más “rail”) */
    .mud-drawer .mud-nav-link {
        justify-content: center;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .blazor-error-ui {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.8);
        display: none;
        z-index: 10000;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

        .blazor-error-ui .error-content {
            max-width: 500px;
            width: 100%;
        }
</style>

@code {
    private const string SessionKey_IsDarkMode = "isDarkMode";
    private const string SessionKey_AccountsDrawerOpen = "accountsDrawerOpen";

    private bool _isDarkMode = true;
    private bool _showQuickBalance = true;
    private bool _showBreadcrumbs = false;
    private MudTheme? _theme;
    private bool _initialized = false;

    private bool AccountsDrawerOpen
    {
        get => AccountsDrawer.IsOpen;
        set => _ = SetAccountsDrawerOpenAsync(value);
    }

    protected override void OnInitialized()
        => AccountsDrawer.OnChange += AccountsDrawerChanged;

    private async void AccountsDrawerChanged()
    {
        await SaveAccountsDrawerStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task CloseAccountsDrawer()
        => AccountsDrawer.CloseAsync();

    private Task ToggleAccountsDrawer()
        => AccountsDrawer.ToggleAsync();

    private async Task SetAccountsDrawerOpenAsync(bool open)
    {
        if (open)
            await AccountsDrawer.OpenAsync();
        else
            await AccountsDrawer.CloseAsync();
    }

    public void Dispose()
        => AccountsDrawer.OnChange -= AccountsDrawerChanged;

    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Dashboard", href: "/", icon: Icons.Material.Filled.Dashboard),
        new BreadcrumbItem("Accounts", href: "/accounts", icon: Icons.Material.Filled.AccountBalance),
    };

    protected override async Task OnInitializedAsync()
    {
        _theme = new MudTheme
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties
            {
                AppbarHeight = "80px"
            },
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;

            try
            {
                var themeResult = await SessionStorage.GetAsync<bool>(SessionKey_IsDarkMode);
                if (themeResult.Success)
                    _isDarkMode = themeResult.Value;

                var drawerResult = await SessionStorage.GetAsync<bool>(SessionKey_AccountsDrawerOpen);
                if (drawerResult.Success)
                    await SetAccountsDrawerOpenAsync(drawerResult.Value);

                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error accessing SessionStorage: {ex.Message}");
            }
        }
    }

    private async Task SaveAccountsDrawerStateAsync()
    {
        try
        {
            await SessionStorage.SetAsync(SessionKey_AccountsDrawerOpen, AccountsDrawer.IsOpen);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving accounts drawer state: {ex.Message}");
        }
    }

    private async void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;

        try
        {
            await SessionStorage.SetAsync(SessionKey_IsDarkMode, _isDarkMode);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving theme preference: {ex.Message}");
        }

        StateHasChanged();
    }

    private string GetAppVersion()
    {
        var version = Assembly.GetExecutingAssembly().GetName().Version;
        return version != null ? $"{version.Major}.{version.Minor}.{version.Build}" : "1.0.0";
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#3b3c3d",
        Secondary = "#71c4ef",
        Background = "#fffefb",
        Surface = "#f5f4f1",
        AppbarBackground = "#f5f4f1",
        AppbarText = "#1d1c1c",
        DrawerBackground = "#fffefb",
        DrawerText = "#1d1c1c",
        DrawerIcon = "#3b3c3d",
        TextPrimary = "#1d1c1c",
        TextSecondary = "#313d44",
        ActionDefault = "#3b3c3d",
        ActionDisabled = "#b6ccd8",
        ActionDisabledBackground = "#d4eaf7",
        Info = "#00668c",
        Success = "#1fab89",
        Warning = "#f39c12",
        Error = "#e74c3c",
        TableLines = "#cccbc8",
        LinesDefault = "#cccbc8",
        Divider = "#cccbc8"
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#0085ff",
        Secondary = "#006fff",
        Background = "#1E1E1E",
        Surface = "#2d2d2d",
        AppbarBackground = "#2d2d2d",
        AppbarText = "#FFFFFF",
        DrawerBackground = "#1E1E1E",
        DrawerText = "#FFFFFF",
        DrawerIcon = "#69b4ff",
        TextPrimary = "#FFFFFF",
        TextSecondary = "#9e9e9e",
        ActionDefault = "#0085ff",
        ActionDisabled = "#454545",
        ActionDisabledBackground = "#2d2d2d",
        Info = "#1e40af",
        Success = "#3dcb6c",
        Warning = "#ffb545",
        Error = "#ff3f5f",
        TableLines = "#454545",
        LinesDefault = "#454545",
        Divider = "#454545"
    };

    public string DarkLightModeButtonIcon => _isDarkMode
        ? Icons.Material.Rounded.LightMode
        : Icons.Material.Outlined.DarkMode;
}