@using System.Reflection
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage SessionStorage

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>

    <!-- Top AppBar -->
    <MudAppBar Elevation="1" Color="Color.Default">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle" />
        <MudText Typo="Typo.h6" Class="ml-2 font-weight-bold">Money Tracker</MudText>
        <MudSpacer />
        <MudIconButton Icon="@DarkLightModeButtonIcon" Color="Color.Inherit" OnClick="@DarkModeToggle" />
    </MudAppBar>

    <!-- Side Drawer (Menu) -->
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Elevation="2" Class="mud-width-260">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            @Body
        </MudContainer>

        <!-- Footer -->
        <footer class="mt-8">
            <MudDivider />
            <MudContainer Class="py-2">
                <MudText Typo="Typo.caption" Align="Align.Center">
                    Money Tracker © @DateTime.Now.Year | Version @(Assembly.GetExecutingAssembly().GetName().Version?.ToString())
                </MudText>
            </MudContainer>
        </footer>
    </MudMainContent>

</MudLayout>

<!-- Blazor error UI -->
<div id="blazor-error-ui" style="display:none;">
    <p>An unknown error has occurred.</p>
    <a href="" class="reload">Reload</a>
    <a class="dismiss" style="cursor:pointer; margin-left:10px;">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private MudTheme? _theme;

    protected override async Task OnInitializedAsync()
    {
        _theme = new MudTheme
            {
                PaletteLight = _lightPalette,
                PaletteDark = _darkPalette,
                LayoutProperties = new LayoutProperties
                {
                    AppbarHeight = "64px",
                    DrawerWidthLeft = "260px"
                }
            };
    }


    private bool _initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;

            try
            {
                var result = await SessionStorage.GetAsync<bool>("isDarkMode");

                if (result.Success)
                {
                    _isDarkMode = result.Value;
                    StateHasChanged(); // actualiza la UI si es necesario
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error accessing SessionStorage: {ex.Message}");
            }
        }
    }


    private async void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
        await SessionStorage.SetAsync("isDarkMode", _isDarkMode);
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;


    private readonly PaletteLight _lightPalette = new()
        {
            Primary = "#3b3c3d",              // primary-300
            Secondary = "#71c4ef",            // accent-100
            Background = "#fffefb",           // bg-100
            Surface = "#f5f4f1",              // bg-200
            AppbarBackground = "#f5f4f1",     // bg-200
            AppbarText = "#1d1c1c",           // text-100
            DrawerBackground = "#fffefb",     // bg-100
            DrawerText = "#1d1c1c",           // text-100
            DrawerIcon = "#3b3c3d",           // primary-300
            TextPrimary = "#1d1c1c",          // text-100
            TextSecondary = "#313d44",        // text-200
            ActionDefault = "#3b3c3d",        // primary-300
            ActionDisabled = "#b6ccd8",       // primary-200
            ActionDisabledBackground = "#d4eaf7", // primary-100
            Info = "#00668c",                 // accent-200
            Success = "#1fab89",              // elegido armónicamente
            Warning = "#f39c12",              // opcional (no incluido)
            Error = "#e74c3c",                // opcional (no incluido)
            TableLines = "#cccbc8",           // bg-300
            LinesDefault = "#cccbc8",
            Divider = "#cccbc8"
        };




    private readonly PaletteDark _darkPalette = new()
        {
            Primary = "#0085ff",              // primary-100
            Secondary = "#006fff",            // accent-100
            Background = "#1E1E1E",           // bg-100
            Surface = "#2d2d2d",              // bg-200
            AppbarBackground = "#2d2d2d",     // bg-200
            AppbarText = "#FFFFFF",           // text-100
            DrawerBackground = "#1E1E1E",     // bg-100
            DrawerText = "#FFFFFF",           // text-100
            DrawerIcon = "#69b4ff",           // primary-200
            TextPrimary = "#FFFFFF",          // text-100
            TextSecondary = "#9e9e9e",        // text-200
            ActionDefault = "#0085ff",        // primary-100
            ActionDisabled = "#454545",       // bg-300
            ActionDisabledBackground = "#2d2d2d", // bg-200
            Info = "#e1ffff",                 // accent-200
            Success = "#3dcb6c",              // armónico
            Warning = "#ffb545",              // armónico
            Error = "#ff3f5f",                // armónico
            TableLines = "#454545",           // bg-300
            LinesDefault = "#454545",
            Divider = "#454545"
        };




    public string DarkLightModeButtonIcon => _isDarkMode
        ? Icons.Material.Rounded.AutoMode
        : Icons.Material.Outlined.DarkMode;
}
